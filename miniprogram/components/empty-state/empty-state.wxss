/* 易理明灯 — Empty State Component Styles */

.empty-state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-3xl) var(--space-lg);
  min-height: 240px;
}

.empty-state-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 320px;
}

/* ---- Title ---- */
.empty-state-title {
  font-size: var(--font-xl);
  font-weight: 500;
  color: var(--color-text);
  letter-spacing: 0.02em;
  line-height: 1.4;
}

/* ---- Subtitle ---- */
.empty-state-subtitle {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  margin-top: var(--space-sm);
  line-height: 1.6;
  letter-spacing: 0.02em;
}

/* ---- Hints (chat suggestions) ---- */
.empty-state-hints {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
  width: 100%;
}

.hint-chip {
  padding: var(--space-sm) var(--space-md);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  text-align: center;
  transition: all var(--transition-fast);
}

.hint-chip:active {
  transform: scale(0.97);
  background: rgba(212, 168, 67, 0.06);
  border-color: rgba(212, 168, 67, 0.3);
}

.hint-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  letter-spacing: 0.02em;
}

/* ---- Action Button ---- */
.empty-state-btn {
  margin-top: var(--space-xl);
  padding: var(--space-sm) var(--space-2xl);
  min-height: 44px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, rgba(212, 168, 67, 0.15), rgba(212, 168, 67, 0.08));
  border: 1px solid rgba(212, 168, 67, 0.35);
  font-size: var(--font-md);
  color: var(--gold);
  font-weight: 500;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(8px);
  transition: all var(--transition-normal);
}

.empty-state-btn.visible {
  opacity: 1;
  transform: translateY(0);
}

.empty-state-btn:active {
  transform: scale(0.97);
  background: linear-gradient(135deg, rgba(212, 168, 67, 0.25), rgba(212, 168, 67, 0.12));
}

/* ---- Detail text ---- */
.empty-state-detail {
  display: block;
  font-size: var(--font-xs);
  color: var(--stone);
  margin-top: var(--space-md);
  line-height: 1.5;
  max-width: 280px;
}

/* ---- Responsive ---- */
@media (prefers-reduced-motion: reduce) {
  .empty-state-btn {
    transition: none;
  }
}
