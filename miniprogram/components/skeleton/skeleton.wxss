/* 易理明灯 — Skeleton Loading | 宣纸墨韵 */

/* ---- Shimmer Animation ---- */
@keyframes skeletonShimmer {
  0% { background-position: -800rpx 0; }
  100% { background-position: 800rpx 0; }
}

.skeleton {
  width: 100%;
}

/* ---- Base shimmer line ---- */
.skeleton-line {
  height: 28rpx;
  border-radius: 7rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(90deg,
    rgba(58, 44, 30, 0.05) 25%,
    rgba(58, 44, 30, 0.1) 37%,
    rgba(58, 44, 30, 0.05) 63%
  );
  background-size: 1600rpx 100%;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}

.skeleton-line-title {
  height: 36rpx;
  border-radius: 9rpx;
}

/* ---- Card type ---- */
.skeleton-card {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
}

.skeleton-card-img {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  background: linear-gradient(90deg,
    rgba(58, 44, 30, 0.05) 25%,
    rgba(58, 44, 30, 0.1) 37%,
    rgba(58, 44, 30, 0.05) 63%
  );
  background-size: 1600rpx 100%;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
}

.skeleton-card-body {
  padding-top: var(--space-xs);
}

/* ---- List type ---- */
.skeleton-list {
  display: flex;
  flex-direction: column;
}

.skeleton-list-item {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.skeleton-list-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: var(--space-md);
  background: linear-gradient(90deg,
    rgba(58, 44, 30, 0.05) 25%,
    rgba(58, 44, 30, 0.1) 37%,
    rgba(58, 44, 30, 0.05) 63%
  );
  background-size: 1600rpx 100%;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
}

.skeleton-list-body {
  flex: 1;
}

/* ---- Text type ---- */
.skeleton-text {
  padding: var(--space-md) 0;
}
