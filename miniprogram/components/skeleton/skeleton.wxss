/* 易理明灯 — Skeleton Loading Styles */

/* ---- Shimmer Animation ---- */
@keyframes skeletonShimmer {
  0% { background-position: -400px 0; }
  100% { background-position: 400px 0; }
}

.skeleton {
  width: 100%;
}

/* ---- Base shimmer line ---- */
.skeleton-line {
  height: 14px;
  border-radius: 7px;
  margin-bottom: 12px;
  background: linear-gradient(90deg,
    var(--color-bg-card-alt) 25%,
    rgba(255,255,255,0.06) 37%,
    var(--color-bg-card-alt) 63%
  );
  background-size: 800px 100%;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}

.skeleton-line-title {
  height: 18px;
  border-radius: 9px;
}

/* ---- Card type ---- */
.skeleton-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
}

.skeleton-card-img {
  width: 100%;
  height: 120px;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  background: linear-gradient(90deg,
    var(--color-bg-card-alt) 25%,
    rgba(255,255,255,0.06) 37%,
    var(--color-bg-card-alt) 63%
  );
  background-size: 800px 100%;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
}

.skeleton-card-body {
  padding-top: var(--space-xs);
}

/* ---- List type ---- */
.skeleton-list {
  display: flex;
  flex-direction: column;
}

.skeleton-list-item {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 1px solid var(--color-divider);
}

.skeleton-list-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: var(--space-md);
  background: linear-gradient(90deg,
    var(--color-bg-card-alt) 25%,
    rgba(255,255,255,0.06) 37%,
    var(--color-bg-card-alt) 63%
  );
  background-size: 800px 100%;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
}

.skeleton-list-body {
  flex: 1;
}

/* ---- Text type ---- */
.skeleton-text {
  padding: var(--space-md) 0;
}

/* ---- Light mode adjustment ---- */
@media (prefers-color-scheme: light) {
  .skeleton-line {
    background: linear-gradient(90deg,
      #E0DBD2 25%,
      #F0EBE0 37%,
      #E0DBD2 63%
    );
    background-size: 800px 100%;
  }
  .skeleton-card-img {
    background: linear-gradient(90deg,
      #E0DBD2 25%,
      #F0EBE0 37%,
      #E0DBD2 63%
    );
    background-size: 800px 100%;
  }
  .skeleton-list-avatar {
    background: linear-gradient(90deg,
      #E0DBD2 25%,
      #F0EBE0 37%,
      #E0DBD2 63%
    );
    background-size: 800px 100%;
  }
}
