/* 易理明灯 — Animated Score Ring | v6 */

.score-ring-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-ring-canvas {
  position: absolute;
  top: 0;
  left: 0;
}

.score-ring-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.score-ring-number {
  font-size: 96rpx;
  font-weight: 600;
  line-height: 1;
  transition: color 0.4s ease-out;
}

.score-ring-label {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  margin-top: 4rpx;
  letter-spacing: 0.08em;
}
