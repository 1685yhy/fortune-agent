/* 易理明灯 — Animated Score Ring Styles */

.score-ring-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-ring-canvas {
  position: absolute;
  top: 0;
  left: 0;
}

.score-ring-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.score-ring-number {
  font-size: 48px;
  font-weight: 700;
  line-height: 1;
  transition: color 0.4s ease-out;
}

.score-ring-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: 2px;
  letter-spacing: 0.08em;
}
