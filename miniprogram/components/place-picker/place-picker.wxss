/* 出生地选择 · 省/市级联 + 搜索弹层（persons / hehun / bazi 共用） */

.pp-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 2rpx solid var(--line-soft);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.pp-box-active {
  border-color: var(--acc-soft);
}

.pp-text {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.4;
}

.pp-empty .pp-text {
  color: var(--ink-faint);
}

.pp-chev {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-left: 12rpx;
}

/* ── 弹层 ── */
.pp-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(30, 20, 10, 0.45);
}

.pp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  height: 76vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.pp-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 18rpx;
}

.pp-sheet-title {
  font-family: var(--font-song);
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: .12em;
  color: var(--ink);
}

.pp-sheet-x {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--ink-soft);
  border-radius: 50%;
}

.pp-x-active {
  background: var(--acc-soft);
  color: var(--acc);
}

.pp-search {
  margin: 0 30rpx 18rpx;
  height: 76rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid var(--line-soft);
  border-radius: 12rpx;
  color: var(--ink);
}

.pp-search-ph {
  color: var(--ink-faint);
}

/* 搜索列表 */
.pp-search-list {
  flex: 1;
  min-height: 0;
}

.pp-sr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 30rpx;
  padding: 26rpx 6rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.pp-sr-active {
  background: var(--acc-soft);
}

.pp-sr-city {
  font-size: 30rpx;
  color: var(--ink);
}

.pp-sr-prov {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.pp-sr-empty {
  padding: 60rpx 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-faint);
}

/* 双列联动 */
.pp-cols {
  flex: 1;
  min-height: 0;
  display: flex;
}

.pp-prov-col {
  width: 210rpx;
  height: 100%;
  background: var(--paper-deep);
  border-right: 2rpx solid var(--line-soft);
}

.pp-prov {
  padding: 26rpx 14rpx;
  font-size: 27rpx;
  text-align: center;
  color: var(--ink-mid);
  border-left: 6rpx solid transparent;
}

.pp-prov.on {
  background: var(--paper-card);
  color: var(--acc);
  border-left-color: var(--acc);
  font-weight: 600;
}

.pp-city-col {
  flex: 1;
  height: 100%;
}

.pp-city {
  padding: 26rpx 30rpx;
  font-size: 28rpx;
  color: var(--ink);
  border-bottom: 2rpx solid var(--line-soft);
}

.pp-city-active {
  background: var(--acc-soft);
  color: var(--acc);
}
