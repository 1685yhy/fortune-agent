/* ═══════════════════════════════════════════════════════════════
   多盘对比（P1-2 前端）— 墨韵对照盘面（复用排盘页组件样式体系：
   输入区 pp-input/form-card，卡片 pp-card/pp-head/pp-seal，页脚 page-foot）
   视觉基准：宣纸 #F5EFE1 / 墨 #3A2C1E / 朱砂 #A93A2C / 金 #B08A4F（app.wxss 变量）
   ═══════════════════════════════════════════════════════════════ */

page {
  /* 五行色（排盘页同款，页级补齐） */
  --wx-mu: #4E6B4A; --wx-huo: #A93A2C; --wx-tu: #8A6A44;
  --wx-jin: #B08A4F; --wx-shui: #4A6B7A;
}

.pp-page, .pp-input { padding: 24rpx 30rpx 60rpx; }

/* ════════ ① 输入区（复用排盘页 input/form 体系） ════════ */

.input-head { display: flex; align-items: center; gap: 20rpx; padding: 30rpx 10rpx 22rpx; }
.input-seal {
  width: 78rpx; height: 78rpx; flex-shrink: 0; border-radius: 10rpx;
  background: var(--acc); box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 4rpx 10rpx rgba(60,30,20,.25);
  display: flex; align-items: center; justify-content: center;
}
.input-seal-char { font-family: var(--font-kai); font-size: 42rpx; color: #FBF6E8; line-height: 1; }
.input-mid { min-width: 0; }
.input-title { display: block; font-family: var(--font-song); font-weight: 700; font-size: 40rpx; letter-spacing: .2em; color: var(--ink); }
.input-sub { display: block; margin-top: 6rpx; font-family: var(--font-song); font-size: 22rpx; letter-spacing: .14em; color: var(--ink-soft); }

.form-card {
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  padding: 8rpx 30rpx 30rpx;
  box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
}
.form-group { margin-top: 26rpx; }
.form-label { display: flex; align-items: center; gap: 10rpx; font-family: var(--font-song); font-size: 24rpx; letter-spacing: .06em; color: var(--ink-mid); margin-bottom: 14rpx; }
.form-req { font-family: var(--font-song); font-size: 20rpx; color: var(--acc); border: 2rpx solid var(--acc-line); border-radius: 5rpx; padding: 2rpx 10rpx; }
.form-opt { font-family: var(--font-song); font-size: 20rpx; color: var(--ink-faint); letter-spacing: .04em; }
.form-picker {
  padding: 24rpx;
  background: var(--paper);
  border: 2rpx solid var(--line-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink-mid);
}
.form-picker-empty { color: var(--ink-faint); }
/* 性别：男/女 并排大按钮（与 paipan 同款：选中朱砂底白字，未选宣纸墨框） */
.gender-group { display: flex; gap: 22rpx; }
.gender-btn {
  flex: 1; display: flex; align-items: center; justify-content: center;
  padding: 26rpx 0; border-radius: 14rpx;
  background: var(--paper); border: 2rpx solid var(--line-btn);
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.35);
}
.gender-char { font-family: var(--font-song); font-size: 32rpx; letter-spacing: .3em; color: var(--ink); text-indent: .3em; }
.gender-btn-tap { transform: translateY(2rpx); }
.gender-btn.is-on {
  background: var(--acc); border-color: var(--acc);
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 6rpx 18rpx rgba(169,58,44,.28);
}
.gender-btn.is-on .gender-char { color: #FBF6E8; font-weight: 600; }
.form-error { margin-top: 22rpx; font-family: var(--font-song); font-size: 24rpx; color: var(--acc); letter-spacing: .06em; }

.pp-btn {
  margin-top: 34rpx;
  background: var(--acc); border-radius: 12rpx;
  padding: 26rpx 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 8rpx 20rpx rgba(169,58,44,.25);
}
.pp-btn text { font-family: var(--font-song); font-weight: 600; font-size: 30rpx; letter-spacing: .34em; color: #FBF6E8; text-indent: .34em; }
.pp-btn-active { background: var(--acc-deep); }
.pp-btn-disabled { opacity: .72; }
.input-privacy { margin-top: 20rpx; text-align: center; font-family: var(--font-song); font-size: 20rpx; letter-spacing: .16em; color: var(--ink-faint); }

.pp-repick {
  margin-top: 40rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-btn);
  border-radius: 12rpx;
  padding: 24rpx 0;
  display: flex; align-items: center; justify-content: center;
}
.pp-repick text { font-family: var(--font-song); font-size: 26rpx; letter-spacing: .3em; color: var(--ink); }

/* ════════ ② 命主信息头（复用排盘页 master 体系） ════════ */

.master-head {
  display: flex; align-items: center; gap: 24rpx; padding: 26rpx 30rpx; margin-bottom: 24rpx;
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
}
.master-seal {
  width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 12rpx;
  background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 48rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 4rpx 10rpx rgba(60,30,20,.25);
}
.master-mid { flex: 1; min-width: 0; }
.master-name { font-family: var(--font-song); font-weight: 700; font-size: 34rpx; letter-spacing: .12em; color: var(--ink); }
.master-name-sub { font-size: 20rpx; font-weight: 400; letter-spacing: .1em; color: var(--ink-soft); margin-left: 16rpx; }
.master-sub { margin-top: 6rpx; font-family: var(--font-song); font-size: 21rpx; letter-spacing: .08em; color: var(--ink-soft); }
.master-right { text-align: right; flex-shrink: 0; }
.mr-tag {
  font-family: var(--font-song); font-size: 20rpx; letter-spacing: .16em; color: var(--acc);
  border: 2rpx solid rgba(169,58,44,.3); background: var(--acc-soft); border-radius: 6rpx; padding: 6rpx 14rpx;
}

/* ════════ ③ 通用卡片（复用排盘页 pp-card 体系） ════════ */

.pp-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
  margin-top: 20rpx;
}
.pp-head { display: flex; align-items: center; gap: 18rpx; padding-bottom: 26rpx; border-bottom: 2rpx solid var(--line-soft); }
.pp-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.pp-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.pp-head-sub { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint); }
.pp-foot { margin-top: 28rpx; padding-top: 24rpx; border-top: 2rpx solid var(--line-soft); display: flex; align-items: center; gap: 16rpx; }
.pp-foot-tag {
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .14em; color: #FBF6E8;
  background: var(--ink); border-radius: 6rpx; padding: 6rpx 16rpx; flex-shrink: 0;
}
.pp-foot-txt { font-family: var(--font-kai); font-size: 23rpx; letter-spacing: .08em; color: var(--ink-mid); line-height: 1.8; }

/* ════════ ④ 对比摘要 ════════ */

.dp-summary { margin-top: 28rpx; }
.dp-sum-item { display: flex; align-items: flex-start; gap: 16rpx; }
.dp-sum-item + .dp-sum-item { margin-top: 18rpx; }
.dp-sum-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--ink-faint);
  margin-top: 14rpx; flex-shrink: 0;
}
.dp-sum-item.is-key .dp-sum-dot { background: var(--acc); box-shadow: 0 0 0 6rpx var(--acc-soft); }
.dp-sum-txt { flex: 1; font-family: var(--font-kai); font-size: 26rpx; line-height: 1.85; letter-spacing: .05em; color: var(--ink-mid); }
.dp-sum-item.is-key .dp-sum-txt { color: var(--acc); font-weight: 600; }

/* ════════ ⑤ 四柱并排对照 ════════ */

.dp-pan-row { display: flex; align-items: stretch; gap: 10rpx; margin-top: 26rpx; }
.dp-pan-row.dp-pan-b { margin-top: 14rpx; }
.dp-pan-label {
  width: 76rpx; flex-shrink: 0; border-radius: 12rpx;
  background: var(--paper); border: 2rpx solid var(--line);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
}
.dp-pan-row.dp-pan-b .dp-pan-label { background: var(--paper-deep); }
.dp-pan-char { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; color: var(--ink); }
.dp-pan-sh { font-family: var(--font-song); font-size: 17rpx; letter-spacing: .06em; color: var(--ink-soft); }
.dp-pillar {
  flex: 1; min-width: 0; position: relative;
  background: var(--paper); border: 2rpx solid var(--line-soft); border-radius: 12rpx;
  padding: 16rpx 4rpx 14rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.dp-pillar.is-changed {
  background: rgba(169,58,44,.08); border: 2rpx solid var(--acc);
  box-shadow: 0 8rpx 20rpx rgba(169,58,44,.16);
}
.dp-pillar-mark {
  position: absolute; top: -14rpx; right: -10rpx;
  font-family: var(--font-kai); font-size: 18rpx; letter-spacing: .08em; color: #FBF6E8;
  background: var(--acc); border-radius: 6rpx; padding: 4rpx 10rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12);
}
.dp-p-name { font-family: var(--font-song); font-size: 17rpx; letter-spacing: .2em; color: var(--ink-faint); }
.dp-p-shishen {
  font-family: var(--font-song); font-size: 18rpx; letter-spacing: .1em; color: var(--ink-soft);
  background: var(--paper-card); border: 2rpx solid var(--line-soft); border-radius: 5rpx; padding: 4rpx 12rpx;
  max-width: 100%; overflow: hidden; white-space: nowrap;
}
.dp-pillar.is-changed .dp-p-shishen { color: var(--acc); background: var(--acc-soft); border-color: rgba(169,58,44,.28); }
.dp-p-gz { font-family: var(--font-song); font-weight: 700; font-size: 34rpx; line-height: 1.15; color: var(--ink); letter-spacing: .02em; }
.dp-pillar.is-changed .dp-p-gz { color: var(--acc); }
.dp-p-nayin { font-family: var(--font-song); font-size: 16rpx; letter-spacing: .12em; color: var(--gold); }

/* ════════ ⑥ 五行差异 ════════ */

.dp-wx-row { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; }
.dp-wx-row + .dp-wx-row { border-top: 2rpx dashed var(--line-soft); padding-top: 18rpx; }
.dp-wx-name { width: 60rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.dp-wx-char { font-family: var(--font-song); font-weight: 700; font-size: 28rpx; color: var(--ink); }
.dp-wx-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.dp-wx-dot.mu { background: var(--wx-mu); } .dp-wx-dot.huo { background: var(--wx-huo); }
.dp-wx-dot.tu { background: var(--wx-tu); } .dp-wx-dot.jin { background: var(--wx-jin); } .dp-wx-dot.shui { background: var(--wx-shui); }
.dp-wx-num { width: 48rpx; flex-shrink: 0; text-align: center; font-family: var(--font-song); font-size: 26rpx; color: var(--ink); }
.dp-wx-arrow { flex: 1; text-align: center; font-family: var(--font-song); font-size: 22rpx; color: var(--ink-faint); }
.dp-wx-delta {
  width: 92rpx; flex-shrink: 0; text-align: center;
  font-family: var(--font-song); font-size: 20rpx; letter-spacing: .08em;
  color: var(--ink-faint); border: 2rpx dashed var(--line-soft); border-radius: 6rpx; padding: 6rpx 0;
}
.dp-wx-delta.is-changed { color: var(--acc); background: var(--acc-soft); border: 2rpx solid rgba(169,58,44,.3); font-weight: 600; }

/* ════════ ⑦ 用神 · 格局 ════════ */

.dp-pair { margin-top: 22rpx; }
.dp-pair-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.dp-pair-row + .dp-pair-row { border-top: 2rpx dashed var(--line-soft); }
.dp-pair-key { width: 110rpx; flex-shrink: 0; font-family: var(--font-song); font-size: 20rpx; letter-spacing: .18em; color: var(--ink-faint); }
.dp-pair-val { flex: 1; min-width: 0; font-family: var(--font-kai); font-size: 25rpx; letter-spacing: .04em; color: var(--ink); }
.dp-pair-badge {
  flex-shrink: 0; font-family: var(--font-song); font-size: 18rpx; letter-spacing: .1em;
  border-radius: 6rpx; padding: 6rpx 14rpx;
}
.dp-pair-badge.is-same { color: var(--gold); background: rgba(176,138,79,.1); border: 2rpx solid var(--gold-soft); }
.dp-pair-badge.is-diff { color: var(--acc); background: var(--acc-soft); border: 2rpx solid rgba(169,58,44,.3); }

/* ════════ ⑧ 大运差异 ════════ */

.dp-dy-row { display: flex; align-items: stretch; gap: 14rpx; margin-top: 26rpx; }
.dp-dy-cell {
  flex: 1; min-width: 0; background: var(--paper); border: 2rpx solid var(--line-soft);
  border-radius: 14rpx; padding: 18rpx 16rpx;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.dp-dy-label { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .22em; color: var(--ink-faint); }
.dp-dy-num { font-family: var(--font-kai); font-size: 44rpx; color: var(--ink); line-height: 1.2; }
.dp-dy-unit { font-size: 20rpx; color: var(--ink-soft); margin-left: 4rpx; }
.dp-dy-qi { font-family: var(--font-song); font-size: 17rpx; letter-spacing: .04em; color: var(--ink-soft); text-align: center; }
.dp-dy-gap {
  width: 150rpx; flex-shrink: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx;
}
.dp-dy-gap-badge { font-family: var(--font-song); font-size: 20rpx; letter-spacing: .08em; border-radius: 6rpx; padding: 8rpx 18rpx; }
.dp-dy-gap-badge.is-same { color: var(--gold); background: rgba(176,138,79,.1); border: 2rpx solid var(--gold-soft); }
.dp-dy-gap-badge.is-diff { color: var(--acc); background: var(--acc-soft); border: 2rpx solid rgba(169,58,44,.3); }
.dp-dy-seq { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .1em; color: var(--ink-soft); text-align: center; }
.dp-dy-steps { margin-top: 22rpx; display: flex; flex-direction: column; gap: 10rpx; }
.dp-dy-steps-row { display: flex; align-items: center; gap: 14rpx; }
.dp-dy-steps-side { width: 26rpx; flex-shrink: 0; font-family: var(--font-song); font-weight: 700; font-size: 20rpx; color: var(--ink-faint); }
.dp-dy-step {
  display: inline-flex; align-items: baseline; gap: 8rpx;
  font-family: var(--font-song); font-weight: 600; font-size: 24rpx; letter-spacing: .06em; color: var(--ink-mid);
  background: var(--paper); border: 2rpx solid var(--line-soft); border-radius: 8rpx; padding: 8rpx 18rpx;
}
.dp-dy-step.is-first { color: var(--acc); background: var(--acc-soft); border-color: rgba(169,58,44,.3); }
.dp-dy-step-sui { font-size: 17rpx; color: var(--ink-faint); font-weight: 400; }

/* ════════ ⑨ 神煞差异（新增朱砂 · 消失墨灰） ════════ */

.dp-ss-group { margin-top: 26rpx; }
.dp-ss-gname {
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .26em; color: var(--ink-faint);
  display: flex; align-items: center; gap: 12rpx;
}
.dp-ss-gname::after { content: ''; flex: 1; height: 2rpx; background: var(--line-soft); }
.dp-ss-count { color: var(--ink-soft); font-weight: 600; }
.dp-ss-tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.dp-ss-tag {
  display: inline-flex; align-items: center; gap: 10rpx;
  font-family: var(--font-song); font-size: 23rpx; letter-spacing: .12em;
  border-radius: 8rpx; padding: 14rpx 24rpx;
}
.dp-ss-tag.is-added { color: var(--acc); background: var(--acc-soft); border: 2rpx solid rgba(169,58,44,.3); }
.dp-ss-tag.is-removed { color: var(--ink-mid); background: var(--paper-deep); border: 2rpx solid var(--line); }
.dp-ss-empty {
  margin-top: 26rpx; padding: 26rpx 0; text-align: center;
  font-family: var(--font-kai); font-size: 24rpx; letter-spacing: .1em; color: var(--ink-faint);
  background: var(--paper); border: 2rpx dashed var(--line-soft); border-radius: 12rpx;
}
.dp-ss-common {
  margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line-soft);
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint);
}
.dp-ss-common-b { color: var(--acc); font-weight: 600; }

/* ════════ 页脚 ════════ */

.page-foot { margin-top: 32rpx; text-align: center; }
.pf-line { width: 320rpx; height: 2rpx; margin: 0 auto 20rpx; background: linear-gradient(90deg, transparent, var(--ink-faint), transparent); }
.pf-t1, .pf-t2 { display: block; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .22em; color: var(--ink-faint); line-height: 2.1; }
