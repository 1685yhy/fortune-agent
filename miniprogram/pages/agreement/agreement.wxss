/* 用户协议 — 灯下契约 | 宣纸墨韵 */

.page-agreement {
  min-height: 100vh;
  background: var(--paper);
}

.agreement-scroll {
  height: 100vh;
  padding: var(--space-lg);
}

/* ========================================
   头部
   ======================================== */
.agreement-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 var(--space-xl);
}

.agreement-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: var(--space-md);
}

.agreement-title {
  font-family: var(--font-kai);
  font-size: var(--text-xl);
  font-weight: 400;
  color: var(--ink);
  margin-bottom: var(--space-xs);
  letter-spacing: .16em;
}

.agreement-subtitle {
  font-size: var(--text-xs);
  color: var(--ink-soft);
  letter-spacing: .1em;
}

/* ========================================
   内容区块
   ======================================== */
.agreement-section {
  margin-bottom: var(--space-xl);
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  box-shadow: 0 3rpx 12rpx rgba(58,44,30,.05);
}

.agreement-section-title {
  display: block;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--acc);
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--line-soft);
  letter-spacing: .16em;
}

.agreement-text {
  display: block;
  font-size: var(--text-sm);
  color: var(--ink-mid);
  line-height: 1.9;
  margin-bottom: var(--space-sm);
}

.agreement-text.highlight {
  color: var(--ink);
  font-weight: 500;
  background: rgba(251,247,236,.7);
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  margin-top: var(--space-sm);
  border-left: 3rpx solid var(--acc);
}

/* ========================================
   列表
   ======================================== */
.agreement-list {
  margin-top: var(--space-sm);
}

.agreement-list-item {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.agreement-list-item:last-child {
  border-bottom: none;
}

.agreement-list-bullet {
  font-size: var(--text-sm);
  color: var(--acc);
  font-weight: 600;
  flex-shrink: 0;
  width: 40rpx;
}

.agreement-list-text {
  font-size: var(--text-sm);
  color: var(--ink-mid);
  line-height: 1.8;
  flex: 1;
}

/* ========================================
   免责声明卡片
   ======================================== */
.disclaimer-card {
  background: rgba(169,58,44,.05);
  border: 1rpx solid rgba(169,58,44,.3);
  border-radius: var(--radius-sm);
  padding: var(--space-md);
  margin: var(--space-md) 0;
}

.disclaimer-card-title {
  display: block;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--acc);
  margin-bottom: var(--space-xs);
  letter-spacing: .14em;
}

.disclaimer-card-text {
  display: block;
  font-size: var(--text-sm);
  color: var(--ink-mid);
  line-height: 1.8;
}

/* ========================================
   联系卡片
   ======================================== */
.contact-card {
  background: rgba(251,247,236,.6);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-sm);
  padding: var(--space-md);
  margin: var(--space-md) 0;
}

.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: var(--text-xs);
  color: var(--ink-soft);
}

.contact-value {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--ink);
}

/* ========================================
   页脚
   ======================================== */
.agreement-footer {
  text-align: center;
  padding: var(--space-xl) 0 var(--space-xl);
}

.agreement-footer-text {
  display: block;
  font-size: var(--text-xs);
  color: var(--ink-soft);
  line-height: 1.8;
}
