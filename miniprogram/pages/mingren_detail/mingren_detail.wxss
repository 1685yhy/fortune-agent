/* ═══ 名人命例 — 详情页（L3-1）墨韵视觉基准：
   宣纸 #F5EFE1 / 墨 #3A2C1E / 朱砂 #A93A2C / 金 #B08A4F（同列表页一族） ═══ */

.mrd-page {
  min-height: 100vh;
  background: var(--paper);
}

/* ── 加载态 ── */
.mrd-loading {
  padding: 200rpx 0;
  text-align: center;
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .3em;
  color: var(--ink-faint);
}

/* ── 未解锁视图（朱砂锁印 + 开通引导） ── */
.mrd-locked {
  padding: 200rpx 70rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

/* ── 加载失败视图（重试路径, 同锁视图布局） ── */
.mrd-failed {
  padding: 200rpx 70rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.mrd-lock-seal {
  width: 110rpx;
  height: 110rpx;
  font-size: 60rpx;
  border-radius: 14rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 6rpx 16rpx rgba(60,30,20,.25);
}
.mrd-lock-t {
  margin-top: 20rpx;
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 34rpx;
  letter-spacing: .14em;
  color: var(--ink);
}
.mrd-lock-s {
  font-family: var(--font-song);
  font-size: 23rpx;
  line-height: 1.7;
  letter-spacing: .05em;
  color: var(--ink-mid);
  text-align: center;
}
.mrd-lock-btn {
  margin-top: 26rpx;
  padding: 22rpx 70rpx;
  background: var(--acc);
  border-radius: 12rpx;
  font-family: var(--font-song);
  font-size: 26rpx;
  letter-spacing: .2em;
  color: #FBF6E8;
  box-shadow: 0 8rpx 20rpx rgba(169,58,44,.3);
}
.mrd-lock-btn-active { opacity: .85; transform: translateY(2rpx); }

/* ── 详情滚动区 ── */
.mrd-scroll {
  height: 100vh;
  padding: 26rpx 38rpx 80rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 姓名题头 */
.mrd-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 10rpx 6rpx 30rpx;
}
.mrd-hero-seal {
  width: 92rpx;
  height: 92rpx;
  font-size: 52rpx;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 6rpx 16rpx rgba(60,30,20,.25);
}
.mrd-hero-mid { display: flex; flex-direction: column; gap: 8rpx; }
.mrd-hero-name {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 52rpx;
  letter-spacing: .24em;
  color: var(--ink);
}
.mrd-hero-sub {
  font-family: var(--font-kai);
  font-size: 22rpx;
  letter-spacing: .2em;
  color: var(--acc);
}

/* ── 章节卡（papercard 底） ── */
.mrd-card {
  margin-bottom: 26rpx;
  padding: 28rpx 30rpx 32rpx;
}
.mrd-sec-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: .14em;
  color: var(--ink);
}
.mrd-sec-head .zd {
  width: 10rpx;
  height: 10rpx;
  transform: rotate(45deg);
  background: var(--acc);
  border-radius: 2rpx;
}
.mrd-sec-count {
  margin-left: auto;
  font-weight: 400;
  font-size: 19rpx;
  letter-spacing: .1em;
  color: var(--ink-faint);
}
.mrd-info {
  font-family: var(--font-song);
  font-size: 25rpx;
  line-height: 1.8;
  letter-spacing: .05em;
  color: var(--ink-mid);
}

/* ── 穷通宝鉴评注（朱砂框 + 印章，突出呈现） ── */
.mrd-note {
  margin-bottom: 26rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--acc-line);
  border-left: 8rpx solid var(--acc);
  border-radius: 14rpx;
  padding: 28rpx 30rpx 32rpx;
  box-shadow: 0 14rpx 40rpx rgba(169,58,44,.08);
}
.mrd-note-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}
.mrd-note-seal {
  width: 64rpx;
  height: 64rpx;
  font-size: 36rpx;
  border-radius: 8rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12);
}
.mrd-note-title {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 30rpx;
  letter-spacing: .14em;
  color: var(--acc-deep);
}
.mrd-note-sub {
  font-family: var(--font-kai);
  font-weight: 400;
  font-size: 20rpx;
  letter-spacing: .16em;
  color: var(--acc);
}
.mrd-note-body {
  font-family: var(--font-kai);
  font-size: 26rpx;
  line-height: 1.9;
  letter-spacing: .04em;
  color: var(--ink);
}
.mrd-note-src {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .06em;
  color: var(--ink-faint);
}

/* ── 生平大事时间线（朱砂点 + 墨线） ── */
.mrd-tl { margin-top: 4rpx; }
.mrd-tl-item {
  display: flex;
  gap: 20rpx;
}
.mrd-tl-rail {
  width: 28rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  position: relative;
}
.mrd-tl-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--acc);
  box-shadow: 0 0 0 4rpx var(--acc-soft);
  flex-shrink: 0;
}
.mrd-tl-item:not(:last-child) .mrd-tl-rail::after {
  content: '';
  position: absolute;
  top: 34rpx;
  bottom: -8rpx;
  left: 50%;
  width: 2rpx;
  transform: translateX(-50%);
  background: var(--line);
}
.mrd-tl-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 30rpx;
}
.mrd-tl-year {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 25rpx;
  letter-spacing: .12em;
  color: var(--acc-deep);
}
.mrd-tl-text {
  font-family: var(--font-song);
  font-size: 23rpx;
  line-height: 1.75;
  letter-spacing: .04em;
  color: var(--ink-mid);
}
.mrd-tl-empty {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .16em;
  color: var(--ink-faint);
}

/* 页脚 */
.mrd-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19rpx;
  margin-top: 20rpx;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .24em;
  color: var(--ink-faint);
}

/* ── 会员开通弹层（同列表页一族） ── */
.member-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20, 14, 8, .6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.member-dialog {
  width: 100%;
  max-width: 620rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 24rpx 64rpx rgba(30, 20, 10, .35);
  padding: 52rpx 44rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.md-seal { display: flex; align-items: center; justify-content: center; }
.md-seal-seal { width: 92rpx; height: 92rpx; font-size: 56rpx; transform: rotate(-3deg); }
.md-title {
  margin-top: 18rpx;
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 40rpx;
  letter-spacing: .22em;
  color: var(--ink);
}
.md-sub {
  margin-top: 10rpx;
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .16em;
  color: var(--ink-soft);
}
.md-benefits {
  width: 100%;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--paper-deep);
  border: 2rpx solid var(--line-soft);
  border-radius: 12rpx;
  padding: 26rpx 28rpx;
}
.md-b-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .1em;
  color: var(--ink-mid);
}
.md-b-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--acc);
  flex-shrink: 0;
}
.md-plan {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--paper-deep);
  border: 2rpx solid var(--line-soft);
  border-radius: 12rpx;
  padding: 24rpx 26rpx;
}
.md-plan-active { background: var(--gold-soft); }
.mp-ic { display: flex; align-items: center; justify-content: center; }
.mp-seal { width: 62rpx; height: 62rpx; font-size: 36rpx; transform: rotate(-2deg); }
.mp-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  min-height: 100rpx;
}
.mp-name {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: .08em;
  color: var(--ink);
}
.mp-desc {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .06em;
  color: var(--ink-faint);
}
.mp-price {
  flex-shrink: 0;
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  white-space: nowrap;
  text-align: right;
}
.mp-num {
  font-family: var(--font-lat);
  font-weight: 700;
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--acc-deep);
}
.mp-unit {
  font-family: var(--font-song);
  font-size: 19rpx;
  line-height: 1.2;
  letter-spacing: .04em;
  color: var(--ink-faint);
}
.md-close {
  margin-top: 34rpx;
  padding: 18rpx 40rpx;   /* 触达 ~72rpx(≥44px 建议值), UX批2 Minor */
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .2em;
  color: var(--ink-faint);
}

/* ═══ 八字命盘卡 + 大运×大事对照（B5-3，同墨韵一族：宣纸/墨/朱砂） ═══ */

/* 时辰缺失标注：小字灰注（显眼但不突兀——正文级小字+墨灰，不抢盘面焦点） */
.mrd-hournote {
  display: block;
  margin: -4rpx 0 18rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .06em;
  color: var(--ink-faint);
}

/* 命主信息行 */
.mrd-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 26rpx;
  padding: 2rpx 0 22rpx;
  border-bottom: 1rpx dashed rgba(58,44,30,.18);
}
.mrd-meta-item {
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .06em;
  color: var(--ink-mid);
}

/* 四柱盘面（问真式：四柱为列、多行为格的表格——行序：主星→天干→地支→
   藏干→副星→星运→空亡→纳音→神煞；日柱朱砂底 + 天干上乾造/坤造小标） */
.mrd-pillars {
  display: flex;
  flex-direction: column;
  padding-top: 18rpx;
}
/* 表头行：行标签占位 + 四柱名（日柱朱砂） */
.mrd-g-head {
  display: flex;
  align-items: stretch;
  margin-bottom: 8rpx;
}
.mrd-g-label {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .12em;
  color: var(--ink-faint);
}
.mrd-g-col {
  flex: 1;
  text-align: center;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .28em;
  color: var(--ink-soft);
}
.mrd-g-col.is-day {
  color: var(--acc);
  font-weight: 700;
}
/* 数据行 */
.mrd-g-row {
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid rgba(58,44,30,.08);
}
.mrd-g-cell {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 16rpx 4rpx;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .06em;
  color: var(--ink-mid);
  text-align: center;
  border-left: 1rpx solid rgba(58,44,30,.06);
}
.mrd-g-cell.is-day {
  background: linear-gradient(180deg, rgba(169,58,44,.07) 0%, rgba(169,58,44,.015) 88%);
}
/* 天干/地支大字醒目居中（问真排版感） */
.mrd-g-big {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 56rpx;
  line-height: 1.12;
  color: var(--ink);
}
.mrd-g-cell.is-day .mrd-g-big {
  color: var(--acc-deep);
}
/* 乾造/坤造：日柱天干上小朱标 */
.mrd-g-gankun {
  position: absolute;
  top: 0;
  padding: 1rpx 10rpx;
  background: var(--acc);
  border-radius: 0 0 6rpx 6rpx;
  font-family: var(--font-song);
  font-size: 17rpx;
  letter-spacing: .08em;
  color: #FBF6E8;
}
/* 详盘行：藏干/副星/星运/空亡/神煞（小字） */
.mrd-g-cell.is-detail {
  padding: 14rpx 4rpx;
  font-size: 19rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}
.mrd-g-ss {
  display: block;
  padding: 2rpx 10rpx;
  margin: 2rpx 0;
  border: 1rpx solid rgba(169,58,44,.35);
  border-radius: 16rpx;
  font-size: 18rpx;
  letter-spacing: .08em;
  color: var(--acc-deep);
}
.mrd-g-none {
  color: var(--ink-faint);
}
/* 详盘折叠开关 */
.mrd-detail-toggle {
  margin-top: 18rpx;
  padding: 14rpx 0 2rpx;
  text-align: center;
  border-top: 1rpx dashed rgba(58,44,30,.18);
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .12em;
  color: var(--acc);
}

/* 起运行 */
.mrd-qiyun {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed rgba(58,44,30,.18);
}
.mrd-qiyun-tag {
  padding: 4rpx 14rpx;
  background: var(--acc);
  border-radius: 6rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .2em;
  color: #FBF6E8;
}
.mrd-qiyun-t {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 24rpx;
  letter-spacing: .06em;
  color: var(--ink);
}
.mrd-qiyun-desc {
  width: 100%;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .06em;
  color: var(--ink-soft);
}
.mrd-birth-src {
  margin-top: 12rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .04em;
  color: var(--ink-faint);
}

/* 大运×大事对照表 */
.mrd-dy {
  padding-top: 8rpx;
}
.mrd-dy-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 20rpx 0 10rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(169,58,44,.35);
}
.mrd-dy-head.is-plain {
  border-bottom-color: rgba(58,44,30,.22);
}
.mrd-dy-gz {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 30rpx;
  letter-spacing: .1em;
  color: var(--acc-deep);
}
.mrd-dy-gz.is-empty {
  color: var(--ink-mid);
  font-weight: 600;
}
.mrd-dy-range {
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .06em;
  color: var(--ink-mid);
}
.mrd-dy-item {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}
.mrd-dy-year {
  flex-shrink: 0;
  width: 96rpx;
  font-family: var(--font-lat);
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--acc-deep);
}
.mrd-dy-text {
  flex: 1;
  font-family: var(--font-song);
  font-size: 23rpx;
  line-height: 1.75;
  letter-spacing: .03em;
  color: var(--ink);
}
/* 大运干支可点（弹解释层，问真对标） */
.mrd-dy-gz {
  padding: 4rpx 12rpx 4rpx 0;
}

/* ── 命盘知识解释弹层（B5-3：主星/星运/纳音/神煞/大运干支） ── */
.mrd-explain-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20, 14, 8, .55);
  z-index: 110;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.mrd-explain {
  width: 100%;
  max-height: 72vh;
  background: var(--paper);
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -10rpx 40rpx rgba(30, 20, 10, .3);
  padding: 30rpx 38rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.mrd-explain-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(58,44,30,.14);
}
.mrd-explain-head .zd {
  width: 10rpx;
  height: 10rpx;
  transform: rotate(45deg);
  background: var(--acc);
  border-radius: 2rpx;
}
.mrd-explain-title {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 32rpx;
  letter-spacing: .16em;
  color: var(--ink);
}
.mrd-explain-close {
  margin-left: auto;
  padding: 4rpx 14rpx;
  font-family: var(--font-lat);
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink-faint);
}
.mrd-explain-body {
  max-height: 52vh;
  padding-top: 20rpx;
}
.mrd-explain-sec {
  margin-bottom: 22rpx;
}
.mrd-explain-name {
  display: block;
  margin-bottom: 8rpx;
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 24rpx;
  letter-spacing: .1em;
  color: var(--acc-deep);
}
.mrd-explain-text {
  display: block;
  font-family: var(--font-song);
  font-size: 24rpx;
  line-height: 1.8;
  letter-spacing: .04em;
  color: var(--ink);
}
.mrd-explain-gujue {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 18rpx;
  background: rgba(169,58,44,.06);
  border-left: 4rpx solid var(--acc);
  border-radius: 6rpx;
  font-family: var(--font-kai);
  font-size: 22rpx;
  line-height: 1.7;
  letter-spacing: .04em;
  color: var(--ink-mid);
}
.mrd-explain-foot {
  margin-top: 8rpx;
  text-align: center;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .24em;
  color: var(--ink-faint);
}
