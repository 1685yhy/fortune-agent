<view class="screen" style="--nav-off:{{navOff}}px">
  <view class="navrow">
    <view class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goToday">
      <image class="back-icon" src="/assets/images/ic-back.png"></image>
    </view>
    <view class="nav-title">
      <text>我的</text>
    </view>
    <view class="nav-right" hover-class="navrow-hover" hover-stay-time="0">
      <image class="nav-right-icon" src="/assets/images/ic-kebab.png"></image>
    </view>
  </view>

  <scroll-view scroll-y class="me-scroll">
    <!-- Task5 滚动条修复（同 chat/history）：padding 归内层容器，scroll-view 自身无 padding -->
    <view class="me-inner">
      <view class="handscroll">
        <view class="roll-left"></view>
        <view class="roll-right"></view>
        <view class="hs-in">
          <view class="hs-id">
            <image wx:if="{{avatarUrl}}" class="seal-avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="seal seal-88"><text class="seal-char">明</text></view>
            <view class="hs-sub">命盘之印</view>
          </view>
          <view class="hs-info">
            <view class="hs-name-row">
              <view class="hs-name">{{displayName}}</view>
              <view class="hs-tag {{realLogin ? 'hs-tag-real' : 'hs-tag-local'}}" wx:if="{{loginTag}}">{{loginTag}}</view>
            </view>
            <view class="hs-profile-edit" hover-class="hs-profile-edit-active" hover-stay-time="0" bindtap="openProfileDialog">{{nicknameSet ? '编辑' : '点击设置头像昵称'}}</view>
            <view class="hs-sub">{{birthdayText}}</view>
            <view class="hs-sub">{{lunarBirthday}}</view>
          </view>
          <view class="hs-spacer"></view>
          <view class="hs-pillars">
            <view wx:for="{{pillars}}" wx:key="index" class="hs-pillar {{index > 0 ? 'pillar-line' : ''}}">
              <text class="p-label">{{item.l}}</text>
              <text class="p-char">{{item.c}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="companion-line">
        <view class="fl"></view>
        <text>明灯与你同行 · 第 {{nights}} 晚</text>
      </view>

      <view class="papercard me-list">
        <view wx:for="{{meRows}}" wx:key="label" class="me-row {{index < meRows.length - 1 ? 'row-line' : ''}}"
          hover-class="me-row-active" hover-stay-time="0"
          data-action="{{item.action}}" bindtap="onRowTap">
          <view class="mr-ic"><image src="{{item.icon}}"></image></view>
          <view class="mr-label">{{item.label}}</view>
          <view class="mr-val">{{item.val}}</view>
          <view class="mr-chev" wx:if="{{!item.sub}}"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
          <view class="mr-switch" wx:else>
            <switch checked="{{subOn}}" color="#A93A2C" bindchange="onSubChange" />
          </view>
        </view>
      </view>

      <view class="me-foot">秉烛而谈 · 灯火长明</view>
    </view>
  </scroll-view>

  <!-- 头像昵称采集弹层（Task 2：chooseAvatar + nickname，墨韵 paper 风格） -->
  <view class="pp-mask" wx:if="{{profileDialogVisible}}" catchtouchmove="noop" bindtap="closeProfileDialog">
    <view class="pp-card" catchtap="noop">
      <view class="md-title">头像昵称</view>
      <view class="md-sub">一盏灯下 · 以何为名</view>
      <button class="pp-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{draftAvatar}}" class="pp-avatar" src="{{draftAvatar}}" mode="aspectFill"></image>
        <view wx:else class="seal pp-avatar-seal"><text class="seal-char">明</text></view>
        <view class="pp-avatar-tip">点击选择头像</view>
      </button>
      <input class="pp-input" type="nickname" value="{{draftNickname}}" bindinput="onNicknameInput"
        placeholder="起个名号 · 微信昵称或自拟" placeholder-class="pp-ph" maxlength="20" confirm-type="done" />
      <view class="pp-actions">
        <view class="pp-btn-ghost" hover-class="pp-btn-active" hover-stay-time="0" bindtap="closeProfileDialog">取消</view>
        <view class="pp-btn-ink" hover-class="pp-btn-active" hover-stay-time="0" bindtap="onProfileSave">保存</view>
      </view>
    </view>
  </view>

  <!-- 会员开通（虚拟支付优先，mock 降级由 payment.js 统一处理） -->
  <view class="member-mask" wx:if="{{memberDialogVisible}}" bindtap="closeMemberDialog">
    <view class="member-dialog" catchtap="noop">
      <view class="md-seal"><view class="seal md-seal-seal"><text class="seal-char">明</text></view></view>
      <view class="md-title">{{memberIsMember ? '会员权益' : '开通会员'}}</view>
      <view class="md-sub">{{memberIsMember ? '明灯长明 · 专属守护' : '全功能解锁 · 明灯长明'}}</view>
      <view class="md-benefits" wx:if="{{memberIsMember}}">
        <view class="md-b-item" wx:for="{{memberBenefits}}" wx:key="*this">
          <view class="md-b-dot"></view>
          <text>{{item}}</text>
        </view>
        <view class="md-b-expire" wx:if="{{memberExpireText}}">会员有效期至 {{memberExpireText}}</view>
      </view>
      <view class="md-plan" wx:for="{{memberPlans}}" wx:key="id"
        hover-class="md-plan-active" hover-stay-time="0"
        data-plan="{{item.id}}" bindtap="buyPlan">
        <view class="mp-ic"><view class="seal mp-seal"><text class="seal-char">阅</text></view></view>
        <view class="mp-info">
          <view class="mp-name">{{item.name}}</view>
          <view class="mp-desc">{{item.description}}</view>
        </view>
        <view class="mp-price">{{item.priceLabel}}</view>
      </view>
      <view class="md-close" bindtap="closeMemberDialog">暂不开通</view>
    </view>
  </view>

  <view class="tabbar">
    <view class="tab-item" bindtap="onTab" data-tab="chat">
      <image class="tab-ic" src="/assets/images/ic-chat.png"></image>
      <text class="tab-label">对话</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="today">
      <image class="tab-ic" src="/assets/images/ic-lantern.png"></image>
      <text class="tab-label">今日</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="suance">
      <image class="tab-ic" src="/assets/images/ic-book2.png"></image>
      <text class="tab-label">测算</text>
    </view>
    <view class="tab-item on" bindtap="onTab" data-tab="me">
      <image class="tab-ic" src="/assets/images/ic-seal-on.png"></image>
      <text class="tab-label">我的</text>
      <view class="dot"></view>
    </view>
  </view>
</view>
