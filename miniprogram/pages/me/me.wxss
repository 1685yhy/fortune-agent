/* ═══ 屏 4 · 我的 — 一卷手札（dir_b.html 987-1040 行逐行翻译，px×1.923→rpx） ═══ */

/* 右侧图标预留胶囊宽度（原型 right:10px 会被微信胶囊遮挡，右移避开） */
.navrow .nav-right { right: 190rpx; }

.me-scroll {
  position: absolute;
  top: calc(183rpx + var(--nav-off));   /* 95px */
  left: 0; right: 0;
  bottom: 173rpx;                        /* 90px */
  z-index: 25;
  padding: 19rpx 38rpx 46rpx;            /* 10px 20px 24px */
  overflow-x: hidden;                    /* 真机修复：内容超宽时横向裁剪，页面不可横滑 */
}

/* ── 一卷手札（木轴 + 宣纸芯 + 印章/名号/四柱） ── */
.handscroll {
  position: relative;
  background: var(--paper-deep);
  border-radius: 12rpx;                  /* 6px */
  border: 2rpx solid var(--line);        /* 1px */
  margin-bottom: 31rpx;                  /* 16px */
  box-shadow: 0 12rpx 31rpx var(--shadow);  /* 0 6px 16px */
}
.handscroll .roll-left, .handscroll .roll-right {
  position: absolute;
  top: -6rpx; bottom: -6rpx;             /* -3px */
  width: 25rpx;                          /* 13px */
  border-radius: 10rpx;                  /* 5px */
  z-index: 3;
  background: linear-gradient(90deg, #4A3A28, #2E2318 60%, #4A3A28);
  box-shadow: 0 4rpx 12rpx rgba(30,20,10,.35), inset 0 0 0 2rpx rgba(255,255,255,.09);  /* 0 2px 6px / 1px */
}
.handscroll .roll-left { left: 12rpx; }   /* 6px */
.handscroll .roll-right { right: 12rpx; }
.handscroll .hs-in {
  padding: 35rpx 58rpx 31rpx;            /* 18px 30px 16px */
  display: flex;
  align-items: center;
  gap: 27rpx;                            /* 14px */
}
.hs-id {
  width: 123rpx;                         /* 64px */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.seal-88 { width: 88rpx; height: 88rpx; font-size: 55rpx; transform: rotate(-2deg); }  /* 46px */
.hs-sub {
  margin-top: 8rpx;                      /* 4px */
  font-family: var(--font-song);
  font-size: 19rpx;                      /* 10px */
  letter-spacing: .08em;
  color: var(--ink-soft);
}
.hs-info { display: flex; flex-direction: column; gap: 6rpx; }  /* 3px */
.hs-name {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 35rpx;                      /* 18px */
  letter-spacing: .1em;
  color: var(--ink);
}

/* ── 登录显式展示：头像（微信头像，印章圆框）/ 状态标签 / 登录·退出 ── */
.seal-avatar {
  width: 88rpx;                          /* 与 seal-88 同尺寸，倾角呼应印章 */
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid var(--acc-soft);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .22), 0 4rpx 10rpx rgba(30, 20, 10, .18);
  transform: rotate(-2deg);
}
.hs-name-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.hs-tag {
  font-family: var(--font-song);
  font-size: 17rpx;                      /* 9px */
  letter-spacing: .12em;
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  transform: translateY(-5rpx);
}
.hs-tag-real {                           /* 微信登录：印章朱砂色 */
  color: var(--acc-deep);
  border: 2rpx solid var(--acc-soft);
  background: rgba(169, 58, 44, .05);
}
.hs-tag-local {                          /* 体验用户：低调墨色 */
  color: var(--ink-faint);
  border: 2rpx solid var(--line);
}
.hs-spacer { flex: 1; }

/* 四柱竖排（年/月/日/时） */
.hs-pillars { display: flex; }
.hs-pillar {
  width: 65rpx;                          /* 34px */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;                            /* 5px */
}
.hs-pillar .p-label {
  font-family: var(--font-song);
  font-size: 18rpx;                      /* 9.5px */
  letter-spacing: .14em;
  color: var(--ink-faint);
}
.hs-pillar .p-char {
  writing-mode: vertical-rl;
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 26rpx;                      /* 13.5px */
  letter-spacing: .18em;
  color: var(--ink);
  line-height: 1.5;
}
.pillar-line { border-left: 2rpx solid var(--line-soft); }  /* 1px */

/* ── 同行第 N 晚 ── */
.companion-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;                            /* 8px */
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .22em;
  color: var(--ink-soft);
  margin: -8rpx 0 31rpx;                 /* -4px 16px */
}
.companion-line .fl {
  width: 10rpx;                          /* 5px */
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 12rpx var(--gold-soft);  /* 6px */
}

/* ── 我的四行 ── */
.me-list { overflow: hidden; }
.me-row {
  display: flex;
  align-items: center;
  gap: 23rpx;                            /* 12px */
  padding: 27rpx 31rpx;                  /* 14px 16px */
  position: relative;
}
.me-row-active { background: var(--acc-soft); }
.mr-ic {
  width: 58rpx;                          /* 30px */
  display: flex;
  align-items: center;
  justify-content: center;
}
.mr-ic image { width: 37rpx; height: 37rpx; }  /* 19px */
.mr-label {
  flex: 1;
  font-family: var(--font-song);
  font-size: 28rpx;                      /* 14.5px */
  letter-spacing: .1em;
  color: var(--ink);
}
.mr-val {
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .14em;
  color: var(--ink-faint);
}
.mr-chev { display: flex; align-items: center; }
.mr-chev .chev { width: 23rpx; height: 23rpx; }  /* 12px */

/* ── 脚注（秉烛而谈 · 灯火长明） ── */
.me-foot {
  text-align: center;
  margin-top: 42rpx;                     /* 22px */
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .3em;
  color: var(--ink-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19rpx;                            /* 10px */
}
.me-foot::before, .me-foot::after {
  content: '';
  width: 38rpx;                          /* 20px */
  height: 2rpx;                          /* 1px */
  background: var(--line);
}

/* ── 开灯提醒行内开关 ── */
.mr-switch { display: flex; align-items: center; }
.mr-switch switch { transform: scale(.72); transform-origin: right center; }

/* ═══ 会员开通弹层（虚拟支付/首月·月度套餐，墨韵 paper 风格） ═══ */
.member-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20, 14, 8, .6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.member-dialog {
  width: 100%;
  max-width: 620rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 24rpx 64rpx rgba(30, 20, 10, .35);
  padding: 52rpx 44rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.md-seal { display: flex; align-items: center; justify-content: center; }
.md-seal-seal { width: 92rpx; height: 92rpx; font-size: 56rpx; transform: rotate(-3deg); }
.md-title {
  margin-top: 18rpx;
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 40rpx;
  letter-spacing: .22em;
  color: var(--ink);
}
.md-sub {
  margin-top: 10rpx;
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .16em;
  color: var(--ink-soft);
}
/* 会员权益列表 */
.md-benefits {
  width: 100%;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--paper-deep);
  border: 2rpx solid var(--line-soft);
  border-radius: 12rpx;
  padding: 26rpx 28rpx;
}
.md-b-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .1em;
  color: var(--ink-mid);
}
.md-b-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--acc);
  flex-shrink: 0;
}
.md-plan {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--paper-deep);
  border: 2rpx solid var(--line-soft);
  border-radius: 12rpx;
  padding: 24rpx 26rpx;
}
.md-plan-active { background: var(--gold-soft); }
.mp-ic { display: flex; align-items: center; justify-content: center; }
.mp-seal { width: 62rpx; height: 62rpx; font-size: 36rpx; transform: rotate(-2deg); }
.mp-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.mp-name {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: .08em;
  color: var(--ink);
}
.mp-desc {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .06em;
  color: var(--ink-faint);
}
.mp-price {
  font-family: var(--font-lat);
  font-weight: 700;
  font-size: 30rpx;
  color: var(--acc-deep);
}
.md-close {
  margin-top: 34rpx;
  padding: 10rpx 40rpx;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .2em;
  color: var(--ink-faint);
}

/* ── 头像昵称采集（Task 2：名片区引导小字 + chooseAvatar 弹层） ── */
.hs-profile-edit {
  align-self: flex-start;
  font-family: var(--font-song);
  font-size: 19rpx;                      /* 10px */
  letter-spacing: .14em;
  color: var(--acc-deep);
  border-bottom: 2rpx dotted var(--acc-soft);
  padding-bottom: 2rpx;
}
.hs-profile-edit-active { color: var(--acc); border-bottom-color: var(--acc); }

/* 弹层（同 member-mask/member-dialog 同族：宣纸底 + 墨线 + 朱砂点缀） */
.pp-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20, 14, 8, .6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.pp-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 24rpx 64rpx rgba(30, 20, 10, .35);
  padding: 52rpx 44rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pp-avatar-btn {
  margin-top: 31rpx;                     /* 16px */
  padding: 0;
  width: 179rpx;                         /* 93px */
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.pp-avatar-btn::after { border: none; }
.pp-avatar {
  width: 179rpx;                         /* 93px */
  height: 179rpx;
  border-radius: 50%;
  border: 3rpx solid var(--acc-soft);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .22), 0 4rpx 10rpx rgba(30, 20, 10, .18);
  transform: rotate(-2deg);
}
.pp-avatar-seal { width: 179rpx; height: 179rpx; font-size: 108rpx; transform: rotate(-2deg); }
.pp-avatar-tip {
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .12em;
  color: var(--ink-soft);
}
.pp-input {
  margin-top: 27rpx;                     /* 14px */
  width: 100%;
  height: 89rpx;                         /* 46px */
  padding: 0 27rpx;                      /* 14px */
  text-align: center;
  background: var(--paper-deep);
  border: 2rpx solid var(--line-input);
  border-radius: 8rpx;
  font-family: var(--font-song);
  font-size: 29rpx;                      /* 15px */
  letter-spacing: .14em;
  color: var(--ink);
}
.pp-ph { color: var(--ink-faint); letter-spacing: .1em; font-size: 25rpx; }
.pp-input:focus { border-color: var(--acc); box-shadow: 0 0 0 6rpx var(--acc-soft); }
.pp-actions {
  margin-top: 35rpx;                     /* 18px */
  width: 100%;
  display: flex;
  gap: 19rpx;                            /* 10px */
}
.pp-btn-ghost, .pp-btn-ink {
  flex: 1;
  height: 85rpx;                         /* 44px */
  border-radius: 8rpx;
  font-family: var(--font-song);
  font-size: 27rpx;                      /* 14px */
  letter-spacing: .22em;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .12s, opacity .12s;
}
.pp-btn-ghost { background: transparent; border: 2rpx solid var(--line); color: var(--ink-mid); }
.pp-btn-ink { background: var(--ink); color: #F5EFE1; box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.2); }
.pp-btn-active { opacity: .85; transform: scale(.97); }
