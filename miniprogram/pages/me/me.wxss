/* 我的 — 个人中心样式 */

.page-me {
  min-height: 100vh;
  padding-bottom: var(--space-2xl);
  background: var(--color-bg);
}

/* ========================================
   用户头部 — 居中布局 + 渐变背景
   ======================================== */
.profile-header {
  padding: var(--space-2xl) var(--space-lg) var(--space-lg);
  background: var(--gradient-card);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 2px solid var(--gold);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card-alt);
  margin-bottom: var(--space-md);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 32px;
}

.profile-info {
  text-align: center;
  margin-bottom: var(--space-sm);
}

.profile-name {
  font-size: var(--font-lg);
  font-weight: 700;
  display: block;
  color: var(--color-text-card);
}

.profile-badge {
  font-size: var(--font-xs);
  padding: 2px 10px;
  border-radius: var(--radius-full);
  background: var(--gold-glow);
  color: var(--stone);
  display: inline-block;
  margin-top: var(--space-xs);
}

.login-badge {
  background: var(--gold);
  color: var(--ink);
  font-weight: 600;
}

.profile-edit {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========================================
   数据统计行
   ======================================== */
.stats-row {
  display: flex;
  gap: var(--space-md);
  margin: var(--space-md);
}

.stat-card {
  flex: 1;
  text-align: center;
  padding: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.stat-value {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--gold-light);
  display: block;
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--stone);
  margin-top: var(--space-xs);
  display: block;
}

/* ========================================
   区块
   ======================================== */
.section {
  margin-top: var(--space-md);
  padding: 0 var(--space-md);
  animation: fadeSlideUp 0.35s ease-out both;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;
}

.section-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text);
}

.section-action {
  padding: 4px 14px;
  border-radius: var(--radius-full);
  background: var(--gold-glow);
  color: var(--gold);
  font-size: var(--font-sm);
  font-weight: 500;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========================================
   八字卡片
   ======================================== */
.bazi-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-md) var(--space-lg);
  box-shadow: var(--shadow-sm);
  animation: fadeSlideUp 0.35s ease-out both;
}

.bazi-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--color-divider);
}

.bazi-row:last-child {
  border-bottom: none;
}

.bazi-label {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.bazi-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
}

.bazi-empty {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  text-align: center;
  border: 2px dashed var(--color-border);
}

.bazi-empty-text {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

/* ========================================
   设置分组 — 卡片式分组
   ======================================== */
.settings-group {
  margin: 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  animation: fadeSlideUp 0.35s ease-out both;
}

.settings-group-title {
  padding: var(--space-md) var(--space-md) var(--space-sm);
  font-size: var(--font-xs);
  color: var(--stone);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  display: block;
}

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md);
  border-bottom: 1px solid var(--color-divider);
  min-height: 48px;
}

.settings-item:last-child {
  border-bottom: none;
}

/* ========================================
   旧版设置卡片兼容
   ======================================== */
.settings-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  animation: fadeSlideUp 0.35s ease-out both;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1px solid var(--color-divider);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.setting-icon {
  font-size: 18px;
  width: 24px;
  text-align: center;
}

.setting-icon.danger {
  color: var(--danger);
}

.setting-label {
  font-size: var(--font-md);
  color: var(--color-text);
}

.danger-label {
  color: var(--danger);
}

.setting-value {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.setting-arrow {
  font-size: 20px;
  color: var(--color-text-tertiary);
  font-weight: 300;
  padding: 10px;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setting-switch {
  transform: scale(0.8);
}

/* 反馈输入 */
.feedback-item {
  flex-direction: column;
  align-items: stretch;
  gap: var(--space-sm);
}

.feedback-input-area {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.feedback-input {
  flex: 1;
  padding: var(--space-sm) 0;
  font-size: var(--font-md);
  color: var(--color-text);
  background: transparent;
  border: none;
}

/* ========================================
   弹窗 — 暗色道家主题
   ======================================== */
.bazi-overlay,
.disclaimer-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.bazi-overlay.show,
.disclaimer-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.bazi-sheet,
.disclaimer-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 弹窗头部 */
.bazi-editor-header,
.disclaimer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 1px solid var(--color-divider);
}

.bazi-editor-title,
.disclaimer-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.bazi-editor-close,
.disclaimer-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-bg-card-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* 弹窗体 */
.bazi-editor-body,
.disclaimer-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-lg);
  max-height: 55vh;
}

.disclaimer-text {
  font-size: var(--font-md);
  color: var(--color-text);
  line-height: 2;
  white-space: pre-wrap;
  display: block;
}

/* 表单组 */
.form-group {
  margin-bottom: var(--space-lg);
}

.form-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--space-sm);
}

.form-picker {
  padding: 12px 16px;
  background: var(--color-bg-card-alt);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  font-size: var(--font-md);
  color: var(--color-text);
}

.form-radio-group {
  display: flex;
  gap: var(--space-lg);
}

.form-radio {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 20px;
  border-radius: var(--radius-md);
  background: var(--color-bg-card-alt);
  border: 1px solid var(--color-border);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.form-radio.active {
  border-color: var(--gold);
  color: var(--gold);
  background: var(--gold-glow);
}

/* 弹窗底部 */
.bazi-editor-footer {
  padding: var(--space-md) var(--space-lg);
  border-top: 1px solid var(--color-divider);
  display: flex;
  justify-content: center;
}

/* ========================================
   AI 了解你 — 偏好画像卡片
   ======================================== */
.pref-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-md) var(--space-lg);
  box-shadow: var(--shadow-sm);
  animation: fadeSlideUp 0.35s ease-out both;
}

.pref-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--color-divider);
}

.pref-row:last-child {
  border-bottom: none;
}

.pref-label {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.pref-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--gold);
}

.pref-note {
  font-size: var(--font-xs);
  color: var(--stone);
  margin-top: var(--space-sm);
  text-align: center;
}
