/* ═══ 我的收藏 — 收藏星笺（墨韵：宣纸卡片列表 + 朱砂小标） ═══ */

.fav-scroll {
  position: absolute;
  top: calc(183rpx + var(--nav-off));   /* 95px */
  left: 0; right: 0;
  bottom: 0;
  z-index: 25;
  padding: 19rpx 38rpx 46rpx;           /* 10px 20px 24px */
  overflow-x: hidden;
}

/* ── 空态 ── */
.fav-empty {
  padding: 150rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fe-seal {
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--acc-soft);
  border: 3rpx solid var(--acc);
  border-radius: 12rpx;
  transform: rotate(-3deg);
}
.fe-star {
  font-size: 60rpx;
  color: var(--acc);
}
.fe-line1 {
  margin-top: 30rpx;
  font-family: var(--font-song);
  font-size: 28rpx;
  letter-spacing: .26em;
  color: var(--ink-soft);
}
.fe-line2 {
  margin-top: 12rpx;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .12em;
  color: var(--ink-faint);
}

/* ── 收藏卡片（宣纸笺，左朱砂细条，与对话明灯笺呼应） ── */
.fav-list { display: flex; flex-direction: column; gap: 24rpx; }
.fav-card {
  position: relative;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
  padding: 25rpx 29rpx 21rpx;
  box-shadow: 0 4rpx 15rpx var(--shadow-sm);
}
.fav-card::before {
  content: '';
  position: absolute;
  left: 0; top: 27rpx; bottom: 27rpx;
  width: 4rpx;
  background: var(--acc-soft);
  border-radius: 2rpx;
}
.fav-card-active { border-color: var(--acc-line); background: var(--acc-soft); }
.fc-tag {
  display: inline-flex;
  margin-bottom: 15rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .16em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line-soft);
  border-radius: 4rpx;
  padding: 4rpx 13rpx;
  background: var(--tag-bg);
}
.fc-body {
  font-family: var(--poem);
  font-size: 29rpx;
  line-height: 1.9;
  letter-spacing: .03em;
  color: var(--ink-mid);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}
.fc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.fc-time {
  font-family: var(--font-lat);
  font-style: italic;
  font-size: 19rpx;
  letter-spacing: .06em;
  color: var(--ink-faint);
}
.fc-hint {
  font-family: var(--font-song);
  font-size: 18rpx;
  letter-spacing: .08em;
  color: var(--acc);
}
.fav-note {
  text-align: center;
  margin-top: 44rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .24em;
  color: var(--ink-faint);
}

/* ── 分类 tab（笺匣：全部 / 笺 / 对话 · 印章式小签） ── */
.fav-tabs {
  display: flex;
  gap: 14rpx;                          /* 7px */
  margin-bottom: 25rpx;                /* 13px */
}
.fav-tab {
  padding: 9rpx 30rpx;                 /* 4.7px 15.6px */
  border: 2rpx solid var(--line);
  border-radius: 6rpx;
  background: var(--paper-card);
  font-family: var(--font-song);
  font-size: 22rpx;                    /* 11.5px */
  letter-spacing: .24em;
  color: var(--ink-soft);
  transition: all .12s;
}
.fav-tab-on {                          /* 选中：墨底纸字，如落印 */
  background: var(--ink);
  border-color: var(--ink);
  color: #F5EFE1;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, .2);
}
.fav-tab-active { opacity: .85; }

/* ── 笺卡片（晨笺收藏 · 视觉同今日页晨笺卡：晨印 + 干支 + 宜忌 + 金句 + 轻私语 + 小问） ── */
.fav-jian { padding-top: 21rpx; }
.fj-head {
  display: flex;
  align-items: center;
  gap: 15rpx;                          /* 8px */
}
.fj-seal {
  width: 46rpx;                        /* 24px */
  height: 46rpx;
  font-size: 27rpx;                    /* 14px */
  border-radius: 6rpx;
  transform: rotate(-3deg);
}
.fj-title {
  font-family: var(--font-song);
  font-weight: 700;
  font-size: 27rpx;                    /* 14px */
  letter-spacing: .1em;
  color: var(--ink);
}
.fj-yiji {
  margin-top: 18rpx;                   /* 9px */
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.fj-yiji-row { display: flex; align-items: flex-start; gap: 13rpx; }
.fj-yiji-label {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 19rpx;                    /* 10px */
  letter-spacing: .14em;
  color: var(--acc);
  border: 2rpx solid var(--acc-line);
  border-radius: 4rpx;
  padding: 3rpx 11rpx;
  transform: translateY(1rpx);
}
.fj-yiji-label-ji {
  color: var(--ink-soft);
  border-color: var(--line);
}
.fj-chips { display: flex; flex-wrap: wrap; gap: 9rpx; padding-top: 1rpx; }
.fj-chip { font-size: 19rpx; padding: 4rpx 14rpx; }
.fj-chip-ji { border-color: var(--acc-line); }
.fj-chip-empty {
  font-family: var(--font-song);
  font-size: 19rpx;                    /* 10px */
  padding: 4rpx 14rpx;
  color: var(--ink-faint);
  border: 2rpx dashed var(--line);
  border-radius: 4rpx;
}
.fj-quote {
  margin-top: 17rpx;                   /* 9px */
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  font-family: var(--poem);
  font-size: 27rpx;                    /* 14px */
  line-height: 1.75;
  letter-spacing: .03em;
  color: var(--ink-mid);
}
.fj-quote-text { color: var(--ink); }
.fj-quote-book {
  font-family: var(--font-song);
  font-size: 19rpx;                    /* 10px */
  letter-spacing: .08em;
  color: var(--ink-soft);
}
.fj-private {
  margin-top: 17rpx;                   /* 9px */
  font-family: var(--font-song);
  font-size: 21rpx;                    /* 11px */
  line-height: 1.7;
  letter-spacing: .04em;
  color: var(--ink-soft);
  display: flex;
  flex-direction: column;
}
.fj-private-label {
  color: var(--acc);
  font-size: 18rpx;                    /* 9.5px */
  letter-spacing: .18em;
  margin-bottom: 3rpx;
}
.fj-question {
  margin-top: 17rpx;                   /* 9px */
  display: flex;
  align-items: center;
  gap: 11rpx;                          /* 6px */
  background: var(--acc-soft);
  border: 2rpx solid var(--acc-line);
  border-radius: 6rpx;
  padding: 11rpx 15rpx;                /* 6px 8px */
}
.fj-question-label {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 18rpx;                    /* 9.5px */
  letter-spacing: .16em;
  color: var(--acc);
}
.fj-question text:last-child {
  font-family: var(--font-song);
  font-size: 20rpx;                    /* 10.5px */
  letter-spacing: .04em;
  color: var(--ink-mid);
}
