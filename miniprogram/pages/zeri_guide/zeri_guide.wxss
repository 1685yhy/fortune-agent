/* 择吉日 · 表单式三步入口 — 宣纸底 · 墨字 · 朱砂印章 · 金线分隔（dir_b 同族） */
.page-guide {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 60rpx;
}

/* ========================================
   头部
   ======================================== */
.gd-header {
  padding: 70rpx var(--space-lg) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.gd-header-seal {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: var(--acc);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
  transform: rotate(-3deg);
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}

.gd-header-seal-char {
  color: #FBF6E8;
  font-family: var(--font-brush);
  font-size: 56rpx;
  line-height: 1;
}

.gd-header-title {
  font-family: var(--font-brush);
  font-size: 44rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-sm);
}

.gd-header-sub {
  font-size: var(--text-xs);
  color: var(--ink-soft);
  letter-spacing: 0.08em;
  line-height: 1.6;
}

/* ========================================
   三步卡片（事 · 时 · 命）
   ======================================== */
.gd-step {
  margin: 0 var(--space-lg) var(--space-md);
  background: var(--paper-card);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
}

.gd-step-head {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.gd-step-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: var(--acc);
  color: #FBF6E8;
  font-family: var(--font-kai);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}

.gd-step-titles {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
  min-width: 0;
}

.gd-step-title {
  font-family: var(--font-kai);
  font-size: var(--text-base);
  color: var(--ink);
  letter-spacing: 0.1em;
}

.gd-step-sub {
  font-size: 18rpx;
  color: var(--ink-faint);
  letter-spacing: 0.1em;
}

/* ========================================
   第 1 步 · 场景网格
   ======================================== */
.gd-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
}

.gd-scene {
  position: relative;
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-xs);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.gd-scene-active { background: var(--acc-soft); }

.gd-scene-on {
  border-color: var(--acc);
  background: var(--acc-soft);
}

.gd-scene-seal {
  width: 64rpx;
  height: 64rpx;
  font-size: 34rpx;
  border-radius: 8rpx;
}

.gd-scene-seal-on {
  background: var(--acc);
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}

.gd-scene-seal-on .seal-char { color: #FBF6E8; }

.gd-scene-name {
  font-family: var(--font-kai);
  font-size: var(--text-base);
  color: var(--ink);
  letter-spacing: 0.14em;
}

.gd-scene-sub {
  font-size: 18rpx;
  color: var(--ink-faint);
  letter-spacing: 0.04em;
  text-align: center;
  line-height: 1.5;
}

.gd-scene-check {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--acc);
  color: #FBF6E8;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========================================
   第 2 步 · 时间段 chips
   ======================================== */
.gd-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.gd-chip {
  flex: 1;
  min-width: 140rpx;
  height: 64rpx;
  border: 1rpx solid var(--acc-line);
  border-radius: var(--radius-pill);
  background: var(--paper);
  color: var(--ink-mid);
  font-family: var(--font-song);
  font-size: var(--text-sm);
  letter-spacing: 0.1em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gd-chip-active { opacity: .85; transform: scale(.97); }

.gd-chip-on {
  background: var(--acc);
  border-color: var(--acc);
  color: #FBF6E8;
  box-shadow: 0 4rpx 12rpx var(--shadow);
}

/* ========================================
   第 3 步 · 八字选填
   ======================================== */
.gd-input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0 var(--space-md);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-sm);
  font-family: var(--font-song);
  font-size: var(--text-sm);
  color: var(--ink);
}

.gd-input-ph {
  font-size: var(--text-xs);
  color: var(--ink-faint);
  letter-spacing: 0.04em;
}

.gd-hint {
  display: block;
  margin-top: var(--space-sm);
  font-size: 18rpx;
  color: var(--ink-faint);
  letter-spacing: 0.06em;
  line-height: 1.6;
}

/* ========================================
   行动
   ======================================== */
.gd-actions {
  margin-top: var(--space-lg);
  padding: 0 var(--space-lg);
}

.gd-btn {
  height: 84rpx;
  border-radius: var(--radius-sm);
  font-family: var(--font-song);
  font-size: var(--text-base);
  letter-spacing: 0.2em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gd-btn-primary {
  background: var(--acc);
  color: #FBF6E8;
  box-shadow: 0 4rpx 12rpx var(--shadow);
}

.gd-btn-active { opacity: .85; transform: scale(.98); }

.gd-foot {
  margin-top: var(--space-xl);
  font-size: 18rpx;
  color: var(--ink-faint);
  text-align: center;
  letter-spacing: 0.1em;
}
