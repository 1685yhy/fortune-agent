/* 姓名学 — 五格数理 | v6 靛蓝夜空 + 磨砂玻璃 + 暖金 */

/* ---- 动画 ---- */
.content-enter { animation: fadeUp 0.3s ease-out both; }
.animate-fade-up { animation: fadeUp 0.4s ease-out both; }

.page-xingming {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: var(--bg-night);
}

/* ========================================
   Page Header
   ======================================== */
.page-header {
  padding: 80rpx var(--space-lg) var(--space-lg);
  text-align: center;
}

.page-title {
  font-family: var(--font-brush);
  font-size: var(--text-xl);
  font-weight: 400;
  color: var(--gold-light);
  display: block;
  margin-bottom: var(--space-sm);
  letter-spacing: 0.06em;
}

.page-desc {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  display: block;
  line-height: 1.6;
}

/* ========================================
   Form Card — 磨砂玻璃
   ======================================== */
.form-card {
  margin: 0 var(--space-lg);
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
}

.form-group {
  margin-bottom: var(--space-lg);
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  display: block;
  margin-bottom: var(--space-sm);
}

.form-input {
  width: 100%;
  padding: var(--space-md);
  background: var(--bg-input);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: var(--text-base);
  color: var(--ink-primary);
  line-height: 1.4;
}

.form-input-placeholder {
  color: var(--ink-muted);
  font-size: var(--text-base);
}

/* ========================================
   性别 — 男/女 大按钮（与 paipan 同款，金色选中态适配暖金主题）
   ======================================== */
.gender-group {
  display: flex;
  gap: var(--space-lg);
}

.gender-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) 0;
  border-radius: var(--radius-md);
  background: var(--bg-input);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.gender-char {
  font-family: var(--font-song);
  font-size: var(--text-base);
  letter-spacing: 0.3em;
  color: var(--ink-primary);
  text-indent: 0.3em;
}

.gender-btn-tap { transform: translateY(2rpx); }

.gender-btn.is-on {
  background: var(--gold);
  border-color: var(--gold);
  box-shadow: 0 6rpx 18rpx rgba(176, 138, 79, 0.28);
}

.gender-btn.is-on .gender-char { color: #FBF6E8; font-weight: 600; }

/* ========================================
   Submit Button
   ======================================== */
.submit-wrap {
  padding: var(--space-lg) var(--space-lg);
}

.btn-submit {
  width: 100%;
  padding: var(--space-sm) var(--space-xl);
  letter-spacing: 0.08em;
}

.btn-submit[disabled] {
  opacity: 0.5;
}

/* ========================================
   Loading
   ======================================== */
.loading-container {
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.08);
  border-top-color: var(--gold);
  animation: spin 0.8s linear infinite;
  margin-bottom: var(--space-lg);
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
}

/* ========================================
   Results Section
   ======================================== */
.result-section {
  padding: 0 var(--space-lg);
}

.result-header {
  text-align: center;
  padding: var(--space-lg) 0;
}

.result-name {
  font-size: var(--text-xl);
  font-weight: 500;
  color: var(--gold-light);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 0.08em;
}

.result-gender {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  display: block;
}

/* ========================================
   Section Header
   ======================================== */
.section-header {
  padding: var(--space-sm) var(--space-sm) var(--space-xs);
}

.section-title {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--ink-muted);
  letter-spacing: 0.06em;
}

/* ========================================
   Five Cells Table
   ======================================== */
.five-cells {
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.cell-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.cell-row:last-child {
  border-bottom: none;
}

.cell-label {
  width: 120rpx;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--ink-primary);
  flex-shrink: 0;
}

.cell-strokes {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  text-align: center;
}

.cell-wuxing {
  width: 80rpx;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--gold-light);
  text-align: center;
  flex-shrink: 0;
}

.cell-luck {
  width: 80rpx;
  font-size: var(--text-sm);
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
}

.luck-good {
  color: var(--success);
  background: rgba(125, 184, 154, 0.15);
}

.luck-bad {
  color: var(--error);
  background: rgba(196, 96, 74, 0.15);
}

/* ========================================
   Sancai Card
   ======================================== */
.sancai-card {
  margin-top: var(--space-md);
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  border-left: 3rpx solid var(--gold);
}

.sancai-header {
  margin-bottom: var(--space-sm);
}

.sancai-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.04em;
}

.sancai-text {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  line-height: 1.8;
  display: block;
}

/* ========================================
   Judgment Card
   ======================================== */
.judgment-card {
  margin-top: var(--space-md);
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
}

.judgment-header {
  margin-bottom: var(--space-sm);
}

.judgment-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.04em;
}

.judgment-text {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  line-height: 1.8;
  display: block;
}

/* ═══ 互打入口: 去 AI 取名(原型 S4 与姓名学页互打) ═══ */
.ming-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6rpx 0 22rpx;
  padding: 18rpx 26rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
}
.ming-entry-active { background: var(--acc-soft); }
.ming-entry-t { font-size: var(--text-xs); color: var(--ink-muted); }
.ming-entry-btn {
  font-size: var(--text-xs);
  color: var(--acc);
  font-weight: 600;
  letter-spacing: 0.03em;
}
