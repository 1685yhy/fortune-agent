<!-- 万年历 · 月历宫格 + 日详情（问真吉真万年历同款，墨韵纸笺） -->
<view class="screen wn-page" style="--nav-off:{{navOff}}px">

  <!-- ===== 顶栏 ===== -->
  <view class="navrow">
    <view class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goToday">
      <image class="back-icon" src="/assets/images/ic-back.png"></image>
    </view>
    <view class="nav-title"><text>万年历</text></view>
    <view class="nav-right"></view>
  </view>

  <scroll-view scroll-y class="wn-scroll">
    <view class="wn-inner">

      <!-- 月切换条 -->
      <view class="wn-mbar">
        <view class="wn-nav-btn" hover-class="wn-btn-active" hover-stay-time="0" bindtap="onPrevMonth">
          <text>‹</text>
        </view>
        <view class="wn-mid">
          <text class="wn-month">{{monthText}}</text>
          <view class="wn-jinri" wx:if="{{todayMonth}}" hover-class="wn-btn-active" hover-stay-time="0" bindtap="onJumpToday">今</view>
        </view>
        <view class="wn-nav-btn" hover-class="wn-btn-active" hover-stay-time="0" bindtap="onNextMonth">
          <text>›</text>
        </view>
      </view>

      <!-- 星期表头（首列周日，与后端 first_weekday 0=周日 对齐） -->
      <view class="wn-week">
        <view class="wn-week-cell {{index === 0 || index === 6 ? 'wn-week-rest' : ''}}"
          wx:for="{{weekHead}}" wx:key="*this">{{item}}</view>
      </view>

      <!-- 宫格：swiper 三页预渲染（0=上月 1=当月 2=下月），滑动切月（B5-2 L） -->
      <swiper class="wn-swiper" wx:if="{{!loading}}" current="{{swiperCurrent}}"
        duration="280" bindchange="onSwiperChange">
        <swiper-item wx:for="{{months}}" wx:key="key">
          <block wx:if="{{item}}">
            <view class="wn-grid">
              <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="date"
                class="wn-cell {{cell.blank ? 'wn-cell-blank' : ''}} {{cell.isToday ? 'wn-cell-today' : ''}} {{cell.isSelected ? 'wn-cell-sel' : ''}}"
                hover-class="{{cell.blank ? '' : 'wn-cell-active'}}" hover-stay-time="0"
                data-date="{{cell.date}}" data-blank="{{cell.blank}}" bindtap="onTapDay">
                <block wx:if="{{!cell.blank}}">
                  <!-- 干支 + 黄黑道 -->
                  <view class="wn-top">
                    <text class="wn-ganzhi">{{cell.ganzhi}}</text>
                    <text class="wn-hd {{cell.huanghedao === '黄道' ? 'wn-hd-huang' : 'wn-hd-hei'}}">{{cell.huanghedao}}</text>
                  </view>
                  <!-- 公历日 -->
                  <text class="wn-num {{cell.isToday ? 'wn-num-today' : ''}}">{{cell.day}}</text>
                  <!-- 农历小字：节气朱砂（取代农历日，传统黄历口径） -->
                  <text class="wn-lunar {{cell.isJieqi ? 'wn-lunar-jieqi' : ''}} {{cell.isFestival ? 'wn-lunar-fest' : ''}}"
                    wx:if="{{!cell.isFestival || cell.isJieqi}}">{{cell.cellLunar}}</text>
                  <text class="wn-lunar wn-lunar-fest" wx:if="{{cell.isFestival && !cell.isJieqi}}">{{cell.festival}}</text>
                  <!-- 宜忌点 + 值日名（k27c: 建除不再带吉凶标签/吉凶配色） -->
                  <view class="wn-bot">
                    <text class="wn-dot wn-dot-yi" wx:if="{{cell.yiDot}}">宜{{cell.yiDot}}</text>
                    <text class="wn-dot wn-dot-ji" wx:if="{{cell.jiDot}}">忌{{cell.jiDot}}</text>
                  </view>
                  <view class="wn-foot">
                    <text class="wn-jc">{{cell.jianchu}}</text>
                  </view>
                </block>
              </view>
            </view>
            <!-- 单页加载骨架（远端页预取） -->
            <view class="wn-loading" wx:if="{{item.loading}}">
              <view class="inkdot"></view><view class="inkdot"></view><view class="inkdot"></view>
            </view>
          </block>
        </swiper-item>
      </swiper>

      <!-- 初始加载骨架 -->
      <view class="wn-loading" wx:if="{{loading}}">
        <view class="inkdot"></view><view class="inkdot"></view><view class="inkdot"></view>
      </view>

      <!-- 宜忌摘要行（B5-2 L）：选中日 宜/忌 前几项；未选中日显示今日（今日页朱砂胶囊/淡墨虚线风格） -->
      <view class="wn-summary" wx:if="{{summary}}">
        <view class="wn-summary-head">
          <text class="wn-summary-title">{{summary.title}}</text>
          <text class="wn-summary-date">{{summary.date}}</text>
        </view>
        <view class="ws-yiji" wx:if="{{summary.yi.length}}">
          <text class="ws-yiji-label">宜</text>
          <view class="ws-chips">
            <view class="ws-chip wn-sum-chip wn-sum-chip-yi" wx:for="{{summary.yi}}" wx:key="*this">{{item}}</view>
          </view>
        </view>
        <view class="ws-yiji" wx:if="{{summary.ji.length}}">
          <text class="ws-yiji-label ws-yiji-label-ji">忌</text>
          <view class="ws-chips">
            <view class="ws-chip wn-sum-chip wn-sum-chip-ji" wx:for="{{summary.ji}}" wx:key="*this">{{item}}</view>
          </view>
        </view>
      </view>

      <view class="wn-note">
        <view class="fg"></view>
        <text>黄历宜忌 · 以建除与黄黑道为本</text>
        <view class="fg"></view>
      </view>
    </view>
  </scroll-view>

  <!-- ===== 日详情（底部笺页） ===== -->
  <view class="wn-mask" wx:if="{{detailVisible || detailLoading}}" catchtouchmove="noop" bindtap="onCloseDetail">
    <view class="wn-sheet" catchtap="noop">
      <!-- 加载态 -->
      <view class="wn-sheet-loading" wx:if="{{detailLoading}}">
        <view class="inkdot"></view><view class="inkdot"></view><view class="inkdot"></view>
      </view>

      <block wx:elif="{{detail}}">
        <!-- 头：干支 + 农历 + 星期/节日 -->
        <view class="ws-head">
          <view class="seal ws-seal"><text class="seal-char">历</text></view>
          <view class="ws-titles">
            <view class="ws-title-row">
              <text class="ws-title">{{detail.ganzhi.day}}日</text>
              <text class="ws-lunar">{{detail.lunar.month}}{{detail.lunar.day}}</text>
              <text class="ws-fest" wx:if="{{detail.festivals.length}}">{{detail.festivals[0]}}</text>
            </view>
            <view class="ws-sub">{{detail.date}} · 星期{{detail.weekday}} · {{detail.lunar.year}}</view>
          </view>
          <view class="ws-close" hover-class="ws-close-active" hover-stay-time="0" bindtap="onCloseDetail">收</view>
        </view>

        <!-- 干支纳音 -->
        <view class="ws-sec ws-sec-line">
          <view class="ws-sec-label">干支</view>
          <view class="ws-ganzhi">
            <text class="ws-gz">{{detail.ganzhi.year}}年</text>
            <text class="ws-gz">{{detail.ganzhi.month}}月</text>
            <text class="ws-gz ws-gz-hl">{{detail.ganzhi.day}}日</text>
            <text class="ws-nayin">{{detail.nayin.day}}</text>
          </view>
        </view>

        <!-- 值日：黄黑道 · 建除 · 廿八宿（k27c: 只给值日名 + 值宿名, 不展示吉/凶判定
             —— 建除「（吉/平/凶）」与廿八宿「（吉/凶）」括号标签一并下线;
             吉凶总评只在择吉/聊天给, 三面同源） -->
        <view class="ws-sec ws-sec-line">
          <view class="ws-sec-label">值日</view>
          <view class="ws-zhirow">
            <text class="ws-zhi ws-zhi-huang {{detail.huanghedao.type === '黄道' ? '' : 'ws-zhi-hei'}}">{{detail.huanghedao.type}} · {{detail.huanghedao.tianshen}}</text>
            <text class="ws-zhi">建除{{detail.jianchu.name}}</text>
            <text class="ws-zhi">廿八宿 · {{detail.ershibaxiu.name}}</text>
          </view>
        </view>

        <!-- 宜 / 忌（k27: 空列表整行不渲染 —— 空忌日如 2026-02-10（权威忌=无,
             建除表忌全被黄历宜覆盖）不得出现悬空「忌」标签; 与月历摘要行
             「宜忌摘要行」同一守卫写法, 不新造文案） -->
        <view class="ws-sec">
          <view class="ws-yiji" wx:if="{{detail.yi.length}}">
            <text class="ws-yiji-label">宜</text>
            <view class="ws-chips">
              <view class="ws-chip ws-chip-yi" wx:for="{{detail.yi}}" wx:key="*this">{{item}}</view>
            </view>
          </view>
          <view class="ws-yiji" wx:if="{{detail.ji.length}}">
            <text class="ws-yiji-label ws-yiji-label-ji">忌</text>
            <view class="ws-chips">
              <view class="ws-chip ws-chip-ji" wx:for="{{detail.ji}}" wx:key="*this">{{item}}</view>
            </view>
          </view>
        </view>

        <!-- 吉神宜趋 / 凶煞宜忌 -->
        <view class="ws-sec ws-sec-line" wx:if="{{detail.jishen.length || detail.xiongsha.length}}">
          <view class="ws-sha" wx:if="{{detail.jishen.length}}">
            <text class="ws-sha-label ws-sha-label-ji">吉神宜趋</text>
            <view class="ws-chips">
              <view class="ws-chip ws-chip-yi" wx:for="{{detail.jishen}}" wx:key="*this">{{item}}</view>
            </view>
          </view>
          <view class="ws-sha" wx:if="{{detail.xiongsha.length}}">
            <text class="ws-sha-label">凶煞宜忌</text>
            <view class="ws-chips">
              <view class="ws-chip ws-chip-ji" wx:for="{{detail.xiongsha}}" wx:key="*this">{{item}}</view>
            </view>
          </view>
        </view>

        <!-- 冲煞 · 旬空 -->
        <view class="ws-sec ws-sec-line">
          <view class="ws-sec-label">冲煞</view>
          <view class="ws-zhirow">
            <text class="ws-zhi">冲{{detail.chong.zodiac}}（{{detail.chong.ganzhi}}）</text>
            <text class="ws-zhi">煞{{detail.chong.sha}}</text>
            <text class="ws-zhi" wx:if="{{detail.xunkongText}}">旬空 {{detail.xunkongText}}</text>
          </view>
        </view>

        <!-- 方位 -->
        <view class="ws-sec">
          <view class="ws-sec-label">方位</view>
          <view class="ws-zhirow">
            <text class="ws-zhi">财神{{detail.positions.cai}}</text>
            <text class="ws-zhi">喜神{{detail.positions.xi}}</text>
            <text class="ws-zhi">福神{{detail.positions.fu}}</text>
            <text class="ws-zhi">阳贵{{detail.positions.yang_gui}}</text>
            <text class="ws-zhi">阴贵{{detail.positions.yin_gui}}</text>
          </view>
        </view>

        <!-- 吉时（B5-2 L）：13 时辰（早/晚子时分列），吉朱砂 / 凶淡墨 -->
        <view class="ws-sec ws-sec-line">
          <view class="ws-sec-label">吉时</view>
          <view class="ws-jishi">
            <view class="ws-jishi-cell {{item.luck === '吉' ? 'ws-jishi-ji' : 'ws-jishi-xiong'}}"
              wx:for="{{detail.jishi}}" wx:key="time">
              <view class="ws-jishi-top">
                <text class="ws-jishi-time">{{item.time}}</text>
                <text class="ws-jishi-luck">{{item.luck}}</text>
              </view>
              <text class="ws-jishi-range">{{item.range}}</text>
              <text class="ws-jishi-ganzhi">{{item.ganzhi}} · {{item.tianshen}}</text>
            </view>
          </view>
        </view>

        <!-- 彭祖百忌 + 胎神（B5-2 L） -->
        <view class="ws-sec ws-sec-line">
          <view class="ws-sec-label">彭祖百忌</view>
          <view class="ws-pengzu">
            <text class="ws-zhi">日干忌 · {{detail.pengzu.gan}}</text>
            <text class="ws-zhi">日支忌 · {{detail.pengzu.zhi}}</text>
          </view>
        </view>

        <view class="ws-sec">
          <view class="ws-sec-label">胎神</view>
          <view class="ws-zhirow">
            <text class="ws-zhi">胎神占方 · {{detail.taishen.desc}}</text>
          </view>
        </view>

        <!-- 复制导出（B5-2 L） -->
        <view class="ws-copy" hover-class="ws-copy-active" hover-stay-time="0" bindtap="onCopyDetail">
          <text class="ws-copy-char">印</text>
          <text>复制文本 · 导出今日黄历</text>
        </view>

        <view class="ws-foot">明灯谨录 · 宜忌随历</view>
      </block>
    </view>
  </view>
</view>
