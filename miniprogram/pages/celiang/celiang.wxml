<view class="screen suance-wrap" style="--nav-off:{{navOff}}px">
  <view class="navrow">
    <view class="nav-title">
      <text>测算</text>
    </view>
  </view>

  <scroll-view scroll-y class="suance-scroll">
    <view class="suance-date">
      <text>问事入口台</text>
      <view class="zd"></view>
      <text>以命为据 · 以事为问</text>
    </view>

    <!-- 看我的：八字排盘（L4 主推第一位——确定性功能，免费） -->
    <view class="eg-head">
      <text>看我的</text>
      <text class="eg-tag">主推</text>
    </view>
    <view class="papercard eg-card">
      <view class="book-row" hover-class="book-row-active" hover-stay-time="0"
        data-url="/pages/paipan/paipan" bindtap="onEntryTap">
        <view class="seal cl-seal"><text class="seal-char">排</text></view>
        <view class="br-mid">
          <view class="br-title">八字排盘</view>
          <view class="br-sub">四柱 · 大运 · 神煞 · 称骨</view>
        </view>
        <view class="br-page"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
    </view>

    <!-- 姻缘 · 命名 · 择日：三件人生大事 -->
    <view class="eg-head">
      <text>姻缘 · 命名 · 择日</text>
      <text class="eg-tag">三件人生大事</text>
    </view>
    <view class="papercard eg-card">
      <!-- 实入口：双人合盘 → 合盘页（onLoad 自动回填我方默认命主） -->
      <view class="book-row" hover-class="book-row-active" hover-stay-time="0"
        data-url="/pages/hehun/hehun" bindtap="onEntryTap">
        <view class="seal cl-seal"><text class="seal-char">缘</text></view>
        <view class="br-mid">
          <view class="br-title">双人合盘</view>
          <view class="br-sub">缘分契合 · 免费 · 输入 → 缘笺 → 深度报告</view>
        </view>
        <view class="br-page"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
      <!-- 实入口：AI 取名 → 取名页（姓氏+期望+风格chips → 免费 5 名 → 雷达 → 名笺） -->
      <view class="book-row" hover-class="book-row-active" hover-stay-time="0"
        data-url="/pages/ming/ming" bindtap="onEntryTap">
        <view class="seal cl-seal"><text class="seal-char">名</text></view>
        <view class="br-mid">
          <view class="br-title">AI 取名</view>
          <view class="br-sub">五维评分 · 免费 5 名 · 5 名 → 雷达 → 名笺</view>
        </view>
        <view class="br-page"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
      <!-- 实入口：大事择吉日 → 引导页（选场景 → 对话/直接看吉日） -->
      <view class="book-row" hover-class="book-row-active" hover-stay-time="0"
        data-url="/pages/zeri_guide/zeri_guide" bindtap="onEntryTap">
        <view class="seal cl-seal"><text class="seal-char">吉</text></view>
        <view class="br-mid">
          <view class="br-title">大事择吉日</view>
          <view class="br-sub">嫁娶 / 搬家 / 开业 / 出行 · 表单式 → 3 吉日 → 清单</view>
        </view>
        <view class="br-page"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
    </view>

    <!-- 问事：把心绪说出口 -->
    <view class="eg-head">
      <text>问事</text>
      <text class="eg-tag">把心绪说出口</text>
    </view>
    <view class="entry-grid g2">
      <!-- 占位灰态：解梦（对话内功能，即将上线，不可点） -->
      <view class="entry-card cl-off">
        <view class="seal ec-seal cl-seal-off"><text class="seal-char">梦</text></view>
        <view class="ec-t">解梦</view>
        <view class="ec-s">记一段梦 · 我来解</view>
        <view class="ec-tag">即将上线</view>
      </view>
      <!-- 实入口：抽灵签 → 灵签页（签筒摇签 → 签卡 → 保存/再摇） -->
      <view class="entry-card ec-on" hover-class="ec-on-active" hover-stay-time="0"
        data-url="/pages/qian/qian" bindtap="onEntryTap">
        <view class="seal ec-seal"><text class="seal-char">签</text></view>
        <view class="ec-t">抽灵签</view>
        <view class="ec-s">默念一事 · 摇一支 · 免费</view>
      </view>
    </view>

    <!-- 运势：把一生画给你看 -->
    <view class="eg-head">
      <text>运势</text>
      <text class="eg-tag">把一生画给你看</text>
    </view>
    <view class="papercard eg-card">
      <!-- 占位灰态：人生时轴（即将上线，不可点） -->
      <view class="book-row cl-off">
        <view class="seal cl-seal cl-seal-off"><text class="seal-char">轴</text></view>
        <view class="br-mid">
          <view class="br-title">人生时轴</view>
          <view class="br-sub">月卷 → 年卷 → 十年 K 线 · 可返</view>
        </view>
        <view class="cl-tag">即将上线</view>
      </view>
      <!-- 占位灰态：运势曲线（即将上线，不可点） -->
      <view class="book-row cl-off">
        <view class="seal cl-seal cl-seal-off"><text class="seal-char">势</text></view>
        <view class="br-mid">
          <view class="br-title">人生运势曲线</view>
          <view class="br-sub">1-100 岁 · 一张 K 线图，存下来就能传家</view>
        </view>
        <view class="cl-tag">即将上线</view>
      </view>
      <!-- 占位灰态：水逆提醒（即将上线，不可点） -->
      <view class="book-row cl-off">
        <view class="seal cl-seal cl-seal-off"><text class="seal-char">逆</text></view>
        <view class="br-mid">
          <view class="br-title">水逆提醒</view>
          <view class="br-sub">旧事易回头 · 恰是了结旧账的好时机</view>
        </view>
        <view class="cl-tag">即将上线</view>
      </view>
    </view>

    <!-- 进阶工具：万年历 + 名人命例 + 多盘对比（万年历 P1-1：确定性 0 成本；
         命例 L3-1；多盘对比 P1-2 前端：同一生辰不同时辰两盘差异） -->
    <view class="eg-head">
      <text>进阶工具</text>
      <text class="eg-tag">历法 · 命例 · 多盘</text>
    </view>
    <view class="papercard eg-card">
      <!-- 实入口：万年历 → 月历宫格 + 日详情（问真吉真万年历同款：日历+干支+宜忌） -->
      <view class="book-row" hover-class="book-row-active" hover-stay-time="0"
        data-url="/pages/wannianli/wannianli" bindtap="onEntryTap">
        <view class="seal cl-seal"><text class="seal-char">历</text></view>
        <view class="br-mid">
          <view class="br-title">万年历</view>
          <view class="br-sub">日历 · 干支 · 黄历宜忌 · 每日详情</view>
        </view>
        <view class="br-page"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
      <!-- 实入口：名人命例 → 命例库列表（免费试看前 35 · 高级会员全量 2807 位） -->
      <view class="book-row" hover-class="book-row-active" hover-stay-time="0"
        data-url="/pages/mingren/mingren" bindtap="onEntryTap">
        <view class="seal cl-seal"><text class="seal-char">例</text></view>
        <view class="br-mid">
          <view class="br-title">名人命例</view>
          <view class="br-sub">2807 位历史人物 · 穷通宝鉴评注 · 免费试看 35 例</view>
        </view>
        <view class="br-page"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
      <!-- 实入口：多盘对比 → 同一生辰不同时辰两盘差异（时辰不定 / 想选时辰必看） -->
      <view class="book-row" hover-class="book-row-active" hover-stay-time="0"
        data-url="/pages/duipan/duipan" bindtap="onEntryTap">
        <view class="seal cl-seal"><text class="seal-char">盘</text></view>
        <view class="br-mid">
          <view class="br-title">多盘对比</view>
          <view class="br-sub">同一生辰 · 两个时辰 · 四柱五行差异一览</view>
        </view>
        <view class="br-page"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
    </view>

    <view class="suance-foot">
      <view class="fg"></view>
      <text>明灯谨录 · 观命不执命</text>
      <view class="fg"></view>
    </view>
  </scroll-view>

  <view class="tabbar">
    <view class="tab-item" bindtap="onTab" data-tab="chat">
      <image class="tab-ic" src="/assets/images/ic-chat.png"></image>
      <text class="tab-label">对话</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="today">
      <image class="tab-ic" src="/assets/images/ic-lantern.png"></image>
      <text class="tab-label">今日</text>
    </view>
    <view class="tab-item on" bindtap="onTab" data-tab="suance">
      <image class="tab-ic" src="/assets/images/ic-book2-on.png"></image>
      <text class="tab-label">测算</text>
      <view class="dot"></view>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="me">
      <image class="tab-ic" src="/assets/images/ic-seal.png"></image>
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
