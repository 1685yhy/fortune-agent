/* ═══ 屏 3 · 测算 — 问事入口台（dir_b SUANCE_MAIN 分组克制排布：姻缘·命名·择日 / 问事 / 运势）
   视觉基准：宣纸/墨/朱砂/金（禁灰）——占位灰态用淡墨/水痕（--ink-soft/--ink-faint），不用灰色系 ═══ */

.suance-wrap { position: fixed; inset: 0; }

/* 主列滚动区（navrow 之下 / tabbar 之上，同命书 book-scroll 位） */
.suance-scroll {
  position: absolute;
  top: calc(183rpx + var(--nav-off));   /* 95px */
  left: 0; right: 0;
  bottom: 173rpx;                        /* 90px */
  z-index: 25;
  padding: 23rpx 38rpx 50rpx;            /* 12px 20px 26px */
  overflow-x: hidden;                    /* 真机修复：内容超宽时横向裁剪，页面不可横滑 */
}

/* 页头：问事入口台 · 以命为据 · 以事为问（同 today-date 家族：宋体小字 + 朱砂菱点） */
.suance-date {
  text-align: center;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .32em;
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19rpx;
  margin-bottom: 8rpx;
}
.suance-date .zd {
  width: 10rpx;
  height: 10rpx;
  transform: rotate(45deg);
  background: var(--acc);
  border-radius: 2rpx;
}

/* ── 分组标题（原型 .eg-head：刷体小字 + 右侧细框标签） ── */
.eg-head {
  display: flex;
  align-items: center;
  gap: 19rpx;                            /* 10px */
  margin: 34rpx 0 15rpx;                 /* 18px 0 8px */
  font-family: var(--font-brush);
  font-size: 26rpx;                      /* 13.5px */
  letter-spacing: .26em;
  color: var(--ink);
  font-weight: 400;
}
.eg-head:first-of-type { margin-top: 17rpx; }
.eg-head .eg-tag {
  margin-left: auto;
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .1em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);
  border-radius: 6rpx;
  padding: 4rpx 15rpx;
  font-weight: 400;
}

/* ── 入口卡组（papercard 底 + book-row 行，同命书章目/合盘入口卡一族） ── */
.eg-card { overflow: hidden; }
.book-row {
  display: flex;
  align-items: center;
  gap: 23rpx;                            /* 12px */
  padding: 29rpx 31rpx;                  /* 15px 16px */
  position: relative;
}
.book-row + .book-row { border-top: 2rpx solid var(--line-soft); }
.book-row-active { background: var(--acc-soft); }

/* 印章字图标（实入口：朱砂印章） */
.cl-seal { width: 52rpx; height: 52rpx; font-size: 30rpx; border-radius: 6rpx; }
.ec-seal { width: 52rpx; height: 52rpx; font-size: 30rpx; border-radius: 6rpx; }

.br-mid { flex: 1; min-width: 0; }
.br-title-row { display: flex; align-items: center; gap: 12rpx; }
/* 主推角标（朱砂底白字，紧贴标题） */
.br-badge {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 18rpx;                      /* 9.5px */
  letter-spacing: .14em;
  color: #FBF6E8;
  background: var(--acc);
  border-radius: 5rpx;
  padding: 3rpx 13rpx;
  transform: translateY(-1rpx);
}
.br-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 30rpx;                      /* 15.5px */
  letter-spacing: .08em;
  color: var(--ink);
}
.br-sub {
  margin-top: 6rpx;
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .12em;
  color: var(--ink-soft);
}
.br-page {
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .14em;
  color: var(--ink-faint);
  display: flex;
  align-items: center;
  gap: 15rpx;
  flex-shrink: 0;
}
.br-page .chev { width: 23rpx; height: 23rpx; }

/* ── 占位灰态（未开发功能：淡墨/水痕呈现，克制不点睛，不可点） ── */
.cl-off { opacity: 1; }
.cl-off .cl-seal-off {
  background: transparent;
  border: 2rpx solid var(--ink-faint);
  color: var(--ink-faint);
  box-shadow: none;
}
.cl-off .br-title { color: var(--ink-soft); }
.cl-off .br-sub { color: var(--ink-faint); }
.cl-tag {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .1em;
  color: var(--ink-faint);
  border: 2rpx solid var(--line-soft);
  border-radius: 5rpx;
  padding: 4rpx 13rpx;
}

/* ── 问事组：双列入口卡（原型 .entry-card g2） ── */
.entry-grid {
  width: 100%;
  display: flex;
  gap: 17rpx;                            /* 9px */
}
.entry-grid.g2 .entry-card { flex: 1; }
.entry-card {
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 23rpx 10rpx 19rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
  text-align: center;
}
.entry-card .ec-t {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 27rpx;                      /* 13.5px */
  letter-spacing: .06em;
  color: var(--ink-soft);
  white-space: nowrap;
}
.entry-card .ec-s {
  font-family: var(--font-song);
  font-size: 22rpx;                      /* 12px */
  letter-spacing: .02em;
  color: var(--ink-faint);
  line-height: 1.5;
  white-space: nowrap;
}
.entry-card .ec-tag {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .1em;
  color: var(--ink-faint);
  border: 2rpx solid var(--line-soft);
  border-radius: 5rpx;
  padding: 3rpx 12rpx;
  margin-top: 3rpx;
}

/* 实入口问事卡（抽灵签：朱砂印章 + 浓墨标题，与灰态占位区分） */
.entry-card.ec-on .ec-t { color: var(--ink); }
.entry-card.ec-on .ec-s { color: var(--ink-soft); }
.ec-on-active { background: var(--acc-soft); }

/* ── 落款 ── */
.suance-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 23rpx;
  margin-top: 42rpx;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .2em;
  color: var(--ink-faint);
}
.suance-foot .fg {
  width: 69rpx;                          /* 36px */
  height: 2rpx;
  background: var(--line-soft);
}
