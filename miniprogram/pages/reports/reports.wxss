/* 报告 — 历史解读页面样式 */

.page-reports {
  min-height: 100vh;
  padding-bottom: 20px;
  background: var(--color-bg);
}

/* 头部 — refined section-header style */
.reports-header {
  padding: var(--space-lg) var(--space-lg) var(--space-md);
}

.reports-title {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--color-text-tertiary);
  letter-spacing: 0.06em;
  display: block;
}

.reports-subtitle {
  font-size: 11px;
  color: var(--color-text-tertiary);
  opacity: 0.6;
  margin-top: var(--space-xs);
  display: block;
}

/* 报告列表 */
.report-list {
  padding: var(--space-sm) var(--space-md) var(--space-xl);
}

.report-item {
  margin-bottom: var(--space-md);
}

.report-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
  animation: fadeSlideUp 0.35s ease-out both;
  position: relative;
}

.report-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* 卡片场景色调 — subtle accent bar on the left */
.card-tint-career {
  border-left: 3px solid rgba(91,140,90,0.5);
}
.card-tint-love {
  border-left: 3px solid rgba(194,65,61,0.5);
}
.card-tint-wealth {
  border-left: 3px solid rgba(184,134,11,0.5);
}
.card-tint-health {
  border-left: 3px solid rgba(91,140,162,0.5);
}
.card-tint-default {
  border-left: 3px solid var(--color-border);
}

.report-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.report-meta {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.report-date {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
}

.report-scenario {
  font-size: var(--font-xs);
  padding: 2px 10px;
  background: var(--gold-glow);
  color: var(--gold);
  border-radius: var(--radius-full);
}

.report-score {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--gradient-gold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-score-text {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--ink);
}

.report-summary {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: block;
  margin-bottom: var(--space-sm);
}

/* 标签 */
.report-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: var(--space-sm);
}

.report-tag {
  font-size: var(--font-xs);
  padding: 2px 10px;
  border-radius: var(--radius-full);
  background: var(--color-bg-card-alt);
  color: var(--color-text-tertiary);
  border: 1px solid var(--color-border);
}

/* 操作按钮 */
.report-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-sm);
  border-top: 1px solid var(--color-divider);
}

.report-action {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  padding: 4px 0;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-action-view {
  color: var(--gold);
  font-weight: 500;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: var(--space-lg) 0;
}

.load-end-text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* ===== 详情弹窗 ===== */
.detail-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.detail-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.detail-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 1px solid var(--color-divider);
}

.detail-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.detail-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-bg-card-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.detail-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-lg);
  max-height: 55vh;
}

.detail-loading {
  display: flex;
  justify-content: center;
  padding: var(--space-2xl);
}

/* 详情元数据 */
.detail-meta {
  background: var(--color-bg-card-alt);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-lg);
}

.detail-meta-item {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
}

.detail-meta-item + .detail-meta-item {
  border-top: 1px solid var(--color-divider);
}

.detail-meta-label {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.detail-meta-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
}

/* 详情内容 */
.detail-content {
  margin-bottom: var(--space-lg);
}

.detail-content-text {
  font-size: var(--font-md);
  color: var(--color-text);
  line-height: 1.8;
  display: block;
  white-space: pre-wrap;
}

/* 额外信息 */
.detail-extras {
  background: var(--color-bg-card-alt);
  border-radius: var(--radius-md);
  padding: var(--space-md);
}

.extra-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 6px 0;
}

.extra-label {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  min-width: 80px;
}

.extra-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
}

/* 底部 */
.detail-footer {
  padding: var(--space-md) var(--space-lg);
  border-top: 1px solid var(--color-divider);
  display: flex;
  justify-content: center;
}

/* 空状态 — 大气居中对齐 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-3xl) var(--space-xl);
  text-align: center;
  min-height: 60vh;
}

.empty-state-icon-reports {
  font-size: 72px;
  margin-bottom: var(--space-lg);
  opacity: 0.35;
  filter: blur(0.5px);
  text-shadow: 0 0 40px rgba(212,168,67,0.15);
}

.empty-state-title {
  font-size: var(--font-xl);
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: var(--space-sm);
  letter-spacing: 0.04em;
}

.empty-state-hint {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  max-width: 280px;
  line-height: 1.8;
  letter-spacing: 0.03em;
  white-space: pre-line;
  margin-bottom: var(--space-xl);
}

.empty-state-btn {
  min-width: 140px;
}

/* 暗色模式 */
@media (prefers-color-scheme: dark) {
  .detail-overlay {
    background: rgba(0, 0, 0, 0.7);
  }
}

/* ========================================
   AI 建议（Sub-project B）
   ======================================== */
.advisor-section {
  padding: 0 var(--space-md);
  margin-top: var(--space-sm);
}

.advisor-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
  animation: fadeSlideUp 0.35s ease-out both;
}

.advisor-subsection {
  margin-bottom: var(--space-lg);
}

.advisor-subsection:last-child {
  margin-bottom: 0;
}

.advisor-subtitle {
  font-size: var(--font-xs);
  color: var(--gold);
  font-weight: 600;
  letter-spacing: 0.06em;
  display: block;
  margin-bottom: var(--space-md);
  text-transform: uppercase;
}

.advisor-matches {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.advisor-match-item {
  padding: var(--space-md);
  background: var(--color-bg-card-alt);
  border-radius: var(--radius-md);
  border-left: 3px solid var(--gold);
}

.match-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.match-name {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text);
}

.match-type {
  font-size: var(--font-xs);
  padding: 1px 8px;
  border-radius: var(--radius-full);
  background: var(--gold-glow);
  color: var(--gold);
}

.match-reason {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: block;
}

.advisor-advices {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.advisor-advice-item {
  padding: var(--space-md);
  background: var(--color-bg-card-alt);
  border-radius: var(--radius-md);
}

.advice-domain-tag {
  display: inline-block;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--color-text);
  padding: 2px 10px;
  border-radius: var(--radius-full);
  background: var(--gold-glow);
  margin-bottom: var(--space-sm);
}

.advice-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: block;
}

.advisor-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: var(--space-xl) 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
}
