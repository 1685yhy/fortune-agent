/* ═══ 屏 3 · 命书 — 线装书（dir_b.html 938-972 行逐行翻译，px×1.923→rpx） ═══ */

/* 右侧图标预留胶囊宽度（原型 right:10px 会被微信胶囊遮挡，右移避开） */
.navrow .nav-right { right: 190rpx; }

.book-scroll {
  position: absolute;
  top: calc(183rpx + var(--nav-off));   /* 95px */
  left: 0; right: 0;
  bottom: 173rpx;                        /* 90px */
  z-index: 25;
  padding: 23rpx 38rpx 50rpx;            /* 12px 20px 26px */
  overflow-x: hidden;                    /* 真机修复：内容超宽时横向裁剪，页面不可横滑 */
}

/* ── 封面（缝线 / 朱砂丝带 / 墨题 / 朱印） ── */
.book-cover {
  position: relative;
  border: 2rpx solid var(--line-hard);  /* 1px */
  border-radius: 4rpx;                   /* 2px */
  background: var(--cover-grad);
  padding: 46rpx 46rpx 42rpx;            /* 24px 24px 22px */
  margin-bottom: 35rpx;                  /* 18px */
  box-shadow: 0 15rpx 42rpx var(--shadow-lg);  /* 0 8px 22px */
}
.book-cover::after {
  content: '';
  position: absolute;
  inset: 10rpx;                          /* 5px */
  border: 2rpx solid var(--line-med); /* 1px */
  border-radius: 2rpx;
  pointer-events: none;
}
.book-stitch {
  position: absolute;
  left: 15rpx;                           /* 8px */
  top: 50rpx;                            /* 26px */
  z-index: 2;
  width: 19rpx;                          /* 10px */
  height: 396rpx;                        /* 206px */
  pointer-events: none;
}
.book-ribbon {
  position: absolute;
  top: -17rpx;                           /* -9px */
  right: 46rpx;                          /* 24px */
  z-index: 3;
  width: 29rpx;                          /* 15px */
  height: 165rpx;                        /* 86px */
  pointer-events: none;
}
.bc-top {
  text-align: center;
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .42em;
  color: var(--ink-soft);
  margin-bottom: 23rpx;                  /* 12px */
}
.bc-title {
  font-family: var(--font-brush);
  font-size: 88rpx;                      /* 46px */
  letter-spacing: .3em;
  color: var(--ink);
  text-align: center;
  line-height: 1.15;
  font-weight: 400;
}
.bc-title .bc-em { font-style: normal; color: var(--acc); }
.bc-line {
  width: 108rpx;                         /* 56px */
  height: 2rpx;                          /* 1px */
  background: var(--line-mid);
  margin: 23rpx auto 19rpx;              /* 12px 10px */
}
.bc-sub {
  text-align: center;
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .34em;
  color: var(--ink-soft);
}
.bc-seal {
  position: absolute;
  right: 50rpx;                          /* 26px */
  bottom: 38rpx;                         /* 20px */
}
.seal-50 { width: 50rpx; height: 50rpx; font-size: 31rpx; transform: rotate(-2deg); }

/* ── 章节目录 ── */
.book-chapters { overflow: hidden; }
.book-row {
  display: flex;
  align-items: center;
  gap: 23rpx;                            /* 12px */
  padding: 29rpx 31rpx;                  /* 15px 16px */
  position: relative;
}
.row-line { border-bottom: 2rpx solid var(--line-soft); }  /* 1px */
.book-row-active { background: var(--acc-soft); }

.br-no {
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .2em;
  color: var(--ink-soft);
  width: 85rpx;                          /* 44px */
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;                            /* 6px */
}
.br-no .r-dot {
  width: 10rpx;                          /* 5px */
  height: 10rpx;
  border-radius: 50%;
  background: var(--acc);
}
.br-no .r-ring {
  width: 10rpx;                          /* 5px */
  height: 10rpx;
  border-radius: 50%;
  border: 2rpx solid var(--ink-faint);   /* 1px */
}
.br-mid { flex: 1; min-width: 0; }
.br-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 30rpx;                      /* 15.5px */
  letter-spacing: .08em;
  color: var(--ink);
}
.br-sub {
  margin-top: 6rpx;                      /* 3px */
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .12em;
  color: var(--ink-soft);
}
.br-page {
  font-family: var(--font-song);
  font-size: 23rpx;                      /* 12px */
  letter-spacing: .14em;
  color: var(--ink-faint);
  display: flex;
  align-items: center;
  gap: 15rpx;                            /* 8px */
}
.br-page .chev { width: 23rpx; height: 23rpx; }  /* 12px */

/* ── 竖排落款（观命不执命 · 明灯谨识） ── */
.book-vertical {
  display: flex;
  justify-content: flex-end;
  margin-top: 42rpx;                     /* 22px */
  padding-right: 12rpx;                  /* 6px */
}
.book-vertical .vt {
  writing-mode: vertical-rl;
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .42em;
  color: var(--ink-soft);
  line-height: 1.9;
}

/* ═══ v1.3 卷章全文弹层（墨韵线装书：宣纸底 / 竖排卷名 / 朱印 / 内容可滚动） ═══ */

/* 封面按压反馈（点封面开卷） */
.book-cover-active { opacity: .88; }

/* ── 空态（暂无命书 · 去聊一段生成） ── */
.book-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 0 84rpx;
}
.be-seal {
  width: 68rpx;
  height: 68rpx;
  font-size: 42rpx;
  margin-bottom: 26rpx;
}
.be-line1 {
  font-family: var(--font-song);
  font-size: 30rpx;
  letter-spacing: .3em;
  color: var(--ink);
}
.be-line2 {
  margin-top: 12rpx;
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .18em;
  color: var(--ink-faint);
}
.be-btn {
  margin-top: 40rpx;
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .24em;
  color: var(--acc);
  border: 2rpx solid var(--acc-line);
  border-radius: 8rpx;
  padding: 14rpx 52rpx;
  background: var(--paper-card);
}
.be-btn-active { background: var(--acc-soft); }

/* ── 弹层（半屏纸笺上滑，宣纸底） ── */
.dt-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 120;
  background: rgba(58, 44, 30, .38);     /* 墨色蒙层 */
  animation: dt-fade .18s ease;
}
@keyframes dt-fade { from { opacity: 0; } to { opacity: 1; } }

.dt-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 130;
  height: 82vh;
  background: var(--paper);
  border-top: 2rpx solid var(--line-strong);
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  display: flex;
  flex-direction: column;
  animation: dt-up .22s ease;
}
@keyframes dt-up { from { transform: translateY(40%); opacity: .4; } to { transform: none; opacity: 1; } }

.dt-top {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 36rpx 22rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.dt-seal {
  width: 62rpx;
  height: 62rpx;
  font-size: 38rpx;
  flex-shrink: 0;
}
.dt-titles {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.dt-no {
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .18em;
  color: var(--acc);
  flex-shrink: 0;
}
.dt-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 32rpx;
  letter-spacing: .14em;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dt-x {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink-faint);
  border: 2rpx solid var(--line);
  border-radius: 50%;
  box-sizing: border-box;
}
.dt-x-active { color: var(--acc); border-color: var(--acc); }

.dt-body {
  flex: 1;
  min-height: 0;
  padding: 26rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.dt-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}
.dt-meta-item {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .1em;
  color: var(--ink-soft);
  border: 1rpx solid var(--line-med);
  border-radius: 5rpx;
  padding: 4rpx 14rpx;
}
.dt-content {
  display: block;
  font-family: var(--font-kai);
  font-size: 28rpx;
  line-height: 2.05;
  letter-spacing: .03em;
  color: var(--ink-mid);
  white-space: pre-wrap;
  word-break: break-all;
}
.dt-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 34rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line-soft);
}
.dt-foot-seal {
  width: 44rpx;
  height: 44rpx;
  font-size: 26rpx;
}
.dt-foot-txt {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .22em;
  color: var(--ink-faint);
}
