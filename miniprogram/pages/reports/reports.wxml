<view class="screen" style="--nav-off:{{navOff}}px">
  <view class="navrow">
    <view class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goToday">
      <image class="back-icon" src="{{dark ? '/assets/images/ic-back-dark.png' : '/assets/images/ic-back.png'}}"></image>
    </view>
    <view class="nav-title">
      <text>命书</text>
    </view>
    <view class="nav-right" hover-class="navrow-hover" hover-stay-time="0" bindtap="onShare">
      <image class="nav-right-icon" src="{{dark ? '/assets/images/ic-share-dark.png' : '/assets/images/ic-share.png'}}"></image>
    </view>
  </view>

  <scroll-view scroll-y class="book-scroll">
    <view class="book-cover">
      <image class="book-stitch" src="/assets/images/stitch.png"></image>
      <image class="book-ribbon" src="/assets/images/ribbon.png"></image>
      <view class="bc-top">戊寅年 · 开卷</view>
      <view class="bc-title">命<text class="bc-em">书</text></view>
      <view class="bc-line"></view>
      <view class="bc-sub">卷一至卷四 · 明灯谨录</view>
      <view class="bc-seal">
        <view class="seal seal-50"><text class="seal-char">明</text></view>
      </view>
    </view>

    <view class="papercard book-chapters">
      <view wx:for="{{books}}" wx:key="noText" class="book-row {{index < books.length - 1 ? 'row-line' : ''}}"
        hover-class="book-row-active" hover-stay-time="0">
        <view class="br-no">
          <view wx:if="{{item.read}}" class="r-dot"></view>
          <view wx:else class="r-ring"></view>
          <text>{{item.noText}}</text>
        </view>
        <view class="br-mid">
          <view class="br-title">{{item.title}}</view>
          <view class="br-sub">{{item.sub}}</view>
        </view>
        <view class="br-page">
          <text>第{{item.page}}页</text>
          <image class="chev" src="{{dark ? '/assets/images/ic-chev-dark.png' : '/assets/images/ic-chev.png'}}"></image>
        </view>
      </view>
    </view>

    <view class="book-vertical">
      <text class="vt">观命不执命 · 明灯谨识</text>
    </view>
  </scroll-view>

  <view class="tabbar">
    <view class="tab-item" bindtap="onTab" data-tab="today">
      <image class="tab-ic" src="{{dark ? '/assets/images/ic-lantern-dark.png' : '/assets/images/ic-lantern.png'}}"></image>
      <text class="tab-label">今日</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="chat">
      <image class="tab-ic" src="{{dark ? '/assets/images/ic-chat-dark.png' : '/assets/images/ic-chat.png'}}"></image>
      <text class="tab-label">聊天</text>
    </view>
    <view class="tab-item on" bindtap="onTab" data-tab="book">
      <image class="tab-ic" src="/assets/images/ic-book-on.png"></image>
      <text class="tab-label">命书</text>
      <view class="dot"></view>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="me">
      <image class="tab-ic" src="{{dark ? '/assets/images/ic-seal-dark.png' : '/assets/images/ic-seal.png'}}"></image>
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
