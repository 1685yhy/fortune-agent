/* 易理学堂 — 灯下课堂 | v6 靛蓝夜空 + 磨砂玻璃 + 暖金 */

/* ---- 动画 ---- */
.content-enter { animation: fadeUp 0.3s ease-out both; }
.animate-fade-up { animation: fadeUp 0.4s ease-out both; }
.animate-fade-down { animation: fadeUp 0.4s ease-out both; }
.animate-scale { animation: scaleIn 0.3s ease-out both; }

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

.page-xuetang {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: var(--bg-night);
}

/* 头部 */
.xuetang-header {
  padding: 80rpx var(--space-lg) var(--space-md);
}

.xuetang-title {
  font-family: var(--font-brush);
  font-size: var(--text-xl);
  font-weight: 400;
  color: var(--gold-light);
  letter-spacing: 0.06em;
  display: block;
}

.xuetang-subtitle {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  opacity: 0.8;
  margin-top: var(--space-xs);
  display: block;
}

/* 话题列表 */
.topic-list {
  padding: var(--space-sm) var(--space-lg) var(--space-xl);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}

.topic-item {
  width: calc(50% - var(--space-md) / 2);
}

.topic-card {
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 320rpx;
}

.topic-card:active {
  transform: scale(0.97);
}

.topic-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--space-md);
}

.topic-icon {
  font-size: var(--text-lg);
  line-height: 1;
  display: block;
}

.topic-badge {
  background: rgba(212, 165, 116, 0.12);
  padding: 2rpx 16rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(212, 165, 116, 0.3);
}

.topic-badge-text {
  font-size: var(--text-xs);
  color: var(--gold);
  font-weight: 500;
}

.topic-name {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--ink-primary);
  display: block;
  margin-bottom: var(--space-xs);
  letter-spacing: 0.03em;
}

.topic-desc {
  font-size: var(--text-sm);
  color: var(--ink-muted);
  line-height: 1.6;
  display: block;
  flex: 1;
}

/* ---- 加载 ---- */
.loading-container {
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.08);
  border-top-color: var(--gold);
  animation: spin 0.8s linear infinite;
  margin-bottom: var(--space-lg);
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
}

/* ---- 空状态 ---- */
.empty-state {
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.empty-state-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: var(--space-md);
  opacity: 0.6;
}
.empty-state-title {
  font-size: var(--text-lg);
  color: var(--ink-primary);
  font-weight: 500;
  margin-bottom: var(--space-sm);
  letter-spacing: 0.04em;
}
.empty-state-hint {
  font-size: var(--text-sm);
  color: var(--ink-muted);
  max-width: 560rpx;
  line-height: 1.8;
  letter-spacing: 0.03em;
  white-space: pre-line;
  margin-bottom: var(--space-xl);
}

/* ===== 课程详情态 ===== */

.page-xuetang-detail {
  min-height: 100vh;
  background: var(--bg-night);
  padding-bottom: var(--space-xl);
}

/* 返回按钮 */
.detail-back {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: var(--space-md) var(--space-lg);
  min-height: 44px;
}

.detail-back:active {
  opacity: 0.7;
}

.detail-back-arrow {
  font-size: var(--text-base);
  color: var(--gold);
  font-weight: 600;
}

.detail-back-text {
  font-size: var(--text-sm);
  color: var(--gold);
  font-weight: 500;
}

/* 课程头部 */
.lesson-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: 0 var(--space-lg) var(--space-lg);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: var(--space-lg);
}

.lesson-icon {
  font-size: var(--text-xl);
  line-height: 1;
  display: block;
}

.lesson-header-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.lesson-title {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--ink-primary);
  line-height: 1.3;
  letter-spacing: 0.03em;
  display: block;
}

.lesson-topic-label {
  font-size: var(--text-xs);
  color: var(--gold);
  background: rgba(212, 165, 116, 0.12);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  display: inline-flex;
  align-self: flex-start;
  border: 1rpx solid rgba(212, 165, 116, 0.25);
}

/* 课程正文 */
.lesson-body {
  padding: 0 var(--space-lg);
  max-height: calc(100vh - 200px);
}

.lesson-content {
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
}

.lesson-content-text {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  line-height: 1.9;
  display: block;
  white-space: pre-wrap;
  letter-spacing: 0.03em;
}

/* 底部 */
.lesson-footer {
  text-align: center;
  padding: var(--space-xl) 0 var(--space-lg);
}

.lesson-footer-text {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  opacity: 0.5;
  letter-spacing: 0.08em;
}
