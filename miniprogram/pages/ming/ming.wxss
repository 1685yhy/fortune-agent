/* ═══ AI 取名 · 名笺(原型 S4/S15: ming-input → ming-result → ming-report)
   视觉基准: 宣纸/墨/朱砂/金(禁灰), dir_b v7 同款
   三段式: 输入(分段+chips+自定义) / 5 名卡(雷达+出处+补益+锁) / 墨韵名笺 ═══ */

.ming-wrap { position: fixed; inset: 0; }
.ming-scroll {
  position: absolute;
  top: calc(183rpx + var(--nav-off));
  left: 0; right: 0;
  bottom: 0;
  z-index: 25;
  padding: 24rpx 38rpx 60rpx;
  overflow-x: hidden;
}

/* ── 宝宝/成人分段 ── */
.seg-tabs {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin: 16rpx 0 20rpx;
}
.seg-tab {
  font-family: var(--font-song);
  font-size: 30rpx;
  letter-spacing: .1em;
  color: var(--ink-soft);
  padding: 6rpx 0;
  position: relative;
}
.seg-tab.on { color: var(--ink); font-weight: 600; }
.seg-tab .und {
  position: absolute;
  left: 50%; bottom: -4rpx;
  transform: translateX(-50%);
  width: 0; height: 3rpx;
  background: var(--acc);
  transition: width .2s;
}
.seg-tab.on .und { width: 44rpx; }

/* ── 表单 ── */
.ming-form { border-radius: 20rpx; padding: 8rpx 30rpx; }
.mf-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--line-soft);
  flex-wrap: wrap;
  padding: 12rpx 0;
}
.mf-row:last-child { border-bottom: none; }
.mf-label {
  width: 150rpx;
  font-family: var(--font-song);
  font-size: 27rpx;
  color: var(--ink-mid);
  flex-shrink: 0;
}
.mf-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  min-width: 0;
}
.mf-ph { color: var(--ink-faint); font-size: 25rpx; }
.mf-sex { display: flex; gap: 18rpx; }
.sex-btn {
  min-width: 100rpx;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 10rpx;
  border: 2rpx solid var(--line);
  font-size: 27rpx;
  color: var(--ink-mid);
  background: var(--paper-card);
}
.sex-btn.on {
  border-color: var(--acc);
  color: var(--acc);
  background: var(--acc-soft);
  font-weight: 600;
}
.mf-chips { display: flex; flex-wrap: wrap; gap: 14rpx; width: 100%; }
.chip {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  font-size: 25rpx;
  color: var(--ink-mid);
  background: var(--paper-card);
}
.chip.on {
  border-color: var(--acc);
  color: var(--acc);
  background: var(--acc-soft);
  font-weight: 600;
}
.mf-custom {
  width: 100%;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: var(--ink);
  background: rgba(58,44,30,.04);
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
}

.mf-note {
  margin: 20rpx 6rpx 0;
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  letter-spacing: .03em;
}
.ming-gen { margin-top: 26rpx; }
.footnote {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 26rpx;
  letter-spacing: .04em;
}

/* ── 结果页: 本次期望 + 5 名卡 ── */
.zf-result-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 22rpx;
}
/* 成人免费现名诊断 */
.diag-box {
  background: rgba(169, 58, 44, .06);
  border: 1rpx solid rgba(169, 58, 44, .18);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 0 24rpx;
}
.diag-title {
  font-family: var(--font-song);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: .06em;
  margin-bottom: 10rpx;
}
.diag-item {
  font-size: 23rpx;
  color: var(--ink-mid);
  line-height: 1.7;
  padding-left: 22rpx;
  position: relative;
}
.diag-item::before {
  content: '·';
  position: absolute;
  left: 4rpx;
  color: #A93A2C;
}
.diag-more {
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-top: 10rpx;
  letter-spacing: .03em;
}
.zf-scene-name {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: .06em;
}
.zf-period-tag {
  font-size: 21rpx;
  color: var(--acc);
  border: 2rpx solid rgba(169,58,44,.4);
  border-radius: 3rpx;
  padding: 2rpx 12rpx;
  background: var(--acc-soft);
}

.name-card {
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
}
.name-card-active { background: var(--acc-soft); }
.name-card.locked { opacity: .92; }
.nc-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.nc-name {
  font-family: var(--font-song);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: .08em;
}
.nc-full { font-size: 24rpx; color: var(--ink-soft); }
.nc-score {
  margin-left: auto;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--acc);
}
.nc-score-u { font-size: 21rpx; font-weight: 400; color: var(--ink-soft); }
.nc-lock {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-faint);
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.nc-body {
  display: flex;
  gap: 22rpx;
  margin-top: 16rpx;
  align-items: flex-start;
}
.nc-radar { width: 172rpx; height: 172rpx; flex-shrink: 0; }
.nc-info { flex: 1; min-width: 0; }
.nc-src {
  font-size: 23rpx;
  color: var(--ink-mid);
  line-height: 1.6;
}
.nc-src-b { color: var(--acc); font-weight: 600; }
.nc-buyi { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.chip-yi {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  border: 2rpx solid rgba(62,122,99,.45);
  color: #4E7A63;
  background: rgba(62,122,99,.08);
}
.chip-xie {
  border-color: rgba(169,58,44,.4);
  color: var(--acc);
  background: var(--acc-soft);
}
.nc-ping {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-mid);
  font-family: var(--font-song);
  line-height: 1.7;
}
.nc-locked-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  line-height: 1.6;
}

.hp-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.hp-btns .btn-primary, .hp-btns .btn-secondary { flex: 1; }
.ming-unlock { font-size: 26rpx; }
.ming-sample { font-size: 26rpx; }
.regen-btn {
  font-size: 23rpx;
  color: var(--acc);
  border: 2rpx solid rgba(169,58,44,.4);
  border-radius: 6rpx;
  padding: 6rpx 16rpx;
}
.regen-btn-active { background: var(--acc-soft); }
.nav-share {
  font-size: 23rpx;
  color: var(--acc);
  padding: 6rpx 10rpx;
}

/* ── 名笺(深度报告) ── */
.ming-report-head {
  text-align: center;
  padding: 30rpx 0 6rpx;
}
.mr-name {
  font-family: var(--font-song);
  font-size: 84rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: .16em;
}
.mr-full { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-soft); }
.mr-score {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  color: var(--acc);
}

.wuxing-bar, .buyi-matrix, .wuge-card, .rename-card, .extras-card {
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-top: 20rpx;
}
.wx-t, .bm-t, .wu-t, .rn-t, .ex-t {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 27rpx;
  color: var(--ink);
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.wx-tag {
  font-size: 20rpx;
  font-weight: 400;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.wx-tag-strong { color: var(--acc); background: var(--acc-soft); }
.wx-tag-weak { color: #4E7A63; background: rgba(62,122,99,.08); }
.wx-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.wx-k { width: 34rpx; font-size: 24rpx; color: var(--ink-mid); font-family: var(--font-song); }
.wx-bar {
  flex: 1;
  height: 16rpx;
  background: rgba(58,44,30,.08);
  border-radius: 8rpx;
  overflow: hidden;
}
.wx-bar-in { height: 100%; border-radius: 8rpx; }
.wx-n { width: 26rpx; font-size: 22rpx; color: var(--ink-soft); }
.wx-jian { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 4rpx; }
.wx-jian.add { color: #4E7A63; background: rgba(62,122,99,.08); }
.wx-jian.xie { color: var(--acc); background: var(--acc-soft); }
.wx-note { margin-top: 8rpx; font-size: 21rpx; color: var(--ink-faint); }

.bm-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 24rpx;
  color: var(--ink-mid);
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.bm-plus {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #4E7A63;
  border: 2rpx solid rgba(62,122,99,.45);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.bm-xie { color: var(--acc); border-color: rgba(169,58,44,.4); }
.bm-ys {
  font-size: 23rpx;
  color: var(--ink-soft);
  margin-bottom: 12rpx;
}
.bm-explain {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  border-top: 1rpx dashed var(--line);
  padding-top: 12rpx;
}
.bm-empty { font-size: 23rpx; color: var(--ink-soft); line-height: 1.7; }

.wu-cells { display: flex; flex-wrap: wrap; gap: 12rpx; }
.wu-cell {
  font-size: 22rpx;
  color: #4E7A63;
  background: rgba(62,122,99,.08);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}
.wu-cell.bad { color: var(--acc); background: var(--acc-soft); }

.rn-row { display: flex; align-items: stretch; gap: 14rpx; }
.rn-side {
  flex: 1;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 16rpx;
}
.rn-side-t { font-size: 23rpx; color: var(--ink-mid); }
.rn-side-score { margin-top: 8rpx; font-size: 32rpx; font-weight: 700; color: var(--acc); }
.rn-arrow { align-self: center; color: var(--ink-faint); font-size: 30rpx; }
.rn-issues { margin-top: 8rpx; }
.rn-issue {
  display: block;
  font-size: 21rpx;
  color: var(--acc);
  line-height: 1.6;
}
.rn-ok { margin-top: 8rpx; font-size: 21rpx; color: #4E7A63; }
.rn-verdict {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 600;
}
.rn-notice { margin-top: 6rpx; font-size: 21rpx; color: var(--ink-faint); }

.ex-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
  flex-wrap: wrap;
}
.ex-row:last-child { border-bottom: none; }
.ex-name { font-family: var(--font-song); font-size: 28rpx; color: var(--ink); font-weight: 600; }
.ex-score { font-size: 22rpx; color: var(--acc); }
.ex-ping { font-size: 22rpx; color: var(--ink-mid); flex: 1; min-width: 200rpx; }
.ex-src { font-size: 21rpx; color: var(--ink-faint); }

.ming-save { font-size: 26rpx; }
.ming-share { font-size: 26rpx; }

/* 分享图隐藏画布 */
.ming-share-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 750rpx;
  height: 1200rpx;
}

/* ── 单名详情弹层 ── */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(30,22,12,.55);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-card {
  width: 640rpx;
  background: var(--paper);
  border-radius: 24rpx;
  padding: 36rpx 34rpx;
  max-height: 86vh;
  overflow-y: auto;
}
.dc-head { display: flex; align-items: baseline; gap: 16rpx; }
.dc-name { font-family: var(--font-song); font-size: 52rpx; font-weight: 600; color: var(--ink); }
.dc-score { font-size: 30rpx; font-weight: 700; color: var(--acc); }
.dc-level { font-size: 23rpx; color: var(--ink-soft); }
.dc-radar { width: 320rpx; height: 320rpx; margin: 20rpx auto 6rpx; }
.dc-dims { margin-top: 10rpx; }
.dc-dim {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.dc-dim-k { width: 110rpx; font-size: 24rpx; color: var(--ink-mid); font-family: var(--font-song); }
.dc-dim-bar {
  flex: 1;
  height: 14rpx;
  background: rgba(58,44,30,.08);
  border-radius: 7rpx;
  overflow: hidden;
}
.dc-dim-in {
  height: 100%;
  background: linear-gradient(90deg, rgba(169,58,44,.55), var(--acc));
  border-radius: 7rpx;
}
.dc-dim-v { width: 52rpx; text-align: right; font-size: 23rpx; color: var(--ink); }
.dc-src { margin-top: 12rpx; font-size: 23rpx; color: var(--ink-mid); }
.dc-src .b { color: var(--acc); }
.dc-ping { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-mid); font-family: var(--font-song); line-height: 1.7; }
.dc-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.dc-actions .btn-primary, .dc-actions .btn-secondary { flex: 1; font-size: 25rpx; }

/* ── 付费弹层 ── */
.paywall-mask {
  position: fixed;
  inset: 0;
  background: rgba(30,22,12,.55);
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pw-card {
  width: 620rpx;
  background: var(--paper);
  border-radius: 24rpx;
  padding: 44rpx 36rpx 30rpx;
  text-align: center;
}
.pw-seal {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  background: var(--acc);
  color: var(--paper-card);
  font-family: var(--font-song);
  font-size: 48rpx;
  line-height: 84rpx;
  text-align: center;
}
.pw-t { margin-top: 20rpx; font-family: var(--font-song); font-size: 34rpx; font-weight: 600; color: var(--ink); }
.pw-s { margin-top: 12rpx; font-size: 24rpx; color: var(--ink-soft); line-height: 1.7; }
.pw-price { margin-top: 22rpx; font-size: 52rpx; font-weight: 700; color: var(--acc); }
.pw-price-u { font-size: 24rpx; font-weight: 400; color: var(--ink-soft); }
.pw-btns { display: flex; gap: 16rpx; margin-top: 26rpx; }
.pw-btns .btn-primary, .pw-btns .btn-secondary { flex: 1; font-size: 26rpx; }
.pw-close { margin-top: 22rpx; font-size: 24rpx; color: var(--ink-faint); }
