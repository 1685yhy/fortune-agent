/* 隐私 — 灯下契约 | 宣纸墨韵 */

.page-privacy {
  min-height: 100vh;
  padding: 80rpx var(--space-xl) 120rpx;
  background: var(--paper);
}

.privacy-title {
  font-family: var(--font-kai);
  font-size: var(--text-xl);
  font-weight: 400;
  text-align: center;
  margin-bottom: var(--space-xl);
  letter-spacing: .16em;
  color: var(--ink);
}

.privacy-section {
  margin-bottom: var(--space-lg);
  padding: 0 8rpx;
}

.privacy-heading {
  font-size: var(--text-sm);
  font-weight: 500;
  letter-spacing: .16em;
  color: var(--acc);
  margin-bottom: var(--space-sm);
  position: relative;
  padding-left: 24rpx;
}
.privacy-heading::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 4rpx;
  background: var(--acc-soft);
  border-radius: 2rpx;
}

.privacy-text {
  font-size: var(--text-sm);
  color: var(--ink-mid);
  line-height: 2.1;
}

.privacy-list { padding-left: var(--space-lg); }
.privacy-list-item {
  font-size: var(--text-sm);
  color: var(--ink-mid);
  line-height: 2.1;
}

.privacy-signature { text-align: center; margin-top: var(--space-xl); }
.privacy-signature-text {
  font-family: var(--font-kai);
  font-size: var(--text-lg);
  letter-spacing: .3em;
  color: var(--ink-mid);
}
