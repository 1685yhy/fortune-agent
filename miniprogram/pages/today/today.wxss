/* ═══ 屏 1 · 今日 — 笺谱封面（dir_b.html 755-797 行逐行翻译，px×1.923→rpx） ═══ */

/* 真机修复：保持 .screen 的 fixed 定位（此前 absolute 会让容器跟随内容伸展，真机上页面可横向滑动） */
.today-wrap { position: fixed; inset: 0; display: flex; flex-direction: column; }

/* ── 外框（top:64 / lr:20 / bottom:40 / 1px 墨框 + 顶线 + 水痕晕染） ── */
.today-frame {
  position: absolute;
  top: calc(123rpx + var(--nav-off));   /* 64px */
  left: 38rpx;                           /* 20px */
  right: 38rpx;
  bottom: 77rpx;                         /* 40px */
  border: 2rpx solid var(--line-strong); /* 1px */
  border-radius: 4rpx;                   /* 2px */
}
.today-frame::before {
  content: '';
  position: absolute;
  top: -10rpx; left: -10rpx; right: -10rpx;
  height: 2rpx;                          /* 1px */
  background: var(--line-strong);
}
.today-frame::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(120% 90% at 50% 30%, transparent 60%, rgba(90,70,45,.05) 100%);
}

/* ── 竖排品牌（易理明灯） ── */
.today-brand {
  position: absolute;
  top: calc(123rpx + var(--nav-off));   /* 64px */
  left: 69rpx;                           /* 36px */
  z-index: 25;
  font-family: var(--font-brush);
  font-size: 25rpx;                      /* 13px */
  letter-spacing: .5em;
  line-height: 1.7;
  color: var(--ink-brand);
  writing-mode: vertical-rl;
}

/* ── 日期行（八月六日 ◆ 明日立秋 · 今夜宜早眠） ── */
.today-date {
  position: absolute;
  top: calc(150rpx + var(--nav-off));   /* 78px */
  left: 0; right: 0;
  z-index: 25;
  text-align: center;
  font-family: var(--font-song);
  font-size: 22rpx;                      /* 11.5px */
  letter-spacing: .32em;
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19rpx;                            /* 10px */
}
.today-date .zd {
  width: 10rpx;                          /* 5px */
  height: 10rpx;
  transform: rotate(45deg);
  background: var(--acc);
  border-radius: 2rpx;
}

/* ── 主列（晨笺卡 → 诗签/按钮/脚注，上下分布；内容超框时框内滚动） ── */
.today-col {
  position: absolute;
  inset: 0;
  padding: calc(246rpx + var(--nav-off)) 65rpx 81rpx;  /* 128px 34px 42px */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  overflow-y: auto;
}

/* 封面内容列：占满晨笺卡以下剩余空间，保持原「诗签→按钮→脚注」上下分布 */
.cover-col {
  flex: 1;
  width: 100%;
  min-height: 780rpx;                   /* 短屏兜底：不压缩封面，可框内滚动 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

/* ── 诗签块 ── */
.poem-block { display: flex; flex-direction: column; align-items: center; position: relative; }

/* 水墨灯笼 135×218 → 260×419rpx：烛光两层独立呼吸 */
.lantern-box { position: relative; width: 260rpx; height: 419rpx; }
.lantern-body {
  position: absolute; inset: 0;
  width: 260rpx; height: 419rpx;
}
.lantern-glow {
  position: absolute; left: 0; top: 0;
  width: 260rpx; height: 419rpx;
  pointer-events: none;
}
.lantern-glow-delay { animation-delay: 1.2s; }

.poem-lines { margin-top: 19rpx; }       /* 10px */
.poem-line {
  font-family: var(--poem);
  font-weight: 400;
  font-size: 48rpx;                      /* 25px */
  line-height: 2;
  letter-spacing: .14em;
  color: var(--ink);
  text-align: center;
}
.poem-line .jk {
  color: var(--acc);
  font-size: 29rpx;                      /* 15px */
  vertical-align: super;
  letter-spacing: 0;
}

/* 印章（27px → 52rpx，朱砂「明」） */
.seal-attach {
  position: relative;
  align-self: flex-end;
  margin-right: 73rpx;                   /* 38px */
  margin-top: -15rpx;                    /* -8px */
}
.seal-52 { width: 52rpx; height: 52rpx; font-size: 32rpx; }

/* 两宜标签 */
.yi-chips { display: flex; gap: 19rpx; margin-top: 12rpx; }  /* 10px 6px */
.yi-chip { font-size: 21rpx; padding: 8rpx 23rpx; letter-spacing: .18em; }  /* 11px 4px 12px */

/* 签文注 */
.poem-note {
  margin-top: 27rpx;                     /* 14px */
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .2em;
  color: var(--ink-faint);
  display: flex;
  align-items: center;
  gap: 15rpx;                            /* 8px */
}
.poem-note::before, .poem-note::after {
  content: '';
  width: 31rpx;                          /* 16px */
  height: 2rpx;                          /* 1px */
  background: var(--line);
}

/* ── 想聊聊？按钮 + 截屏提示 ── */
.talk-col { display: flex; flex-direction: column; align-items: center; gap: 27rpx; }  /* 14px */
.talk-btn {
  height: 92rpx;                         /* 48px */
  width: 415rpx;                         /* 216px（原型观感） */
  max-width: 100%;                       /* 真机修复：窄屏自适应，不再因 min-width 撑宽页面 */
  min-width: 0;
  padding: 0 58rpx;                      /* 30px */
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 23rpx;                            /* 12px */
  background: var(--paper-card);
  border: 2rpx solid var(--line-btn); /* 1px */
  border-radius: 8rpx;                   /* 4px */
  font-family: var(--font-song);
  font-size: 31rpx;                      /* 16px */
  letter-spacing: .22em;
  color: var(--ink);
  box-shadow: 0 4rpx 15rpx var(--shadow);  /* 0 2px 8px */
}
.talk-btn-active {
  transform: translateY(2rpx) scale(.985);
  box-shadow: 0 0 0 rgba(0,0,0,0);
  background: var(--acc-soft);
}
.brush-arrow { width: 33rpx; height: 23rpx; }  /* 17×12 */

.shot-hint {
  display: flex;
  align-items: center;
  gap: 13rpx;                            /* 7px */
  justify-content: center;
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .2em;
  color: var(--ink-soft);
}
.shot-ic { width: 25rpx; height: 25rpx; }  /* 13px */

/* 隐藏的分享卡画布（off-screen） */
.ink-card-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750px;
  height: 1200px;
}
.shot-hint-active { color: var(--acc); }

/* ── 脚注（三秒内，为你掌灯） ── */
.today-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;                            /* 7px */
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .24em;
  color: var(--ink-faint);
  padding-bottom: 8rpx;                  /* 4px */
}
.today-foot .fg {
  width: 10rpx;                          /* 5px */
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
}

/* ═══ 晨笺卡（spec 三·小程序内晨笺卡；双线笺框，同 jian_onboard 视觉语言） ═══ */
.jian-card {
  position: relative;
  width: 100%;
  flex-shrink: 0;
  background: var(--paper-card);
  border: 2rpx solid var(--line-strong);
  border-radius: 10rpx;
  padding: 23rpx 27rpx 21rpx;
  box-shadow: 0 6rpx 19rpx var(--shadow-sm);
}
.jian-card::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid var(--line-soft);
  border-radius: 6rpx;
  pointer-events: none;
}

/* 头：印章「晨」+ 干支日期 + 收藏钮 */
.jian-head { display: flex; align-items: center; gap: 15rpx; }
.jian-seal { width: 46rpx; height: 46rpx; font-size: 27rpx; border-radius: 6rpx; }
.jian-title {
  flex: 1;
  min-width: 0;
  font-family: var(--font-kai);
  font-size: 27rpx;
  letter-spacing: .12em;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.jian-fav {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .12em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);
  border-radius: 6rpx;
  padding: 6rpx 17rpx;
  background: var(--tag-bg);
}
.jian-fav-on { color: var(--acc); border-color: var(--acc-line); background: var(--acc-soft); }
.jian-fav-active { opacity: .72; }

/* 宜忌两行（宜=朱砂 忌=淡墨，同签文标签语言） */
.jian-yi { margin-top: 16rpx; display: flex; flex-direction: column; gap: 9rpx; }
.jian-yi-row { display: flex; align-items: flex-start; gap: 13rpx; }
.jian-yi-label {
  flex-shrink: 0;
  font-family: var(--font-brush);
  font-size: 22rpx;
  letter-spacing: .1em;
  color: var(--acc);
  line-height: 1.5;
  margin-top: 2rpx;
}
.jian-yi-label-ji { color: var(--ink-soft); }
.jian-yi-tags { display: flex; flex-wrap: wrap; gap: 9rpx; }
.jian-yi-chip { font-size: 19rpx; padding: 4rpx 14rpx; }
.jian-yi-chip-ji { border-color: var(--acc-line); }
.jian-yi-empty { font-size: 19rpx; padding: 4rpx 14rpx; color: var(--ink-faint); }

/* 金句：收起一行 / 展开（书名 + 原文） */
.jian-quote {
  margin-top: 16rpx;
  border-top: 2rpx solid var(--line-soft);
  padding-top: 13rpx;
}
.jian-quote-row { display: flex; align-items: center; gap: 10rpx; }
.jian-quote-text {
  flex: 1;
  min-width: 0;
  font-family: var(--font-kai);
  font-size: 23rpx;
  letter-spacing: .06em;
  color: var(--ink);
  line-height: 1.55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.jian-quote-text-open { white-space: normal; }
.jian-quote-more {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 18rpx;
  letter-spacing: .1em;
  color: var(--acc);
}
.jian-quote-book {
  margin-top: 7rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .12em;
  color: var(--ink-soft);
  text-align: right;
}

/* 轻私语 */
.jian-private {
  margin-top: 14rpx;
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .05em;
  color: var(--ink-mid);
  line-height: 1.6;
}
.jian-private-label {
  color: var(--ink-faint);
  font-size: 19rpx;
  letter-spacing: .12em;
  margin-right: 10rpx;
}

/* 今日小问 → 对话页 */
.jian-question {
  margin-top: 15rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 13rpx 16rpx;
  background: var(--acc-soft);
  border-radius: 8rpx;
}
.jian-question-active { opacity: .75; }
.jian-question-label {
  flex-shrink: 0;
  font-family: var(--font-brush);
  font-size: 21rpx;
  letter-spacing: .1em;
  color: var(--acc);
}
.jian-question-text {
  flex: 1;
  min-width: 0;
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .05em;
  color: var(--ink);
}
.jian-question-arrow { width: 27rpx; height: 19rpx; flex-shrink: 0; }

/* 未开启晨笺：顶部引导入口 */
.jian-open {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 2rpx dashed var(--line-mid);
  border-radius: 10rpx;
  padding: 19rpx 24rpx;
  background: var(--tag-bg);
}
.jian-open-active { background: var(--acc-soft); }
.jian-open-text {
  flex: 1;
  min-width: 0;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .08em;
  color: var(--ink-mid);
}
.jian-open-cta {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .14em;
  color: var(--acc);
}

/* ═══ 双人合盘入口卡（第二入口：朱砂「缘」印章 + 标题 + 副文案 + brush-arrow） ═══ */
.yuan-entry {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 15rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--acc-line);
  border-radius: 10rpx;
  padding: 19rpx 24rpx;
  box-shadow: 0 6rpx 19rpx var(--shadow-sm);
  margin-top: 19rpx;
}
.yuan-entry-active { background: var(--acc-soft); }
.yuan-seal { width: 52rpx; height: 52rpx; font-size: 30rpx; border-radius: 6rpx; }
.yuan-entry-mid { flex: 1; min-width: 0; }
.yuan-entry-title {
  font-family: var(--font-kai);
  font-size: 27rpx;
  letter-spacing: .1em;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.yuan-entry-sub {
  margin-top: 6rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .08em;
  color: var(--ink-soft);
}
.yuan-entry-arrow { width: 27rpx; height: 19rpx; flex-shrink: 0; }

/* ═══ Task 8 · 深夜入口横幅（方案·灯下漫谈）：夜色宣纸卡底 + 灯笼暖光 + 朱砂描边 ═══ */
.night-banner {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 21rpx;
  padding: 20rpx 24rpx;
  background: #FBF4E1;                    /* 夜色笺卡底（暖纸 #F4EBD6 系加深一层） */
  border: 2rpx solid var(--acc);          /* 朱砂描边 */
  border-radius: 10rpx;
  box-shadow: 0 4rpx 15rpx rgba(58,44,30,.08);
  margin-bottom: 25rpx;
  box-sizing: border-box;
}
.night-banner-active { background: #F7EBD0; transform: translateY(2rpx) scale(.985); }
.nb-lantern {
  flex-shrink: 0;
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 50%, #F6C98A 0%, #E8A34B 62%, #C98F3D 100%);
  border-radius: 50%;
  box-shadow: 0 0 16rpx rgba(232,163,75,.55), inset 0 0 0 3rpx rgba(251,240,214,.65); /* 灯笼暖光圆点 */
}
.nb-lantern-char {
  font-family: var(--font-brush);
  font-size: 34rpx;
  color: #6B4308;
}
.nb-mid { flex: 1; min-width: 0; }
.nb-title {
  font-family: var(--font-kai);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: .1em;
  color: var(--ink);
}
.nb-sub {
  margin-top: 5rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .1em;
  color: var(--ink-soft);
}
.nb-go {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .14em;
  color: #FFF8EC;
  background: var(--acc);
  border-radius: 7rpx;
  padding: 12rpx 18rpx;
}
