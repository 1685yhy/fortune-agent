/* ═══ 屏 1 · 今日 — 笺谱封面（对齐 dir_b.html v7 TodayScreen，px×1.923→rpx） ═══ */

/* 真机修复：保持 .screen 的 fixed 定位（此前 absolute 会让容器跟随内容伸展，真机上页面可横向滑动） */
.today-wrap { position: fixed; inset: 0; display: flex; flex-direction: column; }

/* ── 日期副题行（原型 .today-date：干支小字 + ◆ + 掌灯中；弱化，可点 → 今日详解页） ── */
.today-date {
  flex-shrink: 0;
  z-index: 25;
  padding-top: calc(var(--top-pad, 88px) + 10px);  /* 11px 原型间距 + 安全区（状态栏+胶囊避让） */
  text-align: center;
  font-family: var(--font-song);
  font-size: 24rpx;                       /* 12.5px */
  letter-spacing: .28em;
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19rpx;                             /* 10px */
}
.today-date .zd {
  width: 10rpx;                           /* 5px */
  height: 10rpx;
  transform: rotate(45deg);
  background: var(--acc);
  border-radius: 2rpx;                    /* 1px */
}
.today-date-active { opacity: .72; }

/* ── 主滚动列（原型 .today-scroll：上下滚动流，大量留白，内容居中） ──
   top 含安全区：从日期行（安全区 + 约 56rpx 行高）下方开始滚动，
   hero 灯笼顶部不被胶囊/日期行遮挡 */
.today-col {
  position: absolute;
  left: 0; right: 0; top: calc(var(--top-pad, 88px) + 56rpx); bottom: 0;
  padding: 15rpx 42rpx 190rpx;            /* 8px 22px 98px（底部给 tabbar 让位） */
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;
}

/* ═══ 标题区（原型 .today-hero：小灯笼 + 诗行 + 宜忌 chips） ═══ */
.today-hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 4rpx;                      /* 2px */
}

/* 水墨灯笼：原型 InkLantern h=118px w≈73px（260×419rpx 大灯笼 → 140×227rpx 小灯笼） */
.lantern-box { position: relative; width: 140rpx; height: 227rpx; }
.lantern-body {
  position: absolute; inset: 0;
  width: 140rpx; height: 227rpx;
}
.lantern-glow {
  position: absolute; left: 0; top: 0;
  width: 140rpx; height: 227rpx;
  pointer-events: none;
  animation: lanternPulse 3.6s ease-in-out infinite;
}
.lantern-glow-delay { animation-delay: 1.2s; }
@keyframes lanternPulse {
  0%, 100% { opacity: .55; }
  50% { opacity: 1; }
}

/* 诗行（原型 .poem-line：25px 楷体居中；签文拆两行 + 朱砂点） */
.poem-block { margin-top: -6rpx; display: flex; flex-direction: column; align-items: center; }
.poem-line {
  font-family: var(--poem);
  font-weight: 400;
  font-size: 48rpx;                       /* 25px */
  line-height: 1.9;
  letter-spacing: .14em;
  color: var(--ink);
  text-align: center;
}
.poem-line .jk {
  color: var(--acc);
  font-size: 29rpx;                       /* 15px */
  vertical-align: super;
  letter-spacing: 0;
}

/* 宜忌 chips（原型 .yi-chips > .inktag：浅墨小标签，可点 → 今日详解页） */
.yi-chips { display: flex; gap: 19rpx; margin-top: 8rpx; }   /* 10px 4px */
.yi-chip {
  font-size: 23rpx;                       /* 12px */
  padding: 8rpx 23rpx;                    /* 4px 12px */
  letter-spacing: .16em;
}
.yi-chips-active { opacity: .72; }

/* ═══ 深夜入口横幅（原型 .night-banner：纸卡底 + 金灯 + 灯下见） ═══ */
.night-banner {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 21rpx;                             /* 11px */
  margin-top: 34rpx;                      /* 18px */
  padding: 25rpx 27rpx;                   /* 13px 14px */
  background: var(--paper-card);
  border: 2rpx solid var(--line);         /* 1px */
  border-radius: 12rpx;                   /* 6px */
  box-shadow: 0 8rpx 23rpx var(--shadow-sm); /* 0 4px 12px rgba(58,44,30,.06) */
}
.night-banner-active { background: var(--acc-soft); }
.nb-lantern {
  flex-shrink: 0;
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 50%, #F6C98A 0%, #E8A34B 62%, #C98F3D 100%);
  border-radius: 50%;
  box-shadow: 0 0 16rpx rgba(232,163,75,.55), inset 0 0 0 3rpx rgba(251,240,214,.65); /* 灯笼暖光圆点 */
}
.nb-lantern-char {
  font-family: var(--font-brush);
  font-size: 34rpx;
  color: #6B4308;
}
.nb-mid { flex: 1; min-width: 0; }
.nb-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 28rpx;                       /* 14.5px */
  letter-spacing: .12em;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 13rpx;                             /* 7px */
}
.nb-title::before {
  content: '';
  width: 12rpx;                           /* 6px */
  height: 12rpx;
  border-radius: 50%;
  background: var(--acc);
  box-shadow: 0 0 15rpx rgba(169,58,44,.55);
  flex-shrink: 0;
}
.nb-sub {
  margin-top: 6rpx;                       /* 3px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .08em;
  color: var(--ink-soft);
}
.nb-go {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;                             /* 5px */
  font-family: var(--font-song);
  font-size: 24rpx;                       /* 12.5px */
  letter-spacing: .12em;
  color: var(--acc);
  border: 2rpx solid var(--acc-line);     /* rgba(169,58,44,.4) */
  border-radius: 12rpx;                   /* 6px */
  padding: 17rpx 25rpx;                   /* 9px 13px */
  background: var(--acc-soft);
  min-height: 85rpx;                      /* 44px */
}

/* ═══ 晨笺卡（原型 .jian-card：纸卡 + 红金顶条；开启态） ═══ */
.jian-card {
  position: relative;
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--paper-card);
  border: 2rpx solid var(--line);         /* 1px */
  border-radius: 12rpx;                   /* 6px */
  box-shadow: 0 10rpx 31rpx rgba(58,44,30,.07); /* 0 5px 16px */
  overflow: hidden;
  margin-top: 34rpx;                      /* 18px */
}
/* 顶部红金渐变条（原型 .jian-card::before） */
.jian-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6rpx;                           /* 3px */
  background: linear-gradient(90deg, var(--acc), var(--gold));
}

/* 头：印章「晨」+ 标题「今日晨笺」+ 干支副题 + 收藏钮（原型 .jc-head） */
.jian-head { display: flex; align-items: center; gap: 19rpx; padding: 29rpx 31rpx 0; }  /* 15px 16px */
.jian-seal { width: 52rpx; height: 52rpx; font-size: 30rpx; border-radius: 6rpx; }      /* 28px Seal */
.jian-head-txt { flex: 1; min-width: 0; }
.jian-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 29rpx;                       /* 15px */
  letter-spacing: .14em;
  color: var(--ink);
}
.jian-date {
  margin-top: 4rpx;                       /* 2px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .12em;
  color: var(--ink-soft);
}
.jian-fav {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .12em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);         /* 1px */
  border-radius: 12rpx;                   /* 6px */
  padding: 18rpx 24rpx;                   /* UX批1 M-10：竖向内边距 15→18rpx，热区稳超 72rpx */
  background: var(--paper-card);
  min-height: 73rpx;                      /* 38px */
  display: flex;
  align-items: center;
}
.jian-fav-on { color: var(--acc); border-color: var(--acc-line); background: var(--acc-soft); }
.jian-fav-active { opacity: .72; }

/* 宜忌两行（原型 .jc-chips：chip-yi 朱砂胶囊 / chip-ji 淡墨虚线胶囊） */
.jian-yi { margin-top: 25rpx; padding: 0 31rpx; display: flex; flex-direction: column; gap: 17rpx; }  /* 13px 16px 9px */
.jian-yi-row { display: flex; align-items: flex-start; gap: 15rpx; }
.jian-yi-label {
  flex-shrink: 0;
  font-family: var(--font-brush);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .18em;
  color: var(--acc);
  line-height: 1.6;
  margin-top: 3rpx;
}
.jian-yi-label-ji { color: var(--ink-soft); }
.jian-yi-tags { display: flex; flex-wrap: wrap; gap: 13rpx; }   /* 7px */
.jian-yi-chip {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .1em;
  color: var(--acc);
  border: 2rpx solid rgba(169,58,44,.4);
  background: var(--acc-soft);
  border-radius: 999rpx;
  padding: 10rpx 25rpx;                   /* 5px 13px */
}
.jian-yi-chip-ji {
  color: var(--ink-faint);
  border: 2rpx dashed rgba(58,44,30,.38);
  background: transparent;
}
.jian-yi-empty {
  font-size: 23rpx;
  padding: 10rpx 25rpx;
  color: var(--ink-faint);
  border: 2rpx dashed rgba(58,44,30,.38);
  border-radius: 999rpx;
}

/* 金句（原型 .jc-quote：浅纸底小框 + 展开/收起） */
.jian-quote {
  margin: 25rpx 31rpx 0;                  /* 13px 16px */
  background: var(--paper);
  border: 2rpx solid var(--line-soft);    /* 1px */
  border-radius: 12rpx;                   /* 6px */
  padding: 21rpx 25rpx 17rpx;             /* 11px 13px 9px */
}
.jian-quote-row { display: flex; align-items: center; gap: 10rpx; }
/* UX批1 M-9：金句展开/收起按压反馈 */
.jian-quote-active { background: var(--paper-deep); border-color: var(--line); }
.jian-quote-text {
  flex: 1;
  min-width: 0;
  font-family: var(--poem);
  font-size: 28rpx;                       /* 14.5px */
  letter-spacing: .03em;
  color: var(--ink);
  line-height: 1.85;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.jian-quote-text-open { white-space: normal; }
.jian-quote-more {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .1em;
  color: var(--acc);
}
.jian-quote-book {
  margin-top: 10rpx;                      /* 5px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .08em;
  color: var(--ink-soft);
  text-align: right;
}

/* 轻私语（原型 .jc-whisper：上虚线分隔 + 朱砂毛笔标签） */
.jian-private {
  margin: 23rpx 31rpx 0;                  /* 12px 16px */
  display: flex;
  align-items: flex-start;
  gap: 15rpx;                             /* 8px */
  border-top: 2rpx dashed rgba(58,44,30,.38);
  padding-top: 21rpx;                     /* 11px */
}
.jian-private-label {
  flex-shrink: 0;
  font-family: var(--font-brush);
  font-size: 23rpx;                       /* 12px */
  color: var(--acc);
  letter-spacing: .18em;
  margin-top: 2rpx;
  font-weight: 400;
}
.jian-private > text:last-child {
  font-family: var(--font-song);
  font-size: 25rpx;                       /* 13px */
  line-height: 1.85;
  letter-spacing: .03em;
  color: var(--ink-mid);
}

/* 今日小问（原型 .jc-q：朱砂描边按钮 + 问字印章） */
.jian-question {
  margin: 23rpx 31rpx 27rpx;              /* 12px 16px 14px */
  display: flex;
  align-items: center;
  gap: 17rpx;                             /* 9px */
  border: 3rpx solid var(--acc);          /* 1.5px */
  background: var(--acc-soft);
  border-radius: 15rpx;                   /* 8px */
  padding: 21rpx 25rpx;                   /* 11px 13px */
}
.jian-question-active { opacity: .8; }
.q-seal {
  width: 42rpx;                           /* 22px */
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 6rpx;                    /* 3px */
  background: var(--acc);
  color: #FBF6E8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.q-seal-char {
  font-family: var(--font-brush);
  font-size: 25rpx;                       /* 13px */
}
.jian-question-text {
  flex: 1;
  min-width: 0;
  font-family: var(--font-song);
  font-size: 25rpx;                       /* 13px */
  letter-spacing: .04em;
  color: var(--acc-deep);
}
.jian-question-arrow { width: 27rpx; height: 19rpx; flex-shrink: 0; }

/* 卡内落款（原型 .jc-foot） */
.jian-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 17rpx 0;                       /* 9px */
  background: var(--paper-deep);
  border-top: 2rpx solid var(--line-soft); /* 1px */
  font-family: var(--font-brush);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .28em;
  color: var(--ink-faint);
  font-weight: 400;
}

/* ═══ 未开启晨笺（原型 .jian-un：虚线框 + 笺印 + 红按钮） ═══ */
.jian-open {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-top: 34rpx;                      /* 18px */
  border: 3rpx dashed rgba(58,44,30,.32); /* 1.5px */
  border-radius: 12rpx;                   /* 6px */
  padding: 25rpx 29rpx;                   /* 13px 15px */
  display: flex;
  align-items: center;
  gap: 23rpx;                             /* 12px */
  background: rgba(251,247,236,.4);
}
.jian-open-active { background: var(--acc-soft); }
.jian-open-seal { width: 65rpx; height: 65rpx; font-size: 38rpx; border-radius: 6rpx; transform: rotate(-2deg); }  /* 34px Seal rot-2 */
.jian-open-mid { flex: 1; min-width: 0; }
.jian-open-t {
  font-family: var(--font-song);
  font-size: 25rpx;                       /* 13px */
  color: var(--ink);
  letter-spacing: .05em;
}
.jian-open-s {
  margin-top: 6rpx;                       /* 3px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .08em;
  color: var(--ink-faint);
}
.jian-open-cta {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 24rpx;                       /* 12.5px */
  letter-spacing: .16em;
  color: #FBF6E8;
  background: var(--acc);
  border-radius: 12rpx;                   /* 6px */
  padding: 19rpx 31rpx;                   /* 10px 16px */
  min-height: 85rpx;                      /* 44px */
  display: flex;
  align-items: center;
}

/* ═══ 今日流日（原型 .day-flow：无整卡背景；四运浅块 + 解释 + 逐条详解 + 时辰） ═══ */
.day-flow {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-top: 31rpx;                      /* 16px */
}
.day-flow-active { opacity: .85; }
.df-head {
  display: flex;
  align-items: center;
  gap: 19rpx;                             /* 10px */
  margin-bottom: 19rpx;                   /* 10px */
}
.df-title {
  font-family: var(--font-brush);
  font-size: 27rpx;                       /* 14px */
  letter-spacing: .26em;
  color: var(--ink);
  font-weight: 400;
}
.df-tag {
  margin-left: auto;
  font-family: var(--font-song);
  font-size: 21rpx;                       /* 11px */
  letter-spacing: .1em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);         /* 1px */
  border-radius: 6rpx;                    /* 3px */
  padding: 4rpx 15rpx;                    /* 2px 8px */
  font-weight: 400;
}

/* 四运浅块（原型 .four-yun > .yun-block） */
.four-yun { display: flex; gap: 17rpx; }  /* 9px */
.yun-block {
  flex: 1;
  background: var(--paper-card);
  border: 2rpx solid var(--line);         /* 1px */
  border-radius: 12rpx;                   /* 6px */
  padding: 19rpx 8rpx 17rpx;              /* 10px 4px 9px */
  text-align: center;
}
.yb-label {
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .12em;
  color: var(--ink-soft);
}
.yb-num {
  margin-top: 10rpx;                      /* 5px */
  font-family: var(--font-lat);
  font-style: italic;
  font-size: 42rpx;                       /* 22px */
  color: var(--ink);
  line-height: 1;
}

/* 解释文本（原型 .df-line：楷体 · 朱砂加粗词） */
.df-line {
  margin-top: 23rpx;                      /* 12px */
  font-family: var(--poem);
  font-size: 26rpx;                       /* 13.5px */
  line-height: 1.95;
  letter-spacing: .03em;
  color: var(--ink-mid);
}

/* UX批1 M-11：四运/时辰均无数据时的占位文案（不再渲染空壳） */
.df-empty {
  margin-top: 23rpx;
  padding: 27rpx 0;
  text-align: center;
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .14em;
  color: var(--ink-faint);
  border: 2rpx dashed var(--line-soft);
  border-radius: 12rpx;
}

/* 逐条详解入口（原型 .df-more） */
.df-more {
  margin-top: 19rpx;                      /* 10px */
  display: inline-flex;
  align-items: center;
  gap: 10rpx;                             /* 6px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .1em;
  color: var(--acc);
}
.df-arrow { width: 25rpx; height: 17rpx; }

/* 时辰胶囊（原型 .shichen-row > .sc-chip） */
.shichen-row {
  margin-top: 19rpx;                      /* 10px */
  display: flex;
  align-items: center;
  gap: 13rpx;                             /* 7px */
  overflow-x: auto;
  padding-bottom: 2rpx;
}
.shichen-chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;                             /* 6px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .08em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);         /* 1px */
  border-radius: 999rpx;
  padding: 12rpx 23rpx;                   /* 6px 12px */
  background: var(--paper-card);
}
.shichen-chip-cur { border-color: var(--acc); color: var(--acc); background: var(--acc-soft); }
.sc-time {
  font-family: var(--font-song);
  font-size: 22rpx;                       /* 11.5px */
  letter-spacing: .06em;
  color: var(--ink-faint);
}
.shichen-chip-cur .sc-time { color: var(--acc); }
.sc-tag {
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .1em;
  color: var(--acc);
}
.shichen-chip-cur .sc-tag { color: var(--acc); }

/* ═══ 收尾：想聊聊？+ 随手截屏（低调，不与主区抢节奏） ═══ */
.talk-col {
  width: 100%;
  margin-top: 42rpx;                      /* 22px */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25rpx;                             /* 13px */
}
.talk-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19rpx;                             /* 10px */
  font-family: var(--font-song);
  font-size: 25rpx;                       /* 13px */
  letter-spacing: .22em;
  color: var(--ink-mid);
}
.talk-btn .brush-arrow { width: 29rpx; height: 20rpx; }
.talk-btn-active { color: var(--acc); }
.brush-arrow { width: 33rpx; height: 23rpx; }  /* 17×12 */

/* v2026-08-17：随手截屏入口（shot-hint/shot-ic/shot-hint-active）样式已删
   （wxml 与 js onShot 同步移除；ink-card-canvas 画布保留——ming 页仍在用） */

/* ── 脚注（原型 .today-foot：明灯谨录 · 观命不执命） ── */
.today-foot {
  margin-top: 35rpx;                      /* 18px */
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;                             /* 7px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .2em;
  color: var(--ink-faint);
  padding-bottom: 8rpx;                   /* 4px */
}
.today-foot .fg {
  width: 10rpx;                           /* 5px */
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
}

/* 隐藏的分享卡画布（off-screen） */
.ink-card-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750px;
  height: 1200px;
}

/* ── 未设置命主信息提示条（通用运势时出现；墨韵虚线卡 + 朱砂去设置按钮，与晨笺未开启同款） ── */
.arch-hint {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-top: 34rpx;                      /* 18px */
  border: 3rpx dashed rgba(58,44,30,.32); /* 1.5px */
  border-radius: 12rpx;                   /* 6px */
  padding: 25rpx 29rpx;                   /* 13px 15px */
  display: flex;
  align-items: center;
  gap: 23rpx;                             /* 12px */
  background: rgba(251,247,236,.4);
}
.arch-hint-active { background: var(--acc-soft); }
.arch-hint-seal { width: 65rpx; height: 65rpx; font-size: 38rpx; border-radius: 6rpx; transform: rotate(-2deg); }
.arch-hint-mid { flex: 1; min-width: 0; }
.arch-hint-t {
  font-family: var(--font-song);
  font-size: 25rpx;                       /* 13px */
  color: var(--ink);
  letter-spacing: .05em;
}
.arch-hint-s {
  margin-top: 6rpx;                       /* 3px */
  font-family: var(--font-song);
  font-size: 23rpx;                       /* 12px */
  letter-spacing: .08em;
  color: var(--ink-faint);
}
.arch-hint-cta {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 24rpx;                       /* 12.5px */
  letter-spacing: .16em;
  color: #FBF6E8;
  background: var(--acc);
  border-radius: 12rpx;                   /* 6px */
  padding: 19rpx 31rpx;                   /* 10px 16px */
  min-height: 85rpx;                      /* 44px */
  display: flex;
  align-items: center;
}

/* ═══ E1 未建档提示条（本地无档案 → 显示；× 关闭；点击跳排盘）
     样式跟随 arch-hint/夜间横幅：宣纸卡底 + 墨色变量（设计系统 token，暗色随动） ═══ */
.noarch-tip {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-top: 34rpx;                      /* 18px */
  border: 2rpx solid var(--line);         /* 1px */
  border-radius: 12rpx;                   /* 6px */
  padding: 23rpx 24rpx;                   /* 12px */
  display: flex;
  align-items: center;
  gap: 21rpx;                             /* 11px */
  background: var(--paper-card);
  box-shadow: 0 8rpx 23rpx var(--shadow-sm);
}
.noarch-tip-active { background: var(--acc-soft); }
.noarch-tip-seal {
  width: 62rpx;
  height: 62rpx;
  font-size: 36rpx;
  border-radius: 6rpx;
  transform: rotate(-2deg);
}
.noarch-tip-mid { flex: 1; min-width: 0; }
.noarch-tip-t {
  font-family: var(--font-song);
  font-size: 25rpx;                       /* 13px */
  color: var(--ink);
  letter-spacing: .05em;
  line-height: 1.5;
}
.noarch-tip-s {
  margin-top: 6rpx;                       /* 3px */
  font-family: var(--font-song);
  font-size: 22rpx;                       /* 11.5px */
  letter-spacing: .08em;
  color: var(--ink-faint);
}
.noarch-tip-arrow {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 30rpx;
  color: var(--acc);
  padding: 0 4rpx;
}
.noarch-tip-close {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 30rpx;
  color: var(--ink-faint);
  border-radius: 50%;
}
.noarch-tip-close-active { color: var(--acc); background: var(--acc-soft); }
