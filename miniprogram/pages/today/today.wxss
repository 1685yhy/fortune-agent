/* 易理明灯 — 今日运势样式 */

/* ---- 页面容器 ---- */
.page {
  min-height: 100vh;
  background: var(--gradient-primary);
  opacity: 0;
  transition: opacity 0.4s ease-out;
}
.page.animated {
  opacity: 1;
}

/* ---- Hero Section -- Pure CSS Score Card ---- */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
}

.score-card {
  width: 100%;
  background: linear-gradient(135deg, rgba(30,41,59,0.9) 0%, rgba(15,23,42,0.95) 100%);
  border: 1px solid rgba(212,168,67,0.15);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-ring-bg {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: conic-gradient(var(--gold) calc(var(--score-pct) * 1%), transparent 0);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 20rpx;
}
.score-ring-bg::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  background: #0F172A;
}

.score-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.score-number {
  font-size: 64rpx;
  font-weight: 200;
  color: #fff;
  line-height: 1;
}
.score-unit {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}

.score-level {
  text-align: center;
  margin-bottom: 28rpx;
}
.level-text {
  font-size: 36rpx;
  font-weight: 600;
}
.score-level.excellent .level-text { color: #D4A843; }
.score-level.good .level-text { color: #5B8C5A; }
.score-level.fair .level-text { color: #C2852A; }
.score-level.poor .level-text { color: #C2413D; }
.level-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 6rpx;
}

.score-factors {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.factor {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.factor-name {
  width: 100rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: right;
  flex-shrink: 0;
}
.factor-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--gold);
  flex: 1;
  transition: width 0.8s ease-out;
}
.factor-score {
  width: 48rpx;
  font-size: 24rpx;
  color: var(--color-text);
  text-align: right;
  flex-shrink: 0;
}

.hero-date {
  text-align: center;
  margin-top: 32rpx;
}
.hero-date-lunar {
  font-size: 32rpx;
  color: var(--color-text);
  display: block;
}
.hero-date-ganzhi {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}
.hero-jieqi {
  font-size: 22rpx;
  color: var(--gold);
  margin-top: 4rpx;
}

/* ---- Section 通用 ---- */
.section {
  padding: var(--space-xl) var(--space-lg);
  opacity: 0;
  transform: translateY(16px);
}
.page.animated .section {
  animation: fadeUp 0.6s ease-out forwards;
}
.page.animated .section:nth-child(2) { animation-delay: 0.5s; }
.page.animated .section:nth-child(3) { animation-delay: 0.58s; }
.page.animated .section:nth-child(4) { animation-delay: 0.66s; }
.page.animated .section:nth-child(5) { animation-delay: 0.74s; }
.page.animated .section:nth-child(6) { animation-delay: 0.82s; }

.section-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}
.section-title {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--color-text-tertiary);
  letter-spacing: 0.06em;
}
.section-hint {
  font-size: 11px;
  color: var(--color-text-tertiary);
  opacity: 0.6;
}

/* ---- 时辰时间线 ---- */
.hour-scroll {
  width: 100%;
  white-space: nowrap;
}
.hour-track {
  display: flex;
  flex-direction: row;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}
.hour-item {
  flex-shrink: 0;
  width: 56px;
  padding: var(--space-sm);
  border-radius: var(--radius-md);
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all var(--transition-fast);
}
.hour-item.active {
  background: rgba(255,255,255,0.04);
}
.hour-name {
  font-size: var(--font-sm);
  color: var(--color-text);
  font-weight: 500;
}
.hour-time {
  font-size: var(--font-xs);
  color: var(--stone);
  margin-top: 2px;
}
.hour-mark {
  font-size: var(--font-xs);
  margin-top: 4px;
  padding: 1px 6px;
  border-radius: var(--radius-full);
}
.hour-mark.good { color: var(--jade); background: rgba(91,140,90,0.15); }
.hour-mark.fair { color: var(--warning); background: rgba(194,133,42,0.15); }
.hour-mark.poor { color: var(--cinnabar); background: rgba(194,65,61,0.15); }

/* ---- 时辰评分数值 ---- */
.hour-score {
  font-size: 10px;
  color: var(--color-text-tertiary);
  margin-top: 2px;
  font-weight: 500;
}

/* ---- 最佳/最差时辰高亮 ---- */
.hour-best {
  background: rgba(91,140,90,0.12);
  border: 1px solid rgba(91,140,90,0.3);
  border-radius: var(--radius-md);
}
.hour-best .hour-name {
  color: var(--jade);
  font-weight: 600;
}
.hour-worst {
  background: rgba(194,65,61,0.08);
  border: 1px solid rgba(194,65,61,0.2);
  border-radius: var(--radius-md);
}
.hour-worst .hour-name {
  color: var(--cinnabar);
}
.hour-worst .hour-mark.poor {
  color: #fff;
  background: var(--cinnabar);
}

.hour-detail {
  margin-top: var(--space-md);
  padding: var(--space-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
}
.hour-detail-ganzhi {
  font-size: var(--font-md);
  color: var(--gold);
  font-weight: 500;
}
.hour-detail-advice {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: var(--space-xs);
  line-height: 1.5;
}

/* ---- 幸运三连 ---- */
.lucky-row {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
}
.lucky-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-lg) var(--space-sm);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
}
.lucky-icon {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-sm);
}
.lucky-icon-text {
  font-size: var(--font-2xl);
  margin-bottom: var(--space-sm);
}
.lucky-label {
  font-size: var(--font-xs);
  color: var(--stone);
}
.lucky-value {
  font-size: var(--font-md);
  color: var(--color-text);
  font-weight: 500;
  margin-top: var(--space-xs);
  text-align: center;
}

/* ---- 宜忌 ---- */
.yi-ji-row {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
}
.yi-ji-col {
  flex: 1;
  padding: var(--space-lg) var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
}
.yi-ji-title {
  font-size: var(--font-md);
  font-weight: 500;
  margin-bottom: var(--space-sm);
  display: block;
}
.yi-title { color: var(--jade); }
.ji-title { color: var(--cinnabar); }
.yi-ji-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: var(--space-xs) 0;
}
.yi-ji-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}
.yi-ji-time {
  font-size: var(--font-xs);
  color: var(--stone);
}

/* ---- 本周预览 ---- */
.week-canvas {
  width: 100%;
  height: 120px;
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
}

/* ---- 心情记录 ---- */
.mood-row {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
  justify-content: center;
}
.mood-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  min-width: 72px;
  min-height: 72px;
  transition: all var(--transition-fast);
}
.mood-btn:active {
  transform: scale(0.94);
  background: rgba(255,255,255,0.05);
}
.mood-btn.active {
  background: rgba(255,255,255,0.06);
}
.mood-emoji {
  font-size: var(--font-2xl);
}
.mood-label {
  font-size: var(--font-xs);
  color: var(--stone);
  margin-top: var(--space-xs);
}
.mood-feedback {
  margin-top: var(--space-md);
  text-align: center;
}
.mood-feedback-text {
  font-size: var(--font-sm);
  color: var(--jade);
}

/* ---- 底部留白 ---- */
.section-bottom-space {
  height: var(--space-3xl);
}

/* ---- 动画 ---- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}
