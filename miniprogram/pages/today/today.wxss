/* 今日 — 运势卡片页样式 */

.page-today {
  min-height: 100vh;
  padding-bottom: 20px;
  background: var(--gradient-warm);
}

/* 头部 */
.header {
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-sm);
  text-align: center;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xs);
}

.header-date {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1px;
}

.header-ganzhi {
  display: inline-flex;
}

.ganzhi-badge {
  display: inline-block;
  padding: 2px 10px;
  background: linear-gradient(135deg, #c9a96e, #d4b87a);
  color: #1a1a2e;
  font-size: var(--font-xs);
  font-weight: 700;
  border-radius: var(--radius-full);
  letter-spacing: 1px;
}

.header-subtitle {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  margin-top: 2px;
}

/* 运势卡片包裹 */
.fortune-card-wrapper {
  padding: var(--spacing-md);
}

.fortune-swiper {
  height: 480px;
}

.fortune-card {
  background: var(--gradient-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl) var(--spacing-lg);
  color: #fff;
  position: relative;
  overflow: hidden;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 卡片装饰光晕 */
.fortune-card::before {
  content: '';
  position: absolute;
  top: -60px;
  right: -60px;
  width: 180px;
  height: 180px;
  background: radial-gradient(circle, rgba(201,169,110,0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.fortune-card::after {
  content: '';
  position: absolute;
  bottom: -40px;
  left: -40px;
  width: 120px;
  height: 120px;
  background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 运势分数环 */
.score-ring {
  width: 100px;
  height: 100px;
  position: relative;
  margin-bottom: var(--spacing-sm);
}

.score-ring-inner {
  position: absolute;
  top: 10px;
  left: 10px;
  right: 10px;
  bottom: 10px;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
  backdrop-filter: blur(4px);
}

.score-number {
  font-size: var(--font-3xl);
  font-weight: 800;
  color: #fff;
  line-height: 1;
  letter-spacing: -1px;
}

.score-label {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.6);
  margin-top: 2px;
}

.score-ring-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  z-index: 1;
}

/* 运势等级 */
.score-level {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: var(--spacing-lg);
}

.level-icon {
  font-size: 20px;
}

.level-text {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-accent-light);
}

/* 宜忌区域 */
.yi-ji-section {
  display: flex;
  gap: var(--spacing-lg);
  width: 100%;
  margin-bottom: var(--spacing-md);
}

.yi-column, .ji-column {
  flex: 1;
}

.yi-ji-title {
  font-size: var(--font-sm);
  font-weight: 700;
  margin-bottom: var(--spacing-sm);
  display: block;
}

.yi-title { color: #4caf50; }
.ji-title { color: #e74c3c; }

.yi-ji-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.yi-ji-item:last-child {
  border-bottom: none;
}

.yi-ji-action {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.9);
}

.yi-ji-time {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.5);
}

/* 分隔线 */
.card-divider {
  width: 60%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(201,169,110,0.4), transparent);
  margin: var(--spacing-md) 0;
}

/* 建议区域 */
.advice-section {
  width: 100%;
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

.advice-label {
  font-size: var(--font-xs);
  color: var(--color-accent);
  opacity: 0.8;
  display: block;
  margin-bottom: var(--spacing-xs);
}

.advice-text {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
  display: block;
}

/* 心情提示 */
.mood-section {
  margin-top: auto;
  padding-top: var(--spacing-sm);
}

.mood-text {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.6);
}

/* 滑动指示 */
.swipe-hint {
  text-align: center;
  margin-top: var(--spacing-sm);
}

.swipe-hint-text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* 占位卡片 */
.card-placeholder {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  color: var(--color-text-tertiary);
  border: 2px dashed var(--color-border);
}

/* 未设置八字状态 */
.no-bazi {
  padding: var(--spacing-xl);
}

/* 暗色模式适配 */
@media (prefers-color-scheme: dark) {
  .page-today {
    background: linear-gradient(135deg, #12121a 0%, #1a1a2e 100%);
  }

  .card-placeholder {
    background: var(--color-bg-card);
  }
}
