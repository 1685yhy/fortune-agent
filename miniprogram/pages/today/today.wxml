<view class="screen today-wrap" style="--nav-off:{{navOff}}px">
  <view class="today-frame"></view>
  <view class="today-brand">易理明灯</view>
  <!-- 流日行（原型可点 → 今日详解页） -->
  <view class="today-date" hover-class="today-date-active" hover-stay-time="0" bindtap="goTodayDetail">
    <text>{{dateText}}</text>
    <view class="zd"></view>
    <text>{{solarHint}}</text>
  </view>

  <view class="today-col">
    <!-- 深夜入口横幅(21:00 后出现,白天不出现) -->
    <view wx:if="{{night.mode}}" class="night-banner lamp-fade" hover-class="night-banner-active" hover-stay-time="0" bindtap="onNightEntry">
      <view class="nb-lantern"><text class="nb-lantern-char">灯</text></view>
      <view class="nb-mid">
        <view class="nb-title">灯下漫谈 · 夜深了,灯还亮着</view>
        <view class="nb-sub">今夜说的话,天亮就忘。进来坐坐。</view>
      </view>
      <view class="nb-go">进去坐坐</view>
    </view>

    <!-- 晨笺卡（已开启 + 数据就绪；接口失败/未开启均静默） -->
    <view class="jian-card" wx:if="{{jian.show}}">
      <view class="jian-head">
        <view class="seal jian-seal"><text class="seal-char">晨</text></view>
        <view class="jian-title">{{jian.ganzhiDate}}</view>
        <view class="jian-fav {{jian.saved ? 'jian-fav-on' : ''}}" hover-class="jian-fav-active" hover-stay-time="0" bindtap="onJianFav">{{jian.saved ? '已收藏' : '收藏'}}</view>
      </view>

      <!-- 宜忌两行 -->
      <view class="jian-yi">
        <view class="jian-yi-row">
          <text class="jian-yi-label">宜</text>
          <view class="jian-yi-tags">
            <view class="inktag jian-yi-chip" wx:for="{{jian.yi}}" wx:key="*this">{{item}}</view>
            <view wx:if="{{!jian.yi.length}}" class="jian-yi-chip jian-yi-empty">无</view>
          </view>
        </view>
        <view class="jian-yi-row">
          <text class="jian-yi-label jian-yi-label-ji">忌</text>
          <view class="jian-yi-tags">
            <view class="inktag jian-yi-chip jian-yi-chip-ji" wx:for="{{jian.ji}}" wx:key="*this">{{item}}</view>
            <view wx:if="{{!jian.ji.length}}" class="jian-yi-chip jian-yi-empty">无</view>
          </view>
        </view>
      </view>

      <!-- 金句：收起一行 / 展开（书名 + 原文） -->
      <view class="jian-quote" wx:if="{{jian.quote}}" bindtap="onQuoteTap">
        <view class="jian-quote-row">
          <text class="jian-quote-text {{jian.expanded ? 'jian-quote-text-open' : ''}}">「{{jian.quote}}」</text>
          <text class="jian-quote-more">{{jian.expanded ? '收起' : '展开'}}</text>
        </view>
        <view class="jian-quote-book" wx:if="{{jian.expanded}}">
          <text wx:if="{{jian.book}}">——《{{jian.book}}》</text>
          <text wx:else>——明灯拟 · 古籍原句</text>
        </view>
      </view>

      <!-- 轻私语 -->
      <view class="jian-private" wx:if="{{jian.privateLine}}">
        <text class="jian-private-label">轻私语</text>
        <text>{{jian.privateLine}}</text>
      </view>

      <!-- 今日小问 → 对话页 -->
      <view class="jian-question" hover-class="jian-question-active" hover-stay-time="0" bindtap="onQuestionTap">
        <text class="jian-question-label">今日小问</text>
        <text class="jian-question-text">{{jian.question}}</text>
        <image class="brush-arrow jian-question-arrow" src="/assets/images/brush-arrow.png"></image>
      </view>
    </view>

    <!-- 未开启晨笺：顶部入口 → 开启引导页 -->
    <view class="jian-open" wx:if="{{jian.notEnabled}}" hover-class="jian-open-active" hover-stay-time="0" bindtap="onOpenJian">
      <text class="jian-open-text">开启每日晨笺 · 宜忌/金句/轻私语</text>
      <text class="jian-open-cta">去开启</text>
    </view>

    <!-- 流日四运卡（原型：事业/财运/感情/健康 4 行 + 分数；点开 → 今日详解页） -->
    <view class="four-card" wx:if="{{fortune4.length}}" hover-class="four-card-active" hover-stay-time="0" bindtap="goTodayDetail">
      <view class="four-head">
        <text class="four-title">流日四运</text>
        <view class="four-go">
          <text class="four-go-text">详解</text>
          <image class="brush-arrow four-arrow" src="/assets/images/brush-arrow.png"></image>
        </view>
      </view>
      <view class="four-row" wx:for="{{fortune4}}" wx:key="key">
        <text class="four-label">{{item.label}}</text>
        <view class="four-bar"><view class="four-bar-fill" style="width:{{item.percent}}%"></view></view>
        <text class="four-score">{{item.scoreText}}</text>
      </view>
    </view>

    <!-- 时辰择时行（原型：巳时/午时/申时 chips；点开 → 今日详解页） -->
    <view class="shichen-row" wx:if="{{shichen.length}}" hover-class="shichen-row-active" hover-stay-time="0" bindtap="goTodayDetail">
      <view class="shichen-head">
        <text class="shichen-title">时辰择时</text>
        <text class="shichen-go">详解</text>
      </view>
      <view class="shichen-chips">
        <view class="shichen-chip {{item.cur ? 'shichen-chip-cur' : ''}}" wx:for="{{shichen}}" wx:key="time">
          <text class="sc-time">{{item.time}}</text>
          <text class="sc-tag">{{item.tag}}</text>
        </view>
      </view>
    </view>

    <view class="cover-col">
    <view class="poem-block">
      <view class="lantern-box">
        <image class="lantern-glow" src="/assets/images/lantern-glow1.png"></image>
        <image class="lantern-glow lantern-glow-delay" src="/assets/images/lantern-glow2.png"></image>
        <image class="lantern-body" src="/assets/images/lantern.jpg"></image>
      </view>
      <view class="poem-lines">
        <view class="poem-line">{{poemLines[0]}}<text class="jk">·</text></view>
        <view class="poem-line">{{poemLines[1]}}</view>
      </view>
      <view class="seal-attach">
        <view class="seal seal-52"><text class="seal-char">明</text></view>
      </view>
      <!-- 宜忌区（原型可点 → 今日详解页） -->
      <view class="yi-chips" hover-class="yi-chips-active" hover-stay-time="0" bindtap="goTodayDetail">
        <view class="inktag yi-chip">{{yiChips[0]}}</view>
        <view class="inktag yi-chip">{{yiChips[1]}}</view>
        <text class="yi-chips-go">宜忌详解</text>
      </view>
      <view class="poem-note">签文只作心意，不作断言 · 明灯拟</view>
    </view>

    <view class="talk-col">
      <view class="talk-btn" hover-class="talk-btn-active" hover-stay-time="0" bindtap="goChat">
        <text>想聊聊？</text>
        <image class="brush-arrow" src="/assets/images/brush-arrow.png"></image>
      </view>
      <view class="shot-hint" hover-class="shot-hint-active" hover-stay-time="0" bindtap="onShot">
        <image class="shot-ic" src="/assets/images/ic-camera-soft.png"></image>
        <text>随手截屏 · 存为今晚的笺页</text>
      </view>
    </view>

    <view class="today-foot">
      <view class="fg"></view>
      <text>三秒内，为你掌灯</text>
      <view class="fg"></view>
    </view>
    </view>
  </view>

  <canvas type="2d" id="inkCard" class="ink-card-canvas"></canvas>

  <view class="tabbar">
    <view class="tab-item" bindtap="onTab" data-tab="chat">
      <image class="tab-ic" src="/assets/images/ic-chat.png"></image>
      <text class="tab-label">对话</text>
    </view>
    <view class="tab-item on" bindtap="onTab" data-tab="today">
      <image class="tab-ic" src="/assets/images/ic-lantern-on.png"></image>
      <text class="tab-label">今日</text>
      <view class="dot"></view>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="suance">
      <image class="tab-ic" src="/assets/images/ic-book2.png"></image>
      <text class="tab-label">测算</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="me">
      <image class="tab-ic" src="/assets/images/ic-seal.png"></image>
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
