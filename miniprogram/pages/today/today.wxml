<view class="screen today-wrap" style="--top-pad:{{topPad}}px">
  <!-- 日期副题行（弱化小字，可点 → 今日详解页；padding-top 含安全区避让微信胶囊） -->
  <view class="today-date" hover-class="today-date-active" hover-stay-time="0" bindtap="goTodayDetail">
    <text>{{dateText}}</text>
    <view class="zd"></view>
    <text>{{solarHint}}</text>
  </view>

  <view class="today-col">
    <!-- 标题区（原型 hero：小灯笼 + 诗行 + 宜忌 chips） -->
    <view class="today-hero">
      <view class="lantern-box">
        <image class="lantern-glow" src="/assets/images/lantern-glow1.png"></image>
        <image class="lantern-glow lantern-glow-delay" src="/assets/images/lantern-glow2.png"></image>
        <image class="lantern-body" src="/assets/images/lantern.jpg"></image>
      </view>
      <view class="poem-block">
        <view class="poem-line">{{poemLines[0]}}<text class="jk">·</text></view>
        <view class="poem-line">{{poemLines[1]}}</view>
      </view>
      <!-- 宜忌区（原型可点 → 今日详解页） -->
      <view class="yi-chips" hover-class="yi-chips-active" hover-stay-time="0" bindtap="goTodayDetail">
        <view class="inktag yi-chip" wx:for="{{yiChips}}" wx:key="*this">{{item}}</view>
      </view>
    </view>

    <!-- E1 未建档提示条：本地无档案才显示；点击跳排盘；× 关闭落 ylm_noarch_tip_closed=1。
         与下方 archiveHint 互斥（E1 优先：同真时只显示本条；× 关闭后原「去设置」条接管） -->
    <view class="noarch-tip" wx:if="{{noarchHint}}" hover-class="noarch-tip-active" hover-stay-time="0" bindtap="onGoNoarchTip">
      <view class="seal noarch-tip-seal"><text class="seal-char">卷</text></view>
      <view class="noarch-tip-mid">
        <view class="noarch-tip-t">还没建档？排一次盘，会生成专属分析</view>
        <view class="noarch-tip-s">今日仅为通用运势 · 建档后解读更贴合自己</view>
      </view>
      <view class="noarch-tip-arrow">→</view>
      <view class="noarch-tip-close" hover-class="noarch-tip-close-active" hover-stay-time="0" catchtap="onCloseNoarchTip">×</view>
    </view>

    <!-- 未设置命主档案：通用运势提示条 + 去设置（跳档案页）（E1 条可见时隐藏，避免双条） -->
    <view class="arch-hint" wx:if="{{archiveHint && !noarchHint}}" hover-class="arch-hint-active" hover-stay-time="0" bindtap="onGoArchive">
      <view class="seal arch-hint-seal"><text class="seal-char">命</text></view>
      <view class="arch-hint-mid">
        <view class="arch-hint-t">尚未设置命主信息</view>
        <view class="arch-hint-s">今日为通用运势 · 设置后解读更贴合自己</view>
      </view>
      <view class="arch-hint-cta">去设置</view>
    </view>

    <!-- 深夜入口横幅(21:00 后出现,白天不出现) -->
    <view wx:if="{{night.mode}}" class="night-banner lamp-fade" hover-class="night-banner-active" hover-stay-time="0" bindtap="onNightEntry">
      <view class="nb-lantern"><text class="nb-lantern-char">灯</text></view>
      <view class="nb-mid">
        <view class="nb-title">夜深了 · 灯还亮着</view>
        <view class="nb-sub">21:00-01:00 · 枕边灯语 · 倾诉 · 今夜说的话，天亮就忘</view>
      </view>
      <view class="nb-go">灯下见</view>
    </view>

    <!-- 晨笺卡（已开启 + 数据就绪；接口失败/未开启均静默） -->
    <view class="jian-card" wx:if="{{jian.show}}">
      <view class="jian-head">
        <view class="seal jian-seal"><text class="seal-char">晨</text></view>
        <view class="jian-head-txt">
          <view class="jian-title">今日晨笺</view>
          <view class="jian-date">{{jian.ganzhiDate}}</view>
        </view>
        <view class="jian-fav {{jian.saved ? 'jian-fav-on' : ''}}" hover-class="jian-fav-active" hover-stay-time="0" bindtap="onJianFav">{{jian.saved ? '已收藏' : '收藏'}}</view>
      </view>

      <!-- 宜忌两行（宜=朱砂胶囊 忌=淡墨虚线胶囊） -->
      <view class="jian-yi">
        <view class="jian-yi-row">
          <text class="jian-yi-label">宜</text>
          <view class="jian-yi-tags">
            <view class="jian-yi-chip" wx:for="{{jian.yi}}" wx:key="*this">{{item}}</view>
          </view>
        </view>
        <view class="jian-yi-row">
          <text class="jian-yi-label jian-yi-label-ji">忌</text>
          <view class="jian-yi-tags">
            <view class="jian-yi-chip jian-yi-chip-ji" wx:for="{{jian.ji}}" wx:key="*this">{{item}}</view>
          </view>
        </view>
      </view>

      <!-- 金句：收起一行 / 展开（书名 + 原文）（UX批1 M-9：补按压反馈） -->
      <view class="jian-quote" wx:if="{{jian.quote}}" hover-class="jian-quote-active" hover-stay-time="0" bindtap="onQuoteTap">
        <view class="jian-quote-row">
          <text class="jian-quote-text {{jian.expanded ? 'jian-quote-text-open' : ''}}">「{{jian.quote}}」</text>
          <text class="jian-quote-more">{{jian.expanded ? '收起' : '展开'}}</text>
        </view>
        <view class="jian-quote-book" wx:if="{{jian.expanded}}">
          <text wx:if="{{jian.book}}">——《{{jian.book}}》</text>
          <text wx:else>——明灯拟 · 古籍原句</text>
        </view>
      </view>

      <!-- 轻私语 -->
      <view class="jian-private" wx:if="{{jian.privateLine}}">
        <text class="jian-private-label">轻私语</text>
        <text>{{jian.privateLine}}</text>
      </view>

      <!-- 今日小问 → 对话页 -->
      <view class="jian-question" hover-class="jian-question-active" hover-stay-time="0" bindtap="onQuestionTap">
        <view class="q-seal"><text class="q-seal-char">问</text></view>
        <text class="jian-question-text">{{jian.question}}</text>
        <image class="brush-arrow jian-question-arrow" src="/assets/images/brush-arrow.png"></image>
      </view>

      <view class="jian-foot">明灯谨录 · 观命不执命</view>
    </view>

    <!-- 未开启晨笺：顶部入口 → 开启引导页 -->
    <view class="jian-open" wx:if="{{jian.notEnabled}}" hover-class="jian-open-active" hover-stay-time="0" bindtap="onOpenJian">
      <view class="seal jian-open-seal"><text class="seal-char">笺</text></view>
      <view class="jian-open-mid">
        <view class="jian-open-t">今日晨笺 · 未开启</view>
        <view class="jian-open-s">每日 07:30 推送 · 干支宜忌与一句金句</view>
      </view>
      <view class="jian-open-cta">去开启</view>
    </view>

    <!-- 今日流日（原型 day-flow：四运浅块 + 解释 + 逐条详解入口 + 时辰胶囊） -->
    <view class="day-flow" hover-class="day-flow-active" hover-stay-time="0" bindtap="goTodayDetail">
      <view class="df-head">
        <text class="df-title">今日流日</text>
        <text class="df-tag">点开详解 · 免费</text>
      </view>
      <view class="four-yun" wx:if="{{fortune4.length}}">
        <view class="yun-block" wx:for="{{fortune4}}" wx:key="key">
          <view class="yb-label">{{item.label}}</view>
          <view class="yb-num">{{item.scoreText}}</view>
        </view>
      </view>
      <view class="df-line" wx:if="{{fortune4.length}}">{{fortune4[0].desc}}</view>
      <!-- UX批1 M-11：四运/时辰均无数据时不渲染空壳 -->
      <view class="df-empty" wx:if="{{!fortune4.length && !shichen.length}}">今日暂无数据</view>
      <view class="df-more">
        <text>逐条详解 · 四运 · 宜忌 · 时辰</text>
        <image class="brush-arrow df-arrow" src="/assets/images/brush-arrow.png"></image>
      </view>
      <!-- 时辰择时 chips（原型：巳时 9-11 宜洽谈 式胶囊） -->
      <view class="shichen-row">
        <view class="shichen-chip {{item.cur ? 'shichen-chip-cur' : ''}}" wx:for="{{shichen}}" wx:key="time">
          <text class="sc-time">{{item.time}}</text>
          <text class="sc-tag">{{item.tag}}</text>
        </view>
      </view>
    </view>

    <!-- 想聊聊？（低调收尾；v2026-08-17：随手截屏入口移除——真机上与下方元素
         视觉重叠（PM 反馈），绘制能力 drawInkCard 保留（ming 页仍在用）） -->
    <view class="talk-col">
      <view class="talk-btn" hover-class="talk-btn-active" hover-stay-time="0" bindtap="goChat">
        <text>想聊聊？</text>
        <image class="brush-arrow" src="/assets/images/brush-arrow.png"></image>
      </view>
    </view>

    <view class="today-foot">
      <view class="fg"></view>
      <text>明灯谨录 · 观命不执命</text>
      <view class="fg"></view>
    </view>
  </view>

  <canvas type="2d" id="inkCard" class="ink-card-canvas"></canvas>

  <view class="tabbar">
    <view class="tab-item" bindtap="onTab" data-tab="chat">
      <image class="tab-ic" src="/assets/images/ic-chat.png"></image>
      <text class="tab-label">对话</text>
    </view>
    <view class="tab-item on" bindtap="onTab" data-tab="today">
      <image class="tab-ic" src="/assets/images/ic-lantern-on.png"></image>
      <text class="tab-label">今日</text>
      <view class="dot"></view>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="suance">
      <image class="tab-ic" src="/assets/images/ic-book2.png"></image>
      <text class="tab-label">测算</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="me">
      <image class="tab-ic" src="/assets/images/ic-seal.png"></image>
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
