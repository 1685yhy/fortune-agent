<!-- 排盘 — 选命主 + 八字档案（原型 dir_funcs 捌：档案直选 / 手动临时排盘 / 对话建档提示） -->
<view class="screen" style="--nav-off:{{navOff}}px">

  <!-- ═══ ① 选命主（原型捌） ═══ -->
  <block wx:if="{{mode === 'pick'}}">
    <view class="navrow">
      <view class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goBack">
        <image class="back-icon" src="{{dark ? '/assets/images/ic-back-dark.png' : '/assets/images/ic-back.png'}}"></image>
      </view>
      <view class="nav-title">
        <image class="nav-lantern" src="/assets/images/ic-lantern-on.png"></image>
        <text>排盘 · 选择命主</text>
      </view>
      <view class="nav-right" hover-class="navrow-hover" hover-stay-time="0" bindtap="navHelp">
        <image class="nav-right-icon" src="{{dark ? '/assets/images/ic-lantern-dark.png' : '/assets/images/ic-lantern.png'}}"></image>
      </view>
    </view>

    <scroll-view scroll-y class="pick-scroll">
      <!-- 对话建档提示条（chat 页检测到排盘回复含建档 key → 本地标记 → 本页展示） -->
      <view wx:if="{{bannerVisible}}" class="dlg-banner" hover-class="dlg-banner-active" hover-stay-time="0" bindtap="onBannerTap">
        <view class="seal db-seal"><text class="seal-char">对</text></view>
        <view class="db-mid">
          <view class="db-title">对话中识别到出生信息</view>
          <view class="db-sub"><text wx:if="{{bannerText}}">「{{bannerText}}」</text><text class="db-sub-strong">已保存到档案</text><text> · 点击确认</text></view>
        </view>
        <view class="db-x" catchtap="dismissBanner">✕</view>
      </view>

      <!-- ① 从档案选择 -->
      <view class="sec-label">
        <view class="sl-no">壹</view>从档案选择
        <text class="sec-small">共 {{persons.length}} 位</text>
      </view>
      <block wx:if="{{persons.length}}">
        <view wx:for="{{persons}}" wx:key="id"
          class="pick-card {{selId === item.id ? 'sel' : ''}}"
          hover-class="pick-card-active" hover-stay-time="0"
          data-id="{{item.id}}" bindtap="onPick">
          <view class="pk-av">
            <view class="seal pk-seal"><text class="seal-char">{{item.seal}}</text></view>
            <view wx:if="{{selId === item.id}}" class="ok-ring"><text class="ok-check">✓</text></view>
          </view>
          <view class="pk-mid">
            <view class="pk-name">{{item.name}}
              <view wx:if="{{item.rel}}" class="inktag">{{item.rel}}</view>
              <view wx:if="{{item.is_default}}" class="inktag pk-def-tag">默认</view>
            </view>
            <view class="pk-birth">{{item.birth}}</view>
          </view>
          <view class="pk-radio"><text wx:if="{{selId === item.id}}" class="radio-check">✓</text></view>
        </view>
      </block>
      <view wx:else class="pick-empty" hover-class="pick-empty-active" hover-stay-time="0" bindtap="goPersons">
        档案为空 · 去「档案」添加命主
      </view>

      <!-- ② 手动输入 · 帮别人排 -->
      <view class="sec-label">
        <view class="sl-no">贰</view>手动输入 · 帮别人排
        <text class="sec-small">排完即走 · 不留档案</text>
      </view>
      <view class="manual-box">
        <view class="mb-title">临时生辰</view>
        <view class="mb-hint">未保存的命主，排完即走，不进入档案</view>

        <view class="form-label">出生年月日<text class="req">*</text></view>
        <view class="input-row3">
          <input class="input-ink" type="number" maxlength="4" placeholder="年"
            placeholder-class="input-placeholder" value="{{mYear}}" bindinput="onMYearInput" />
          <input class="input-ink" type="number" maxlength="2" placeholder="月"
            placeholder-class="input-placeholder" value="{{mMonth}}" bindinput="onMMonthInput" />
          <input class="input-ink" type="number" maxlength="2" placeholder="日"
            placeholder-class="input-placeholder" value="{{mDay}}" bindinput="onMDayInput" />
        </view>

        <view class="form-label">时辰</view>
        <view class="seg shichen-seg">
          <view wx:for="{{hourLabels}}" wx:key="*this"
            class="seg-btn shichen-btn {{mHourIndex === index ? 'on' : ''}}"
            data-idx="{{index}}" bindtap="onMHourChange">{{item}}</view>
        </view>

        <view class="form-label">性别 / 出生地</view>
        <view class="gender-place-row">
          <view class="seg gender-seg">
            <view class="seg-btn {{mGender === '男' ? 'on' : ''}}" data-g="男" bindtap="onMGenderChange">男</view>
            <view class="seg-btn {{mGender === '女' ? 'on' : ''}}" data-g="女" bindtap="onMGenderChange">女</view>
          </view>
          <input class="input-ink place-input" type="text" maxlength="20" placeholder="出生地 · 如：广州"
            placeholder-class="input-placeholder" value="{{mPlace}}" bindinput="onMPlaceInput" />
        </view>

        <view class="save-check {{saveToArc ? 'on' : ''}}" hover-class="save-check-active" hover-stay-time="0" bindtap="toggleSaveArc">
          <view class="ck-box"><text class="ck-check">✓</text></view>
          <text class="ck-label">保存到档案</text>
          <text class="ck-note">勾选后，此命主将加入「档案」</text>
        </view>
        <view wx:if="{{saveToArc}}" class="save-name">
          <view class="form-label">命主姓名</view>
          <input class="input-ink" type="text" maxlength="8" placeholder="如：老张"
            placeholder-class="input-placeholder" value="{{mName}}" bindinput="onMNameInput" />
        </view>
      </view>

      <view class="pick-cta">
        <button class="btn btn-acc btn-wide" hover-class="btn-active" hover-stay-time="0"
          disabled="{{!canStart}}" bindtap="onStart">{{ctaText}}</button>
        <view class="pick-note"><view class="pn-dot"></view>命主不同，命盘不同 · 生辰只用于排盘</view>
      </view>
    </scroll-view>
  </block>

  <!-- ═══ ② 排盘表单（原 bazi 页） ═══ -->
  <block wx:else>
    <view class="navrow">
      <view class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goBack">
        <image class="back-icon" src="{{dark ? '/assets/images/ic-back-dark.png' : '/assets/images/ic-back.png'}}"></image>
      </view>
      <view class="nav-title">
        <text>{{formTitle}}</text>
      </view>
      <view class="nav-right" hover-class="navrow-hover" hover-stay-time="0" bindtap="switchPerson" wx:if="{{currentPerson}}">
        <text class="nav-switch-txt">换命主</text>
      </view>
      <view class="nav-right" wx:else><view class="nav-right-spacer"></view></view>
    </view>

    <scroll-view scroll-y class="bazi-scroll">
      <!-- 头：朱砂印 + 题字 -->
      <view class="bazi-head">
        <view class="seal bazi-seal"><text class="seal-char">命</text></view>
        <text class="bazi-title">{{hasBazi ? '更正八字档案' : '初立八字档案'}}</text>
        <text class="bazi-sub">出生信息将用于每日运势与四柱排盘，请如实填写</text>
      </view>

      <!-- 表单笺纸卡 -->
      <view class="papercard bazi-card">
        <view class="bazi-row">
          <view class="form-group form-group-third">
            <text class="form-label">出生年份</text>
            <picker mode="selector" range="{{years}}" bindchange="onYearChange" value="{{yearIdx}}">
              <view class="form-picker">
                <text>{{birthYear}} 年</text>
              </view>
            </picker>
          </view>
          <view class="form-group form-group-third">
            <text class="form-label">出生月份</text>
            <picker mode="selector" range="{{months}}" bindchange="onMonthChange" value="{{monthIdx}}">
              <view class="form-picker">
                <text>{{birthMonth}} 月</text>
              </view>
            </picker>
          </view>
          <view class="form-group form-group-third">
            <text class="form-label">出生日期</text>
            <picker mode="selector" range="{{days}}" bindchange="onDayChange" value="{{dayIdx}}">
              <view class="form-picker">
                <text>{{birthDay}} 日</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">出生时辰</text>
          <picker mode="selector" range="{{hourLabels}}" bindchange="onHourChange" value="{{hourIndex}}">
            <view class="form-picker">
              <text>{{hourLabels[hourIndex]}}</text>
            </view>
          </picker>
          <text class="form-hint">时辰不定可选「子时」，准确度约八成</text>
        </view>

        <view class="form-group">
          <text class="form-label">性别</text>
          <view class="form-radio-group">
            <label class="form-radio {{gender === 'male' ? 'active' : ''}}">
              <radio value="male" checked="{{gender === 'male'}}" bindchange="onGenderChange" color="#A93A2C" />
              <text>男</text>
            </label>
            <label class="form-radio {{gender === 'female' ? 'active' : ''}}">
              <radio value="female" checked="{{gender === 'female'}}" bindchange="onGenderChange" color="#A93A2C" />
              <text>女</text>
            </label>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">出生地 <text class="form-optional">（选填）</text></text>
          <input
            class="form-input"
            type="text"
            value="{{city}}"
            placeholder="如：北京（用于真太阳时校准）"
            placeholder-class="form-input-placeholder"
            bindinput="onCityInput"
            maxlength="20"
          />
        </view>

        <view class="form-group">
          <text class="form-label">历法</text>
          <view class="form-picker form-picker-static">
            <text>{{calendar === 'lunar' ? '农历' : '公历'}}</text>
            <text class="form-static-tag">{{calendar === 'lunar' ? '按原样保存' : '已选'}}</text>
          </view>
          <text class="form-hint">排盘引擎目前仅支持公历（阳历），农历按原样保存</text>
        </view>
      </view>

      <!-- 保存 -->
      <button class="btn-primary bazi-save" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">
        <text wx:if="{{!saving}}">{{currentPerson ? '为「' + currentPerson.name + '」保存' : (hasBazi ? '保存更正' : '保存档案')}}</text>
      </button>
      <view class="bazi-foot">
        <view class="bf-line"></view>
        <text>明灯相随 · 命理可参</text>
        <view class="bf-line"></view>
      </view>
    </scroll-view>
  </block>
</view>
