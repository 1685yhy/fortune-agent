<view class="screen {{nightMode ? 'night' : ''}}" style="--nav-off:{{navOff}}px" bindtap="onListTap">
  <view class="navrow {{showBack ? 'show-back' : ''}}">
    <!-- 返回箭头：仅导航栈进入（历史/解梦 navigateTo）时显示；tab 主屏隐藏（原型 4-tab 常驻无返回） -->
    <view wx:if="{{showBack}}" class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goBack">
      <image class="back-icon" src="/assets/images/ic-back.png"></image>
    </view>
    <!-- 页头左侧符号钮（零文字，原型 v7 反馈#7 改造）：
         左上角固定「新开对话」（方框加号）：点按 = 当前对话保存到历史 → 全新空对话（带确认弹窗）；
         右侧历史为固定列表图标钮；标题「对话」居中。
         v1.3：删除原「临时对话」（⊕）入口——临时对话通道（tempChat）复用 deepNight（后端不落记忆），
         而深夜模式（灯下漫谈/枕边灯语）由夜间时段自动或晚安推送 entry='night' 独立进入（_enterNight
         同样 setDeepNight(true)），⊕ 入口移除不影响深夜功能；后端 deepNight 能力保留，仅收回前端入口 -->
    <view class="nav-actions">
      <view class="nav-sym na-strong" hover-class="navrow-hover" hover-stay-time="0" bindtap="startNewChat" aria-label="新开对话">
        <view class="sym-new">
          <view class="sym-new-frame"></view>
          <view class="sym-plus-h"></view>
          <view class="sym-plus-v"></view>
        </view>
      </view>
      <view class="nav-sym" hover-class="navrow-hover" hover-stay-time="0" bindtap="goHistory" aria-label="历史记录">
        <view class="sym-list">
          <view class="sym-list-line"></view>
          <view class="sym-list-line"></view>
          <view class="sym-list-line"></view>
        </view>
      </view>
    </view>
    <view class="nav-title">
      <text>对话</text>
    </view>
  </view>

  <!-- v1.3 多选操作条（长按菜单「多选」进入）：已选 N 条 / 全选 / 收藏 / 分享 / 取消 -->
  <view wx:if="{{multiMode}}" class="multi-bar">
    <text class="mb-count">已选 {{multiCount}} 条</text>
    <view class="mb-btn" hover-class="mb-btn-active" hover-stay-time="0" bindtap="multiSelectAll">{{multiAll ? '取消全选' : '全选'}}</view>
    <view class="mb-btn mb-btn-acc" hover-class="mb-btn-active" hover-stay-time="0" bindtap="multiFav">收藏</view>
    <view class="mb-btn mb-btn-acc" hover-class="mb-btn-active" hover-stay-time="0" bindtap="multiShare">分享</view>
    <view class="mb-btn mb-btn-cancel" hover-class="mb-btn-active" hover-stay-time="0" bindtap="exitMulti">取消</view>
  </view>

  <!-- ═══ Task 8 · 深夜模式（方案·灯下漫谈） ═══
       B3-3（PM 2026-08-29 要求）：聊天页深夜浮层全部移除——夜提示条
       （night-head）、枕边灯语卡（lamp-card）、挽留条（keepBar）、劝睡
       （sleepBar）、「要我记得吗」（rememberPrompt）均不再展示；深夜主题
       （.night 变量级联）、服务端 /api/night/lamp/* 与灯语收藏体系保留 -->
  <!-- 对话建档提示条：AI 回复含建档 key → 顶部提示（点按确认/取消，可关闭） -->
  <view wx:if="{{saveBanner}}" class="dlg-banner" hover-class="dlg-banner-active" hover-stay-time="0" bindtap="onSaveBannerTap">
    <view class="seal db-seal"><text class="seal-char">对</text></view>
    <view class="db-mid">
      <view class="db-title">对话中识别到出生信息</view>
      <view class="db-sub"><text class="db-sub-strong">已保存到档案</text><text> · 点击确认</text></view>
    </view>
    <view class="db-x" catchtap="dismissSaveBanner">✕</view>
  </view>

  <!-- v2.0 空会话引导区（微信对话空态式）：无消息时显示（品牌 + 示例问题），
       内容整体左下对齐（PM 反馈：参考微信对话空态——内容在左下，不是居中）；
       v2026-08-17：去掉底部快捷入口排（今日运势/深夜灯语/双人合盘/择吉日，
       4 条示例问题已足够，避免视觉冗余）。
       有消息/历史时列表接管（条件互斥，msg-list 保持原布局） -->
  <!-- 全局免责一行（2026-08-17：对话回复不再逐条带「仅供参考」尾巴——改为
       消息区顶部固定浅色小字，空会话时在引导区下方、有消息时在列表上方，
       不随消息滚动隐藏；全局只出现一次） -->
  <view class="chat-disclaimer">内容由 AI 生成 · 仅供娱乐参考</view>

  <!-- ═══ k6-P1 输入区入流 · 屏幕中部内容容器（.chat-mid，结构见 chat.wxss .screen 注释）═══
       容器占满导航行与输入条之间的全部弹性空间：输入条（.chat-inputbar，流内 flex 子项）
       随额度条显隐 / textarea auto-height 增行而长高时，本容器由 flex 自然收缩——容器内的
       绝对覆盖层（安全条 .safety-card / 引导区 .guide / 消息列表 .msg-list，坐标已换算为
       mid 内锚点）随容器锚定，视觉与旧布局零位移、全程无 setData / 无 calc 重排 / 无滚动。
       屏级绝对组件（multi-bar / dlg-banner / chat-disclaimer / navrow / tabbar）保持在容器
       之外、坐标不动（见各自 wxss 注释） -->
  <view class="chat-mid">
    <!-- 12356 心理援助（UX批1 M-5：加 ✕ 关闭入口，用户读完可收起；k6-P1 移入 chat-mid，
         bottom 锚点 = 容器底（输入条顶），见 chat.wxss .safety-card） -->
    <view wx:if="{{safetyCard.show}}" class="safety-card">
      <view class="safety-head">心理援助 · 请先联系专业人员</view>
      <text>{{safetyCard.text}}</text>
      <view class="safety-x" hover-class="safety-x-active" hover-stay-time="0" catchtap="dismissSafetyCard" aria-label="关闭心理援助提示">✕</view>
    </view>

    <view wx:if="{{showGuide}}" class="guide">
    <view class="guide-main">
      <!-- 左下 · 品牌（印章 + 名称 + 副标题） -->
      <view class="guide-brand">
        <view class="guide-seal"><text class="guide-seal-char">易</text></view>
        <view class="guide-name">易理明灯</view>
        <view class="guide-sub">观命 · 不执命</view>
        <view class="guide-rule"></view>
      </view>
      <!-- 左下 · 示例问题（墨韵小卡片，点击直接发送提问） -->
      <view class="guide-qs">
        <view class="guide-q" hover-class="guide-q-active" hover-stay-time="0" data-text="今天运势如何？" bindtap="quickAsk">
          <text class="guide-q-mark">问</text>
          <text class="guide-q-txt">今天运势如何？</text>
        </view>
        <view class="guide-q" hover-class="guide-q-active" hover-stay-time="0" data-text="帮我看看这段感情" bindtap="quickAsk">
          <text class="guide-q-mark">问</text>
          <text class="guide-q-txt">帮我看看这段感情</text>
        </view>
        <view class="guide-q" hover-class="guide-q-active" hover-stay-time="0" data-text="我这个名字怎么样？" bindtap="quickAsk">
          <text class="guide-q-mark">问</text>
          <text class="guide-q-txt">我这个名字怎么样？</text>
        </view>
        <view class="guide-q" hover-class="guide-q-active" hover-stay-time="0" data-text="测测明天的宜忌" bindtap="quickAsk">
          <text class="guide-q-mark">问</text>
          <text class="guide-q-txt">测测明天的宜忌</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Task 5 滚动不拽回：bindscroll 记录用户滚动位置，上滑查看历史时流式自动滚不再拽回 -->
  <scroll-view wx:else scroll-y class="msg-list {{multiMode ? 'multi-on' : ''}}" scroll-into-view="{{scrollInto}}" scroll-with-animation bindscroll="onScroll">
    <view class="msg-inner">
      <block wx:for="{{messages}}" wx:key="id">
        <!-- B3-3 D 修复：气泡加 catchtap 吞掉点击冒泡——选取模式中点选中气泡
             不触发 .screen 的 onListTap，选择不会被误退出（气泡外仍可退出） -->
        <view wx:if="{{item.role === 'ai'}}" class="jianzhu {{selectMsgId === item.id ? 'select-mode' : ''}} {{multiMode && multiSel[item.id] ? 'multi-on' : ''}}"
          bindlongpress="onBubbleLongPress" bindtap="onMsgTap" catchtap="noop" data-id="{{item.id}}" data-role="ai">
          <!-- v1.3 多选勾选框（气泡左上角圆形，点按勾选/取消） -->
          <view wx:if="{{multiMode}}" class="msg-check {{multiSel[item.id] ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onMsgTap">
            <text wx:if="{{multiSel[item.id]}}" class="mc-mark">✓</text>
          </view>
          <view class="jz-tag">{{item.tag}}</view>
          <!-- k10-C 甲兜底引导小字：选取模式 + 已锁定段落 → 气泡顶部提示（替代旧 toast
               引导——常驻可见，无需在点击「选取文字」后猜第二次长按的位置） -->
          <view wx:if="{{selectMsgId === item.id && selParaKey}}" class="sel-guide">
            <text>长按这段文字即可拖动选择</text>
          </view>
          <!-- Task 3 思考步骤（元宝「深度思考」样式，v2026-08-17 重做）：
               顶部折叠胶囊（呼吸墨点 + 状态文案 + 用时秒数），展开后是分步列表
               （✓ 已完成 / ● 进行中）；流式中逐条累积上屏——每来一步新事件
               上一步即变 ✓，步骤可见地推进（修复 PM：步骤不轮换）；
               完成后自动收起为「深度思考完成 · 用时 Xs」，点开展开全部步骤 -->
          <view wx:if="{{item.thinking && item.thinking.length}}" class="think-path {{item.thinkCollapsed ? 'fold' : ''}}" data-id="{{item.id}}" bindtap="toggleThink">
            <view class="think-row">
              <view class="think-dot {{item.streaming ? 'pulse' : 'ok'}}"></view>
              <text class="think-label">{{item.thinkLabel}}</text>
              <text wx:if="{{!item.streaming && item.thinkSeconds > 0}}" class="think-secs">用时 {{item.thinkSeconds}}s</text>
              <text class="think-fold">{{item.thinkCollapsed ? '＋' : '－'}}</text>
            </view>
            <block wx:if="{{!item.thinkCollapsed}}">
              <view class="think-items">
                <view class="think-item" wx:for="{{item.thinking}}" wx:key="index">
                  <text class="think-mark {{item.state === 'done' ? 'ok' : 'doing'}}">{{item.state === 'done' ? '✓' : '●'}}</text>
                  <text class="think-text">{{item.text}}</text>
                </view>
              </view>
            </block>
          </view>
          <!-- v1.2 正文：Markdown 节点树渲染（md-block 模板逐节点 view/text，墨韵样式）；
               引用 [n]/🔗 由 utils/md.js 解析为 cite 节点（代码内不解析）；流式增量重解析。
               v1.2 图片消息预留：msg.image → 圆角墨框图片
               E2-2 对话卡片化：item.card 非空 → 卡片壳渲染（标题条 + 正文区 + 收藏按钮
               + 卡外引导语）；无标记/降级 → 保持原 md-block 渲染（零回归） -->
          <view class="jz-body sel-body-{{item.id}}">
            <image wx:if="{{item.image && item.image.url}}" class="msg-img"
              src="{{item.image.url}}" mode="widthFix"
              style="{{item.image.width ? 'max-width:' + item.image.width + 'rpx;' : ''}}"
              data-url="{{item.image.url}}" catchtap="previewMsgImage"></image>
            <block wx:if="{{item.card}}">
              <!-- 前置内容（流式重发重复前缀已由镜像丢弃；此处仅兜底非重复前置） -->
              <view wx:if="{{item.cardPrefixNodes && item.cardPrefixNodes.length}}" class="card-prefix">
                <template is="md-block" data="{{nodes: item.cardPrefixNodes, msgId: item.id, sel: selectMsgId === item.id, paraKey: 'pre', paraSel: (selectMsgId === item.id) ? selParaKey : ''}}" />
              </view>
              <view class="card-shell">
                <view class="card-head">
                  <text class="card-type">{{item.cardTypeLabel}}</text>
                  <text class="card-title">{{item.cardTitle}}</text>
                </view>
                <view class="card-body">
                  <template is="md-block" data="{{nodes: item.cardNodes, msgId: item.id, sel: selectMsgId === item.id, paraKey: 'card', paraSel: (selectMsgId === item.id) ? selParaKey : ''}}" />
                </view>
                <!-- E2-2 收藏按钮（仅卡片定格后；复用现有收藏逻辑：data-k=keep → toggleFb） -->
                <view wx:if="{{item.cardFinal}}" class="card-fav" hover-class="card-fav-active" hover-stay-time="0"
                  data-id="{{item.id}}" data-k="keep" bindtap="toggleFb">
                  <text class="card-fav-txt">{{item.kept ? '已收藏' : '收藏'}}</text>
                </view>
              </view>
              <!-- 卡外引导语（"还想了解…"等，渲染在卡片容器外） -->
              <view wx:if="{{item.cardTailNodes && item.cardTailNodes.length}}" class="card-tail">
                <template is="md-block" data="{{nodes: item.cardTailNodes, msgId: item.id, sel: selectMsgId === item.id, paraKey: 'tail', paraSel: (selectMsgId === item.id) ? selParaKey : ''}}" />
              </view>
            </block>
            <template wx:else is="md-block" data="{{nodes: item.mdNodes, msgId: item.id, sel: selectMsgId === item.id, paraKey: 'md', paraSel: (selectMsgId === item.id) ? selParaKey : ''}}" />
            <text wx:if="{{item.streaming && item.content}}" class="jz-cursor"></text>
          </view>
          <!-- 2026-08-18 生成中断分级：网络中断/超时/失败 → 气泡底部浅色小字（正文保留，不覆盖为失败） -->
          <view wx:if="{{item.statusText}}" class="jz-status">{{item.statusText}}</view>
          <!-- 2026-08-19 断点续传：退出后服务端后台完成的回复 → 气泡底部小字 -->
          <view wx:if="{{item.offline}}" class="jz-status">上次生成 · 退出后已完成</view>
          <!-- Task 8 对话内引导卡：AI 回复行内识别 /pages/ 路径 → 气泡末尾跳转按钮 -->
          <view wx:if="{{item.navPath && !item.streaming}}" class="nav-btn" hover-class="nav-btn-active" hover-stay-time="0" data-url="{{item.navPath}}" bindtap="onNavBtnTap">
            <text class="nav-btn-txt">{{item.navLabel || '进入双人合盘 →'}}</text>
            <image class="nav-btn-arrow" src="/assets/images/brush-arrow.png"></image>
          </view>
          <!-- v1.2 建议卡片（回复完成后显示，白卡 + 朱砂描边，点击直接发送追问） -->
          <view wx:if="{{item.suggestions && item.suggestions.length && !item.streaming}}" class="sug-card">
            <view class="sug-head"><text class="sug-title">还想问</text></view>
            <view class="sug-item" hover-class="sug-item-active" hover-stay-time="0"
              wx:for="{{item.suggestions}}" wx:for-item="sug" wx:key="index"
              data-text="{{sug}}" bindtap="sendSuggestion">
              <text class="sug-txt">{{sug}}</text>
              <text class="sug-arrow">问</text>
            </view>
          </view>
          <!-- v1.2 表情反应：气泡角小 emoji 列表（点已加的 → 移除） -->
          <view wx:if="{{item.reactions && item.reactions.length}}" class="reaction-row">
            <view class="reaction-chip" hover-class="reaction-chip-active" hover-stay-time="0"
              wx:for="{{item.reactions}}" wx:for-item="em" wx:key="index"
              data-id="{{item.id}}" data-em="{{em}}" bindtap="removeReaction">{{em}}</view>
          </view>
          <!-- v8 阶段 3：失败重试（保留输入与已输出） -->
          <view wx:if="{{item.error}}" class="jz-retry" hover-class="jz-fb-active" hover-stay-time="0" data-id="{{item.id}}" data-text="{{item.retryText}}" bindtap="retryStream">
            <text class="jz-retry-icon">↻</text><text class="jz-retry-label">重试</text>
          </view>
          <view class="jz-foot">
            <view class="jz-timewrap">
              <text class="jz-time">明灯 · {{item.time}}</text>
              <view class="jz-speak {{speakingId === item.id ? 'on' : ''}}" hover-class="jz-fb-active" hover-stay-time="0" data-id="{{item.id}}" bindtap="speakMessage">
                <view wx:if="{{speakingId === item.id}}" class="spk-bars">
                  <view class="spk-bar"></view>
                  <view class="spk-bar"></view>
                  <view class="spk-bar"></view>
                </view>
                <image wx:else src="/assets/images/ic-speak.png"></image>
              </view>
            </view>
            <view class="jz-fb">
              <view class="jz-fb-btn {{fb[item.id + '-up'] ? 'on' : ''}}" hover-class="jz-fb-active" hover-stay-time="0" data-id="{{item.id}}" data-k="up" bindtap="toggleFb">
                <image src="{{fb[item.id + '-up'] ? '/assets/images/ic-up-on.png' : '/assets/images/ic-up.png'}}"></image>
              </view>
              <view class="jz-fb-btn {{fb[item.id + '-down'] ? 'on' : ''}}" hover-class="jz-fb-active" hover-stay-time="0" data-id="{{item.id}}" data-k="down" bindtap="toggleFb">
                <image src="{{fb[item.id + '-down'] ? '/assets/images/ic-down-on.png' : '/assets/images/ic-down.png'}}"></image>
              </view>
              <view class="jz-fb-btn keep {{item.kept ? 'on' : ''}}" hover-class="jz-fb-active" hover-stay-time="0" data-id="{{item.id}}" data-k="keep" bindtap="toggleFb">
                <image src="{{item.kept ? '/assets/images/ic-keep-on.png' : '/assets/images/ic-keep.png'}}"></image>
              </view>
              <!-- v1.2 表情反应快捷 ＋（气泡尾部） -->
              <view class="jz-fb-btn react-add" hover-class="jz-fb-active" hover-stay-time="0" data-id="{{item.id}}" bindtap="openEmojiSheet">
                <text class="react-add-txt">＋</text>
              </view>
            </view>
          </view>
        </view>
        <!-- v1.1 排队消息立即上屏：pending 灰态 + 「排队中」小标 -->
        <view wx:else class="user-note sel-body-{{item.id}} {{item.pending ? 'pending' : ''}} {{selectMsgId === item.id ? 'select-mode' : ''}} {{multiMode && multiSel[item.id] ? 'multi-on' : ''}}"
          bindlongpress="onBubbleLongPress" bindtap="onMsgTap" catchtap="noop" data-id="{{item.id}}" data-role="user">
          <!-- v1.3 多选勾选框（气泡左上角圆形，点按勾选/取消） -->
          <view wx:if="{{multiMode}}" class="msg-check {{multiSel[item.id] ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onMsgTap">
            <text wx:if="{{multiSel[item.id]}}" class="mc-mark">✓</text>
          </view>
          <!-- v1.2 图片消息预留：msg.image → 圆角墨框图片（B4-1：点击放大预览） -->
          <image wx:if="{{item.image && item.image.url}}" class="msg-img"
            src="{{item.image.url}}" mode="widthFix"
            style="{{item.image.width ? 'max-width:' + item.image.width + 'rpx;' : ''}}"
            data-url="{{item.image.url}}" catchtap="previewMsgImage"></image>
          <!-- k10-C：user 消息整体视为一段（'user:0'）——长按正文记录段落，供
               菜单「复制本段」与甲兜底定位；事件冒泡到 .user-note 的 onBubbleLongPress 开菜单 -->
          <text selectable="{{selectMsgId === item.id}}" data-msgid="{{item.id}}" data-para-id="user:0"
            bindlongpress="onParaLongPress">{{item.content}}</text>
          <view wx:if="{{selectMsgId === item.id && selParaKey}}" class="sel-guide">
            <text>长按这段文字即可拖动选择</text>
          </view>
          <view class="u-meta">
            <text class="u-time">我 · {{item.time}}</text>
            <text wx:if="{{item.pending}}" class="u-badge">排队中</text>
          </view>
        </view>
      </block>
      <!-- 2026-08-18：慢提示生效（15s 无内容）时隐藏陈旧的「研墨中」——研墨中是意图分析
           阶段提示，干等 15s+ 后应以主生成阶段的「正在深入分析」为准 -->
      <view wx:if="{{typing && !slowHint}}" class="typing">
        <view class="inkdot"></view>
        <view class="inkdot"></view>
        <view class="inkdot"></view>
        <text class="tlabel">研墨中 · 约三息</text>
      </view>
      <!-- 2026-08-18 生成慢提示：主生成阶段 15s 无内容输出 → 输入区上方浅色小字（不打断） -->
      <view wx:if="{{slowHint}}" class="slow-hint">正在深入分析，请稍候…</view>
      <view id="btm" class="msg-anchor"></view>
    </view>
  </scroll-view>
  </view><!-- /chat-mid (k6-P1) -->

  <view class="chat-inputbar">
    <!-- L5-1/L5-2 对话额度条：免费用户「今日 X/15」；超限降级 → 精简提示 + 开通会员入口 -->
    <view wx:if="{{quotaBar.show}}" class="quota-bar {{quotaBar.downgraded ? 'qb-downgraded' : ''}}">
      <text class="qb-text">{{quotaBar.text}}</text>
      <view wx:if="{{quotaBar.downgraded}}" class="qb-btn" hover-class="qb-btn-active" hover-stay-time="0" bindtap="goMember">开通会员</view>
    </view>
    <!-- B4-1 输入区改版（对齐豆包）：[输入框（内嵌 相机|文本|小话筒）] [+钮] [发送钮]
         文字模式 = 输入框内嵌相机图标（选图/拍照）+ 自动长高文本区 + 内嵌小话筒（点一下切按住说话）
         语音模式 = 按住说话条（复用录音逻辑）+ 键盘图标（点一下切回文字）+ [+钮]
         v1.1 语音三态（voice-hold/rec-bar/convert-bar）与状态机全部保留，仅入口变化 -->
    <view class="input-row">
      <block wx:if="{{inputMode === 'voice'}}">
        <view wx:if="{{!isRecording && !converting}}" class="voice-hold {{micAvailable ? '' : 'mic-off'}}" hover-class="voice-hold-active" hover-stay-time="0"
          bindtouchstart="micTouchStart" bindtouchmove="micTouchMove" bindtouchend="micTouchEnd" bindtouchcancel="micTouchCancel">
          <image class="vh-mic" src="/assets/images/ic-mic.png"></image>
          <text class="vh-txt">按住 说话</text>
        </view>
        <view wx:elif="{{isRecording}}" class="rec-bar {{recCanceling ? 'cancel' : ''}}"
          bindtouchmove="micTouchMove" bindtouchend="micTouchEnd" bindtouchcancel="micTouchCancel">
          <view class="rec-row">
            <view class="rec-stop" hover-class="rec-stop-active" hover-stay-time="0" catchtap="recStopTap"><view class="rec-stop-in"></view></view>
            <view class="rec-wave">
              <view wx:for="{{waveBars}}" wx:key="i" class="rec-col"
                style="height:{{item.h}}rpx;animation-duration:{{item.d}}s;animation-delay:{{item.l}}s"></view>
            </view>
            <text class="rec-time">{{recSeconds < 10 ? '0' : ''}}{{recSeconds}}</text>
          </view>
          <view class="rec-hint">{{recCanceling ? '松开 取消' : '松开 发送 · 上滑 取消'}}</view>
        </view>
        <view wx:else class="convert-bar">
          <view class="inkdot"></view>
          <view class="inkdot"></view>
          <view class="inkdot"></view>
          <text class="convert-label">语音转文字中…</text>
        </view>
        <view class="kb-btn" hover-class="kb-btn-active" hover-stay-time="0" data-mode="text" bindtap="switchInputMode">
          <image src="/assets/images/ic-keyboard.png"></image>
        </view>
        <view class="plus-btn" hover-class="plus-btn-active" hover-stay-time="0" bindtap="openMorePanel">
          <image src="/assets/images/ic-plus.png"></image>
        </view>
      </block>
      <block wx:else>
        <view class="input-shell {{inputFocused ? 'input-focused' : ''}}">
          <!-- 内嵌相机图标（豆包样式）：点击选图/拍照 → 上传发图片消息 -->
          <view class="in-ic in-cam" hover-class="in-ic-active" hover-stay-time="0" bindtap="chooseImage">
            <image src="/assets/images/ic-camera.png"></image>
          </view>
          <!-- B4-1 自动长高：textarea auto-height，5.5 行封顶。k6-P1：不再 bindlinechange——
               原生长高由流内 .chat-inputbar + .chat-mid(flex:1) 自然吸收（打字零 setData/零重排） -->
          <!-- k10-B 多行输入（2026-09-06）：去掉 confirm-type="send"——键盘右下角回归
               微信惯例「换行」键（textarea 下该键即输入 \n），发送统一走右侧朱砂发送钮
               （对齐元宝/豆包：发送在条上）。bindconfirm/onConfirm 保留为无害兜底
               （仅当某输入法仍提供「发送」键时才会触发，走既有 _send 链）。 -->
          <textarea class="chat-input" placeholder="{{nightMode ? '慢慢说，我听着。' : '写下一句心事…'}}"
            placeholder-class="input-ph" value="{{inputText}}" focus="{{inputFocus}}"
            auto-height maxlength="500" cursor-spacing="20"
            bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm" />
          <!-- 内嵌小话筒图标：短按切「按住说话」模式（再点键盘图标切回）；长按（k6-P2）直达
               录音——切 voice 态（textarea 卸载、键盘自然收起）→ 授权 → 直接开录，
               松开发送/取消等一切结束路径自动复位回文字态（micLongPress/_clearLongPressVoice） -->
          <view class="in-ic in-mic {{micAvailable ? '' : 'in-ic-off'}}" hover-class="in-ic-active" hover-stay-time="0" data-mode="voice" bindtap="switchInputMode" bindlongpress="micLongPress">
            <image src="/assets/images/ic-mic.png"></image>
          </view>
        </view>
        <view class="plus-btn" hover-class="plus-btn-active" hover-stay-time="0" bindtap="openMorePanel">
          <image src="/assets/images/ic-plus.png"></image>
        </view>
        <!-- v8 阶段 3：生成中无输入 → 停止钮；正在打字 → 发送钮（点按=排队，豆包式） -->
        <view wx:if="{{streaming && !inputText}}" class="stop-btn" hover-class="stop-btn-active" hover-stay-time="0" bindtap="stopStream">
          <view class="stop-square"></view>
        </view>
        <view wx:else class="send-btn {{inputText ? '' : 'send-btn-off'}}" hover-class="send-btn-active" hover-stay-time="0" bindtap="sendMessage">
          <image src="/assets/images/ic-send.png"></image>
        </view>
      </block>
    </view>
  </view>

  <view class="tabbar">
    <view class="tab-item on" bindtap="onTab" data-tab="chat">
      <image class="tab-ic" src="/assets/images/ic-chat-on.png"></image>
      <text class="tab-label">对话</text>
      <view class="dot"></view>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="today">
      <image class="tab-ic" src="/assets/images/ic-lantern.png"></image>
      <text class="tab-label">今日</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="suance">
      <image class="tab-ic" src="/assets/images/ic-book2.png"></image>
      <text class="tab-label">测算</text>
    </view>
    <view class="tab-item" bindtap="onTab" data-tab="me">
      <image class="tab-ic" src="/assets/images/ic-seal.png"></image>
      <text class="tab-label">我的</text>
    </view>
  </view>

  <!-- ═══ k10-C 方案乙 · 只读 textarea 覆盖层（模拟「点一下即有默认选区可拖」） ═══
       仅在降级判定不命中的机型/场景出现（见 chat.js k10-C 常量与 _textOverlayFeasible）；
       命中平台限制/异常 → 自动走甲（selectMsgId + 段落高亮 + 引导小字）。
       覆盖层把被按气泡的正文区（.jz-body 实测矩形）以纯文本 textarea 垫在原位：
       focus + selection-start/end = 用户长按所在段落 → 呈现可拖动两端焦点的观感。
       键盘抑制：textarea 无 readonly 属性、聚焦必弹键盘 → bindfocus 后立即 wx.hideKeyboard
       尽力抑制（真机验证项；不可靠时引擎开关回甲，见 chat.js 常量注释）。
       滚动联动：覆盖层为全屏模态（mask catchtouchmove 阻断滚动），消息滚动/流式更新
       触发时 _closeTextOverlay 自动退出恢复。点外部/失焦 → 退出恢复。 -->
  <view wx:if="{{selOverlay.show}}" class="sel-overlay">
    <!-- 退出热区：点覆盖层内、textarea 外的任何位置 → 关闭恢复（textarea 为原生/同层
         组件，自身触摸不冒泡到本 mask；mask 单独承接退出，避免点选区误关） -->
    <view class="sel-mask" catchtap="closeTextOverlay" catchtouchmove="noop"></view>
    <textarea class="sel-ov-area {{selOverlay.role === 'user' ? 'is-user' : ''}}" value="{{selOverlay.text}}" focus="{{selOverlay.focus}}"
      selection-start="{{selOverlay.start}}" selection-end="{{selOverlay.end}}"
      maxlength="-1" disable-default-padding adjust-position="{{false}}"
      show-confirm-bar="{{false}}" cursor-spacing="10" auto-height="{{false}}"
      style="top:{{selOverlay.top}}px;left:{{selOverlay.left}}px;width:{{selOverlay.width}}px;height:{{selOverlay.height}}px;"
      bindfocus="onSelOvFocus" bindblur="onSelOvBlur"></textarea>
  </view>

  <!-- 阶段 5·引用抽屉（元宝式）：半屏 ↔ 全屏，分类列表 → 详情页 -->
  <view wx:if="{{citeDrawer.show}}" class="cite-mask" bindtap="closeCiteDrawer" catchtouchmove="noop"></view>
  <view wx:if="{{citeDrawer.show}}" class="cite-drawer {{citeDrawer.full ? 'full' : ''}}" catchtouchmove="noop">
    <view class="cd-handle" bindtouchstart="cdTouchStart" bindtouchmove="cdTouchMove" bindtouchend="cdTouchEnd" bindtap="toggleCiteFull">
      <view class="cd-handle-bar"></view>
    </view>
    <view class="cd-head">
      <text class="cd-title">参考资料</text>
      <text class="cd-full" hover-class="cd-full-active" hover-stay-time="0" bindtap="toggleCiteFull">{{citeDrawer.full ? '收起' : '上滑全屏'}}</text>
    </view>
    <scroll-view scroll-y class="cd-list">
      <!-- Task6 滚动条修复：内边距移至内部容器（scroll-view 自身不设 padding，滚动条贴最右侧） -->
      <view class="cd-list-inner">
        <view class="cd-item" hover-class="cd-item-active" hover-stay-time="0" wx:for="{{citeDrawer.items}}" wx:key="index" data-i="{{index}}" bindtap="onCiteItemTap">
          <view class="cd-row">
            <view class="cd-type {{item.type}}"><image class="cd-type-ic" src="{{citeTypeIcon(item.type)}}"></image><text>{{citeTypeLabel(item.type)}}</text></view>
            <text class="cd-it-title">{{item.title}}</text>
          </view>
          <view class="cd-it-sum">{{item.text}}</view>
        </view>
        <view wx:if="{{!citeDrawer.items.length}}" class="cd-empty">本条回复暂无参考资料</view>
      </view>
    </scroll-view>
  </view>

  <!-- v2.0 气泡长按操作菜单（元宝式竖排：每行=图标+文字并排，分隔线分组，朱砂删除项） -->
  <view wx:if="{{actionMenu.show}}" class="act-mask" bindtap="closeActionMenu" catchtouchmove="noop"></view>
  <view wx:if="{{actionMenu.show}}" class="act-sheet" catchtouchmove="noop">
    <view class="act-head">
      <text class="act-title">{{actionMenu.role === 'ai' ? '明灯 · 此笺' : '我的 · 此笺'}}</text>
    </view>
    <!-- 组一 · 评价收藏（仅明灯回复）：点赞 / 点踩 / 收藏 / 表情反应 -->
    <block wx:if="{{actionMenu.role === 'ai'}}">
      <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="up" bindtap="actFeedback">
        <image class="act-em-ic" src="/assets/images/ic-up.png"></image>
        <text class="act-label">点赞</text>
      </view>
      <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="down" bindtap="actFeedback">
        <image class="act-em-ic" src="/assets/images/ic-down.png"></image>
        <text class="act-label">点踩</text>
      </view>
      <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="keep" bindtap="actFeedback">
        <image class="act-em-ic" src="/assets/images/ic-keep.png"></image>
        <text class="act-label">收藏</text>
      </view>
      <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="emoji" bindtap="actItem">
        <image class="act-em-ic" src="/assets/images/ic-reaction.png"></image>
        <text class="act-label">表情反应</text>
      </view>
      <view class="act-sep"></view>
    </block>
    <!-- 组二 · 文字处理（通用）：复制本段（k10-C，长按落在段落上时） / 复制 / 选取文字 / 多选 -->
    <view wx:if="{{actionMenu.paraKey}}" class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="copyPara" bindtap="actItem">
      <image class="act-em-ic" src="/assets/images/ic-copy.png"></image>
      <text class="act-label">复制本段</text>
    </view>
    <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="copy" bindtap="actItem">
      <image class="act-em-ic" src="/assets/images/ic-copy.png"></image>
      <text class="act-label">复制</text>
    </view>
    <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="select" bindtap="actItem">
      <image class="act-em-ic" src="/assets/images/ic-edit.png"></image>
      <text class="act-label">选取文字</text>
    </view>
    <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="multi" bindtap="actItem">
      <image class="act-em-ic" src="/assets/images/ic-check.png"></image>
      <text class="act-label">多选</text>
    </view>
    <!-- 组三 · 明灯专属（仅 AI）：朗读 / 分享 / 意见反馈 -->
    <block wx:if="{{actionMenu.role === 'ai'}}">
      <view class="act-sep"></view>
      <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="speak" bindtap="actItem">
        <image class="act-em-ic" src="/assets/images/ic-speak.png"></image>
        <text class="act-label">朗读</text>
      </view>
      <button class="act-row act-share" open-type="share" bindtap="closeActionMenu">
        <image class="act-em-ic" src="/assets/images/ic-share.png"></image>
        <text class="act-label">分享</text>
      </button>
      <view class="act-row" hover-class="act-row-active" hover-stay-time="0" data-k="feedback" bindtap="actItem">
        <image class="act-em-ic" src="/assets/images/ic-chat.png"></image>
        <text class="act-label">意见反馈</text>
      </view>
    </block>
    <view class="act-del" hover-class="act-del-active" hover-stay-time="0" data-k="delete" bindtap="actItem">
      <image class="act-del-em-ic" src="/assets/images/ic-delete.png"></image>
      <text class="act-del-txt">删除此条</text>
    </view>
    <view class="act-cancel" hover-class="act-cancel-active" hover-stay-time="0" bindtap="closeActionMenu">取消</view>
  </view>

  <!-- v1.1 意见反馈原因弹层 -->
  <view wx:if="{{fbMenu.show}}" class="act-mask" bindtap="closeFbMenu" catchtouchmove="noop"></view>
  <view wx:if="{{fbMenu.show}}" class="act-sheet" catchtouchmove="noop">
    <view class="act-head">
      <text class="act-title">意见反馈 · 此回复</text>
      <text class="act-sub">明灯会认真读每一句意见</text>
    </view>
    <view class="act-grid fb-grid">
      <view class="act-item" hover-class="act-item-active" hover-stay-time="0" data-reason="不准确" bindtap="submitFeedbackReason">
        <text class="act-glyph">误</text><text class="act-label">不准确</text>
      </view>
      <view class="act-item" hover-class="act-item-active" hover-stay-time="0" data-reason="语气差" bindtap="submitFeedbackReason">
        <text class="act-glyph">语</text><text class="act-label">语气差</text>
      </view>
      <view class="act-item" hover-class="act-item-active" hover-stay-time="0" data-reason="内容不适" bindtap="submitFeedbackReason">
        <text class="act-glyph">忌</text><text class="act-label">内容不适</text>
      </view>
      <view class="act-item" hover-class="act-item-active" hover-stay-time="0" data-reason="其他" bindtap="submitFeedbackReason">
        <text class="act-glyph">余</text><text class="act-label">其他</text>
      </view>
    </view>
    <view class="act-cancel" hover-class="act-cancel-active" hover-stay-time="0" bindtap="closeFbMenu">取消</view>
  </view>

  <!-- v1.2 表情反应选择弹层（墨韵弹层：emoji 宫格，点一下加 / 再点移除） -->
  <view wx:if="{{emojiSheet.show}}" class="act-mask" bindtap="closeEmojiSheet" catchtouchmove="noop"></view>
  <view wx:if="{{emojiSheet.show}}" class="act-sheet" catchtouchmove="noop">
    <view class="act-head">
      <text class="act-title">表情反应</text>
      <text class="act-sub">点一下加上，再点一下移除</text>
    </view>
    <view class="emoji-grid">
      <view class="emoji-cell {{emojiSheet.curMap[item] ? 'on' : ''}}" hover-class="emoji-cell-active" hover-stay-time="0"
        wx:for="{{EMOJIS}}" wx:key="index" data-em="{{item}}" bindtap="toggleReaction">{{item}}</view>
    </view>
    <view class="act-cancel" hover-class="act-cancel-active" hover-stay-time="0" bindtap="closeEmojiSheet">取消</view>
  </view>

  <!-- B4-1 输入区「+」更多面板：拍照 / 从相册选择 → 同一上传链路（面相/手相分析）。
       文件入口暂缓（台账 Minor）；图标为既有 png 线性体系（禁 emoji 图标） -->
  <view wx:if="{{morePanel.show}}" class="act-mask" bindtap="closeMorePanel" catchtouchmove="noop"></view>
  <view wx:if="{{morePanel.show}}" class="act-sheet" catchtouchmove="noop">
    <view class="act-head">
      <text class="act-title">更多</text>
      <text class="act-sub">发一张照片，看看面相或手相</text>
    </view>
    <view class="act-row" hover-class="act-row-active" hover-stay-time="0" bindtap="choosePhoto">
      <image class="mp-ic" src="/assets/images/ic-camera-soft.png"></image>
      <text class="act-label">拍照</text>
    </view>
    <view class="act-row" hover-class="act-row-active" hover-stay-time="0" bindtap="chooseAlbum">
      <image class="mp-ic" src="/assets/images/ic-camera.png"></image>
      <text class="act-label">从相册选择</text>
    </view>
    <view class="act-cancel" hover-class="act-cancel-active" hover-stay-time="0" bindtap="closeMorePanel">取消</view>
  </view>

  <!-- ═══ v1.2 Markdown 渲染模板（utils/md.js 节点树 → 逐节点 view/text，墨韵样式） ═══
       k10-C 段落定位参数：md-block 顶层每次渲染携带 paraKey（zone 前缀：md/pre/card/tail）
       与 paraSel（当前选取段落键，如 'md:2'；非选取态为 ''）——顶层块视图按
       paraKey+':'+index 拼出 data-para-id（长按记录段落，供菜单「复制本段」/甲高亮/乙预设
       选区），并在自身为被选段时挂 md-hl 高亮类。quote 递归以 paraKey='' 关闭内层捕获
       （引用整体为一段）；code/table 不参与段落（code 自带复制钮）。 -->
  <!-- 行内节点：text / strong / em / code / link / cite（引用角标可点开抽屉） -->
  <template name="md-inline">
    <block wx:for="{{node.children}}" wx:for-item="it" wx:key="index">
      <text wx:if="{{it.t === 'text'}}" selectable="{{sel}}" class="md-it">{{it.s}}</text>
      <text wx:elif="{{it.t === 'strong'}}" selectable="{{sel}}" class="md-strong">
        <template is="md-inline" data="{{node: it, msgId: msgId, sel: sel}}" />
      </text>
      <text wx:elif="{{it.t === 'em'}}" selectable="{{sel}}" class="md-em">
        <template is="md-inline" data="{{node: it, msgId: msgId, sel: sel}}" />
      </text>
      <text wx:elif="{{it.t === 'code'}}" selectable="{{sel}}" class="md-icode">{{it.s}}</text>
      <text wx:elif="{{it.t === 'link'}}" selectable="{{sel}}" class="md-link" data-code="{{it.url}}" bindtap="copyCode">
        <template is="md-inline" data="{{node: it, msgId: msgId, sel: sel}}" />
      </text>
      <!-- 图片：气泡内直接显示（圆角墨框、最大宽 100%、widthFix 高度自适应；长按出系统保存菜单） -->
      <image wx:elif="{{it.t === 'image'}}" class="md-image" src="{{it.url}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <text wx:elif="{{it.t === 'cite'}}" class="cite-chip" data-msgid="{{msgId}}" data-idx="{{it.idx}}" bindtap="onCiteTap"><text wx:if="{{it.idx > 0}}">[{{it.idx}}]</text><image wx:else class="cite-chip-ic" src="/assets/images/ic-link.png"></image></text>
    </block>
  </template>
  <!-- 块级节点：p / h / quote（递归） / ul·ol / code（深墨底可复制） / table（细线网格） -->
  <template name="md-block">
    <block wx:for="{{nodes}}" wx:for-item="blk" wx:key="index">
      <view wx:if="{{blk.t === 'p'}}" class="md-p {{paraSel && paraKey && paraSel === (paraKey + ':' + index) ? 'md-hl' : ''}}"
        data-msgid="{{msgId}}" data-para-id="{{paraKey ? paraKey + ':' + index : ''}}" bindlongpress="onParaLongPress">
        <template is="md-inline" data="{{node: blk, msgId: msgId, sel: sel}}" />
      </view>
      <view wx:elif="{{blk.t === 'h'}}" class="md-h md-h{{blk.level}} {{paraSel && paraKey && paraSel === (paraKey + ':' + index) ? 'md-hl' : ''}}"
        data-msgid="{{msgId}}" data-para-id="{{paraKey ? paraKey + ':' + index : ''}}" bindlongpress="onParaLongPress">
        <template is="md-inline" data="{{node: blk, msgId: msgId, sel: sel}}" />
      </view>
      <view wx:elif="{{blk.t === 'quote'}}" class="md-quote {{paraSel && paraKey && paraSel === (paraKey + ':' + index) ? 'md-hl' : ''}}"
        data-msgid="{{msgId}}" data-para-id="{{paraKey ? paraKey + ':' + index : ''}}" bindlongpress="onParaLongPress">
        <template is="md-block" data="{{nodes: blk.children, msgId: msgId, sel: sel, paraKey: '', paraSel: paraSel}}" />
      </view>
      <view wx:elif="{{blk.t === 'ul' || blk.t === 'ol'}}" class="md-list md-list-{{blk.t}} {{paraSel && paraKey && paraSel === (paraKey + ':' + index) ? 'md-hl' : ''}}"
        data-msgid="{{msgId}}" data-para-id="{{paraKey ? paraKey + ':' + index : ''}}" bindlongpress="onParaLongPress">
        <view wx:for="{{blk.items}}" wx:for-item="li" wx:key="index" class="md-li">
          <text class="md-li-mark">{{blk.t === 'ol' ? li.n + '.' : '·'}}</text>
          <view class="md-li-body">
            <template is="md-inline" data="{{node: li, msgId: msgId, sel: sel}}" />
          </view>
        </view>
      </view>
      <view wx:elif="{{blk.t === 'code'}}" class="md-codeblock">
        <view class="md-code-head">
          <text class="md-code-lang">{{blk.lang || 'code'}}</text>
          <text class="md-code-copy" hover-class="md-code-copy-active" hover-stay-time="0" data-code="{{blk.s}}" catchtap="copyCode">复制</text>
        </view>
        <text class="md-code-body" selectable="{{sel}}">{{blk.s}}</text>
      </view>
      <view wx:elif="{{blk.t === 'table'}}" class="md-table-wrap">
        <view class="md-table">
          <view class="md-tr md-th">
            <text class="md-cell" wx:for="{{blk.headers}}" wx:for-item="cell" wx:key="index">
              <template is="md-inline" data="{{node: cell, msgId: msgId, sel: sel}}" />
            </text>
          </view>
          <view class="md-tr" wx:for="{{blk.rows}}" wx:for-item="row" wx:key="index">
            <text class="md-cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">
              <template is="md-inline" data="{{node: cell, msgId: msgId, sel: sel}}" />
            </text>
          </view>
        </view>
      </view>
      <block wx:else>
        <template is="md-inline" data="{{node: blk, msgId: msgId, sel: sel}}" />
      </block>
    </block>
  </template>
</view>
