/* 对话 — AI 聊天页面样式 */

.page-chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 顶部导航 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md);
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.chat-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.chat-header-right {
  display: flex;
  gap: var(--space-sm);
}

.header-btn {
  padding: 6px 12px;
  border-radius: var(--radius-full);
  background: var(--color-bg-card-alt);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 人格模式切换栏 */
.personality-bar {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background: var(--color-bg);
}

.personality-chip {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--stone);
  background: var(--color-bg-card);
  transition: all var(--transition-fast);
}

.personality-chip.active {
  background: var(--gold);
  color: var(--ink);
  font-weight: 600;
}

/* 场景面板 */
.scenario-panel {
  background: var(--color-bg-card);
  padding: var(--space-sm) var(--space-md);
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 44px;
  z-index: 9;
}

.scenario-item {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: var(--color-bg-card-alt);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  transition: all var(--transition-fast);
  min-height: 44px;
  animation: fadeSlideLeft 0.35s ease-out both;
}

.scenario-item.active {
  background: var(--gold-glow);
  color: var(--gold);
  border: 1px solid var(--gold);
}

.scenario-icon {
  font-size: 16px;
}

.scenario-label {
  font-weight: 500;
}

.scenario-check {
  color: var(--gold);
  font-weight: 700;
}

/* 消息列表 */
.message-list {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.message-container {
  padding: var(--space-md);
  padding-bottom: var(--space-lg);
}

/* 消息包裹 */
.message-wrapper {
  margin-bottom: var(--space-md);
  display: flex;
}

.message-wrapper.user {
  justify-content: flex-end;
}

.message-wrapper.assistant {
  justify-content: flex-start;
}

/* 场景切换提示 */
.scenario-hint {
  text-align: center;
  padding: var(--space-sm);
  width: 100%;
}

.scenario-hint-text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  background: var(--color-bg-card-alt);
  padding: 4px 16px;
  border-radius: var(--radius-full);
}

/* 消息气泡 */
.message-bubble {
  display: flex;
  gap: var(--space-sm);
  max-width: 85%;
}

.message-bubble.user {
  flex-direction: row-reverse;
}

.bubble-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card-alt);
  font-size: 16px;
  flex-shrink: 0;
}

.bubble-content {
  min-width: 0;
}

.bubble-text {
  padding: 12px 16px;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  line-height: 1.7;
  word-break: break-word;
}

.user .bubble-text {
  background: var(--gradient-gold);
  color: var(--ink);
  border-bottom-right-radius: 4px;
  animation: fadeSlideUp 0.3s ease-out both;
}

.assistant .bubble-text {
  background: var(--gold-glow);
  color: var(--color-text);
  border-bottom-left-radius: 4px;
  border: 1px solid var(--color-border);
  animation: fadeSlideUp 0.3s ease-out both;
}

/* 结构化报告 */
.structured-report {
  margin-top: var(--space-sm);
}

.report-collapse {
  padding: 10px 16px;
  background: var(--gold-glow);
  border-radius: var(--radius-sm);
  border: 1px solid var(--gold);
}

.report-collapse-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--gold);
}

/* 消息时间 */
.bubble-time {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: 4px;
  padding: 0 4px;
}

.user .bubble-time {
  justify-content: flex-end;
}

.bubble-time text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.bubble-copy {
  opacity: 0;
  transition: opacity var(--transition-fast);
}

.message-bubble:hover .bubble-copy,
.message-bubble:active .bubble-copy {
  opacity: 1;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  gap: var(--space-sm);
  align-items: flex-end;
}

.typing-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card-alt);
  font-size: 16px;
}

.typing-bubble {
  padding: 12px 20px;
  background: var(--color-bg-card-alt);
  border-radius: var(--radius-md);
  border-bottom-left-radius: 4px;
  border: 1px solid var(--color-border);
}

.typing-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

/* 输入区域 */
.input-bar {
  padding: var(--space-sm) var(--space-md);
  background: var(--color-bg-card);
  border-top: 1px solid var(--color-border);
  position: sticky;
  bottom: 0;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  background: var(--color-bg-card-alt);
  border-radius: var(--radius-xl);
  padding: 4px;
  border: 1px solid var(--color-border);
}

.input-wrapper:focus-within {
  border-color: var(--gold);
  box-shadow: 0 0 0 1px var(--gold-glow);
}

.text-input {
  flex: 1;
  padding: 8px 16px;
  font-size: var(--font-md);
  color: var(--color-text);
  background: transparent;
  border: none;
  outline: none;
  min-height: 36px;
}

.send-btn {
  width: 56px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  font-weight: 600;
  background: var(--color-bg-card);
  color: var(--color-text-tertiary);
  transition: all var(--transition-fast);
}

.send-btn.active {
  background: var(--gradient-gold);
  color: var(--ink);
}

.send-btn:active {
  transform: scale(0.95);
}

/* 空状态 — 大气居中布局 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-3xl) var(--space-xl);
  text-align: center;
  min-height: 60vh;
}

.chat-empty-icon {
  font-size: 72px;
  margin-bottom: var(--space-lg);
  opacity: 0.35;
  filter: blur(0.5px);
  text-shadow: 0 0 40px rgba(212,168,67,0.15);
}

.chat-empty-title {
  font-size: var(--font-xl);
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: var(--space-sm);
  letter-spacing: 0.04em;
}

.chat-empty-hint {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  max-width: 280px;
  line-height: 1.8;
  letter-spacing: 0.03em;
}

/* 暗色模式 */
@media (prefers-color-scheme: dark) {
  .user .bubble-text {
    background: var(--gradient-gold);
  }

  .send-btn.active {
    background: var(--gradient-gold);
  }
}

/* ---- 输入按钮（语音/图片）---- */
.input-btn {
  width: 40px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  transition: all var(--transition-fast);
}
.input-btn-icon {
  font-size: 18px;
}
.input-btn:active {
  transform: scale(0.9);
  opacity: 0.7;
}

/* ---- 语音录制条 ---- */
.recording-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-md);
  background: var(--cinnabar);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  animation: fadeUp 0.3s ease-out;
}
.recording-wave {
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 32px;
  margin-bottom: var(--space-sm);
}
.wave-bar {
  width: 3px;
  background: rgba(255,255,255,0.8);
  border-radius: 2px;
  animation: waveBounce 0.6s ease-in-out infinite alternate;
}
@keyframes waveBounce {
  from { height: 8px; }
  to { height: 28px; }
}
.recording-hint {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.9);
}

/* ---- 图片预览（发送前）---- */
.image-preview-wrap {
  padding: var(--space-sm) var(--space-md);
  background: var(--color-bg);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.image-preview {
  width: 60px;
  height: 60px;
  border-radius: var(--radius-sm);
  object-fit: cover;
}
.image-preview-cancel {
  font-size: var(--font-xs);
  color: var(--cinnabar);
  padding: 4px 12px;
}
