/* ═══ 屏 2 · 夜话 — 笺注对话（dir_b.html 825-903 行逐行翻译，px×1.923→rpx） ═══ */

/* 输入条总高（输入行 + 内边距，rpx 常量估算；v2026-08-17 移除快捷 chip 行后
   由 192rpx 降为 130rpx）：
   msg-list 底部与其联动，滚动到底时最后一条气泡不被输入条遮挡 */
.screen { --inputbar-h: 130rpx; }

/* ═══ 页头导航行（原型 v7 反馈#7 符号钮改造）═══
   标题「对话」居中；左侧纯符号钮（零文字）：
   - 固定「新开对话」（方框加号）→ 点击归档当前会话并开新空对话（带确认弹窗）；
   - 历史 = 固定列表图标钮（三横线）。
   v1.3：删除 ⊕ 临时对话入口（其 tempChat 状态与后端 deepNight 通道解耦——
   深夜模式由夜间时段/晚安推送独立进入，deepNight 能力保留在后端）。
   返回箭头：tab 主屏（4-tab 常驻）隐藏；导航栈进入（历史/解梦 navigateTo）时
   显示（navrow 挂 show-back 类 → 符号钮组右移避让）。 */
.navrow { justify-content: center; }
.navrow .nav-title {
  letter-spacing: .14em;        /* 略收紧（33rpx 字重不变） */
  white-space: nowrap;
}
/* 返回箭头沿用 app.wxss 绝对定位（left 19rpx）；符号钮组挂 show-back 时右移避让 */
.navrow .back { z-index: 36; }

/* 左侧符号钮组（零文字，热区 84rpx，参照原型 .nav-actions 44px） */
.nav-actions {
  position: absolute;
  top: 4rpx;
  left: 16rpx;
  height: 84rpx;
  z-index: 36;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
/* 导航栈进入（有返回箭头）时符号钮组右移避让 */
.navrow.show-back .nav-actions { left: 104rpx; }
.nav-sym {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-mid);
  position: relative;
}
.nav-sym.na-strong { color: var(--acc); }

/* 新开对话（原型 Ic.newchat：方框 + 加号）——v1.3 固定页头入口（清晰可辨，朱砂色） */
.sym-new { width: 44rpx; height: 44rpx; position: relative; }
.sym-new-frame {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border: 2.5rpx solid var(--acc);
  border-radius: 8rpx;
  opacity: .85;
}
.sym-plus-h {
  position: absolute; left: 50%; top: 50%;
  width: 18rpx; height: 2.5rpx;
  background: var(--acc);
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}
.sym-plus-v {
  position: absolute; left: 50%; top: 50%;
  width: 2.5rpx; height: 18rpx;
  background: var(--acc);
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

/* 历史列表（原型 Ic.lhist：三横线，末行略短） */
.sym-list {
  width: 34rpx; height: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
}
.sym-list-line {
  width: 34rpx; height: 2.5rpx;
  background: var(--ink-mid);
  border-radius: 2rpx;
  opacity: .8;
}
.sym-list-line:last-child { width: 23rpx; align-self: flex-end; margin-right: 1rpx; }

/* v2026-08-17：顶部悬浮细行（八月初六 · 夜）已整个移除（PM：透明看不清、
   点没反应、删不掉）——wxml 元素删除 + 本样式块删除；多选操作条 top 定位
   独立（190rpx），不依赖该行高度，无需联动调整 */

/* ═══ v2.0 空会话引导区（微信对话空态式：品牌 + 示例问题，左下对齐） ═══
   与 msg-list 同区域互斥（wxml wx:if/wx:else），有消息即隐藏
   v2026-08-17（PM）：整体左下对齐（参考微信对话空态：内容在左下，不居中），
   去掉底部快捷入口排（guide-quick/guide-entry* 样式已删） */
/* 全局免责一行（2026-08-17）：淡墨小字，固定于消息区顶部（navrow 之下、
   第一条气泡之上），不随消息滚动隐藏；空会话时同样在引导区上方显示。
   各消息区绝对定位元素（guide/msg-list/横幅/灯语卡）整体下移 32rpx 让位 */
.chat-disclaimer {
  position: absolute;
  top: calc(188rpx + var(--nav-off));
  left: 0; right: 0;
  z-index: 26;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .12em;
  line-height: 28rpx;
  text-align: center;
  color: var(--ink-soft);               /* 淡墨 #9A8B71 */
  pointer-events: none;
}

.guide {
  position: absolute;
  top: calc(247rpx + var(--nav-off));
  left: 0; right: 0;
  bottom: calc(173rpx + var(--inputbar-h) + 12rpx);
  z-index: 25;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;            /* 内容贴下（输入条上方） */
  align-items: flex-start;              /* 整体左对齐 */
  padding: 0 44rpx 34rpx;               /* 左侧留白 + 底部收边 */
}
.guide-main {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
/* 品牌：朱砂印章（双线）+ 名称 + 副标题 + 朱砂短墨线（左下排列） */
.guide-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 46rpx;
}
.guide-seal {
  width: 112rpx;
  height: 112rpx;
  background: var(--acc);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: inset 0 0 0 5rpx rgba(251,246,232,.5), inset 0 0 0 6rpx var(--acc-deep);
}
.guide-seal-char {
  font-family: var(--font-brush);
  font-size: 64rpx;
  color: #FBF6E8;
  transform: translateY(2rpx);
}
.guide-name {
  font-family: var(--font-song);
  font-size: 44rpx;
  letter-spacing: .32em;
  color: var(--ink);
  margin-right: -0.32em;               /* 抵消末字字距，保持视觉居中 */
}
.guide-sub {
  margin-top: 16rpx;
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .5em;
  color: var(--ink-faint);
  margin-right: -0.5em;
}
.guide-rule {
  margin-top: 32rpx;
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--acc), transparent);
}
/* 示例问题：墨韵小卡片（宣纸卡 + 细墨边 + 朱砂「问」印，点击直接发送；
   左下对齐、撑满引导区宽度） */
.guide-qs {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 22rpx;
}
.guide-q {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 30rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-med);
  border-radius: 14rpx;
}
.guide-q-active { background: var(--paper-deep); border-color: var(--acc-line); }
.guide-q-mark {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--acc);
  color: #FBF6E8;
  border-radius: 8rpx;
  font-family: var(--font-brush);
  font-size: 26rpx;
  transform: translateY(1rpx);
}
.guide-q-txt {
  flex: 1;
  font-family: var(--font-song);
  font-size: 28rpx;
  letter-spacing: .06em;
  color: var(--ink-mid);
}
/* v2026-08-17：快捷入口排（guide-quick/guide-entry*）样式已删（wxml 同步移除） */

/* ═══ v1.3 多选操作条（长按菜单「多选」进入：已选 N 条/全选/收藏/分享/取消） ═══ */
.multi-bar {
  position: absolute;
  top: calc(190rpx + var(--nav-off));   /* 位于 navrow(90+92rpx) 之下、消息区之上 */
  left: 0; right: 0;
  height: 86rpx;
  z-index: 38;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  background: var(--paper);
  border-bottom: 2rpx solid var(--line-strong);
  box-shadow: 0 6rpx 18rpx var(--shadow-sm);
  box-sizing: border-box;
}
.mb-count {
  flex: 1;
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .1em;
  color: var(--acc);
  font-weight: 600;
}
.mb-btn {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .12em;
  color: var(--ink-mid);
  border: 2rpx solid var(--line-med);
  border-radius: 8rpx;
  background: var(--paper-card);
}
.mb-btn-acc { color: var(--acc); border-color: var(--acc-line); }
.mb-btn-cancel { color: var(--ink-faint); border-color: transparent; background: transparent; }
.mb-btn-active { background: var(--acc-soft); }

/* 多选模式：消息区下移避让操作条（215 → 286：让出 86rpx 条高 + 8rpx 间距） */
.msg-list.multi-on { top: calc(318rpx + var(--nav-off)); }

/* 多选勾选框（气泡左上角圆形，勾选=朱砂实心 ✓）
   left:-32rpx：消息区内边距 35rpx，勾选框仍完整在滚动容器内（overflow-x 不裁剪） */
.msg-check {
  position: absolute;
  left: -32rpx;
  top: 20rpx;
  width: 42rpx;
  height: 42rpx;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 3rpx solid var(--acc);
  background: var(--paper);
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx var(--shadow-sm);
}
.msg-check.on { background: var(--acc); }
.mc-mark {
  font-family: var(--font-lat);
  font-size: 25rpx;
  line-height: 1;
  color: #FBF6E8;
  font-weight: 700;
}
/* 勾选中的气泡：朱砂描边（与选取模式同族样式） */
.jianzhu.multi-on, .user-note.multi-on {
  border-color: var(--acc);
  box-shadow: 0 0 0 5rpx var(--acc-soft);
}

/* ── 对话建档提示条（暖金；AI 回复含建档 key 时浮于消息区顶部） ── */
.dlg-banner {
  position: absolute;
  top: calc(247rpx + var(--nav-off));
  left: 35rpx;
  right: 35rpx;
  z-index: 32;
  padding: 21rpx 25rpx;
  background: rgba(176,138,79,.09);
  border: 2rpx solid var(--gold-soft);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  gap: 19rpx;
  box-shadow: 0 6rpx 19rpx var(--shadow);
  animation: bannerIn .3s cubic-bezier(.2,.7,.3,1) both;
}
@keyframes bannerIn {
  from { opacity: 0; transform: translateY(-14rpx); }
  to { opacity: 1; transform: none; }
}
.dlg-banner-active { background: rgba(176,138,79,.16); }
.db-seal {
  width: 62rpx;
  height: 62rpx;
  font-size: 38rpx;
  flex-shrink: 0;
}
.db-mid { flex: 1; min-width: 0; }
.db-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 24rpx;
  letter-spacing: .1em;
  color: var(--ink);
}
.db-sub {
  margin-top: 4rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .12em;
  line-height: 1.8;
  color: var(--ink-soft);
}
.db-sub-strong { color: var(--acc); font-weight: 600; }
.db-x {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-faint);
  flex-shrink: 0;
}

/* ── 消息流 ──
   bottom 与输入条联动：输入条占底部 173rpx(tabbar) 之上 --inputbar-h 高度，
   滚动到底时最后一条气泡（含反馈钮）完整露出，不被快捷笺条/输入行遮挡 */
.msg-list {
  position: absolute;
  top: calc(247rpx + var(--nav-off));   /* 112px（免责一行占位后下移 32rpx） */
  left: 0; right: 0;
  bottom: calc(173rpx + var(--inputbar-h) + 12rpx);  /* 原 246rpx 会被输入条盖住 */
  z-index: 25;
  overflow-x: hidden;                    /* 真机修复：内容超宽时横向裁剪，页面不可横滑 */
}
.msg-inner { display: flex; flex-direction: column; gap: 35rpx; padding: 27rpx 35rpx 35rpx; }  /* 14px 18px 18px */
.msg-anchor { height: 2rpx; }

/* 明灯笺注卡（左，朱砂细条 + 浅墨标签） */
.jianzhu {
  max-width: 569rpx;                     /* 296px */
  align-self: flex-start;
  background: var(--paper-card);
  border: 2rpx solid var(--line);        /* 1px */
  border-radius: 10rpx;                  /* 5px */
  padding: 25rpx 29rpx 21rpx;            /* 13px 15px 11px */
  position: relative;
  box-shadow: 0 4rpx 15rpx var(--shadow-sm);  /* 0 2px 8px */
}
.jianzhu::before {
  content: '';
  position: absolute;
  left: 0; top: 27rpx; bottom: 27rpx;    /* 14px */
  width: 4rpx;                           /* 2px */
  background: var(--acc-soft);
  border-radius: 2rpx;
}
.jz-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;                            /* 5px */
  margin-bottom: 15rpx;                  /* 8px */
  font-family: var(--font-song);
  font-size: 19rpx;                      /* 10px */
  letter-spacing: .16em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line-soft);   /* 1px */
  border-radius: 4rpx;                   /* 2px */
  padding: 4rpx 13rpx;                   /* 2px 7px */
  background: var(--tag-bg);
}
.jz-body {
  font-family: var(--poem);
  font-size: 30rpx;                      /* 15.5px */
  line-height: 1.95;
  letter-spacing: .03em;
  color: var(--ink-mid);
  font-weight: 400;
}

/* ═══ 阶段 5·引用角标（元宝式统一浅色小链接符号）═══
   浅朱砂 rgba(169,58,44,.55) · 14rpx · 可点 · 不抢正文视线 */
.cite-chip {
  display: inline-block;
  font-family: var(--font-lat);
  font-size: 14rpx;                      /* 7px */
  line-height: 1.6;
  color: rgba(169, 58, 44, .55);
  border: 1rpx solid rgba(169, 58, 44, .30);
  border-radius: 5rpx;
  padding: 0 6rpx;
  margin: 0 5rpx;
  vertical-align: 2rpx;
  letter-spacing: .02em;
  user-select: none;
}
.cite-chip:active { color: var(--acc-deep); border-color: var(--acc-deep); }
.cite-chip-ic {
  width: 24rpx;
  height: 24rpx;
  vertical-align: -5rpx;
  display: inline-block;
}

/* ═══ 阶段 5·引用抽屉（墨韵：半屏 ↔ 全屏，分类列表）═══ */
.cite-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
  background: rgba(58, 44, 30, .38);     /* 墨色蒙层 */
  animation: cite-fade .18s ease;
}
@keyframes cite-fade { from { opacity: 0; } to { opacity: 1; } }

.cite-drawer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 110;
  height: 52vh;                          /* 半屏 */
  background: var(--paper);
  border-top: 2rpx solid var(--line-strong);
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  display: flex;
  flex-direction: column;
  animation: cite-up .22s ease;
  transition: height .24s ease;
}
.cite-drawer.full { height: 92vh; }      /* 上滑全屏 */
@keyframes cite-up { from { transform: translateY(40%); opacity: .4; } to { transform: none; opacity: 1; } }

.cd-handle {
  flex-shrink: 0;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cd-handle-bar {
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--line-med);
}

.cd-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 36rpx 20rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.cd-title {
  font-family: var(--font-song);
  font-size: 30rpx;                      /* 15.5px */
  letter-spacing: .24em;
  color: var(--ink);
}
.cd-full {
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .14em;
  color: var(--ink-faint);
  padding: 8rpx 14rpx;
}
.cd-full-active { color: var(--acc); }

.cd-list {
  flex: 1;
  min-height: 0;
  /* Task6 滚动条修复：padding 移至 .cd-list-inner（scroll-view 自身不留内边距，
     滚动条贴最右侧、与内容不错位） */
}
.cd-list-inner { padding: 6rpx 36rpx 42rpx; }
.cd-item {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-soft);
  border-radius: 10rpx;
}
.cd-item-active { border-color: var(--acc-line); background: var(--acc-soft); }
.cd-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.cd-type {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .08em;
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  border-radius: 5rpx;
  padding: 2rpx 10rpx;
}
.cd-type-ic {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}
.cd-type.engine { color: var(--gold); border-color: rgba(176,138,79,.4); }
.cd-type.memory { color: #5F6B4F; border-color: rgba(95,107,79,.4); }
.cd-type.web { color: #7A6B8F; border-color: rgba(122,107,143,.4); }
.cd-it-title {
  flex: 1;
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cd-it-sum {
  font-family: var(--poem);
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.cd-empty {
  padding: 80rpx 0;
  text-align: center;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .2em;
  color: var(--ink-faint);
}

/* ═══ v8 阶段 3·过程体验：思考路径（元宝「深度思考」胶囊） / 打字机光标 / 重试 ═══
   v2026-08-17 重做（PM：学习元宝深度思考样式 + 修复步骤不轮换）：
   - 顶部胶囊：呼吸墨点 + 状态文案（思考中/深度思考完成/思考中断）+ 用时秒数
   - 展开分步列表：✓ 已完成 / ● 进行中，流式中逐条累积（可见推进）
   - 墨韵配色（宣纸/墨/朱砂），仅呼吸动画，无花哨动效
   - 折叠/展开平滑过渡（max-height + opacity） */

/* 思考胶囊（AI 气泡上方小字区） */
.think-path {
  margin: 0 0 16rpx;
  padding: 0 18rpx;
  background: var(--tag-bg);
  border: 2rpx solid var(--line-soft);
  border-radius: 22rpx;                  /* 胶囊 */
  overflow: hidden;
  transition: border-radius .2s ease;
}
.think-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 13rpx 2rpx;
}
/* 呼吸墨点：思考中 = 朱砂呼吸；完成/中断 = 静态浅墨 */
.think-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-faint);
  transition: background .3s ease;
}
.think-dot.pulse {
  background: var(--acc);
  animation: think-breathe 1.2s ease-in-out infinite;
}
@keyframes think-breathe {
  0%, 100% { opacity: .35; transform: scale(.85); }
  50% { opacity: 1; transform: scale(1.12); }
}
.think-label {
  flex: 1;
  min-width: 0;
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .14em;
  color: var(--ink-soft);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.think-secs {
  flex-shrink: 0;
  font-family: var(--font-lat);
  font-size: 18rpx;                      /* 9.5px */
  letter-spacing: .04em;
  color: var(--ink-faint);
}
.think-fold {
  flex-shrink: 0;
  font-family: var(--font-lat);
  font-size: 22rpx;
  color: var(--ink-faint);
  padding: 0 6rpx;
}
/* 展开列表：分隔线上方一列步骤（✓/● 逐条） */
.think-items {
  padding: 4rpx 2rpx 13rpx;
  border-top: 2rpx solid var(--line-soft);
  max-height: 420rpx;                    /* 折叠动画上限（步骤多时可滚出前先限高） */
  overflow: hidden;
  transition: max-height .22s ease, opacity .22s ease, padding .22s ease;
}
.think-path.fold .think-items {
  max-height: 0;
  opacity: 0;
  padding-top: 0;
  padding-bottom: 0;
  border-top-color: transparent;
}
.think-item {
  display: flex;
  align-items: baseline;
  gap: 9rpx;
  padding: 7rpx 0;
}
.think-mark {
  flex-shrink: 0;
  width: 25rpx;
  text-align: center;
  font-family: var(--font-lat);
  font-size: 19rpx;                      /* 10px */
  color: var(--acc);                     /* 朱砂 ● 进行中 */
  animation: think-pulse 1.2s ease-in-out infinite;
  transition: color .25s ease, opacity .25s ease;
}
.think-mark.ok {
  color: var(--acc-deep);
  animation: none;
  font-weight: 600;
}
@keyframes think-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}
.think-text {
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .08em;
  line-height: 1.7;
  color: var(--ink-soft);
}

/* 打字机光标（流式中正文末尾墨点闪烁） */
.jz-cursor {
  display: inline-block;
  width: 7rpx;                           /* 3.5px */
  height: 30rpx;                         /* 与正文行高呼应 */
  margin-left: 7rpx;
  vertical-align: -2rpx;
  background: var(--acc);
  border-radius: 2rpx;
  animation: jz-blink .9s steps(2, start) infinite;
}
@keyframes jz-blink {
  0%, 60% { opacity: 1; }
  61%, 100% { opacity: 0; }
}

/* 重试（失败气泡下，朱砂描边小钮） */
.jz-retry {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 9rpx 22rpx;
  border: 2rpx solid var(--acc);
  border-radius: 7rpx;
  background: var(--paper-card);
}
.jz-retry-icon {
  font-family: var(--font-lat);
  font-size: 25rpx;
  color: var(--acc);
}
.jz-retry-label {
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .18em;
  color: var(--acc);
}

/* 2026-08-18 生成中断分级：气泡底部浅色小字（内容已保留提示，不打断阅读） */
.jz-status {
  margin-top: 12rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .12em;
  color: var(--ink-faint);
}
.jz-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; }  /* 9px */
.jz-time {
  font-family: var(--font-lat);
  font-style: italic;
  font-size: 19rpx;                      /* 10px */
  letter-spacing: .06em;
  color: var(--ink-faint);
}
.jz-fb { display: flex; gap: 4rpx; }     /* 2px */
.jz-fb-btn {
  width: 62rpx;                          /* 32px */
  height: 54rpx;                         /* 28px */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;                  /* 5px */
}
.jz-fb-btn image { width: 38rpx; height: 38rpx; }  /* 17px → v1.3 调大（新图标 192px 更清晰） */
.jz-fb-btn.keep image { width: 36rpx; height: 36rpx; }  /* 16px */
.jz-fb-active { background: var(--acc-soft); }
.jz-fb-btn.on { background: var(--acc-soft); }

/* 我的便签（右，深宣纸底）
   v1.1：排队中消息灰态 + 「排队中」小标；选取模式朱砂描边
   v1.3：position:relative 供多选勾选框锚点 */
.user-note {
  position: relative;
  max-width: 504rpx;                     /* 262px */
  align-self: flex-end;
  background: var(--paper-deep);
  border: 2rpx solid var(--line);        /* 1px */
  border-radius: 10rpx;                  /* 5px */
  padding: 19rpx 27rpx;                  /* 10px 14px */
  font-family: var(--font-song);
  font-size: 29rpx;                      /* 15px */
  line-height: 1.8;
  letter-spacing: .03em;
  color: var(--ink);
  transition: opacity .25s ease;
}
.user-note.pending {
  opacity: .58;                          /* 排队中：整体灰态 */
}
.user-note .u-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 10rpx;                     /* 5px */
}
.user-note .u-time {
  font-family: var(--font-lat);
  font-style: italic;
  font-size: 18rpx;                      /* 9.5px */
  color: var(--ink-faint);
}
.u-badge {
  font-family: var(--font-song);
  font-size: 17rpx;                      /* 9px */
  letter-spacing: .12em;
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  border-radius: 4rpx;
  padding: 2rpx 9rpx;
}

/* v1.1 选取模式：气泡朱砂描边提示（长按文字出系统选择手柄） */
.jianzhu.select-mode, .user-note.select-mode {
  border-color: var(--acc);
  box-shadow: 0 0 0 5rpx var(--acc-soft);
}

/* 研墨中（三点 + 约三息） */
.typing {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 17rpx;                            /* 9px */
  background: var(--paper-card);
  border: 2rpx solid var(--line);        /* 1px */
  border-radius: 10rpx;                  /* 5px */
  padding: 21rpx 29rpx;                  /* 11px 15px */
}
.typing .tlabel {
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .2em;
  color: var(--ink-soft);
}

/* 2026-08-18 生成慢提示：输入区上方浅色小字（墨韵风格，不打断） */
.slow-hint {
  align-self: center;
  margin: 10rpx 0 4rpx;
  padding: 4rpx 14rpx;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .18em;
  color: var(--ink-faint);
}

/* ── L5-1/L5-2 对话额度条（输入条内顶部；免费用户展示，降级时附开通会员入口） ── */
.quota-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 0 8rpx;                     /* 与输入行间距 */
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .16em;
  color: var(--ink-faint);
}
.quota-bar.qb-downgraded {
  color: var(--ink-soft);
}
.qb-btn {
  padding: 3rpx 18rpx;
  border: 2rpx solid var(--acc-line);
  border-radius: 20rpx;
  font-size: 20rpx;
  letter-spacing: .14em;
  color: var(--acc-ink);
}
.qb-btn-active { opacity: .7; }

/* ── 输入条（额度条 + 输入行 + 朱砂发送） ── */
.chat-inputbar {
  position: absolute;
  left: 0; right: 0;
  bottom: 173rpx;                        /* 90px */
  z-index: 30;
  display: flex;
  flex-direction: column;
  background: var(--tabbar-bg);
  border-top: 2rpx solid var(--line-soft);  /* 1px */
  padding: 17rpx 27rpx 19rpx;            /* 9px 14px 10px */
}
/* 额度条展示时输入条增高（~42rpx）→ 消息列表底部联动让位（qb-on 挂在 .screen）。
   注（B4-1-fix Minor）：.screen 恒带内联 --inputbar-h（JS _updateInputBarH 注入，
   内联优先于类规则）→ 本规则实际不生效，仅作 JS 失效时的兜底；
   真实增高由 JS INPUTBAR_QBON=42 驱动（wxml L1 挂 class、L2 内联变量）。 */
.screen.qb-on { --inputbar-h: 172rpx; }
/* v2026-08-17：输入条上方快捷 chip 排（chip-row/quickchip）已删
   （wxml 同步移除；示例问题已在引导区，无需重复入口）。
   quickAsk 函数保留（引导区示例问题使用）；输入条现仅输入行 + 内边距，
   --inputbar-h 已同步降为 130rpx，msg-list/引导区底部联动不变 */
.input-row { display: flex; align-items: center; gap: 17rpx; }  /* 9px */

/* B4-1 输入框外壳（对齐豆包：内嵌 相机|文本区|小话筒；边框/圆角/底移到此层） */
.input-shell {
  flex: 1;
  min-height: 81rpx;                     /* 42px：与旧单行输入等高 */
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);  /* 1px */
  border-radius: 15rpx;                  /* 8px */
}
.input-shell.input-focused {
  border-color: var(--acc);
  box-shadow: 0 0 0 6rpx var(--acc-soft);  /* 3px */
}
/* B4-1 自动长高文本区：auto-height，行高 40rpx，5.5 行封顶（max-height 220rpx）；
   bindlinechange 行数 → JS 联动 --inputbar-h（增量 = (行数-1) × 40rpx，封顶 +200rpx） */
.chat-input {
  flex: 1;
  min-height: 44rpx;                     /* 单行（行高 40rpx） */
  max-height: 220rpx;                    /* 5.5 行封顶，超出内部滚动 */
  height: auto;
  box-sizing: border-box;
  line-height: 40rpx;
  padding: 18rpx 12rpx;
  font-family: var(--font-song);
  font-size: 28rpx;                      /* 14.5px */
  letter-spacing: .04em;
  color: var(--ink);
}
/* 输入框内嵌图标（相机左 / 小话筒右）：圆形热区，点击态浅朱砂 */
.in-ic {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.in-ic image { width: 34rpx; height: 34rpx; }  /* 18px */
.in-ic-active { background: var(--acc-soft); }
/* 语音插件未配置：内嵌话筒置灰（点按仍有提示，不走长按） */
.in-ic.in-ic-off image { opacity: .35; }

/* B4-1 「+」钮（输入框右侧、发送钮左边）：展开更多面板（拍照/相册） */
.plus-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);  /* 1px */
  border-radius: 12rpx;                  /* 6px */
}
.plus-btn image { width: 38rpx; height: 38rpx; }  /* 20px */
.plus-btn-active { border-color: var(--acc); background: var(--acc-soft); }

.input-ph { color: var(--ink-faint); letter-spacing: .12em; }

.send-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--acc);
  border-radius: 12rpx;                  /* 6px */
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 4rpx 12rpx rgba(120,40,30,.3);  /* 1px 0 2px 6px */
}
.send-btn image { width: 33rpx; height: 33rpx; }  /* 17px */
.send-btn-active { transform: scale(.94); background: var(--acc-deep); }
/* UX批1 M-1：空输入时发送钮置灰（点击仍有「先写一句再发」提示） */
.send-btn-off { opacity: .4; background: var(--ink-faint); box-shadow: none; }

/* v8 阶段 3：停止生成（发送钮变身，朱砂方块） */
.stop-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink);
  border-radius: 12rpx;                  /* 6px */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.2);
}
.stop-square {
  width: 27rpx;                          /* 14px */
  height: 27rpx;
  background: var(--paper);
  border-radius: 4rpx;
}
.stop-btn-active { transform: scale(.94); background: var(--ink-faint); }

/* ═══ 语音交互（元宝式）═ 模式切换 / 按住说话 / 朗读播报 ═══
   B4-1：独立麦克风模式钮已移除（入口改为输入框内嵌小话筒，见 .in-ic.in-mic）；
   语音三态（voice-hold/rec-bar/convert-bar）与状态机全部保留 */

/* ── 按住说话条（v1.1 语音模式，浅墨底 + 麦克风小图） ── */
.voice-hold {
  flex: 1;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);
  border-radius: 15rpx;                  /* 8px */
  font-family: var(--font-song);
}
.voice-hold image { width: 36rpx; height: 36rpx; }
.voice-hold .vh-txt {
  font-size: 26rpx;
  letter-spacing: .26em;
  color: var(--ink-soft);
}
.voice-hold-active { background: var(--acc-soft); border-color: var(--acc); }

/* ── 键盘模式钮（v1.1 语音模式右侧：点一下 → 切回文字输入） ── */
.kb-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);
  border-radius: 12rpx;                  /* 6px */
}
.kb-btn image { width: 38rpx; height: 38rpx; }  /* 20px */
.kb-btn-active { border-color: var(--acc); background: var(--acc-soft); }

/* ── 录音条（元宝式按住说话：深色条 + 朱砂声波柱） ── */
.rec-bar {
  flex: 1;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  padding: 0 22rpx;
  background: var(--ink);
  border: 2rpx solid var(--ink);
  border-radius: 15rpx;                  /* 8px */
  overflow: hidden;
}
.rec-bar.cancel { background: var(--acc-deep); border-color: var(--acc-deep); }
.rec-row { display: flex; align-items: center; }
.rec-stop {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--paper);
  border-radius: 50%;
  margin-right: 20rpx;
}
.rec-stop-in { width: 15rpx; height: 15rpx; background: var(--paper); border-radius: 3rpx; }
.rec-stop-active { transform: scale(.9); }
.rec-wave {
  flex: 1;
  height: 42rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  overflow: hidden;
}
.rec-col {
  width: 4rpx;
  background: var(--acc);                /* 朱砂柱 */
  border-radius: 2rpx;
  transform-origin: center;
  animation: rec-bounce 1s ease-in-out infinite;
}
.rec-bar.cancel .rec-col { background: var(--paper); }
@keyframes rec-bounce {
  0%, 100% { transform: scaleY(.3); }
  50% { transform: scaleY(1); }
}
.rec-time {
  flex-shrink: 0;
  margin-left: 18rpx;
  font-family: var(--font-lat);
  font-size: 27rpx;
  letter-spacing: .05em;
  color: var(--paper);
}
.rec-hint {
  text-align: center;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .24em;
  color: var(--paper);
}
.rec-bar.cancel .rec-hint { color: var(--paper); letter-spacing: .32em; }

/* ── 转文字中（三点加载） ── */
.convert-bar {
  flex: 1;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);
  border-radius: 15rpx;
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .18em;
  color: var(--ink-soft);
}
.convert-bar .inkdot { background: var(--acc); }

/* ── 朗读按钮（AI 回复 footer · 时间旁） ── */
.jz-timewrap { display: flex; align-items: center; gap: 10rpx; }
.jz-speak {
  width: 52rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}
.jz-speak image { width: 31rpx; height: 31rpx; }  /* 16px */
.jz-speak.on { background: var(--acc-soft); }
.spk-bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 25rpx;
}
.spk-bar {
  width: 5rpx;
  height: 22rpx;
  border-radius: 2rpx;
  background: var(--acc);
  transform-origin: bottom;
  animation: spk-pulse .9s ease-in-out infinite;
}
.spk-bar:nth-child(2) { animation-delay: .2s; }
.spk-bar:nth-child(3) { animation-delay: .4s; }
@keyframes spk-pulse {
  0%, 100% { transform: scaleY(.35); }
  50% { transform: scaleY(1); }
}

/* ═══ v1.1 气泡长按操作菜单（墨韵弹层：半屏纸笺 + 四列宫格） ═══ */
.act-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 120;
  background: rgba(58, 44, 30, .38);     /* 墨色蒙层 */
  animation: cite-fade .18s ease;
}
.act-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 130;
  background: var(--paper);
  border-top: 2rpx solid var(--line-strong);
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  padding: 30rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: cite-up .22s ease;
  /* v2.0 竖排菜单项增多：小屏可滚动，防溢出 */
  max-height: 84vh;
  overflow-y: auto;
}
.act-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  margin-bottom: 26rpx;
}
.act-title {
  font-family: var(--font-song);
  font-size: 28rpx;                      /* 14.5px */
  letter-spacing: .24em;
  color: var(--ink);
}
.act-sub {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .14em;
  color: var(--ink-faint);
}
/* v1.3 操作菜单项改造（PM 反馈：图标不明显/看不懂）：
   图标+文字并排（大众认知），图标调大、墨色图标+中墨文字（宣纸/墨/朱砂，无灰） */
.act-grid {
  display: flex;
  flex-wrap: wrap;
}
.act-item {
  width: 33.333%;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;                   /* 图标+文字并排 */
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 24rpx 6rpx;
  border-radius: 10rpx;
  background: transparent;               /* button 默认样式重置（分享项） */
  border: none;
  line-height: 1;
  margin: 0;
  text-align: center;
  font-size: inherit;
}
.act-item::after { border: none; }       /* button 伪边框移除（分享项） */
.act-item-active { background: var(--acc-soft); }
.act-ic { width: 54rpx; height: 54rpx; flex-shrink: 0; }   /* 调大 */
.act-glyph {
  width: 54rpx; height: 54rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 28rpx;
  color: var(--ink);
  border: 2rpx solid var(--line-med);
  border-radius: 8rpx;
  box-sizing: border-box;
}
.act-glyph-multi { color: var(--acc); border-color: var(--acc-line); }   /* 多选：朱砂提示 */
.act-glyph-emoji { font-size: 36rpx; border-color: transparent; }        /* emoji 字号加大、去框 */
.act-label {
  font-family: var(--font-song);
  font-size: 23rpx;                      /* 调大 */
  letter-spacing: .06em;
  color: var(--ink-mid);
  white-space: nowrap;
}
.act-del {
  margin-top: 20rpx;
  padding: 20rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-top: 2rpx solid var(--line-soft);
  border-radius: 12rpx;
}
.act-del-txt {
  font-family: var(--font-song);
  font-size: 25rpx;
  letter-spacing: .2em;
  color: var(--acc-deep);
}
.act-del-em-ic { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.act-del-active { background: var(--acc-soft); }
.act-cancel {
  margin-top: 12rpx;
  padding: 22rpx 0 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .22em;
  color: var(--ink-faint);
}
.act-cancel-active { color: var(--acc); }
.fb-grid .act-item { width: 50%; }       /* 意见反馈原因：2×2 */

/* ═══ v2.0 长按菜单竖排行（元宝式：图标+文字每行并排，分隔线分组，朱砂强调） ═══
   B6-1：图标由 emoji 全面更换为墨韵线性 png（ic-up/down/keep/reaction/copy/edit/check/
   speak/share/chat/delete，与气泡动作、输入区同体系） */
.act-row {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 20rpx 26rpx;
  border-radius: 12rpx;
  background: transparent;               /* button 默认样式重置（分享项） */
  border: none;
  margin: 0;
  line-height: 1;
  font-size: inherit;
}
.act-row::after { border: none; }        /* button 伪边框移除（分享项） */
.act-row-active { background: var(--acc-soft); }
/* B4-1 「+」面板入口图标（png 线性体系，与长按菜单图标 act-em-ic 等宽对齐） */
.mp-ic {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}
/* B6-1 长按菜单图标（emoji → 墨韵线性 png，与气泡动作/输入区同体系） */
.act-em-ic {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}
.act-sep {
  height: 2rpx;
  background: var(--line-med);          /* 分组分隔线略深，分组更易读（vision 评审反馈） */
  margin: 10rpx 12rpx;
}
/* 竖排菜单行文字略大，区分分组层级 */
.act-sheet .act-label { font-size: 26rpx; }

/* ═══ v1.2 气泡内容升级：Markdown 完整渲染（墨韵：代码块深墨底浅字 / 表格细线 / 引用左线） ═══ */

/* 段落（正文继承 .jz-body 的字体/行高；break-all 防超长链接/连续字符穿泡） */
.md-p { margin: 0 0 10rpx; word-break: break-all; }
.md-p:last-child { margin-bottom: 0; }
.md-it { display: inline; }
.md-strong { font-weight: 700; color: var(--ink); }
.md-em { font-style: italic; }
.md-icode {
  font-family: var(--font-lat);
  font-size: 24rpx;
  color: var(--acc-deep);
  background: var(--acc-soft);
  border-radius: 4rpx;
  padding: 0 7rpx;
  word-break: break-all;
}
.md-link { color: var(--acc); text-decoration: underline; word-break: break-all; }
/* 图片：气泡内直接显示（圆角墨框，最大宽度 ~100%，mode=widthFix 高度自适应） */
.md-image {
  display: block;
  max-width: 100%;
  border-radius: 10rpx;
  border: 2rpx solid var(--line-med);
  background: var(--paper-deep);
  margin: 6rpx 0;
}

/* 标题（墨韵：不抢正文，行距收紧） */
.md-h {
  font-family: var(--font-song);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: .04em;
  margin: 14rpx 0 10rpx;
}
.md-h1 { font-size: 34rpx; }
.md-h2 { font-size: 32rpx; margin-top: 12rpx; }
.md-h3 { font-size: 30rpx; margin-top: 10rpx; }
.md-h4, .md-h5, .md-h6 { font-size: 29rpx; margin-top: 8rpx; }


.md-codeblock {
  margin: 12rpx 0;
  border-radius: 8rpx;
  background: #2B2620;
  border: 2rpx solid var(--line-med);
  overflow: hidden;
}
.md-code-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 18rpx;
  background: rgba(245, 239, 225, .05);
  border-bottom: 1rpx solid rgba(245, 239, 225, .14);
}
.md-code-lang {
  font-family: var(--font-lat);
  font-size: 18rpx;
  letter-spacing: .08em;
  color: rgba(237, 230, 220, .55);
}
.md-code-copy {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .1em;
  color: rgba(237, 230, 220, .75);
  border: 1rpx solid rgba(237, 230, 220, .25);
  border-radius: 5rpx;
  padding: 4rpx 14rpx;
}
.md-code-copy-active { background: rgba(237, 230, 220, .16); }
.md-code-body {
  display: block;
  padding: 16rpx 18rpx;
  font-family: var(--font-lat);
  font-size: 23rpx;
  line-height: 1.65;
  color: #EDE6DC;               /* 浅字 */
  white-space: pre-wrap;
  word-break: break-all;
}

/* 引用：左线（朱砂） */
.md-quote {
  margin: 10rpx 0;
  padding: 6rpx 0 6rpx 20rpx;
  border-left: 4rpx solid var(--acc);
  color: var(--ink-soft);
}
.md-quote .md-p { margin-bottom: 6rpx; }

/* 列表 */
.md-list { margin: 8rpx 0; }
.md-li {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 4rpx 0;
}
.md-li-mark {
  flex-shrink: 0;
  min-width: 30rpx;
  text-align: center;
  font-family: var(--font-lat);
  font-size: 24rpx;
  color: var(--acc);
}
.md-li-body { flex: 1; }

/* 表格：细线网格（flex 均分对齐） */
.md-table-wrap { margin: 12rpx 0; overflow-x: auto; }
.md-table {
  border: 1rpx solid var(--line-med);
  border-radius: 6rpx;
  overflow: hidden;
}
.md-tr {
  display: flex;
  border-bottom: 1rpx solid var(--line-soft);
}
.md-tr:last-child { border-bottom: none; }
.md-th { background: var(--tag-bg); }
.md-th .md-cell { color: var(--ink); font-weight: 700; }
.md-cell {
  flex: 1;
  min-width: 0;
  padding: 10rpx 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  border-right: 1rpx solid var(--line-soft);
  word-break: break-all;
}
.md-cell:last-child { border-right: none; }

/* ═══ v1.2 建议卡片（墨韵白卡 + 朱砂描边，点击直接发送追问） ═══ */
.sug-card {
  margin-top: 20rpx;
  padding: 18rpx 22rpx 10rpx;
  background: var(--paper);
  border: 2rpx solid var(--acc-line);
  border-radius: 10rpx;
}
.sug-head { margin-bottom: 4rpx; }
.sug-title {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .18em;
  color: var(--acc);
}
.sug-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.sug-item:last-child { border-bottom: none; }
.sug-txt {
  flex: 1;
  font-family: var(--font-song);
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--ink-mid);
}
.sug-arrow {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 18rpx;
  letter-spacing: .08em;
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
}
.sug-item-active { background: var(--acc-soft); }

/* ═══ E2-2 对话消息卡片化（卡片壳：标题条 + 正文区 + 收藏按钮 + 卡外引导语） ═══
   墨韵白卡 + 朱砂描边（与 sug-card 同族）；根 .night 变量级联 → 深夜模式自动适配 */
.card-prefix { margin-bottom: 10rpx; }
.card-shell {
  margin: 4rpx 0 6rpx;
  padding: 18rpx 22rpx 16rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--acc-line);
  border-radius: 12rpx;
}
.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.card-type {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 18rpx;
  letter-spacing: .14em;
  color: var(--acc-deep);
  border: 2rpx solid var(--acc-line);
  border-radius: 5rpx;
  padding: 3rpx 12rpx;
  background: var(--acc-soft);
}
.card-title {
  flex: 1;
  min-width: 0;
  font-family: var(--font-song);
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: .08em;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 正文区继承 .jz-body 字体/行高（md-p 等节点样式照常生效） */
.card-body { min-height: 8rpx; }
/* 收藏按钮（卡片定格后显示；点击复用 toggleFb 的 keep 收藏逻辑） */
.card-fav {
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 8rpx 22rpx;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .12em;
  color: var(--acc);
  border: 2rpx solid var(--acc-line);
  border-radius: 24rpx;
  background: var(--paper);
  user-select: none;
}
.card-fav-active { background: var(--acc-soft); }
/* 卡外引导语（"还想了解…"等）：卡片容器外、略小一号 */
.card-tail {
  margin-top: 10rpx;
  font-size: 26rpx;
}

/* ═══ Task 8 对话内引导卡跳转按钮（AI 回复含 /pages/ 路径 → 墨韵小钮） ═══ */
.nav-btn {
  margin-top: 17rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 11rpx 22rpx;
  background: var(--paper);
  border: 2rpx solid var(--acc-line);
  border-radius: 8rpx;
}
.nav-btn-active { background: var(--acc-soft); }
.nav-btn-txt {
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .1em;
  color: var(--acc);
}
.nav-btn-arrow { width: 27rpx; height: 19rpx; }

/* ═══ v1.2 表情反应（气泡角小 emoji + 弹层宫格） ═══ */
.reaction-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}
.reaction-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 52rpx;
  height: 44rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  font-size: 26rpx;
}
.reaction-chip-active { border-color: var(--acc); background: var(--acc-soft); }
.react-add-txt { font-size: 30rpx; color: var(--ink-faint); }
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  padding: 6rpx 0 22rpx;
}
.emoji-cell {
  width: 92rpx;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
}
.emoji-cell.on { border-color: var(--acc); background: var(--acc-soft); }
.emoji-cell-active { transform: scale(.92); }

/* ═══ v1.2 图片消息预留（圆角墨框） ═══ */
.msg-img {
  display: block;
  max-width: 100%;
  border-radius: 10rpx;
  border: 2rpx solid var(--line-med);
  background: var(--paper-deep);
}
.user-note .msg-img { margin-bottom: 12rpx; }
.jz-body .msg-img { margin-bottom: 10rpx; }

/* ═══════════════════════════════════════════════════════════════
   Task 8 · 深夜模式（方案·灯下漫谈）
   夜色宣纸主题卡组：深一档暖纸 + 灯笼暖光 + 朱砂点睛（根 .night 变量级联）
   B3-3（PM 2026-08-29）：聊天页深夜浮层样式全部移除（night-head / lamp-card /
   night-keep 挽留劝睡 / keep-prompt「要我记得吗」）；.night 主题变量级联在
   app.wxss，不受影响；服务端 /api/night/lamp/* 与灯语收藏体系保留。
   ═══════════════════════════════════════════════════════════════ */

/* UX批1 M-7：语音插件未配置时 mic 入口置灰（点按即提示，不用等长按） */
.mic-off { opacity: .35; }

/* ── 12356 心理援助安全条 ── */
.safety-card {
  position: absolute;
  left: 35rpx;
  right: 35rpx;
  bottom: calc(173rpx + var(--inputbar-h) + 20rpx);
  z-index: 40;
  padding: 21rpx 25rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--acc-deep);
  border-radius: 12rpx;
  box-shadow: 0 6rpx 20rpx var(--shadow-lg);
}
.safety-head {
  font-family: var(--font-song);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: .16em;
  color: var(--acc-deep);
  margin-bottom: 10rpx;
}
.safety-card text {
  font-family: var(--font-song);
  font-size: 23rpx;
  line-height: 1.8;
  letter-spacing: .04em;
  color: var(--ink-mid);
}
/* UX批1 M-5：12356 心理援助卡 ✕ 关闭钮（右上角，避开正文） */
.safety-x {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink-faint);
}
.safety-x-active { color: var(--acc); }
