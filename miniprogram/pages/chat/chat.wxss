/* ═══ 屏 2 · 夜话 — 笺注对话（dir_b.html 825-903 行逐行翻译，px×1.923→rpx） ═══ */

/* 输入条总高（快捷笺行 + 输入行 + 内边距，rpx 常量估算）：
   msg-list 底部与其联动，滚动到底时最后一条气泡不被快捷笺条遮挡 */
.screen { --inputbar-h: 192rpx; }

/* ═══ 页头导航行（原型 v7 反馈#7 符号钮改造）═══
   标题「对话」居中；左侧纯符号钮（零文字）：
   - 默认 ⊕ 临时对话（虚线气泡加号）→ 点击直达发起（toast）；
   - 临时模式中同位置切换为 新开对话（方框加号）→ 点击直接开新普通对话；
   - 历史 = 固定列表图标钮（三横线）。
   返回箭头：tab 主屏（4-tab 常驻）隐藏；导航栈进入（历史/解梦 navigateTo）时
   显示（navrow 挂 show-back 类 → 符号钮组右移避让）。 */
.navrow { justify-content: center; }
.navrow .nav-title {
  letter-spacing: .14em;        /* 略收紧（33rpx 字重不变） */
  white-space: nowrap;
}
/* 返回箭头沿用 app.wxss 绝对定位（left 19rpx）；符号钮组挂 show-back 时右移避让 */
.navrow .back { z-index: 36; }

/* 左侧符号钮组（零文字，热区 84rpx，参照原型 .nav-actions 44px） */
.nav-actions {
  position: absolute;
  top: 4rpx;
  left: 16rpx;
  height: 84rpx;
  z-index: 36;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
/* 导航栈进入（有返回箭头）时符号钮组右移避让 */
.navrow.show-back .nav-actions { left: 104rpx; }
.nav-sym {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-mid);
  position: relative;
}
.nav-sym.na-strong { color: var(--acc); }

/* ⊕ 临时对话（原型 Ic.plusc：虚线气泡 + 加号） */
.sym-temp { width: 40rpx; height: 40rpx; position: relative; }
.sym-temp-frame {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border: 2.5rpx dashed var(--acc);
  border-radius: 10rpx;
  opacity: .9;
}
.sym-temp-tail {
  position: absolute; left: 8rpx; bottom: -5rpx;
  width: 12rpx; height: 12rpx;
  border-right: 2.5rpx solid var(--acc);
  border-bottom: 2.5rpx solid var(--acc);
  border-bottom-right-radius: 4rpx;
  transform: rotate(45deg);
  opacity: .9;
}

/* 新开对话（原型 Ic.newchat：方框 + 加号） */
.sym-new { width: 40rpx; height: 40rpx; position: relative; }
.sym-new-frame {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border: 2.5rpx solid var(--acc);
  border-radius: 8rpx;
  opacity: .85;
}
.sym-plus-h {
  position: absolute; left: 50%; top: 50%;
  width: 18rpx; height: 2.5rpx;
  background: var(--acc);
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}
.sym-plus-v {
  position: absolute; left: 50%; top: 50%;
  width: 2.5rpx; height: 18rpx;
  background: var(--acc);
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

/* 历史列表（原型 Ic.lhist：三横线，末行略短） */
.sym-list {
  width: 34rpx; height: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
}
.sym-list-line {
  width: 34rpx; height: 2.5rpx;
  background: var(--ink-mid);
  border-radius: 2rpx;
  opacity: .8;
}
.sym-list-line:last-child { width: 23rpx; align-self: flex-end; margin-right: 1rpx; }

/* ── 临时对话条（⊕ 进入：临 时 印章 + 离开即不留记录，原型 .temp-strip） ── */
.temp-strip {
  position: absolute;
  top: calc(215rpx + var(--nav-off));
  left: 0; right: 0;
  z-index: 34;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.ts-seal {
  display: flex;
  align-items: center;
  font-family: var(--font-brush);
  font-size: 21rpx;
  letter-spacing: .16em;
  color: #FBF6E8;
  background: var(--acc);
  border-radius: 6rpx;
  padding: 5rpx 15rpx;
}
.ts-txt {
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .14em;
  color: var(--ink-faint);
}

/* ── 头部细行（八月初六 · 夜） ── */
.chat-head {
  position: absolute;
  top: calc(183rpx + var(--nav-off));   /* 95px */
  left: 0; right: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 27rpx;                            /* 14px */
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .3em;
  color: var(--ink-faint);
}
.chat-head::before, .chat-head::after {
  content: '';
  width: 65rpx;                          /* 34px */
  height: 2rpx;                          /* 1px */
  background: var(--line);
}

/* ── 对话建档提示条（暖金；AI 回复含建档 key 时浮于消息区顶部） ── */
.dlg-banner {
  position: absolute;
  top: calc(215rpx + var(--nav-off));
  left: 35rpx;
  right: 35rpx;
  z-index: 32;
  padding: 21rpx 25rpx;
  background: rgba(176,138,79,.09);
  border: 2rpx solid var(--gold-soft);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  gap: 19rpx;
  box-shadow: 0 6rpx 19rpx var(--shadow);
  animation: bannerIn .3s cubic-bezier(.2,.7,.3,1) both;
}
@keyframes bannerIn {
  from { opacity: 0; transform: translateY(-14rpx); }
  to { opacity: 1; transform: none; }
}
.dlg-banner-active { background: rgba(176,138,79,.16); }
.db-seal {
  width: 62rpx;
  height: 62rpx;
  font-size: 38rpx;
  flex-shrink: 0;
}
.db-mid { flex: 1; min-width: 0; }
.db-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 24rpx;
  letter-spacing: .1em;
  color: var(--ink);
}
.db-sub {
  margin-top: 4rpx;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .12em;
  line-height: 1.8;
  color: var(--ink-soft);
}
.db-sub-strong { color: var(--acc); font-weight: 600; }
.db-x {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-faint);
  flex-shrink: 0;
}

/* ── 消息流 ──
   bottom 与输入条联动：输入条占底部 173rpx(tabbar) 之上 --inputbar-h 高度，
   滚动到底时最后一条气泡（含反馈钮）完整露出，不被快捷笺条/输入行遮挡 */
.msg-list {
  position: absolute;
  top: calc(215rpx + var(--nav-off));   /* 112px */
  left: 0; right: 0;
  bottom: calc(173rpx + var(--inputbar-h) + 12rpx);  /* 原 246rpx 会被输入条盖住 */
  z-index: 25;
  overflow-x: hidden;                    /* 真机修复：内容超宽时横向裁剪，页面不可横滑 */
}
.msg-inner { display: flex; flex-direction: column; gap: 35rpx; padding: 27rpx 35rpx 35rpx; }  /* 14px 18px 18px */
.msg-anchor { height: 2rpx; }

/* 明灯笺注卡（左，朱砂细条 + 浅墨标签） */
.jianzhu {
  max-width: 569rpx;                     /* 296px */
  align-self: flex-start;
  background: var(--paper-card);
  border: 2rpx solid var(--line);        /* 1px */
  border-radius: 10rpx;                  /* 5px */
  padding: 25rpx 29rpx 21rpx;            /* 13px 15px 11px */
  position: relative;
  box-shadow: 0 4rpx 15rpx var(--shadow-sm);  /* 0 2px 8px */
}
.jianzhu::before {
  content: '';
  position: absolute;
  left: 0; top: 27rpx; bottom: 27rpx;    /* 14px */
  width: 4rpx;                           /* 2px */
  background: var(--acc-soft);
  border-radius: 2rpx;
}
.jz-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;                            /* 5px */
  margin-bottom: 15rpx;                  /* 8px */
  font-family: var(--font-song);
  font-size: 19rpx;                      /* 10px */
  letter-spacing: .16em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line-soft);   /* 1px */
  border-radius: 4rpx;                   /* 2px */
  padding: 4rpx 13rpx;                   /* 2px 7px */
  background: var(--tag-bg);
}
.jz-body {
  font-family: var(--poem);
  font-size: 30rpx;                      /* 15.5px */
  line-height: 1.95;
  letter-spacing: .03em;
  color: var(--ink-mid);
  font-weight: 400;
}

/* ═══ 阶段 5·引用角标（元宝式统一浅色小链接符号）═══
   浅朱砂 rgba(169,58,44,.55) · 14rpx · 可点 · 不抢正文视线 */
.cite-chip {
  display: inline-block;
  font-family: var(--font-lat);
  font-size: 14rpx;                      /* 7px */
  line-height: 1.6;
  color: rgba(169, 58, 44, .55);
  border: 1rpx solid rgba(169, 58, 44, .30);
  border-radius: 5rpx;
  padding: 0 6rpx;
  margin: 0 5rpx;
  vertical-align: 2rpx;
  letter-spacing: .02em;
  user-select: none;
}
.cite-chip:active { color: var(--acc-deep); border-color: var(--acc-deep); }

/* ═══ 阶段 5·引用抽屉（墨韵：半屏 ↔ 全屏，分类列表）═══ */
.cite-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
  background: rgba(58, 44, 30, .38);     /* 墨色蒙层 */
  animation: cite-fade .18s ease;
}
@keyframes cite-fade { from { opacity: 0; } to { opacity: 1; } }

.cite-drawer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 110;
  height: 52vh;                          /* 半屏 */
  background: var(--paper);
  border-top: 2rpx solid var(--line-strong);
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  display: flex;
  flex-direction: column;
  animation: cite-up .22s ease;
  transition: height .24s ease;
}
.cite-drawer.full { height: 92vh; }      /* 上滑全屏 */
@keyframes cite-up { from { transform: translateY(40%); opacity: .4; } to { transform: none; opacity: 1; } }

.cd-handle {
  flex-shrink: 0;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cd-handle-bar {
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--line-med);
}

.cd-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 36rpx 20rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.cd-title {
  font-family: var(--font-song);
  font-size: 30rpx;                      /* 15.5px */
  letter-spacing: .24em;
  color: var(--ink);
}
.cd-full {
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .14em;
  color: var(--ink-faint);
  padding: 8rpx 14rpx;
}
.cd-full-active { color: var(--acc); }

.cd-list {
  flex: 1;
  min-height: 0;
  padding: 6rpx 36rpx 42rpx;
  box-sizing: border-box;
}
.cd-item {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-soft);
  border-radius: 10rpx;
}
.cd-item-active { border-color: var(--acc-line); background: var(--acc-soft); }
.cd-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.cd-type {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .08em;
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  border-radius: 5rpx;
  padding: 2rpx 10rpx;
}
.cd-type.engine { color: var(--gold); border-color: rgba(176,138,79,.4); }
.cd-type.memory { color: #5F6B4F; border-color: rgba(95,107,79,.4); }
.cd-type.web { color: #7A6B8F; border-color: rgba(122,107,143,.4); }
.cd-it-title {
  flex: 1;
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cd-it-sum {
  font-family: var(--poem);
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.cd-empty {
  padding: 80rpx 0;
  text-align: center;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .2em;
  color: var(--ink-faint);
}

/* ═══ v8 阶段 3·过程体验：思考路径 / 打字机光标 / 重试 ═══ */

/* 思考路径（AI 气泡上方小字区，元宝式逐步点亮，可折叠） */
.think-path {
  margin: -2rpx 0 16rpx;
  padding: 13rpx 16rpx;
  background: var(--tag-bg);
  border: 2rpx solid var(--line-soft);
  border-radius: 8rpx;
}
.think-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.think-label {
  font-family: var(--font-song);
  font-size: 19rpx;                      /* 10px */
  letter-spacing: .2em;
  color: var(--ink-faint);
}
.think-fold {
  font-family: var(--font-lat);
  font-size: 22rpx;
  color: var(--ink-faint);
  padding: 0 6rpx;
}
.think-path.fold .think-row { margin-bottom: 0; }
.think-item {
  display: flex;
  align-items: baseline;
  gap: 9rpx;
  padding: 5rpx 0;
}
.think-mark {
  flex-shrink: 0;
  width: 25rpx;
  text-align: center;
  font-family: var(--font-lat);
  font-size: 19rpx;                      /* 10px */
  color: var(--acc);                     /* 朱砂 ● 进行中 */
  animation: think-pulse 1.2s ease-in-out infinite;
  /* Task 3：完成瞬间 ● → ✓ 过渡（点亮色渐变） */
  transition: color .25s ease, opacity .25s ease;
}
.think-mark.ok {
  color: var(--acc-deep);
  animation: none;
  font-weight: 600;
}
@keyframes think-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}
.think-text {
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .1em;
  color: var(--ink-soft);
}
/* Task 3：已完成计数行（流式中折叠为一行，弱化显示 + 淡入） */
.think-done-row {
  opacity: .72;
  animation: think-fade .3s ease;
}
@keyframes think-fade {
  from { opacity: 0; }
  to { opacity: .72; }
}

/* 打字机光标（流式中正文末尾墨点闪烁） */
.jz-cursor {
  display: inline-block;
  width: 7rpx;                           /* 3.5px */
  height: 30rpx;                         /* 与正文行高呼应 */
  margin-left: 7rpx;
  vertical-align: -2rpx;
  background: var(--acc);
  border-radius: 2rpx;
  animation: jz-blink .9s steps(2, start) infinite;
}
@keyframes jz-blink {
  0%, 60% { opacity: 1; }
  61%, 100% { opacity: 0; }
}

/* 重试（失败气泡下，朱砂描边小钮） */
.jz-retry {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 9rpx 22rpx;
  border: 2rpx solid var(--acc);
  border-radius: 7rpx;
  background: var(--paper-card);
}
.jz-retry-icon {
  font-family: var(--font-lat);
  font-size: 25rpx;
  color: var(--acc);
}
.jz-retry-label {
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .18em;
  color: var(--acc);
}
.jz-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; }  /* 9px */
.jz-time {
  font-family: var(--font-lat);
  font-style: italic;
  font-size: 19rpx;                      /* 10px */
  letter-spacing: .06em;
  color: var(--ink-faint);
}
.jz-fb { display: flex; gap: 4rpx; }     /* 2px */
.jz-fb-btn {
  width: 62rpx;                          /* 32px */
  height: 54rpx;                         /* 28px */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;                  /* 5px */
}
.jz-fb-btn image { width: 33rpx; height: 33rpx; }  /* 17px */
.jz-fb-btn.keep image { width: 31rpx; height: 31rpx; }  /* 16px */
.jz-fb-active { background: var(--acc-soft); }
.jz-fb-btn.on { background: var(--acc-soft); }

/* 我的便签（右，深宣纸底）
   v1.1：排队中消息灰态 + 「排队中」小标；选取模式朱砂描边 */
.user-note {
  max-width: 504rpx;                     /* 262px */
  align-self: flex-end;
  background: var(--paper-deep);
  border: 2rpx solid var(--line);        /* 1px */
  border-radius: 10rpx;                  /* 5px */
  padding: 19rpx 27rpx;                  /* 10px 14px */
  font-family: var(--font-song);
  font-size: 29rpx;                      /* 15px */
  line-height: 1.8;
  letter-spacing: .03em;
  color: var(--ink);
  transition: opacity .25s ease;
}
.user-note.pending {
  opacity: .58;                          /* 排队中：整体灰态 */
}
.user-note .u-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 10rpx;                     /* 5px */
}
.user-note .u-time {
  font-family: var(--font-lat);
  font-style: italic;
  font-size: 18rpx;                      /* 9.5px */
  color: var(--ink-faint);
}
.u-badge {
  font-family: var(--font-song);
  font-size: 17rpx;                      /* 9px */
  letter-spacing: .12em;
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  border-radius: 4rpx;
  padding: 2rpx 9rpx;
}

/* v1.1 选取模式：气泡朱砂描边提示（长按文字出系统选择手柄） */
.jianzhu.select-mode, .user-note.select-mode {
  border-color: var(--acc);
  box-shadow: 0 0 0 5rpx var(--acc-soft);
}

/* 研墨中（三点 + 约三息） */
.typing {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 17rpx;                            /* 9px */
  background: var(--paper-card);
  border: 2rpx solid var(--line);        /* 1px */
  border-radius: 10rpx;                  /* 5px */
  padding: 21rpx 29rpx;                  /* 11px 15px */
}
.typing .tlabel {
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .2em;
  color: var(--ink-soft);
}

/* ── 输入条（快捷笺 + 输入行 + 朱砂发送） ── */
.chat-inputbar {
  position: absolute;
  left: 0; right: 0;
  bottom: 173rpx;                        /* 90px */
  z-index: 30;
  background: var(--tabbar-bg);
  border-top: 2rpx solid var(--line-soft);  /* 1px */
  padding: 17rpx 27rpx 19rpx;            /* 9px 14px 10px */
}
.chip-row { display: flex; gap: 15rpx; margin-bottom: 17rpx; }  /* 8px 9px */
.quickchip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;                            /* 6px */
  font-family: var(--font-song);
  font-size: 21rpx;                      /* 11px */
  letter-spacing: .14em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);        /* 1px */
  border-radius: 6rpx;                   /* 3px */
  padding: 10rpx 23rpx;                  /* 5px 12px */
  background: var(--paper-card);
}
.quickchip-active { color: var(--acc); border-color: var(--acc); background: var(--acc-soft); }

.input-row { display: flex; align-items: center; gap: 17rpx; }  /* 9px */
.chat-input {
  flex: 1;
  height: 81rpx;                         /* 42px */
  padding: 0 29rpx;                      /* 15px */
  background: var(--paper-card);
  border: 2rpx solid var(--line-input); /* 1px */
  border-radius: 15rpx;                  /* 8px */
  font-family: var(--font-song);
  font-size: 28rpx;                      /* 14.5px */
  letter-spacing: .04em;
  color: var(--ink);
}
.chat-input.input-focused {
  border-color: var(--acc);
  box-shadow: 0 0 0 6rpx var(--acc-soft);  /* 3px */
}
.input-ph { color: var(--ink-faint); letter-spacing: .12em; }

.send-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--acc);
  border-radius: 12rpx;                  /* 6px */
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 4rpx 12rpx rgba(120,40,30,.3);  /* 1px 0 2px 6px */
}
.send-btn image { width: 33rpx; height: 33rpx; }  /* 17px */
.send-btn-active { transform: scale(.94); background: var(--acc-deep); }

/* v8 阶段 3：停止生成（发送钮变身，朱砂方块） */
.stop-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink);
  border-radius: 12rpx;                  /* 6px */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.2);
}
.stop-square {
  width: 27rpx;                          /* 14px */
  height: 27rpx;
  background: var(--paper);
  border-radius: 4rpx;
}
.stop-btn-active { transform: scale(.94); background: var(--ink-faint); }

/* ═══ 语音交互（元宝式）═ 模式切换 / 按住说话 / 朗读播报 ═══ */

/* ── 麦克风模式钮（v1.1 输入框左侧：点一下 → 按住说话模式，墨韵描线） ── */
.mic-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);  /* 1px */
  border-radius: 12rpx;                  /* 6px */
}
.mic-btn image { width: 38rpx; height: 38rpx; }  /* 20px */
.mic-btn-active { border-color: var(--acc); background: var(--acc-soft); }

/* ── 按住说话条（v1.1 语音模式，浅墨底 + 麦克风小图） ── */
.voice-hold {
  flex: 1;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);
  border-radius: 15rpx;                  /* 8px */
  font-family: var(--font-song);
}
.voice-hold image { width: 36rpx; height: 36rpx; }
.voice-hold .vh-txt {
  font-size: 26rpx;
  letter-spacing: .26em;
  color: var(--ink-soft);
}
.voice-hold-active { background: var(--acc-soft); border-color: var(--acc); }

/* ── 键盘模式钮（v1.1 语音模式右侧：点一下 → 切回文字输入） ── */
.kb-btn {
  width: 85rpx;                          /* 44px */
  height: 85rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);
  border-radius: 12rpx;                  /* 6px */
}
.kb-btn image { width: 38rpx; height: 38rpx; }  /* 20px */
.kb-btn-active { border-color: var(--acc); background: var(--acc-soft); }

/* ── 录音条（元宝式按住说话：深色条 + 朱砂声波柱） ── */
.rec-bar {
  flex: 1;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  padding: 0 22rpx;
  background: var(--ink);
  border: 2rpx solid var(--ink);
  border-radius: 15rpx;                  /* 8px */
  overflow: hidden;
}
.rec-bar.cancel { background: var(--acc-deep); border-color: var(--acc-deep); }
.rec-row { display: flex; align-items: center; }
.rec-stop {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--paper);
  border-radius: 50%;
  margin-right: 20rpx;
}
.rec-stop-in { width: 15rpx; height: 15rpx; background: var(--paper); border-radius: 3rpx; }
.rec-stop-active { transform: scale(.9); }
.rec-wave {
  flex: 1;
  height: 42rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  overflow: hidden;
}
.rec-col {
  width: 4rpx;
  background: var(--acc);                /* 朱砂柱 */
  border-radius: 2rpx;
  transform-origin: center;
  animation: rec-bounce 1s ease-in-out infinite;
}
.rec-bar.cancel .rec-col { background: var(--paper); }
@keyframes rec-bounce {
  0%, 100% { transform: scaleY(.3); }
  50% { transform: scaleY(1); }
}
.rec-time {
  flex-shrink: 0;
  margin-left: 18rpx;
  font-family: var(--font-lat);
  font-size: 27rpx;
  letter-spacing: .05em;
  color: var(--paper);
}
.rec-hint {
  text-align: center;
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .24em;
  color: var(--paper);
}
.rec-bar.cancel .rec-hint { color: var(--paper); letter-spacing: .32em; }

/* ── 转文字中（三点加载） ── */
.convert-bar {
  flex: 1;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-input);
  border-radius: 15rpx;
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .18em;
  color: var(--ink-soft);
}
.convert-bar .inkdot { background: var(--acc); }

/* ── 朗读按钮（AI 回复 footer · 时间旁） ── */
.jz-timewrap { display: flex; align-items: center; gap: 10rpx; }
.jz-speak {
  width: 52rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}
.jz-speak image { width: 31rpx; height: 31rpx; }  /* 16px */
.jz-speak.on { background: var(--acc-soft); }
.spk-bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 25rpx;
}
.spk-bar {
  width: 5rpx;
  height: 22rpx;
  border-radius: 2rpx;
  background: var(--acc);
  transform-origin: bottom;
  animation: spk-pulse .9s ease-in-out infinite;
}
.spk-bar:nth-child(2) { animation-delay: .2s; }
.spk-bar:nth-child(3) { animation-delay: .4s; }
@keyframes spk-pulse {
  0%, 100% { transform: scaleY(.35); }
  50% { transform: scaleY(1); }
}

/* ═══ v1.1 气泡长按操作菜单（墨韵弹层：半屏纸笺 + 四列宫格） ═══ */
.act-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 120;
  background: rgba(58, 44, 30, .38);     /* 墨色蒙层 */
  animation: cite-fade .18s ease;
}
.act-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 130;
  background: var(--paper);
  border-top: 2rpx solid var(--line-strong);
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  padding: 30rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: cite-up .22s ease;
}
.act-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  margin-bottom: 26rpx;
}
.act-title {
  font-family: var(--font-song);
  font-size: 28rpx;                      /* 14.5px */
  letter-spacing: .24em;
  color: var(--ink);
}
.act-sub {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .14em;
  color: var(--ink-faint);
}
.act-grid {
  display: flex;
  flex-wrap: wrap;
}
.act-item {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
  padding: 20rpx 0 24rpx;
  border-radius: 10rpx;
  background: transparent;               /* button 默认样式重置（分享项） */
  border: none;
  line-height: 1;
  margin: 0;
}
.act-item::after { border: none; }       /* button 伪边框移除（分享项） */
.act-item-active { background: var(--acc-soft); }
.act-ic { width: 44rpx; height: 44rpx; }
.act-glyph {
  width: 44rpx; height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--ink-mid);
  border: 2rpx solid var(--line-med);
  border-radius: 8rpx;
  box-sizing: border-box;
}
.act-label {
  font-family: var(--font-song);
  font-size: 20rpx;                      /* 10.5px */
  letter-spacing: .1em;
  color: var(--ink-soft);
}
.act-del {
  margin-top: 20rpx;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 2rpx solid var(--line-soft);
}
.act-del-txt {
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .2em;
  color: var(--acc-deep);
}
.act-del-active { background: var(--acc-soft); }
.act-cancel {
  margin-top: 12rpx;
  padding: 24rpx 0 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: .22em;
  color: var(--ink-faint);
}
.act-cancel-active { color: var(--acc); }
.fb-grid .act-item { width: 50%; }       /* 意见反馈原因：2×2 */

/* ═══ v1.2 气泡内容升级：Markdown 完整渲染（墨韵：代码块深墨底浅字 / 表格细线 / 引用左线） ═══ */

/* 段落（正文继承 .jz-body 的字体/行高；break-all 防超长链接/连续字符穿泡） */
.md-p { margin: 0 0 10rpx; word-break: break-all; }
.md-p:last-child { margin-bottom: 0; }
.md-it { display: inline; }
.md-strong { font-weight: 700; color: var(--ink); }
.md-em { font-style: italic; }
.md-icode {
  font-family: var(--font-lat);
  font-size: 24rpx;
  color: var(--acc-deep);
  background: var(--acc-soft);
  border-radius: 4rpx;
  padding: 0 7rpx;
  word-break: break-all;
}
.md-link { color: var(--acc); text-decoration: underline; word-break: break-all; }
/* 图片：气泡内直接显示（圆角墨框，最大宽度 ~100%，mode=widthFix 高度自适应） */
.md-image {
  display: block;
  max-width: 100%;
  border-radius: 10rpx;
  border: 2rpx solid var(--line-med);
  background: var(--paper-deep);
  margin: 6rpx 0;
}

/* 标题（墨韵：不抢正文，行距收紧） */
.md-h {
  font-family: var(--font-song);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: .04em;
  margin: 14rpx 0 10rpx;
}
.md-h1 { font-size: 34rpx; }
.md-h2 { font-size: 32rpx; margin-top: 12rpx; }
.md-h3 { font-size: 30rpx; margin-top: 10rpx; }
.md-h4, .md-h5, .md-h6 { font-size: 29rpx; margin-top: 8rpx; }


.md-codeblock {
  margin: 12rpx 0;
  border-radius: 8rpx;
  background: #2B2620;
  border: 2rpx solid var(--line-med);
  overflow: hidden;
}
.md-code-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 18rpx;
  background: rgba(245, 239, 225, .05);
  border-bottom: 1rpx solid rgba(245, 239, 225, .14);
}
.md-code-lang {
  font-family: var(--font-lat);
  font-size: 18rpx;
  letter-spacing: .08em;
  color: rgba(237, 230, 220, .55);
}
.md-code-copy {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .1em;
  color: rgba(237, 230, 220, .75);
  border: 1rpx solid rgba(237, 230, 220, .25);
  border-radius: 5rpx;
  padding: 4rpx 14rpx;
}
.md-code-copy-active { background: rgba(237, 230, 220, .16); }
.md-code-body {
  display: block;
  padding: 16rpx 18rpx;
  font-family: var(--font-lat);
  font-size: 23rpx;
  line-height: 1.65;
  color: #EDE6DC;               /* 浅字 */
  white-space: pre-wrap;
  word-break: break-all;
}

/* 引用：左线（朱砂） */
.md-quote {
  margin: 10rpx 0;
  padding: 6rpx 0 6rpx 20rpx;
  border-left: 4rpx solid var(--acc);
  color: var(--ink-soft);
}
.md-quote .md-p { margin-bottom: 6rpx; }

/* 列表 */
.md-list { margin: 8rpx 0; }
.md-li {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 4rpx 0;
}
.md-li-mark {
  flex-shrink: 0;
  min-width: 30rpx;
  text-align: center;
  font-family: var(--font-lat);
  font-size: 24rpx;
  color: var(--acc);
}
.md-li-body { flex: 1; }

/* 表格：细线网格（flex 均分对齐） */
.md-table-wrap { margin: 12rpx 0; overflow-x: auto; }
.md-table {
  border: 1rpx solid var(--line-med);
  border-radius: 6rpx;
  overflow: hidden;
}
.md-tr {
  display: flex;
  border-bottom: 1rpx solid var(--line-soft);
}
.md-tr:last-child { border-bottom: none; }
.md-th { background: var(--tag-bg); }
.md-th .md-cell { color: var(--ink); font-weight: 700; }
.md-cell {
  flex: 1;
  min-width: 0;
  padding: 10rpx 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  border-right: 1rpx solid var(--line-soft);
  word-break: break-all;
}
.md-cell:last-child { border-right: none; }

/* ═══ v1.2 建议卡片（墨韵白卡 + 朱砂描边，点击直接发送追问） ═══ */
.sug-card {
  margin-top: 20rpx;
  padding: 18rpx 22rpx 10rpx;
  background: var(--paper);
  border: 2rpx solid var(--acc-line);
  border-radius: 10rpx;
}
.sug-head { margin-bottom: 4rpx; }
.sug-title {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: .18em;
  color: var(--acc);
}
.sug-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.sug-item:last-child { border-bottom: none; }
.sug-txt {
  flex: 1;
  font-family: var(--font-song);
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--ink-mid);
}
.sug-arrow {
  flex-shrink: 0;
  font-family: var(--font-song);
  font-size: 18rpx;
  letter-spacing: .08em;
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
}
.sug-item-active { background: var(--acc-soft); }

/* ═══ Task 8 对话内引导卡跳转按钮（AI 回复含 /pages/ 路径 → 墨韵小钮） ═══ */
.nav-btn {
  margin-top: 17rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 11rpx 22rpx;
  background: var(--paper);
  border: 2rpx solid var(--acc-line);
  border-radius: 8rpx;
}
.nav-btn-active { background: var(--acc-soft); }
.nav-btn-txt {
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .1em;
  color: var(--acc);
}
.nav-btn-arrow { width: 27rpx; height: 19rpx; }

/* ═══ v1.2 表情反应（气泡角小 emoji + 弹层宫格） ═══ */
.reaction-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}
.reaction-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 52rpx;
  height: 44rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  font-size: 26rpx;
}
.reaction-chip-active { border-color: var(--acc); background: var(--acc-soft); }
.react-add-txt { font-size: 30rpx; color: var(--ink-faint); }
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  padding: 6rpx 0 22rpx;
}
.emoji-cell {
  width: 92rpx;
  height: 92rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
}
.emoji-cell.on { border-color: var(--acc); background: var(--acc-soft); }
.emoji-cell-active { transform: scale(.92); }

/* ═══ v1.2 图片消息预留（圆角墨框） ═══ */
.msg-img {
  display: block;
  max-width: 100%;
  border-radius: 10rpx;
  border: 2rpx solid var(--line-med);
  background: var(--paper-deep);
}
.user-note .msg-img { margin-bottom: 12rpx; }
.jz-body .msg-img { margin-bottom: 10rpx; }

/* ═══════════════════════════════════════════════════════════════
   Task 8 · 深夜模式（方案·灯下漫谈）
   夜色宣纸主题卡组：深一档暖纸 + 灯笼暖光 + 朱砂点睛（根 .night 变量级联）
   ═══════════════════════════════════════════════════════════════ */

/* ── 深夜标识条（灯笼 + 灯下漫谈 + 倾诉临时提示，浮于消息区顶部） ── */
.night-head {
  position: absolute;
  top: calc(215rpx + var(--nav-off));
  left: 35rpx;
  right: 35rpx;
  z-index: 31;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 22rpx;
  background: var(--gold-soft);
  border: 2rpx solid var(--gold-soft);
  border-radius: 24rpx;
  font-family: var(--font-kai);
  font-size: 22rpx;
  letter-spacing: .18em;
  color: var(--gold);
  box-shadow: 0 4rpx 14rpx var(--shadow-sm);
}
.night-lantern { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.night-head-sub {
  font-family: var(--font-song);
  font-size: 17rpx;
  letter-spacing: .12em;
  color: var(--ink-soft);
}

/* ── 枕边灯语卡（23:00-01:00） ── */
.lamp-card {
  position: absolute;
  top: calc(302rpx + var(--nav-off));
  left: 35rpx;
  right: 35rpx;
  z-index: 31;
  padding: 24rpx 26rpx 21rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--gold);
  border-radius: 12rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}
.lamp-title {
  font-family: var(--font-kai);
  font-size: 23rpx;
  letter-spacing: .3em;
  color: var(--gold);
  margin-bottom: 13rpx;
}
.lamp-text {
  font-family: var(--font-kai);
  font-size: 28rpx;
  line-height: 1.9;
  letter-spacing: .05em;
  color: var(--ink);
}
.lamp-actions {
  display: flex;
  align-items: center;
  gap: 13rpx;
  margin-top: 19rpx;
  flex-wrap: wrap;
}
.lamp-btn {
  padding: 9rpx 19rpx;
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: .12em;
  color: var(--acc);
  border: 2rpx solid var(--acc-line);
  border-radius: 6rpx;
  background: var(--paper);
}
.lamp-btn-active { background: var(--acc-soft); }
.lamp-btn-muted { color: var(--ink-faint); border-color: var(--line); }
.lamp-btn-timer { color: var(--ink-soft); }

/* ── 挽留条 / 0 点后劝睡（浮于输入条上方） ── */
.night-keep {
  position: absolute;
  left: 35rpx;
  right: 35rpx;
  bottom: calc(173rpx + var(--inputbar-h) + 20rpx);
  z-index: 31;
  padding: 16rpx 24rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--gold-soft);
  border-radius: 22rpx;
  font-family: var(--font-kai);
  font-size: 23rpx;
  letter-spacing: .1em;
  text-align: center;
  color: var(--ink-mid);
  box-shadow: 0 4rpx 16rpx var(--shadow);
}

/* ── 「要我记得吗」提示卡 ── */
.keep-prompt {
  position: absolute;
  left: 35rpx;
  right: 35rpx;
  bottom: calc(173rpx + var(--inputbar-h) + 20rpx);
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx 24rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--acc);
  border-radius: 12rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}
.kp-q {
  flex: 1;
  font-family: var(--font-kai);
  font-size: 25rpx;
  letter-spacing: .06em;
  color: var(--ink);
}
.kp-btns { display: flex; gap: 13rpx; flex-shrink: 0; }
.kp-btn {
  padding: 11rpx 23rpx;
  font-family: var(--font-song);
  font-size: 21rpx;
  letter-spacing: .14em;
  color: #FFF8EC;
  background: var(--acc);
  border-radius: 7rpx;
}
.kp-btn-no {
  color: var(--ink-soft);
  background: var(--paper);
  border: 2rpx solid var(--line);
}
.kp-btn-active { opacity: .82; }

/* ── 12356 心理援助安全条 ── */
.safety-card {
  position: absolute;
  left: 35rpx;
  right: 35rpx;
  bottom: calc(173rpx + var(--inputbar-h) + 20rpx);
  z-index: 40;
  padding: 21rpx 25rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--acc-deep);
  border-radius: 12rpx;
  box-shadow: 0 6rpx 20rpx var(--shadow-lg);
}
.safety-head {
  font-family: var(--font-song);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: .16em;
  color: var(--acc-deep);
  margin-bottom: 10rpx;
}
.safety-card text {
  font-family: var(--font-song);
  font-size: 23rpx;
  line-height: 1.8;
  letter-spacing: .04em;
  color: var(--ink-mid);
}
