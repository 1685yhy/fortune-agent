<view class="screen" style="--nav-off:{{navOff}}px">
  <view class="navrow">
    <view class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goBack">
      <image class="back-icon" src="/assets/images/ic-back.png"></image>
    </view>
    <view class="nav-title">
      <text>分享笺</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <!-- Canvas 2d 绘制分享卡（画布随内容高度动态，固定屏幕外） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas-off"></canvas>

  <scroll-view scroll-y class="share-scroll">
    <!-- 生成中 -->
    <view wx:if="{{generating}}" class="sh-loading">
      <view class="inkdot"></view>
      <view class="inkdot"></view>
      <view class="inkdot"></view>
      <text class="sh-loading-txt">研墨绘笺中…</text>
    </view>

    <!-- 预览：生成的分享卡图片（等比缩放到屏宽） -->
    <block wx:elif="{{imgPath}}">
      <view class="sh-head">
        <view class="sh-title">夜话拾笺</view>
        <view class="sh-sub">{{dateText}} · 明灯摘选你与灯下的几段对话</view>
      </view>
      <image class="sh-card" src="{{imgPath}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>

      <!-- 问答同构预览（文字版，随图确认内容） -->
      <view class="sh-msgs">
        <block wx:for="{{pairs}}" wx:key="index">
          <view wx:if="{{item.u}}" class="sh-u"><text class="sh-q">问</text><text>{{item.u}}</text></view>
          <view class="sh-a">
            <text class="sh-tag">{{item.tag}}</text>
            <text class="sh-ai">{{item.content}}</text>
          </view>
        </block>
      </view>

      <!-- 分隔线：内容区与分享渠道之间（元宝式分享面板布局，参考 ref_3） -->
      <view class="sh-divider">
        <view class="sh-div-line"></view>
        <view class="sh-div-diamond"></view>
        <view class="sh-div-line"></view>
      </view>

      <!-- 分享渠道区（元宝式：图标+文字并排的渠道列表，与长按菜单同构） -->
      <view class="sh-channels">
        <button class="ch-row" hover-class="ch-row-active" hover-stay-time="0" open-type="share">
          <view class="ch-ic"><image class="ch-ic-img" src="/assets/images/ic-chat.png"></image></view>
          <text class="ch-label">微信好友</text>
        </button>
        <view class="ch-row" hover-class="ch-row-active" hover-stay-time="0" bindtap="onChannelTimeline">
          <view class="ch-ic"><image class="ch-ic-img" src="/assets/images/ic-camera.png"></image></view>
          <text class="ch-label">朋友圈</text>
        </view>
        <view class="ch-row" hover-class="ch-row-active" hover-stay-time="0" bindtap="onChannelImage">
          <view class="ch-ic"><image class="ch-ic-img" src="/assets/images/ic-image.png"></image></view>
          <text class="ch-label">生成分享图</text>
        </view>
        <view class="ch-row" hover-class="ch-row-active" hover-stay-time="0" bindtap="onChannelLink">
          <view class="ch-ic"><image class="ch-ic-img" src="/assets/images/ic-link.png"></image></view>
          <text class="ch-label">复制链接</text>
        </view>
      </view>
      <view class="sh-note">{{hasQr ? '长按图片也可保存 · 分享图含品牌二维码，可扫码继续对话' : '长按图片也可保存 · 当前未含品牌二维码，网络恢复后重新生成即可'}}</view>
    </block>

    <!-- 生成失败兜底 -->
    <view wx:else class="sh-loading">
      <text class="sh-loading-txt">生成失败，请返回重试</text>
    </view>
  </scroll-view>
</view>
