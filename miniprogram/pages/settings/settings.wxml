<!-- 设置 — 墨韵纸笺：账号与登录 / 账号信息 / 关于与隐私 / 数据说明 / 危险区注销
     设置入口重构：登录·退出·更换账号·注销 自 me 页收进此页（me 页不再单独摆登录按钮） -->
<view class="screen" style="--nav-off:{{navOff}}px">
  <view class="navrow">
    <view class="back" hover-class="navrow-hover" hover-stay-time="0" bindtap="goBack">
      <image class="back-icon" src="/assets/images/ic-back.png"></image>
    </view>
    <view class="nav-title">
      <text>设置</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <scroll-view scroll-y class="st-scroll">
    <!-- Task5 滚动条修复（同 chat/history/me）：padding 归内层容器，scroll-view 自身无 padding -->
    <view class="st-inner">
    <!-- 账号与登录：未登录=微信登录入口；已登录=头像/昵称 + 退出登录/更换账号 -->
    <view class="op-label"><text>账号与登录</text></view>
    <view class="papercard me-list">
      <view wx:if="{{loggedIn}}" class="st-acct">
        <image wx:if="{{avatarUrl}}" class="seal-avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="seal seal-88"><text class="seal-char">明</text></view>
        <view class="st-acct-info">
          <view class="hs-name-row">
            <view class="hs-name">{{displayName}}</view>
            <view class="hs-tag {{realLogin ? 'hs-tag-real' : 'hs-tag-local'}}" wx:if="{{loginTag}}">{{loginTag}}</view>
          </view>
          <view class="hs-sub">身份凭证 · 加密存储</view>
        </view>
      </view>
      <view wx:if="{{loggedIn}}" class="st-acct-btns">
        <view class="btn-ghost-row" hover-class="acct-btn-active" hover-stay-time="0" bindtap="onLogoutTap">退出登录</view>
        <view class="btn-ink-row" hover-class="acct-btn-active" hover-stay-time="0" bindtap="onSwitchAccountTap">更换账号</view>
      </view>
      <view wx:else class="st-login" hover-class="st-login-active" hover-stay-time="0" bindtap="onLoginTap">
        <view class="seal st-login-seal"><text class="seal-char">登</text></view>
        <view class="st-login-txt">
          <view class="st-login-title">微信登录</view>
          <view class="st-login-sub">静默登录 · 灯油命书随身行</view>
        </view>
        <view class="mr-chev"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
    </view>

    <!-- 账号信息：当前登录态三态（微信登录 / 体验用户 / 未登录）+ 手机号绑定（Task 2） -->
    <view class="op-label"><text>账号信息</text></view>
    <view class="papercard me-list">
      <view class="me-row row-line">
        <view class="mr-ic"><image src="/assets/images/ic-seal.png"></image></view>
        <view class="mr-label">当前登录态</view>
        <view class="mr-val">{{identityText}}</view>
      </view>
      <view class="me-row">
        <view class="mr-ic"><image src="/assets/images/ic-moon.png"></image></view>
        <view class="mr-label">手机号</view>
        <view wx:if="{{phoneBound}}" class="mr-val">{{phoneMasked}}</view>
        <button wx:elif="{{realLogin}}" class="st-phone-bind-btn" disabled="{{phoneLoading}}"
          open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">{{phoneLoading ? '绑定中…' : '未绑定 · 点击绑定'}}</button>
        <view wx:else class="mr-val">未绑定</view>
      </view>
    </view>

    <!-- 消息订阅（spec 三·订阅管理：晨笺/晚安开关、时间自选、个性化私语、服务号绑定态）
         红线：开关关闭即 PUT enabled:false，绝不默认推送；未绑定仅提示不阻塞本页操作 -->
    <view class="op-label"><text>消息订阅</text></view>
    <view class="papercard me-list">
      <view class="me-row row-line">
        <view class="mr-ic"><image src="/assets/images/ic-bell.png"></image></view>
        <view class="stj-whisper-col">
          <view class="mr-label">晨笺 · 早安运势</view>
          <view class="stj-whisper-sub">每天早晨推送今日宜忌与一句古籍金句</view>
        </view>
        <switch class="stj-switch" checked="{{jianEnabled}}" disabled="{{jianLoading}}" bindchange="onJianSwitch" color="#A93A2C" />
      </view>
      <view class="me-row row-line">
        <view class="mr-ic"><image src="/assets/images/ic-moon.png"></image></view>
        <view class="stj-whisper-col">
          <view class="mr-label">晚安 · 灯下陪伴</view>
          <view class="stj-whisper-sub">每晚陪你一段灯下私语与晚安金句</view>
        </view>
        <switch class="stj-switch" checked="{{nightEnabled}}" disabled="{{jianLoading}}" bindchange="onNightSwitch" color="#A93A2C" />
      </view>
      <view class="me-row row-line">
        <view class="mr-ic"><image src="/assets/images/ic-bell.png"></image></view>
        <view class="stj-whisper-col">
          <view class="mr-label">择日提醒</view>
          <view class="stj-whisper-sub">选定吉日前1天晚与当天早各提醒一次</view>
        </view>
        <switch class="stj-switch" checked="{{zeriReminder}}" disabled="{{zeriLoading}}" bindchange="onZeriReminderSwitch" color="#A93A2C" />
      </view>
      <!-- zeriLoading 期间不渲染绑定行，避免 prefs 未加载时绑定的用户闪现"未绑定"；
           fix-later: 原条件 (zeriInvalid || !zeriBound) 下"已绑定"不可达——已绑定即整行隐藏。
           简化为可达两态：未绑定+点击绑定 / 已绑定+脱敏号（复用手机号绑定 phoneMasked），
           订阅失效态保留。开关逻辑在上一行 switch，不受影响。 -->
      <view wx:if="{{!zeriLoading}}" class="me-row row-line stj-bind-row">
        <view class="mr-ic"><image src="/assets/images/ic-bell.png"></image></view>
        <view class="stj-bind-col">
          <view class="stj-bind-line">
            <view class="mr-label">择日推送</view>
            <view class="stj-bind-state {{zeriBound ? 'stj-bound' : ''}}">{{zeriInvalid ? '订阅已失效' : (zeriBound ? '已绑定' : '未绑定')}}</view>
          </view>
          <view wx:if="{{zeriInvalid}}" class="stj-bind-hint">推送连续失败，订阅已失效 · 请重新绑定</view>
          <view wx:elif="{{zeriBound}}" class="stj-bind-hint">服务号已绑定{{phoneMasked ? ' · ' + phoneMasked : ''}}</view>
          <view wx:else class="stj-bind-hint">关注服务号后可接收择日提醒</view>
        </view>
        <view wx:if="{{zeriInvalid || !zeriBound}}" class="stj-bind-btn" hover-class="stj-btn-active" hover-stay-time="0" bindtap="goJianOnboard">{{zeriInvalid ? '重新绑定' : '去绑定'}}</view>
      </view>
      <picker mode="selector" range="{{morningOptions}}" value="{{morningIdx}}" bindchange="onMorningPick">
        <view class="me-row row-line {{jianEnabled ? '' : 'stj-pick-dis'}}" hover-class="me-row-active" hover-stay-time="0">
          <view class="mr-ic"><image src="/assets/images/ic-seal.png"></image></view>
          <view class="stj-pick-col">
            <view class="mr-label">晨笺送达时间</view>
            <view class="stj-pick-range">06:00 - 10:00</view>
          </view>
          <view class="stj-pick-hint">点按修改</view>
          <view class="stj-time">{{morningTime}}</view>
          <view class="mr-chev"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
        </view>
      </picker>
      <picker mode="selector" range="{{nightOptions}}" value="{{nightIdx}}" bindchange="onNightPick">
        <view class="me-row {{nightEnabled ? '' : 'stj-pick-dis'}}" hover-class="me-row-active" hover-stay-time="0">
          <view class="mr-ic"><image src="/assets/images/ic-seal.png"></image></view>
          <view class="stj-pick-col">
            <view class="mr-label">晚安送达时间</view>
            <view class="stj-pick-range">21:00 - 23:45</view>
          </view>
          <view class="stj-pick-hint">点按修改</view>
          <view class="stj-time">{{nightTime}}</view>
          <view class="mr-chev"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
        </view>
      </picker>
      <view class="me-row row-line">
        <view class="mr-ic"><image src="/assets/images/ic-book2.png"></image></view>
        <view class="stj-whisper-col">
          <view class="mr-label">个性化私语</view>
          <view class="stj-whisper-sub">推送里加一句记得你的事 · 关闭后回到纯金句模式</view>
        </view>
        <switch class="stj-switch" checked="{{whisper}}" bindchange="onWhisperSwitch" color="#A93A2C" />
      </view>
      <view class="me-row {{bound ? '' : 'stj-bind-row'}}">
        <view class="mr-ic"><image src="/assets/images/ic-bell.png"></image></view>
        <view class="stj-bind-col">
          <view class="stj-bind-line">
            <view class="mr-label">服务号推送</view>
            <view class="stj-bind-state {{bound ? 'stj-bound' : ''}}">{{invalid ? '订阅已失效' : (bound ? '已绑定' : '未绑定')}}</view>
          </view>
          <view wx:if="{{invalid}}" class="stj-bind-hint">推送连续失败，订阅已失效 · 请重新绑定</view>
          <view wx:elif="{{!bound}}" class="stj-bind-hint">关注服务号后可开启每日推送</view>
        </view>
        <view wx:if="{{invalid || !bound}}" class="stj-bind-btn" hover-class="stj-btn-active" hover-stay-time="0" bindtap="goJianOnboard">{{invalid ? '重新绑定' : '去绑定'}}</view>
      </view>
    </view>
    <view class="stj-note">每天早/晚一条运势推送 · 随时可改可关 · 未开启绝不推送</view>

    <!-- 深夜陪伴(方案·灯下漫谈:时段档位/动效/挽留/灯语定时/私语/倾诉说明) -->
    <view class="op-label"><text>深夜陪伴</text></view>
    <view class="papercard me-list">
      <view class="me-row row-line" hover-class="me-row-active" hover-stay-time="0">
        <text class="me-label">深夜时段</text>
        <picker range="{{nightPresetLabels}}" value="{{nightPresetIdx}}" bindchange="onNightPresetChange">
          <view class="me-val">{{nightPresetLabels[nightPresetIdx]}} ▾</view>
        </picker>
      </view>
      <view class="me-row row-line">
        <text class="me-label">点灯动效</text>
        <switch class="stj-switch" checked="{{nightEffectOn}}" disabled="{{nightLoading}}" bindchange="onNightEffectSwitch" color="#A93A2C" />
      </view>
      <view class="me-row row-line">
        <text class="me-label">深夜挽留</text>
        <switch class="stj-switch" checked="{{nightKeepOn}}" disabled="{{nightLoading}}" bindchange="onNightKeepSwitch" color="#A93A2C" />
      </view>
      <view class="me-row row-line">
        <text class="me-label">灯语定时关闭</text>
        <picker range="{{lampTimerOptions}}" value="{{lampTimerIdx}}" bindchange="onLampTimerChange">
          <view class="me-val">{{lampTimerOptions[lampTimerIdx]}} 分钟 ▾</view>
        </picker>
      </view>
      <view class="me-row">
        <text class="me-label">私语(联动晨笺)</text>
        <switch class="stj-switch" checked="{{whisperOn}}" disabled="{{nightLoading}}" bindchange="onNightWhisperSwitch" color="#A93A2C" />
      </view>
    </view>
    <view class="stj-note">今夜说的话,天亮就忘。想让我记住的,点那里。</view>
    <view class="stj-note">关闭私语后,灯语与晨笺只出宜忌金句。</view>

    <!-- 关于与隐私：灯下契约 / 秉烛之约 -->
    <view class="op-label"><text>关于与隐私</text></view>
    <view class="papercard me-list">
      <view class="me-row row-line" hover-class="me-row-active" hover-stay-time="0" bindtap="goPrivacy">
        <view class="mr-ic"><image src="/assets/images/ic-book2.png"></image></view>
        <view class="mr-label">隐私政策</view>
        <view class="mr-val">灯下契约</view>
        <view class="mr-chev"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
      <view class="me-row" hover-class="me-row-active" hover-stay-time="0" bindtap="goAgreement">
        <view class="mr-ic"><image src="/assets/images/ic-book2.png"></image></view>
        <view class="mr-label">用户协议</view>
        <view class="mr-val">秉烛之约</view>
        <view class="mr-chev"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
    </view>

    <!-- 数据说明（同 me 页原 sn-body 文案） -->
    <view class="sec-note">
      <text class="sn-title">安全与数据</text>
      <text class="sn-body">对话与命书加密存储；昵称、称呼与关系、收藏、择日计划与灯语为明文存储。你的内容不会公开展示（为生成回应会交给第三方大模型），只有你主动分享出去的链接拿到即可打开（对话分享链接与报告分享页都是 30 天后自动失效，注销时你分享出去的链接会立即删除）。退出登录不影响本地灯油与命书；注销后登录入口立即关闭，账号内数据保留 90 天后由清理任务删除（你上传的图片、头像与记忆文件同样在清理范围内），唯支付流水依《电子商务法》第三十一条按法定期限留存。注销没有自助恢复入口，如需找回请在保留期内尽快联系我们，能否找回取决于备份是否仍覆盖，我们无法保证。</text>
    </view>

    <!-- 危险区（朱砂注销 · 二次确认） -->
    <view class="op-label"><text>危险区</text></view>
    <view class="papercard me-list">
      <view class="me-row danger-row" hover-class="me-row-active" hover-stay-time="0" bindtap="onDeregTap">
        <view class="mr-ic"><image src="/assets/images/ic-moon.png"></image></view>
        <view class="mr-label mr-label-danger">注销账号</view>
        <view class="mr-val">注销后无法自助恢复</view>
        <view class="mr-chev"><image class="chev" src="/assets/images/ic-chev.png"></image></view>
      </view>
    </view>

    <view class="me-foot">秉烛而谈 · 灯火长明</view>
    </view>
  </scroll-view>

  <!-- 更换账号说明弹层（原型 dir_o：将退出当前账号，可登录其他微信） -->
  <view class="acct-mask" wx:if="{{switchDialogVisible}}" catchtouchmove="noop" bindtap="closeSwitchDialog">
    <view class="acct-card" catchtap="noop">
      <view class="acct-card-title">更换账号</view>
      <view class="acct-card-body">
        <text>将退出当前账号并刷新登录态。微信登录始终使用</text><text class="mb-strong">当前微信账号</text><text>——</text>
        <text>如需其他微信，请先在微信内「我-设置-切换账号」，再回来继续。</text>
        <text>当前账号的灯油、命书与手记</text><text class="mb-strong">不会丢失</text><text>。</text>
      </view>
      <view class="acct-card-note">登录新账号后，本地数据按新账号重新建档</view>
      <view class="acct-card-actions">
        <view class="btn-ghost-row" hover-class="acct-btn-active" hover-stay-time="0" bindtap="closeSwitchDialog">取消</view>
        <view class="btn-ink-row" hover-class="acct-btn-active" hover-stay-time="0" bindtap="confirmSwitchAccount">去换账号</view>
      </view>
    </view>
  </view>

  <!-- 注销账号弹层（朱砂警示 · 输入「注销」二字确认，不匹配按钮禁用） -->
  <view class="acct-mask" wx:if="{{deregDialogVisible}}" catchtouchmove="noop" bindtap="closeDeregDialog">
    <view class="acct-card" catchtap="noop">
      <view class="acct-card-title danger">
        <view class="seal title-seal"><text class="seal-char">销</text></view>
        <text>注销账号</text>
      </view>
      <view class="acct-card-body">
        <text>注销后登录入口立即关闭，对话、命书、收藏与解梦手记</text><text class="mb-strong">无法自助恢复</text><text>（如需找回请在保留期内尽快联系我们，能否找回取决于备份，我们不保证）；</text>
        <text>你分享出去的链接会立即删除；其余数据保留 90 天后逐项删除（你上传的图片与头像也在清理范围内，支付流水等依法需留存的交易记录除外）。</text>
      </view>
      <view class="acct-card-note">此操作不可撤销 · 请慎重</view>
      <input class="acct-input" value="{{deregInput}}" bindinput="onDeregInput"
        placeholder="输入「注销」二字确认" placeholder-class="acct-ph" confirm-type="done" />
      <view class="acct-card-actions">
        <view class="btn-ghost-row" hover-class="acct-btn-active" hover-stay-time="0" bindtap="closeDeregDialog">保留账号</view>
        <view class="btn-acc-row {{deregInput !== '注销' ? 'disabled' : ''}}" hover-class="acct-btn-active" hover-stay-time="0" bindtap="confirmDereg">确认注销</view>
      </view>
    </view>
  </view>

  <!-- 注销成功页（原型 GoneScreen：账号已注销 · 感谢相伴） -->
  <view wx:if="{{deregDone}}" class="gone-screen" catchtouchmove="noop">
    <image class="gone-lantern" src="/assets/images/lantern.jpg"></image>
    <view class="gs-title">账号已注销</view>
    <view class="gs-sub">你的对话、命书与手记将保留 90 天
之后清除 · 不会再收到消息打扰 · 愿你前路有光</view>
    <view class="gs-line"></view>
    <view class="gs-poem">感谢相伴，灯火长明。</view>
    <view class="gs-btn" hover-class="acct-btn-active" hover-stay-time="0" bindtap="onDeregGoneBack">回到首页</view>
    <view class="gs-note">此账号在保留期内无法登录；保留期满数据清除后，用同一个微信登录会重新开始</view>
  </view>
</view>
