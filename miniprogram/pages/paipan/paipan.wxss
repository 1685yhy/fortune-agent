/* ═══════════════════════════════════════════════════════════════
   排盘结果页（L4）— 原型 index.html 墨韵盘面逐组件搬运（1px≈2rpx）
   视觉基准：宣纸 #F5EFE1 / 墨 #3A2C1E / 朱砂 #A93A2C / 金 #B08A4F
   变量全部复用 app.wxss page 级 :root（--ink/--acc/--gold/--paper/--line/--font-*）
   五行色原型 :root 独有（--wx-*），此处页级定义
   ═══════════════════════════════════════════════════════════════ */

page {
  /* 五行色（原型 :root 独有 → 页级补齐，映射关系与原型一致） */
  --wx-mu: #4E6B4A; --wx-huo: #A93A2C; --wx-tu: #8A6A44;
  --wx-jin: #B08A4F; --wx-shui: #4A6B7A;
}

.pp-page, .pp-input { padding: 24rpx 30rpx 60rpx; }

/* ════════ ① 输入区 ════════ */

.input-head { display: flex; align-items: center; gap: 20rpx; padding: 30rpx 10rpx 22rpx; }
.input-seal {
  width: 78rpx; height: 78rpx; flex-shrink: 0; border-radius: 10rpx;
  background: var(--acc); box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 4rpx 10rpx rgba(60,30,20,.25);
  display: flex; align-items: center; justify-content: center;
}
.input-seal-char { font-family: var(--font-kai); font-size: 42rpx; color: #FBF6E8; line-height: 1; }
.input-mid { min-width: 0; }
.input-title { display: block; font-family: var(--font-song); font-weight: 700; font-size: 40rpx; letter-spacing: .2em; color: var(--ink); }
.input-sub { display: block; margin-top: 6rpx; font-family: var(--font-song); font-size: 22rpx; letter-spacing: .14em; color: var(--ink-soft); }

/* Q3 未建档引导条（批次2 收尾）：无档案落地本页 → 建档口径引导，today E1 提示条同款样式 */
.pp-noarch {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--paper-card);
  box-shadow: 0 8rpx 23rpx var(--shadow-sm);
}
.pp-noarch-seal {
  width: 62rpx; height: 62rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
  background: var(--acc);
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12);
  display: flex; align-items: center; justify-content: center;
  transform: rotate(-2deg);
}
.pp-noarch-seal-char { font-family: var(--font-kai); font-size: 36rpx; color: #FBF6E8; line-height: 1; }
.pp-noarch-mid { flex: 1; min-width: 0; }
.pp-noarch-t {
  font-family: var(--font-song);
  font-size: 25rpx;
  color: var(--ink);
  letter-spacing: .05em;
  line-height: 1.5;
}
.pp-noarch-s {
  margin-top: 6rpx;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .08em;
  color: var(--ink-faint);
}
/* k36 A32：关闭 ×（与今日页 .noarch-tip-close 同一尺寸/字体/圆点样式族，不发明新交互） */
.pp-noarch-close {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 30rpx;
  color: var(--ink-faint);
  border-radius: 50%;
}
.pp-noarch-close-active { color: var(--acc); background: var(--acc-soft); }

.form-card {
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  padding: 8rpx 30rpx 30rpx;
  box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
}
.form-group { margin-top: 26rpx; }
.form-label { display: flex; align-items: center; gap: 10rpx; font-family: var(--font-song); font-size: 24rpx; letter-spacing: .06em; color: var(--ink-mid); margin-bottom: 14rpx; }
.form-req { font-family: var(--font-song); font-size: 20rpx; color: var(--acc); border: 2rpx solid var(--acc-line); border-radius: 5rpx; padding: 2rpx 10rpx; }
.form-opt { font-family: var(--font-song); font-size: 20rpx; color: var(--ink-faint); letter-spacing: .04em; }
.form-picker {
  padding: 24rpx;
  background: var(--paper);
  border: 2rpx solid var(--line-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink-mid);
}
.form-picker-empty { color: var(--ink-faint); }
/* k19 分钟精度：钟表时间档（10:55 场景）——时辰 picker 下补充精确输入 */
.clock-mode {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 16rpx; padding: 14rpx 18rpx;
  background: var(--paper); border: 2rpx dashed var(--line-input);
  border-radius: 12rpx;
}
.clock-mode-check {
  width: 22rpx; height: 22rpx; border-radius: 50%;
  border: 2rpx solid var(--ink-faint);
  box-sizing: border-box; flex: none;
}
.clock-mode-check.is-on {
  border: 6rpx solid var(--acc);
  background: var(--paper);
}
.clock-mode-t {
  font-family: var(--font-song); font-size: 22rpx;
  letter-spacing: .05em; color: var(--ink-mid);
}
.clock-pickers {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 16rpx; flex-wrap: wrap;
}
.clock-picker { flex: 1; min-width: 170rpx; }
.clock-picker-box {
  padding: 20rpx 10rpx; text-align: center;
  background: var(--paper); border: 2rpx solid var(--line-input);
  border-radius: 12rpx; font-size: 26rpx; color: var(--ink);
}
.clock-derived {
  flex-basis: 100%;
  font-family: var(--font-song); font-size: 20rpx;
  letter-spacing: .04em; color: var(--ink-faint);
}
/* R2-4 真太阳时开关行：左文案右 switch（产品口径：默认开=按出生地经度校准；关=北京时间直排） */
.solar-row { display: flex; align-items: center; gap: 24rpx; }
.solar-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.solar-t { font-family: var(--font-song); font-size: 24rpx; letter-spacing: .06em; color: var(--ink-mid); }
.solar-d { font-family: var(--font-song); font-size: 20rpx; color: var(--ink-faint); letter-spacing: .04em; line-height: 1.7; }
/* 性别：男/女 并排大按钮（问真式：选中朱砂底白字，未选宣纸墨框） */
.gender-group { display: flex; gap: 22rpx; }
.gender-btn {
  flex: 1; display: flex; align-items: center; justify-content: center;
  padding: 26rpx 0; border-radius: 14rpx;
  background: var(--paper); border: 2rpx solid var(--line-btn);
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.35);
}
.gender-char { font-family: var(--font-song); font-size: 32rpx; letter-spacing: .3em; color: var(--ink); text-indent: .3em; }
.gender-btn-tap { transform: translateY(2rpx); }
.gender-btn.is-on {
  background: var(--acc); border-color: var(--acc);
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 6rpx 18rpx rgba(169,58,44,.28);
}
.gender-btn.is-on .gender-char { color: #FBF6E8; font-weight: 600; }
.form-error { margin-top: 22rpx; font-family: var(--font-song); font-size: 24rpx; color: var(--acc); letter-spacing: .06em; }

.pp-btn {
  margin-top: 34rpx;
  background: var(--acc); border-radius: 12rpx;
  padding: 26rpx 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 8rpx 20rpx rgba(169,58,44,.25);
}
.pp-btn text { font-family: var(--font-song); font-weight: 600; font-size: 30rpx; letter-spacing: .34em; color: #FBF6E8; text-indent: .34em; }
.pp-btn-active { background: var(--acc-deep); }
.pp-btn-disabled { opacity: .72; }
.input-privacy { margin-top: 20rpx; text-align: center; font-family: var(--font-song); font-size: 20rpx; letter-spacing: .16em; color: var(--ink-faint); }

.pp-repick {
  margin-top: 40rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line-btn);
  border-radius: 12rpx;
  padding: 24rpx 0;
  display: flex; align-items: center; justify-content: center;
}
.pp-repick text { font-family: var(--font-song); font-size: 26rpx; letter-spacing: .3em; color: var(--ink); }

/* ════════ ② 命主信息头 ════════ */

.master-head {
  display: flex; align-items: center; gap: 24rpx; padding: 26rpx 30rpx; margin-bottom: 24rpx;
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
}
.master-seal {
  width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 12rpx;
  background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 48rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 4rpx 10rpx rgba(60,30,20,.25);
}
.master-mid { flex: 1; min-width: 0; }
.master-name { font-family: var(--font-song); font-weight: 700; font-size: 34rpx; letter-spacing: .12em; color: var(--ink); }
.master-name-sub { font-size: 20rpx; font-weight: 400; letter-spacing: .1em; color: var(--ink-soft); margin-left: 16rpx; }
.master-sub { margin-top: 6rpx; font-family: var(--font-song); font-size: 21rpx; letter-spacing: .08em; color: var(--ink-soft); }
.master-right { text-align: right; flex-shrink: 0; }
.mr-tag {
  font-family: var(--font-song); font-size: 18rpx; letter-spacing: .16em; color: var(--gold);
  border: 2rpx solid var(--gold-soft); background: rgba(176,138,79,.09); border-radius: 6rpx; padding: 6rpx 14rpx;
}
.mr-time { margin-top: 8rpx; font-family: var(--font-kai); font-size: 21rpx; letter-spacing: .06em; color: var(--ink-mid); }

/* ════════ ③ 四柱盘面（paipan-pillars） ════════
   问真式层级：柱名 → 十神小签 → 天干大字 → 地支大字 → 藏干+副星小字一行
   纳音/星运弱化为柱底小注，收进「展开」（柱身点击切换，默认收起）
   四柱等宽并排：天干地支 80rpx（40px），藏干行 17/15rpx 一行放得下 */

.pp-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 36rpx 24rpx 32rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
}
.pp-head { display: flex; align-items: center; gap: 18rpx; padding: 0 8rpx 26rpx; border-bottom: 2rpx solid var(--line-soft); }
.pp-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.pp-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.pp-head-sub { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint); }
.pp-row { display: flex; margin-top: 24rpx; }
.pp-pillar { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 2rpx 4rpx 6rpx; border-radius: 12rpx; }
.pp-pillar-tap { background: rgba(58,44,30,.05); }
.pp-pillar + .pp-pillar::before {
  content: ''; position: absolute; left: -2rpx; top: 10rpx; bottom: 10rpx; width: 2rpx; background: var(--line-soft);
}
.pp-pillar.is-day::after {
  content: ''; position: absolute; left: 6rpx; right: 6rpx; bottom: -14rpx; height: 4rpx;
  background: var(--acc); opacity: .85; border-radius: 2rpx;
}
.pp-pillar.is-day { background: linear-gradient(180deg, rgba(169,58,44,.05) 0%, transparent 72%); }
.pp-pillar.is-expanded { background: rgba(169,58,44,.045); }
.pp-ganzhi-name { font-family: var(--font-song); font-size: 19rpx; letter-spacing: .3em; color: var(--ink-faint); }
.pp-shishen {
  font-family: var(--font-song); font-size: 21rpx; letter-spacing: .14em; line-height: 1;
  color: var(--acc); background: var(--acc-soft); border: 2rpx solid rgba(169,58,44,.28);
  border-radius: 6rpx; padding: 6rpx 16rpx;
}
.pp-shishen.is-ri { color: #FBF6E8; background: var(--acc); border-color: var(--acc); box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12); }
.pp-tap { transform: translateY(2rpx); }
.pp-tg, .pp-dz { font-family: var(--font-song); font-weight: 700; font-size: 80rpx; line-height: 1.15; color: var(--ink); letter-spacing: .02em; }
/* 藏干+副星：淡墨小字一行（藏干 17rpx 中墨 · 副星 15rpx 淡墨），超宽自动折行兜底 */
.pp-canggan { display: flex; justify-content: center; align-items: baseline; gap: 6rpx; margin-top: 2rpx; flex-wrap: wrap; }
.pp-cg-item { display: inline-flex; align-items: baseline; }
.pp-cg-char { font-family: var(--font-song); font-weight: 600; font-size: 17rpx; line-height: 1.45; color: var(--ink-mid); }
.pp-cg-star { font-family: var(--font-song); font-size: 15rpx; line-height: 1.45; color: var(--ink-soft); margin-left: 2rpx; }
/* 弱化区：纳音/星运（展开后显示） */
.pp-more { display: flex; flex-direction: column; align-items: center; gap: 4rpx; margin-top: 4rpx; }
.pp-nayin { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .16em; color: var(--ink-soft); }
.pp-xingyun { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .18em; color: var(--ink-soft); }
.pp-xingyun.is-changsheng { color: var(--acc); font-weight: 600; }
.pp-more-hint {
  margin-top: 2rpx; font-family: var(--font-song); font-size: 17rpx;
  letter-spacing: .24em; color: var(--ink-faint); opacity: .8;
}
.pp-foot { margin-top: 40rpx; padding-top: 24rpx; border-top: 2rpx solid var(--line-soft); display: flex; align-items: center; gap: 16rpx; }
.pp-foot-tag {
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .14em; color: #FBF6E8;
  background: var(--ink); border-radius: 6rpx; padding: 6rpx 16rpx; flex-shrink: 0;
}
.pp-foot-txt { font-family: var(--font-kai); font-size: 23rpx; letter-spacing: .08em; color: var(--ink-mid); line-height: 1.8; }

/* ════════ ④ 司令/交运行（siling-chip） ════════ */

.sl-wrap { display: flex; gap: 16rpx; margin-top: 20rpx; }
.sl-chip {
  flex: 1; min-width: 0; background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 16rpx;
  padding: 18rpx 20rpx; display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(58,44,30,.05);
}
.sl-seal {
  width: 44rpx; height: 44rpx; flex-shrink: 0; border-radius: 6rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 25rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12);
}
.sl-mid { min-width: 0; }
.sl-name { display: block; font-family: var(--font-song); font-size: 18rpx; letter-spacing: .24em; color: var(--ink-faint); }
.sl-val { display: block; margin-top: 4rpx; font-family: var(--font-song); font-size: 24rpx; letter-spacing: .08em; color: var(--ink); }
.sl-val b { color: var(--acc); font-weight: 700; }
.sl-chip.is-gold .sl-val b { color: var(--gold); }
.sl-chip.is-gold .sl-seal { background: var(--gold); }

/* ════════ ⑤ 五行能量（wuxing-bars） ════════ */

.wx-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 32rpx 32rpx 28rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
  margin-top: 20rpx;
}
.wx-head { display: flex; align-items: center; gap: 18rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid var(--line-soft); }
.wx-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.wx-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.wx-yongshen {
  margin-left: auto; display: inline-flex; align-items: center; gap: 10rpx;
  font-family: var(--font-kai); font-size: 21rpx; letter-spacing: .14em; color: #FBF6E8;
  background: var(--acc); border-radius: 6rpx; padding: 8rpx 18rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12);
}
.wx-row { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; }
.wx-row + .wx-row { border-top: 2rpx dashed var(--line-soft); padding-top: 20rpx; }
.wx-name { width: 56rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.wx-char { font-family: var(--font-song); font-weight: 700; font-size: 29rpx; color: var(--ink); }
.wx-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.wx-dot.mu { background: var(--wx-mu); } .wx-dot.huo { background: var(--wx-huo); }
.wx-dot.tu { background: var(--wx-tu); } .wx-dot.jin { background: var(--wx-jin); } .wx-dot.shui { background: var(--wx-shui); }
.wx-bar { flex: 1; height: 20rpx; background: var(--paper-deep); border: 2rpx solid var(--line-soft); border-radius: 10rpx; overflow: hidden; }
.wx-fill { height: 100%; border-radius: 8rpx; }
.wx-fill.mu { background: linear-gradient(90deg,#4E6B4A,#6C8A64); }
.wx-fill.huo { background: linear-gradient(90deg,#A93A2C,#C25747); }
.wx-fill.tu { background: linear-gradient(90deg,#8A6A44,#A8865E); }
.wx-fill.jin { background: linear-gradient(90deg,#B08A4F,#C9A66B); }
.wx-fill.shui { background: linear-gradient(90deg,#4A6B7A,#5F889C); }
.wx-count { width: 68rpx; flex-shrink: 0; text-align: right; font-family: var(--font-song); font-size: 23rpx; color: var(--ink); }
.wx-count-unit { font-style: normal; font-size: 17rpx; color: var(--ink-soft); margin-left: 2rpx; }
.wx-wangs {
  width: 68rpx; flex-shrink: 0; text-align: center; font-family: var(--font-song); font-size: 19rpx;
  letter-spacing: .1em; border-radius: 6rpx; padding: 6rpx 0;
}
.wx-wangs.wang { color: var(--acc); background: var(--acc-soft); font-weight: 600; }
.wx-wangs.xiang { color: var(--ink-mid); background: var(--paper-deep); border: 2rpx solid var(--line-soft); }
.wx-wangs.xiu { color: var(--gold); background: rgba(176,138,79,.1); border: 2rpx solid var(--gold-soft); }
.wx-wangs.qiu { color: var(--ink-soft); border: 2rpx dashed var(--line); }
.wx-wangs.si { color: var(--ink-faint); border: 2rpx dashed var(--line-soft); }
.wx-sum { margin-top: 30rpx; padding-top: 22rpx; border-top: 2rpx solid var(--line-soft); display: flex; align-items: flex-start; gap: 16rpx; }
.wx-sum-tag {
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .14em; color: #FBF6E8;
  background: var(--ink); border-radius: 6rpx; padding: 6rpx 16rpx; flex-shrink: 0;
}
.wx-sum-txt { font-family: var(--font-kai); font-size: 23rpx; letter-spacing: .06em; color: var(--ink-mid); line-height: 1.8; }

/* ════════ ⑥ 大运时间线（dayun-timeline） ════════ */

.dy-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 32rpx 0 30rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
  margin-top: 20rpx;
}
.dy-head { display: flex; align-items: center; gap: 18rpx; padding: 0 32rpx 24rpx; border-bottom: 2rpx solid var(--line-soft); }
.dy-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.dy-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.dy-hint { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint); }
.dy-jiaoyun {
  margin: 24rpx 32rpx 0; padding: 16rpx 24rpx; background: rgba(176,138,79,.09);
  border: 2rpx solid var(--gold-soft); border-radius: 12rpx; display: flex; align-items: center; gap: 16rpx;
}
.dy-jy-seal { font-family: var(--font-kai); font-size: 21rpx; color: var(--gold); letter-spacing: .2em; white-space: nowrap; }
.dy-jy-txt { font-family: var(--font-song); font-size: 21rpx; letter-spacing: .1em; color: var(--ink-mid); }
