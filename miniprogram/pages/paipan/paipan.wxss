}
.dy-age { font-family: var(--font-song); font-size: 20rpx; letter-spacing: .12em; color: var(--ink-soft); white-space: nowrap; }
.dy-age-b { color: var(--ink); font-weight: 600; font-size: 22rpx; }
.dy-shen {
  font-family: var(--font-song); font-size: 20rpx; letter-spacing: .14em; color: var(--acc);
  background: var(--acc-soft); border-radius: 5rpx; padding: 5rpx 14rpx;
}
.dy-ganzhi { font-family: var(--font-song); font-weight: 700; font-size: 38rpx; letter-spacing: .08em; color: var(--ink); line-height: 1.2; }
.dy-step.is-current .dy-ganzhi { color: var(--acc); }
.dy-years { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .04em; color: var(--ink-faint); white-space: nowrap; }
.dy-qi {
  position: absolute; top: -16rpx; left: -12rpx; font-family: var(--font-kai); font-size: 18rpx; letter-spacing: .1em;
  color: #FBF6E8; background: var(--ink); border-radius: 6rpx; padding: 4rpx 10rpx;
}

/* ════════ ⑦ 流年胶囊（liunian-strip） ════════ */

.ln-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 32rpx 0 30rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
  margin-top: 20rpx;
}
.ln-head { display: flex; align-items: center; gap: 18rpx; padding: 0 32rpx 24rpx; border-bottom: 2rpx solid var(--line-soft); }
.ln-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.ln-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.ln-hint { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint); }
.ln-scroll { margin-top: 26rpx; overflow-x: auto; padding: 4rpx 32rpx 8rpx; white-space: nowrap; }
.ln-track { display: flex; gap: 16rpx; width: max-content; }
.ln-cap {
  width: 112rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 18rpx 4rpx 16rpx; background: var(--paper); border: 2rpx solid var(--line); border-radius: 16rpx;
  position: relative;
}
.ln-cap-tap { transform: translateY(2rpx); }
.ln-gz { font-family: var(--font-song); font-weight: 700; font-size: 32rpx; letter-spacing: .06em; color: var(--ink); line-height: 1.25; }
.ln-yr { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .08em; color: var(--ink-soft); }
.ln-cap.is-now {
  background: var(--acc); border-color: var(--acc); transform: translateY(-4rpx);
  box-shadow: 0 16rpx 32rpx rgba(169,58,44,.22); position: relative;
}
.ln-cap.is-now::after {
  content: '今年'; position: absolute; top: -16rpx; right: -8rpx;
  font-family: var(--font-kai); font-size: 17rpx; letter-spacing: .08em; color: #FBF6E8;
  background: var(--ink); border-radius: 6rpx; padding: 4rpx 10rpx;
}
.ln-cap.is-now .ln-gz { color: #FBF6E8; }
.ln-cap.is-now .ln-yr { color: rgba(251,246,232,.78); }
.ln-note { padding: 18rpx 32rpx 0; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .1em; color: var(--ink-faint); display: flex; align-items: center; gap: 12rpx; }
.ln-note::before { content: '◂'; font-size: 16rpx; color: var(--ink-faint); }

/* ════════ ⑧ 干支关系徽标（rel-badge） ════════ */

.rb-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 32rpx 32rpx 28rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
  margin-top: 20rpx;
}
.rb-head { display: flex; align-items: center; gap: 18rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid var(--line-soft); }
.rb-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.rb-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.rb-hint { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint); }
.rb-group { margin-top: 26rpx; }
.rb-gname {
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .26em; color: var(--ink-faint);
  display: flex; align-items: center; gap: 16rpx;
}
.rb-gname::after { content: ''; flex: 1; height: 2rpx; background: var(--line-soft); }
.rb-chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.rb-badge { display: inline-flex; align-items: center; gap: 14rpx; border-radius: 10rpx; padding: 12rpx 20rpx; }
.rb-tap { transform: translateY(2rpx); }
.rb-name { font-family: var(--font-song); font-weight: 600; font-size: 25rpx; letter-spacing: .14em; }
.rb-where { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .06em; opacity: .8; }
.rb-note { font-family: var(--font-kai); font-size: 21rpx; letter-spacing: .06em; opacity: .85; }
.rb-badge.is-xiong { color: var(--ink-mid); background: var(--paper-deep); border: 2rpx solid var(--line); }
.rb-badge.is-he { color: var(--acc); background: var(--acc-soft); border: 2rpx solid rgba(169,58,44,.3); }
.rb-badge.is-zhong { color: var(--gold); background: rgba(176,138,79,.1); border: 2rpx solid var(--gold-soft); }
.rb-empty { margin-top: 14rpx; font-family: var(--font-kai); font-size: 21rpx; letter-spacing: .1em; color: var(--ink-faint); }
.rb-foot { margin-top: 28rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line-soft); }
.rb-def { display: flex; flex-wrap: wrap; gap: 10rpx 28rpx; }
.rb-def text { font-family: var(--font-song); font-size: 18rpx; letter-spacing: .08em; color: var(--ink-faint); }
.rb-def-b { font-weight: 600; color: var(--ink-soft); }

/* ════════ ⑨ 神煞标签（shensha-tags） ════════ */

.ss-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 32rpx 32rpx 28rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
  margin-top: 20rpx;
}
.ss-head { display: flex; align-items: center; gap: 18rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid var(--line-soft); }
.ss-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.ss-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.ss-hint { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint); }
.ss-legend { display: flex; gap: 28rpx; margin-top: 22rpx; }
.ss-legend text { display: flex; align-items: center; gap: 10rpx; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .14em; color: var(--ink-soft); }
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; display: inline-block; }
.lg-ji { background: var(--acc); }
.lg-zhong { background: var(--gold); }
.lg-xiong { background: var(--ink-soft); }
.ss-tags { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 24rpx; }
.ss-tag {
  display: inline-flex; align-items: center; gap: 10rpx;
  font-family: var(--font-song); font-size: 23rpx; letter-spacing: .12em;
  border-radius: 8rpx; padding: 14rpx 24rpx;
}
.ss-tap { transform: translateY(2rpx); }
.ss-tag-src { font-size: 17rpx; letter-spacing: .06em; opacity: .75; }
.ss-tag.is-ji { color: var(--acc); background: var(--acc-soft); border: 2rpx solid rgba(169,58,44,.3); }
.ss-tag.is-zhong { color: var(--gold); background: rgba(176,138,79,.1); border: 2rpx solid var(--gold-soft); }
.ss-tag.is-xiong { color: var(--ink-mid); background: var(--paper-deep); border: 2rpx solid var(--line); }
.ss-foot {
  margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line-soft);
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint);
  display: flex; align-items: center; gap: 12rpx;
}
.ss-foot-b { color: var(--acc); font-weight: 600; }

/* ════════ ⑩ 称骨卡（chenggu-card） ════════ */

.cg-card {
  background: var(--paper-card); border: 2rpx solid var(--line); border-radius: 24rpx;
  padding: 36rpx 40rpx 32rpx; box-shadow: 0 20rpx 56rpx rgba(58,44,30,.07);
  margin-top: 20rpx; position: relative; overflow: hidden;
}
.cg-card::before {
  content: ''; position: absolute; top: 0; left: 48rpx; right: 48rpx; height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}
.cg-head { display: flex; align-items: center; gap: 18rpx; }
.cg-seal {
  width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 30rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.cg-title { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .3em; color: var(--ink); }
.cg-sub { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint); }
.cg-weight { text-align: center; margin-top: 34rpx; }
.cg-num { font-family: var(--font-kai); font-size: 66rpx; letter-spacing: .2em; color: var(--acc); }
.cg-source { margin-top: 10rpx; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .2em; color: var(--ink-faint); }
.cg-detail { display: flex; justify-content: center; gap: 18rpx; margin-top: 28rpx; flex-wrap: wrap; }
.cg-chip {
  position: relative; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .06em; color: var(--ink-soft);
  background: var(--paper); border: 2rpx solid var(--line); border-radius: 6rpx; padding: 8rpx 18rpx;
  display: flex; align-items: center; gap: 8rpx;
}
.cg-chip + .cg-chip::before {
  content: ''; position: absolute; left: -12rpx; top: 50%; margin-top: -3rpx;
  width: 6rpx; height: 6rpx; border-radius: 50%; background: var(--ink-faint); opacity: .65;
}
.cg-chip-w { color: var(--ink); font-weight: 600; }
.cg-chip.is-total { color: var(--acc); border-color: rgba(169,58,44,.3); background: var(--acc-soft); font-weight: 600; }
.cg-verse { margin-top: 30rpx; padding-top: 26rpx; border-top: 2rpx solid var(--line-soft); }
.cg-verse-p {
  display: block; font-family: var(--font-kai); font-size: 29rpx; line-height: 2.15; text-align: center;
  color: var(--ink); letter-spacing: .08em; white-space: pre-line;
}
.cg-verse-src { display: block; margin-top: 16rpx; text-align: center; font-size: 20rpx; letter-spacing: .24em; color: var(--ink-faint); }

/* ════════ 页脚 ════════ */

.page-foot { margin-top: 32rpx; text-align: center; }
.pf-line { width: 320rpx; height: 2rpx; margin: 0 auto 20rpx; background: linear-gradient(90deg, transparent, var(--ink-faint), transparent); }
.pf-t1, .pf-t2 { display: block; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .22em; color: var(--ink-faint); line-height: 2.1; }

/* ════════ 知识弹层（zhishi-sheet） ════════ */

.zs-mask {
  position: fixed; inset: 0; background: rgba(30,22,12,.45); z-index: 80;
  display: flex; align-items: flex-end; justify-content: center;
  visibility: hidden; opacity: 0;
  transition: opacity .22s, visibility .22s;
}
.zs-mask.zs-open { visibility: visible; opacity: 1; }
.zs-sheet {
  width: 100%; background: var(--paper-card); border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -28rpx 80rpx rgba(20,12,4,.25);
  padding: 20rpx 40rpx calc(48rpx + env(safe-area-inset-bottom, 0px));
  max-height: 64vh; display: flex; flex-direction: column;
  transform: translateY(56rpx); transition: transform .28s cubic-bezier(.22,.9,.3,1);
}
.zs-mask.zs-open .zs-sheet { transform: translateY(0); }
.zs-grip { width: 84rpx; height: 8rpx; border-radius: 4rpx; background: var(--line); margin: 4rpx auto 24rpx; }
.zs-head { display: flex; align-items: center; gap: 18rpx; }
.zs-seal {
  width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: 8rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 32rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}
.zs-kind {
  font-family: var(--font-song); font-size: 20rpx; letter-spacing: .2em; color: var(--gold);
  border: 2rpx solid var(--gold-soft); background: rgba(176,138,79,.09); border-radius: 6rpx; padding: 6rpx 14rpx;
  flex-shrink: 0;
}
.zs-name { font-family: var(--font-song); font-weight: 700; font-size: 38rpx; letter-spacing: .14em; color: var(--ink); }
.zs-src { margin-left: auto; font-family: var(--font-song); font-size: 19rpx; letter-spacing: .1em; color: var(--ink-faint); }
.zs-close {
  width: 64rpx; height: 64rpx; margin-left: 16rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-song); font-size: 30rpx; color: var(--ink-soft);
  border: 2rpx solid var(--line); border-radius: 50%;
}
.zs-close-active { color: var(--acc); border-color: var(--acc); }
.zs-tabs { display: flex; gap: 8rpx; margin-top: 28rpx; border-bottom: 2rpx solid var(--line-soft); }
.zs-tab {
  font-family: var(--font-song); font-size: 24rpx; letter-spacing: .18em; color: var(--ink-soft);
  border-bottom: 4rpx solid transparent; padding: 14rpx 28rpx;
}
.zs-tab.is-on { color: var(--acc); border-bottom-color: var(--acc); font-weight: 600; }
/* 按压反馈（wxml hover-class 引用, 原缺失 UX批2 Minor） */
.zs-tab-active { color: var(--acc); border-bottom-color: var(--acc); }
.zs-body { overflow-y: auto; margin-top: 28rpx; padding-right: 8rpx; max-height: 44vh; }
.zs-para {
  display: block; font-family: var(--font-kai); font-size: 27rpx; line-height: 2.05; color: var(--ink-mid);
  white-space: pre-line;
}
.zs-foot {
  margin-top: 28rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line-soft);
  display: flex; align-items: center; gap: 12rpx;
  font-family: var(--font-song); font-size: 19rpx; letter-spacing: .12em; color: var(--ink-faint);
}

/* ════════ ⑪ 流年详解弹层（批1：复用 zs-sheet 容器 + ss-tag/rb-badge 组件样式） ════════ */

.ln-info {
  margin-top: 26rpx; background: var(--paper); border: 2rpx solid var(--line-soft);
  border-radius: 12rpx; padding: 8rpx 24rpx;
  display: flex; flex-wrap: wrap;
}
.ln-info-item {
  width: 50%; display: flex; align-items: baseline; gap: 14rpx;
  padding: 16rpx 0; box-sizing: border-box;
}
.ln-info-item:nth-child(odd) { padding-right: 24rpx; }
.ln-info-key {
  flex-shrink: 0; font-family: var(--font-song); font-size: 19rpx;
  letter-spacing: .2em; color: var(--ink-faint);
}
.ln-info-val { font-family: var(--font-song); font-weight: 600; font-size: 26rpx; letter-spacing: .08em; color: var(--ink); }
.ln-sec { margin-top: 30rpx; padding-top: 24rpx; border-top: 2rpx solid var(--line-soft); }
.ln-sec-head { display: flex; align-items: center; gap: 14rpx; }
.ln-sec-seal {
  width: 40rpx; height: 40rpx; flex-shrink: 0; border-radius: 6rpx; background: var(--acc); color: #FBF6E8;
  font-family: var(--font-kai); font-size: 22rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12);
}
.ln-sec-title { font-family: var(--font-song); font-weight: 700; font-size: 26rpx; letter-spacing: .22em; color: var(--ink); }
.ln-legend { margin-left: auto; display: flex; gap: 20rpx; }
.ln-legend text { display: flex; align-items: center; gap: 8rpx; font-family: var(--font-song); font-size: 17rpx; letter-spacing: .1em; color: var(--ink-soft); }
.ln-tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.ln-badges { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.ln-empty {
  margin-top: 18rpx; padding: 20rpx 0; text-align: center;
  font-family: var(--font-kai); font-size: 21rpx; letter-spacing: .08em; color: var(--ink-faint);
  background: var(--paper); border: 2rpx dashed var(--line-soft); border-radius: 10rpx;
}
.ln-dayun-head {
  margin-top: 18rpx; display: flex; align-items: baseline; gap: 14rpx;
  background: var(--paper); border: 2rpx solid var(--line-soft); border-radius: 10rpx;
  padding: 14rpx 20rpx;
}
.ln-dayun-gz { font-family: var(--font-song); font-weight: 700; font-size: 30rpx; letter-spacing: .06em; color: var(--acc); }
.ln-dayun-sui { font-family: var(--font-song); font-size: 20rpx; letter-spacing: .1em; color: var(--ink-soft); flex-shrink: 0; }
.ln-dayun-note { font-family: var(--font-song); font-size: 17rpx; letter-spacing: .04em; color: var(--ink-faint); margin-left: auto; text-align: right; }

/* ═══ B3-4 排盘历史回看 + 档案预填（用户问题 #10：谁 + 什么时候 + 问的什么 + 一句话结论） ═══ */

/* 历史入口（输入区头部 / 结果区底部，hehun 同款胶囊） */
.pp-history-link {
  margin-left: auto;
  padding: 8rpx 22rpx;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .18em;
  color: var(--acc);
  background: var(--acc-soft);
  border-radius: 999rpx;
}
.pp-history-link-active { opacity: .75; }
.pp-history-row { margin-top: 24rpx; display: flex; justify-content: center; }

/* 档案预填提示条（自动预填后引导直接排盘） */
.pp-prefill {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid var(--acc-line);
  border-radius: 12rpx;
  background: var(--acc-soft);
}
.pp-prefill-seal {
  width: 46rpx; height: 46rpx; flex-shrink: 0; border-radius: 6rpx;
  background: var(--acc);
  display: flex; align-items: center; justify-content: center;
}
.pp-prefill-seal-char { font-family: var(--font-kai); font-size: 26rpx; color: #FBF6E8; line-height: 1; }
.pp-prefill-t {
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: .05em;
  color: var(--ink);
  line-height: 1.5;
}

/* 历史弹层（底部抽屉，样式同 hehun 历史弹层口径） */
.ph-mask {
  position: fixed; inset: 0; z-index: 90;
  background: rgba(0, 0, 0, .45);
}
.ph-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  height: 68vh;
  display: flex;
  flex-direction: column;
  background: var(--paper-card);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.ph-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 34rpx 16rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.ph-title {
  font-family: var(--font-song);
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: .14em;
  color: var(--ink);
}
.ph-x {
  width: 72rpx; height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--ink-soft);
  border-radius: 50%;
}
.ph-x-active { background: var(--acc-soft); color: var(--acc); }
.ph-body { flex: 1; min-height: 0; }
.ph-item {
  margin: 0 34rpx;
  padding: 26rpx 6rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.ph-item-active { background: var(--acc-soft); }
.ph-top { display: flex; align-items: baseline; gap: 14rpx; }
.ph-name {
  font-family: var(--font-song); font-weight: 700; font-size: 28rpx;
  letter-spacing: .06em; color: var(--ink);
}
.ph-time { margin-left: auto; font-size: 21rpx; color: var(--ink-faint); flex-shrink: 0; }
.ph-q {
  display: block; margin-top: 10rpx;
  font-family: var(--font-song); font-size: 22rpx; letter-spacing: .04em;
  color: var(--ink-soft); line-height: 1.6;
}
.ph-bottom { margin-top: 12rpx; display: flex; align-items: center; gap: 14rpx; }
.ph-concl {
  font-family: var(--font-song); font-size: 23rpx; letter-spacing: .05em;
  color: var(--acc);
}
.ph-bazi {
  margin-left: auto; font-size: 20rpx; letter-spacing: .14em;
  color: var(--ink-faint); flex-shrink: 0;
}
.ph-empty {
  padding: 80rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.9;
}
