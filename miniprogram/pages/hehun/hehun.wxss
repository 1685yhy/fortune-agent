/* 双人合盘 · 缘分契合 — 宣纸底 · 墨字 · 朱砂印章 · 金线分隔（墨韵） */
/* 页面根不做入场动画：transform 会形成 containing block，破坏弹层 position:fixed 定位 */
.page-hehun {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: var(--paper);
}

/* ========================================
   头部
   ======================================== */
.hh-header {
  padding: 70rpx var(--space-lg) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hh-header-seal {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: var(--acc);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
  transform: rotate(-3deg);
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}

.hh-header-seal-char {
  color: #FBF6E8;
  font-family: var(--font-brush);
  font-size: 56rpx;
  line-height: 1;
}

.hh-header-title {
  font-family: var(--font-brush);
  font-size: 44rpx;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-sm);
}

.hh-header-subtitle {
  font-size: var(--text-xs);
  color: var(--ink-soft);
  max-width: 560rpx;
  line-height: 1.6;
}

/* ========================================
   卡片
   ======================================== */
.card {
  background: var(--paper-card);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin: 0 var(--space-lg) var(--space-md);
}

.card-header {
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--line-soft);
}

.card-title {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.04em;
}

.hh-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hh-cache-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  background: var(--acc-soft);
  border-radius: 5rpx;
  vertical-align: middle;
  transform: translateY(-2rpx);
}

.hh-pick-archive {
  font-size: var(--text-xs);
  color: var(--acc);
  border: 1rpx solid var(--acc-line);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
}

.hh-pick-archive-active {
  background: var(--acc-soft);
}

/* ========================================
   表单
   ======================================== */
.form-group {
  margin-bottom: var(--space-md);
}

.form-label {
  font-size: var(--text-xs);
  color: var(--ink-soft);
  display: block;
  margin-bottom: var(--space-sm);
}

.form-required {
  font-size: 20rpx;
  color: var(--acc);
}

.form-optional {
  font-size: 20rpx;
  color: var(--ink-faint);
}

.form-picker {
  padding: var(--space-md);
  background: var(--paper);
  border: 1rpx solid var(--line-input);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  color: var(--ink-mid);
}

.form-picker-empty {
  color: var(--ink-faint);
}

.form-radio-group {
  display: flex;
  gap: var(--space-md);
}

.form-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--paper);
  border: 1rpx solid var(--line-input);
  font-size: var(--text-sm);
  color: var(--ink-soft);
  flex: 1;
}

.form-radio.active {
  border-color: var(--acc-line);
  color: var(--acc);
  background: var(--acc-soft);
}

/* ========================================
   分隔 — 缘
   ======================================== */
.hh-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-lg);
  gap: var(--space-md);
}

.hh-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(176,138,79,0) 0%, rgba(176,138,79,0.5) 50%, rgba(176,138,79,0) 100%);
}

.hh-divider-seal {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: var(--acc);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-3deg);
  flex-shrink: 0;
}

.hh-divider-seal text {
  color: #FBF6E8;
  font-family: var(--font-brush);
  font-size: 32rpx;
  line-height: 1;
}

/* ========================================
   关系标签
   ======================================== */
.hh-relation {
  padding-bottom: var(--space-lg);
}

.hh-relation-label {
  font-size: var(--text-xs);
  color: var(--ink-soft);
  margin-bottom: var(--space-sm);
}

.hh-relation-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.hh-chip {
  padding: 10rpx 30rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-input);
  background: var(--paper);
  font-size: var(--text-xs);
  color: var(--ink-soft);
}

.hh-chip-on {
  border-color: var(--acc-line);
  color: var(--acc);
  background: var(--acc-soft);
}

.hh-chip-active {
  opacity: 0.7;
}

/* ========================================
   错误 + 提交
   ======================================== */
.hh-error {
  margin: 0 var(--space-lg) var(--space-md);
  padding: var(--space-md);
  border: 1rpx solid var(--acc-line);
  background: var(--acc-soft);
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
  color: var(--acc);
  text-align: center;
}

.hh-submit-wrap {
  padding: var(--space-lg) var(--space-lg) 0;
}

.hh-submit-btn {
  width: 100%;
  padding: var(--space-sm) 0;
  border-radius: var(--radius-pill);
  background: var(--acc);
  border: none;
  font-size: var(--text-base);
  font-weight: 500;
  color: #FBF6E8;
  text-align: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hh-submit-btn[disabled] {
  opacity: 0.7;
}

.hh-submit-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-top: var(--space-sm);
  letter-spacing: 0.04em;
}

/* ========================================
   结果区 — 契合概览
   ======================================== */
.hh-results {
  padding-top: var(--space-sm);
}

.hh-overview {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xl) var(--space-lg);
}

.hh-score-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.hh-score-num {
  font-family: var(--font-lat);
  font-size: 128rpx;
  line-height: 1.1;
  color: var(--acc);
  font-weight: 600;
  letter-spacing: 0.02em;
}

.hh-score-unit {
  font-family: var(--font-kai);
  font-size: var(--text-lg);
  color: var(--acc);
  margin-left: 10rpx;
}

.hh-score-level {
  margin-top: var(--space-sm);
  font-family: var(--font-kai);
  font-size: 40rpx;
  color: var(--ink);
  letter-spacing: 0.1em;
}

.hh-score-sub {
  margin-top: var(--space-sm);
  font-size: var(--text-xs);
  color: var(--ink-soft);
  text-align: center;
  max-width: 520rpx;
  line-height: 1.6;
}

.hh-hour-note {
  margin-top: var(--space-md);
  font-size: 20rpx;
  color: var(--ink-faint);
  border: 1rpx dashed var(--line-med);
  border-radius: var(--radius-sm);
  padding: 6rpx 20rpx;
}

/* ========================================
   三维得分条
   ======================================== */
.hh-dim {
  padding: var(--space-sm) 0;
}

.hh-dim-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.hh-dim-label {
  font-size: var(--text-xs);
  color: var(--ink-mid);
}

.hh-dim-value {
  font-family: var(--font-lat);
  font-size: var(--text-sm);
  color: var(--ink);
}

.hh-dim-bar {
  height: 14rpx;
  border-radius: 7rpx;
  background: rgba(58, 44, 30, 0.08);
  overflow: hidden;
}

.hh-dim-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.5s ease;
}

.hh-dim-lock {
  display: block;
  margin-top: var(--space-sm);
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-faint);
}

/* ========================================
   缘语
   ======================================== */
.hh-yuan-line {
  display: block;
  font-family: var(--font-kai);
  font-size: var(--text-base);
  line-height: 1.9;
  letter-spacing: 0.05em;
  color: var(--ink-mid);
}

.hh-yuan-cliff {
  margin-top: var(--space-md);
  padding: var(--space-md);
  border: 1rpx dashed var(--acc-line);
  background: var(--acc-soft);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.hh-yuan-cliff-text {
  flex: 1;
  font-family: var(--font-kai);
  font-size: var(--text-sm);
  color: var(--acc);
}

.hh-yuan-expand {
  flex-shrink: 0;
  font-size: var(--text-xs);
  color: #FBF6E8;
  background: var(--acc);
  border-radius: var(--radius-pill);
  padding: 8rpx 26rpx;
}

.hh-yuan-expand-active {
  opacity: 0.8;
}

/* ========================================
   按钮行
   ======================================== */
.hh-action-row {
  display: flex;
  gap: var(--space-md);
  padding: 0 var(--space-lg);
  margin-bottom: var(--space-md);
}

.hh-action-row-sub {
  margin-bottom: var(--space-xl);
}

.hh-btn {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  padding: 0 var(--space-md);
  box-sizing: border-box;
}

.hh-btn-primary {
  background: var(--acc);
  color: #FBF6E8;
  border: none;
}

.hh-btn-gold {
  background: var(--gold);
  color: #FBF6E8;
  border: none;
}

.hh-btn-ghost {
  background: transparent;
  color: var(--ink-soft);
  border: 1rpx solid var(--line-med);
}

.hh-btn[disabled] {
  opacity: 0.7;
}

/* ========================================
   付费墙弹层
   ======================================== */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 120;
  background: rgba(58, 44, 30, 0.38);
  animation: dt-fade 0.18s ease;
}

@keyframes dt-fade { from { opacity: 0; } to { opacity: 1; } }

.paywall-sheet {
  position: fixed;
  left: 60rpx; right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 130;
  background: var(--paper-card);
  border: 1rpx solid var(--line-strong);
  border-radius: 22rpx;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  padding: var(--space-xl) var(--space-lg) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: pop-in 0.22s ease;
}

@keyframes pop-in {
  from { transform: translateY(-50%) scale(0.92); opacity: 0.4; }
  to { transform: translateY(-50%) scale(1); opacity: 1; }
}

.paywall-seal {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: var(--acc);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-3deg);
  margin-bottom: var(--space-md);
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);
}

.paywall-seal text {
  color: #FBF6E8;
  font-family: var(--font-brush);
  font-size: 44rpx;
  line-height: 1;
}

.paywall-title {
  font-family: var(--font-kai);
  font-size: var(--text-lg);
  color: var(--ink);
  letter-spacing: 0.08em;
  margin-bottom: var(--space-md);
}

.paywall-cliff {
  font-family: var(--font-kai);
  font-size: var(--text-base);
  color: var(--acc);
  text-align: center;
  margin-bottom: var(--space-md);
}

.paywall-desc {
  font-size: var(--text-xs);
  color: var(--ink-soft);
  line-height: 1.8;
  text-align: center;
  margin-bottom: var(--space-md);
}

.paywall-price {
  font-family: var(--font-lat);
  font-size: 56rpx;
  color: var(--acc);
  margin-bottom: var(--space-lg);
}

.paywall-price-sub {
  font-family: var(--font-song);
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-left: 12rpx;
}

.paywall-btn {
  width: 100%;
}

.paywall-close {
  margin-top: var(--space-lg);
  font-size: var(--text-xs);
  color: var(--ink-faint);
  padding: 8rpx 24rpx;
}

.paywall-close-active {
  color: var(--acc);
}

/* ========================================
   缘笺预览弹层
   ======================================== */
.yuan-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 130;
  background: var(--paper);
  border-top: 2rpx solid var(--line-strong);
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  padding: var(--space-lg) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  animation: dt-up 0.22s ease;
}

@keyframes dt-up { from { transform: translateY(40%); opacity: .4; } to { transform: none; opacity: 1; } }

.yuan-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.yuan-sheet-title {
  font-family: var(--font-kai);
  font-size: var(--text-base);
  color: var(--ink);
  letter-spacing: 0.1em;
}

.yuan-sheet-x {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink-faint);
  border: 2rpx solid var(--line);
  border-radius: 50%;
}

.yuan-sheet-x-active {
  color: var(--acc);
  border-color: var(--acc);
}

.yuan-sheet-img {
  width: 100%;
  border-radius: var(--radius-sm);
  display: block;
}

.yuan-sheet-actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

/* ========================================
   四章弹层（墨韵线装书，同命书弹层样式）
   ======================================== */
.dt-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 120;
  background: rgba(58, 44, 30, 0.38);
  animation: dt-fade 0.18s ease;
}

.dt-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 130;
  height: 82vh;
  background: var(--paper);
  border-top: 2rpx solid var(--line-strong);
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 40rpx var(--shadow);
  display: flex;
  flex-direction: column;
  animation: dt-up 0.22s ease;
}

.dt-top {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 36rpx 22rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.dt-seal {
  width: 62rpx;
  height: 62rpx;
  font-size: 38rpx;
  flex-shrink: 0;
}

.dt-titles {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.dt-no {
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: var(--acc);
  flex-shrink: 0;
}

.dt-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 32rpx;
  letter-spacing: 0.14em;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dt-x {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink-faint);
  border: 2rpx solid var(--line);
  border-radius: 50%;
  box-sizing: border-box;
}

.dt-x-active {
  color: var(--acc);
  border-color: var(--acc);
}

.dt-body {
  flex: 1;
  min-height: 0;
  padding: 26rpx 40rpx 30rpx;
  box-sizing: border-box;
}

.dt-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.dt-meta-item {
  font-family: var(--font-song);
  font-size: 19rpx;
  letter-spacing: 0.1em;
  color: var(--ink-soft);
  border: 1rpx solid var(--line-med);
  border-radius: 5rpx;
  padding: 4rpx 14rpx;
}

.chapter {
  margin-bottom: var(--space-lg);
}

.chapter-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: var(--space-sm);
}

.chapter-seal {
  width: 44rpx;
  height: 44rpx;
  font-size: 26rpx;
}

.chapter-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: var(--text-base);
  letter-spacing: 0.14em;
  color: var(--ink);
}

.chapter-content {
  display: block;
  font-family: var(--font-kai);
  font-size: 28rpx;
  line-height: 2.05;
  letter-spacing: 0.03em;
  color: var(--ink-mid);
  white-space: pre-wrap;
  word-break: break-all;
}

.dt-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 34rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line-soft);
}

.dt-foot-seal {
  width: 44rpx;
  height: 44rpx;
  font-size: 26rpx;
}

.dt-foot-txt {
  font-family: var(--font-song);
  font-size: 20rpx;
  letter-spacing: 0.1em;
  color: var(--ink-faint);
}

.dt-bar {
  flex-shrink: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line-soft);
}

.dt-bar-btn {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: var(--acc);
  color: #FBF6E8;
  font-size: var(--text-sm);
  border: none;
}

/* 缘笺画布（隐藏） */
.hh-canvas-off {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1200px;
}

/* ═══ 合盘历史记录（v2026-08-17 PM：只显示自己的 · 脱敏摘要） ═══ */
.hh-history-link {
  margin-top: 14rpx;
  padding: 8rpx 22rpx;
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: .18em;
  color: var(--acc);
  background: var(--acc-soft);
  border-radius: 999rpx;
}
.hh-history-link-active { opacity: .75; }

.hh-hist-note {
  margin: 0 40rpx 8rpx;
  font-size: 22rpx;
  text-align: center;
  color: var(--ink-faint);
  line-height: 1.7;
}

.hh-history-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  height: 68vh;
  display: flex;
  flex-direction: column;
  background: var(--paper-card);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.hh-history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 34rpx 16rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.hh-history-title {
  font-family: var(--font-song);
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: .14em;
  color: var(--ink);
}
.hh-history-x {
  width: 60rpx; height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--ink-soft);
  border-radius: 50%;
}
.hh-x-active { background: var(--acc-soft); color: var(--acc); }
.hh-history-body { flex: 1; min-height: 0; }
.hh-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 34rpx;
  padding: 26rpx 6rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.hh-history-item-active { background: var(--acc-soft); }
.hh-hi-top { display: flex; align-items: baseline; gap: 10rpx; }
.hh-hi-score { font-size: 40rpx; font-weight: 700; color: var(--acc); font-family: var(--font-song); }
.hh-hi-unit { font-size: 22rpx; color: var(--ink-soft); }
.hh-hi-level { font-size: 26rpx; color: var(--ink); }
.hh-hi-rel {
  font-size: 20rpx;
  color: var(--gold);
  border: 2rpx solid var(--gold-soft);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.hh-hi-time { display: block; margin-top: 8rpx; font-size: 21rpx; color: var(--ink-faint); }
.hh-hi-chev { width: 40rpx; }
.hh-history-empty {
  padding: 80rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.9;
}
