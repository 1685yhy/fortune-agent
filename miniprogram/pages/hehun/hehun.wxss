/* 合婚配对 — 双星合璧 | v6 靛蓝夜空 + 磨砂玻璃 + 暖金 */
.content-enter { animation: fadeUp 0.3s ease-out both; }

.page-hehun {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: var(--bg-night);
}

/* ========================================
   Header
   ======================================== */
.hh-header {
  padding: 80rpx var(--space-lg) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hh-header-icon {
  font-size: var(--text-lg);
  margin-bottom: var(--space-sm);
}

.hh-header-title {
  font-family: var(--font-brush);
  font-size: var(--text-xl);
  font-weight: 400;
  color: var(--ink-primary);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-xs);
}

.hh-header-subtitle {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  max-width: 560rpx;
  line-height: 1.6;
}

/* ========================================
   Empty State
   ======================================== */
.empty-state {
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-state-icon {
  font-size: var(--text-xl);
  margin-bottom: var(--space-md);
}

.empty-state-text {
  font-size: var(--text-sm);
  color: var(--ink-muted);
  max-width: 480rpx;
  line-height: 1.6;
}

/* ========================================
   Card — 磨砂玻璃
   ======================================== */
.card {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin: 0 var(--space-lg) var(--space-md);
}

.card-header {
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.card-title {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--gold);
  letter-spacing: 0.04em;
}

/* ========================================
   Form
   ======================================== */
.form-group {
  margin-bottom: var(--space-md);
}

.form-label {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  display: block;
  margin-bottom: var(--space-sm);
}

.form-picker {
  padding: var(--space-md);
  background: var(--bg-input);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: var(--text-sm);
  color: var(--ink-primary);
}

.form-radio-group {
  display: flex;
  gap: var(--space-md);
}

.form-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--bg-input);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  flex: 1;
}

.form-radio.active {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(212, 165, 116, 0.12);
}

/* ========================================
   Divider — 金色渐变
   ======================================== */
.hh-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-lg);
  gap: var(--space-md);
}

.hh-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(212,165,116,0) 0%, rgba(212,165,116,0.4) 50%, rgba(212,165,116,0) 100%);
}

.hh-divider-icon {
  font-size: var(--text-sm);
  flex-shrink: 0;
}

/* ========================================
   Submit Button — 暖金渐变
   ======================================== */
.hh-submit-wrap {
  padding: var(--space-lg) var(--space-lg);
}

.hh-submit-btn {
  width: 100%;
  padding: var(--space-sm) 0;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #D4A574 0%, #C9986A 100%);
  border: none;
  font-size: var(--text-base);
  font-weight: 500;
  color: #241A10;
  text-align: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hh-submit-btn[disabled] {
  opacity: 0.7;
}

/* ========================================
   Loading State
   ======================================== */
.hh-loading {
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hh-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.08);
  border-top-color: var(--gold);
  animation: spin 0.8s linear infinite;
  margin-bottom: var(--space-lg);
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.hh-loading-text {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  margin-bottom: var(--space-sm);
}

.hh-loading-sub {
  font-size: var(--text-xs);
  color: var(--ink-muted);
}

/* ========================================
   Score Card (score-ring component)
   ======================================== */
.score-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xl) var(--space-lg);
}

.score-ring-title {
  font-size: var(--text-base);
  font-weight: 500;
  color: var(--ink-primary);
  margin-top: var(--space-lg);
  margin-bottom: var(--space-sm);
}

.score-ring-desc {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  text-align: center;
  max-width: 520rpx;
  line-height: 1.6;
}

/* ========================================
   Breakdown Cards Row
   ======================================== */
.breakdown-row {
  display: flex;
  gap: var(--space-sm);
  padding: 0 var(--space-lg);
  margin-bottom: var(--space-md);
}

.breakdown-card {
  flex: 1;
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-sm);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.breakdown-icon {
  font-size: var(--text-sm);
  margin-bottom: var(--space-xs);
}

.breakdown-label {
  font-size: var(--text-xs);
  color: var(--ink-muted);
  margin-bottom: var(--space-sm);
}

.breakdown-score {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--gold);
  line-height: 1;
  margin-bottom: var(--space-xs);
}

.breakdown-detail {
  font-size: 20rpx;
  color: var(--ink-muted);
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========================================
   Advice List
   ======================================== */
.advice-card {
  padding-bottom: var(--space-lg);
}

.advice-list {
  padding-top: var(--space-sm);
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.advice-item:last-child {
  border-bottom: none;
}

.advice-dot {
  font-size: var(--text-sm);
  color: var(--gold);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.advice-text {
  font-size: var(--text-sm);
  color: var(--ink-secondary);
  line-height: 1.6;
  flex: 1;
}

/* ========================================
   Reset
   ======================================== */
.hh-reset-wrap {
  padding: var(--space-lg) var(--space-lg);
}

.hh-reset-btn {
  width: 100%;
  padding: var(--space-sm) 0;
  border-radius: var(--radius-pill);
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--ink-secondary);
  text-align: center;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
