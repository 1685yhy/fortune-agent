<!-- 双人合盘 · 缘分契合 — 输入两人生辰 → 免费结果 → 墨韵缘笺 / 深度报告解锁 -->
<!-- 注意：页面根不带动画（transform 会形成 containing block，破坏 position:fixed 弹层） -->
<view class="page-hehun">

  <!-- ===== 头部 ===== -->
  <view class="hh-header">
    <view class="hh-header-seal"><text class="hh-header-seal-char">合</text></view>
    <text class="hh-header-title">双人合盘 · 缘分契合</text>
    <text class="hh-header-subtitle">输入两人生辰，看看你们合不合</text>
  </view>

  <!-- ===== 表单区 ===== -->
  <view class="hh-form" wx:if="{{!submitted}}">

    <!-- 我方 -->
    <view class="card hh-card">
      <view class="card-header hh-card-head">
        <text class="card-title">我方 · 我的生辰</text>
        <text class="hh-pick-archive" hover-class="hh-pick-archive-active" hover-stay-time="0"
          data-target="p1" bindtap="onPickPerson">从档案选择</text>
      </view>

      <view class="form-group">
        <text class="form-label">出生年份 <text class="form-required">必填</text></text>
        <picker mode="selector" range="{{yearOptions}}" bindchange="onP1YearChange" value="{{p1YearIdx}}">
          <view class="form-picker {{p1BirthYear === '请选择' ? 'form-picker-empty' : ''}}">
            <text>{{p1BirthYear === '请选择' ? '请选择出生年份' : p1BirthYear + ' 年'}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生月份 <text class="form-required">必填</text></text>
        <picker mode="selector" range="{{monthOptions}}" bindchange="onP1MonthChange" value="{{p1MonthIdx}}">
          <view class="form-picker {{p1BirthMonth === '请选择' ? 'form-picker-empty' : ''}}">
            <text>{{p1BirthMonth === '请选择' ? '请选择出生月份' : p1BirthMonth + ' 月'}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生日期 <text class="form-required">必填</text></text>
        <picker mode="selector" range="{{dayOptions}}" bindchange="onP1DayChange" value="{{p1DayIdx}}">
          <view class="form-picker {{p1BirthDay === '请选择' ? 'form-picker-empty' : ''}}">
            <text>{{p1BirthDay === '请选择' ? '请选择出生日期' : p1BirthDay + ' 日'}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生时辰 <text class="form-optional">选填，填了更准</text></text>
        <picker mode="selector" range="{{hourOptions}}" bindchange="onP1HourChange" value="{{p1HourIdx}}">
          <view class="form-picker {{!p1HourSet ? 'form-picker-empty' : ''}}">
            <text>{{hourOptions[p1HourIdx]}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生地 <text class="form-optional">选填</text></text>
        <picker mode="selector" range="{{cities}}" bindchange="onP1CityChange" value="{{p1CityIdx}}">
          <view class="form-picker {{!p1CitySet ? 'form-picker-empty' : ''}}">
            <text>{{p1City}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">性别</text>
        <view class="form-radio-group">
          <label class="form-radio {{p1Gender === 'male' ? 'active' : ''}}">
            <radio value="male" checked="{{p1Gender === 'male'}}" bindchange="onP1GenderChange" color="#A93A2C" />
            <text>男</text>
          </label>
          <label class="form-radio {{p1Gender === 'female' ? 'active' : ''}}">
            <radio value="female" checked="{{p1Gender === 'female'}}" bindchange="onP1GenderChange" color="#A93A2C" />
            <text>女</text>
          </label>
        </view>
      </view>
    </view>

    <!-- 分隔 -->
    <view class="hh-divider">
      <view class="hh-divider-line"></view>
      <view class="hh-divider-seal"><text>缘</text></view>
      <view class="hh-divider-line"></view>
    </view>

    <!-- TA -->
    <view class="card hh-card">
      <view class="card-header hh-card-head">
        <text class="card-title">他/她 · TA的生辰
          <text wx:if="{{p2FromCache}}" class="hh-cache-tag">上次记录</text>
        </text>
        <text class="hh-pick-archive" hover-class="hh-pick-archive-active" hover-stay-time="0"
          data-target="p2" bindtap="onPickPerson">从档案选择</text>
      </view>

      <view class="form-group">
        <text class="form-label">出生年份 <text class="form-required">必填</text></text>
        <picker mode="selector" range="{{yearOptions}}" bindchange="onP2YearChange" value="{{p2YearIdx}}">
          <view class="form-picker {{p2BirthYear === '请选择' ? 'form-picker-empty' : ''}}">
            <text>{{p2BirthYear === '请选择' ? '请选择出生年份' : p2BirthYear + ' 年'}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生月份 <text class="form-required">必填</text></text>
        <picker mode="selector" range="{{monthOptions}}" bindchange="onP2MonthChange" value="{{p2MonthIdx}}">
          <view class="form-picker {{p2BirthMonth === '请选择' ? 'form-picker-empty' : ''}}">
            <text>{{p2BirthMonth === '请选择' ? '请选择出生月份' : p2BirthMonth + ' 月'}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生日期 <text class="form-required">必填</text></text>
        <picker mode="selector" range="{{dayOptions}}" bindchange="onP2DayChange" value="{{p2DayIdx}}">
          <view class="form-picker {{p2BirthDay === '请选择' ? 'form-picker-empty' : ''}}">
            <text>{{p2BirthDay === '请选择' ? '请选择出生日期' : p2BirthDay + ' 日'}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生时辰 <text class="form-optional">选填，填了更准</text></text>
        <picker mode="selector" range="{{hourOptions}}" bindchange="onP2HourChange" value="{{p2HourIdx}}">
          <view class="form-picker {{!p2HourSet ? 'form-picker-empty' : ''}}">
            <text>{{hourOptions[p2HourIdx]}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">出生地 <text class="form-optional">选填</text></text>
        <picker mode="selector" range="{{cities}}" bindchange="onP2CityChange" value="{{p2CityIdx}}">
          <view class="form-picker {{!p2CitySet ? 'form-picker-empty' : ''}}">
            <text>{{p2City}}</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">性别</text>
        <view class="form-radio-group">
          <label class="form-radio {{p2Gender === 'male' ? 'active' : ''}}">
            <radio value="male" checked="{{p2Gender === 'male'}}" bindchange="onP2GenderChange" color="#A93A2C" />
            <text>男</text>
          </label>
          <label class="form-radio {{p2Gender === 'female' ? 'active' : ''}}">
            <radio value="female" checked="{{p2Gender === 'female'}}" bindchange="onP2GenderChange" color="#A93A2C" />
            <text>女</text>
          </label>
        </view>
      </view>
    </view>

    <!-- 关系标签 -->
    <view class="hh-relation card">
      <view class="hh-relation-label">你们的关系</view>
      <view class="hh-relation-chips">
        <view wx:for="{{relations}}" wx:key="*this"
          class="hh-chip {{relation === item ? 'hh-chip-on' : ''}}"
          hover-class="hh-chip-active" hover-stay-time="0"
          data-rel="{{item}}" bindtap="onRelationTap">{{item}}</view>
      </view>
    </view>

    <!-- 错误提示 -->
    <view class="hh-error" wx:if="{{errorMsg}}">
      <text>{{errorMsg}}</text>
    </view>

    <!-- 提交 -->
    <view class="hh-submit-wrap">
      <button class="hh-submit-btn" bindtap="onSubmit" loading="{{loading}}" disabled="{{loading}}">
        <text wx:if="{{!loading}}">推演两人命盘</text>
        <text wx:else>推演两人命盘中…</text>
      </button>
      <text class="hh-submit-note">结果即时生成 · 可免费生成墨韵缘笺</text>
    </view>
  </view>

  <!-- ===== 结果区（免费） ===== -->
  <view class="hh-results" wx:if="{{submitted && result}}">

    <!-- 契合概览 -->
    <view class="card hh-overview">
      <view class="hh-score-row">
        <text class="hh-score-num">{{result.score}}</text>
        <text class="hh-score-unit">分</text>
      </view>
      <text class="hh-score-level">{{result.levelLabel}}</text>
      <text class="hh-score-sub" wx:if="{{result.levelSublabel}}">{{result.levelSublabel}}</text>
      <text class="hh-hour-note" wx:if="{{hourNotSetNote}}">时辰未填，仅供参考</text>
    </view>

    <!-- 三维得分条（数值可见，明细锁定） -->
    <view class="card hh-dims">
      <view class="card-header">
        <text class="card-title">三维契合得分</text>
      </view>
      <view class="hh-dim" wx:for="{{dims}}" wx:key="key" data-key="{{item.key}}" bindtap="onDimTap">
        <view class="hh-dim-top">
          <text class="hh-dim-label">{{item.label}}</text>
          <text class="hh-dim-value">{{item.score}}/{{item.max}}</text>
        </view>
        <view class="hh-dim-bar">
          <view class="hh-dim-bar-fill" style="width: {{item.max > 0 ? item.score / item.max * 100 : 0}}%; background: {{item.color}};"></view>
        </view>
      </view>
      <text class="hh-dim-lock">点击得分条查看明细 · 见深度报告·契合详情章</text>
    </view>

    <!-- 缘语 -->
    <view class="card hh-yuan">
      <view class="card-header">
        <text class="card-title">缘语</text>
      </view>
      <text class="hh-yuan-line">{{yuanLine}}</text>
      <view wx:if="{{cliffhanger}}" class="hh-yuan-cliff">
        <text class="hh-yuan-cliff-text">{{cliffhanger}}</text>
        <text class="hh-yuan-expand" hover-class="hh-yuan-expand-active" hover-stay-time="0" bindtap="onExpandCliffhanger">展开</text>
      </view>
    </view>

    <!-- 按钮行 -->
    <view class="hh-action-row">
      <button class="hh-btn hh-btn-primary" bindtap="onGenerateCard" disabled="{{generatingCard}}" loading="{{generatingCard}}">生成墨韵缘笺（免费）</button>
      <button class="hh-btn hh-btn-gold" bindtap="onUnlock" disabled="{{purchasing}}">解锁深度报告 ¥19.9</button>
    </view>
    <view class="hh-action-row hh-action-row-sub">
      <button class="hh-btn hh-btn-ghost" bindtap="onSwitchPerson">换一个人再测</button>
      <button class="hh-btn hh-btn-ghost" bindtap="onReInput">重新输入</button>
    </view>
  </view>

  <!-- ===== 付费墙弹层（悬念半句展开） ===== -->
  <view wx:if="{{showPaywall}}" class="mask" bindtap="onClosePaywall"></view>
  <view wx:if="{{showPaywall}}" class="paywall-sheet" catchtouchmove="noop">
    <view class="paywall-seal"><text>深</text></view>
    <text class="paywall-title">缘分之谜，未完待续</text>
    <text class="paywall-cliff" wx:if="{{cliffhanger}}">{{cliffhanger}}</text>
    <text class="paywall-desc">解锁深度报告，看前世今生 / 相处模式 / 矛盾点与化解 / 契合详情 四章完整解读</text>
    <view class="paywall-price">¥19.9 <text class="paywall-price-sub">一次解锁 · 永久回看</text></view>
    <button class="hh-btn hh-btn-gold paywall-btn" bindtap="onUnlock" disabled="{{purchasing}}">解锁深度报告</button>
    <text class="paywall-close" hover-class="paywall-close-active" hover-stay-time="0" bindtap="onClosePaywall">暂不，再想想</text>
  </view>

  <!-- ===== 缘笺预览弹层 ===== -->
  <view wx:if="{{showYuanPreview}}" class="mask" bindtap="onCloseYuanPreview"></view>
  <view wx:if="{{showYuanPreview}}" class="yuan-sheet" catchtouchmove="noop">
    <view class="yuan-sheet-head">
      <text class="yuan-sheet-title">墨韵缘笺</text>
      <text class="yuan-sheet-x" hover-class="yuan-sheet-x-active" hover-stay-time="0" bindtap="onCloseYuanPreview">✕</text>
    </view>
    <image class="yuan-sheet-img" src="{{yuanImagePath}}" mode="widthFix"></image>
    <view class="yuan-sheet-actions">
      <button class="hh-btn hh-btn-primary" bindtap="onSaveCard">保存到相册</button>
      <button class="hh-btn hh-btn-gold" bindtap="onShareCard">分享给好友</button>
    </view>
  </view>

  <!-- ===== 四章弹层（墨韵线装书，参照命书弹层样式） ===== -->
  <view wx:if="{{showReport}}" class="dt-mask" bindtap="onCloseReport"></view>
  <view wx:if="{{showReport}}" class="dt-sheet" catchtouchmove="noop">
    <view class="dt-top">
      <view class="seal dt-seal"><text class="seal-char">明</text></view>
      <view class="dt-titles">
        <text class="dt-no">双人合盘</text>
        <text class="dt-title">深度报告</text>
      </view>
      <view class="dt-x" hover-class="dt-x-active" hover-stay-time="0" bindtap="onCloseReport">✕</view>
    </view>
    <scroll-view scroll-y class="dt-body">
      <view class="dt-meta">
        <text class="dt-meta-item">{{result.score}} 分</text>
        <text class="dt-meta-item">{{result.levelLabel}}</text>
        <text wx:if="{{result.relation}}" class="dt-meta-item">{{result.relation}}</text>
        <text class="dt-meta-item">已存入报告页</text>
      </view>
      <view class="chapter" wx:for="{{report.chapters}}" wx:key="title">
        <view class="chapter-head">
          <view class="seal chapter-seal"><text class="seal-char">{{index + 1}}</text></view>
          <text class="chapter-title">{{item.title}}</text>
        </view>
        <text class="chapter-content" selectable>{{item.content}}</text>
      </view>
      <view class="dt-foot">
        <view class="seal dt-foot-seal"><text class="seal-char">明</text></view>
        <text class="dt-foot-txt">明灯谨录 · 观命不执命</text>
      </view>
    </scroll-view>
    <view class="dt-bar">
      <button class="dt-bar-btn" bindtap="goReports">去报告页查看</button>
    </view>
  </view>

  <!-- 缘笺画布（隐藏，绘制用） -->
  <canvas type="2d" id="shareCanvas" class="hh-canvas-off"></canvas>
</view>
