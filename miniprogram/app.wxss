/* ── 书法字体（远程托管：https://yilichat.com/fonts/，nginx 静态服务，缓存 7 天）
   @font-face 使用 https 远程 URL，不占主包体积（修复微信代码质量扫描 >1.5M 报错）
   文楷 LXGWWenKai.woff / 马善政 MaShanZheng.woff / Instrument Serif InstrumentSerif.ttf ── */
@font-face {
  font-family: 'LXGW WenKai';
  src: url('https://yilichat.com/fonts/LXGWWenKai.woff') format('woff');
  font-weight: normal;
  font-style: normal;
}
@font-face {
  font-family: 'Ma Shan Zheng';
  src: url('https://yilichat.com/fonts/MaShanZheng.woff') format('woff');
  font-weight: normal;
  font-style: normal;
}
@font-face {
  font-family: 'Instrument Serif';
  src: url('https://yilichat.com/fonts/InstrumentSerif.ttf') format('truetype');
  font-weight: normal;
  font-style: italic;
}


/* ═══════════════════════════════════════════════════════════════
   易理明灯 · 视觉方向 B — 东方墨韵 · 宣纸墨韵
   宣纸为底 #F5EFE1 · 墨分五色 · 朱砂惟一点睛 #A93A2C
   宋体衬线为骨 · 文楷载笺注 · 小圆角 · 零渐变按钮 · 零 emoji
   签名元素：朱砂印章「明」· 笺纸细框 · 线装缝线 · 竖排手札
   ═══════════════════════════════════════════════════════════════ */

page {
  /* ── 真机修复：任何屏宽下禁止横向滚动（内容溢出由 overflow 裁剪，不撑宽页面） ── */
  overflow-x: hidden;
  /* ── 墨分五色 ── */
  --ink: #3A2C1E;          /* 浓墨 — 标题 */
  --ink-mid: #6C5B45;      /* 中墨 — 正文 */
  --ink-soft: #9A8B71;     /* 淡墨 — 注与线 */
  --ink-faint: #BBAE92;    /* 水痕 — 更淡 */
  /* ── 朱砂点睛 ── */
  --acc: #A93A2C;
  --acc-deep: #8C2E22;
  --acc-soft: rgba(169,58,44,.11);
  /* ── 暖金点缀（金线 / 烛光） ── */
  --gold: #B08A4F;
  --gold-soft: rgba(176,138,79,.22);
  /* ── 宣纸 ── */
  --paper: #F5EFE1;
  --paper-deep: #EFE6D1;
  --paper-card: #FBF7EC;
  --line: rgba(58,44,30,.16);
  --line-soft: rgba(58,44,30,.09);
  /* ── 字体：宋体为骨 · 文楷载笺（原型 LXGW WenKai）· 马善政刷体标题 · 衬线拉丁点缀 ── */
  --font-song: 'Songti SC','Noto Serif SC','Source Han Serif SC','STSong','SimSun',serif;
  --font-kai: 'LXGW WenKai','Kaiti SC','STKaiti','KaiTi','BiauKai','Kai',serif;
  --font-brush: 'Ma Shan Zheng','LXGW WenKai','Kaiti SC','STKaiti','KaiTi',serif;
  --font-lat: 'Instrument Serif',Georgia,'Times New Roman','Songti SC',serif;
  /* ── 原型 :root 补充：诗行/正文语体（默认文楷载笺，--poem=--font-kai） ── */
  --poem: var(--font-kai);
  --body: var(--font-song);
  /* ── 度量 ── */
  --space-xs: 8rpx; --space-sm: 16rpx; --space-md: 24rpx; --space-lg: 32rpx; --space-xl: 48rpx;
  --radius-sm: 8rpx; --radius-md: 14rpx; --radius-lg: 18rpx; --radius-pill: 24rpx;
  --text-xs: 22rpx; --text-sm: 26rpx; --text-base: 30rpx; --text-lg: 38rpx; --text-xl: 52rpx;
  /* ── v6 旧 token 兼容（组件/旧页引用，值已映射至宣纸墨韵） ── */
  --bg-night: #F5EFE1;
  --bg-card: #FBF7EC;
  --bg-input: #FBF7EC;
  --ink-primary: #3A2C1E;
  --ink-secondary: #6C5B45;
  --ink-muted: #9A8B71;
  --gold-light: #A93A2C;
  --lavender: #9A8B71;
  --success: #5F6B4F;
  --error: #A93A2C;
  /* ── 派生色（墨框深浅 / 阴影 / 浮层底 / 标签底 / 封面渐变） ── */
  --line-strong: rgba(58,44,30,.38);
  --line-mid: rgba(58,44,30,.4);
  --line-med: rgba(58,44,30,.22);
  --line-hard: rgba(58,44,30,.6);
  --line-input: rgba(58,44,30,.28);
  --line-btn: rgba(58,44,30,.75);
  --ink-brand: rgba(108,91,69,.72);
  --acc-line: rgba(169,58,44,.28);
  --shadow-sm: rgba(58,44,30,.05);
  --shadow: rgba(58,44,30,.08);
  --shadow-lg: rgba(58,44,30,.1);
  --tabbar-bg: rgba(245,239,225,.97);
  --tag-bg: rgba(251,247,236,.55);
  --cover-grad: linear-gradient(165deg, #F7F0DE 0%, #F2E9D2 55%, #ECDFC3 100%);

  background-color: var(--paper);
  color: var(--ink);
  font-family: var(--font-song);
  font-size: var(--text-base);
  line-height: 1.75;
  -webkit-font-smoothing: antialiased;
}


/* Reset — wxss 不支持通配符，标签级 reset */
page, view, text, input, textarea, button, image, scroll-view, rich-text, icon, navigator, switch, slider { margin:0; padding:0; box-sizing:border-box; }

/* ── 导航行 navrow（原型：top 47px / h 48px / back·title·right） ── */
.navrow {
  position: absolute;
  top: calc(90rpx + var(--nav-off));   /* 原型 47px，--nav-off 由页面按状态栏高度补齐 */
  left: 0;
  right: 0;
  height: 92rpx;        /* 原型 48px */
  z-index: 35;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navrow .back {
  position: absolute;
  left: 19rpx;          /* 原型 left 10px */
  top: 4rpx;            /* 原型 top 2px */
  width: 85rpx;         /* 原型 44px */
  height: 85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  border-radius: 15rpx; /* 原型 8px */
}
.navrow .back:active, .navrow-hover { background: var(--acc-soft); color: var(--acc); }
.navrow .back-icon { width: 38rpx; height: 38rpx; }  /* 原型 20px */
.navrow .nav-title {
  font-family: var(--font-song);
  font-weight: 600;
  font-size: 33rpx;     /* 原型 17px */
  letter-spacing: .3em;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 17rpx;           /* 原型 9px */
}
.navrow .nav-title .nav-lantern { width: 29rpx; height: 29rpx; }  /* 原型 15px */
.navrow .nav-right {
  position: absolute;
  right: 19rpx;         /* 原型 right 10px */
  top: 4rpx;
  width: 85rpx;
  height: 85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-mid);
  border-radius: 15rpx;
}
.navrow .nav-right:active { background: var(--acc-soft); color: var(--acc); }
.navrow .nav-right.navrow-hover { background: var(--acc-soft); color: var(--acc); }
.navrow .nav-right-icon { width: 37rpx; height: 37rpx; }  /* 原型 19px */

/* ── 笺纸卡（原型 .papercard：无内边距，行间线由行元素自带） ── */
.papercard {
  background: var(--paper-card);
  border: 2rpx solid var(--line);   /* 原型 1px → 2rpx */
  border-radius: 10rpx;             /* 原型 5px → 10rpx */
  box-shadow: 0 6rpx 19rpx var(--shadow-sm);  /* 原型 0 3px 10px → 0 6rpx 19rpx */
}
.card {
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
  padding: var(--space-lg);
  box-shadow: 0 6rpx 19rpx var(--shadow-sm);
  margin: 0 var(--space-lg);
}

/* ── 纸面按钮（想聊聊？/ 收好） ── */
.btn-primary {
  background: var(--paper-card);
  color: var(--ink);
  border: 2rpx solid var(--line-btn);  /* 原型 1px → 2rpx */
  border-radius: 8rpx;                     /* 原型 4px → 8rpx */
  padding: var(--space-sm) var(--space-xl);
  font-size: 31rpx;                        /* 原型 16px → 31rpx */
  font-weight: 400;
  letter-spacing: .22em;
  text-align: center;
  box-shadow: 0 4rpx 15rpx var(--shadow);  /* 原型 0 2px 8px → 0 4rpx 15rpx */
}
.btn-primary:active { background: var(--acc-soft); transform: translateY(2rpx) scale(.985); }

/* ── 线框次按钮 ── */
.btn-secondary {
  background: transparent;
  color: var(--ink-mid);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: var(--space-sm) var(--space-xl);
  font-size: var(--text-sm);
  letter-spacing: .12em;
  text-align: center;
}
.btn-secondary:active { background: var(--acc-soft); color: var(--acc); }

/* ── 浅墨小标签 ── */
.inktag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;          /* 原型 5px → 10rpx */
  font-size: 20rpx;    /* 原型 10.5px → 20rpx */
  letter-spacing: .12em;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);   /* 原型 1px → 2rpx */
  border-radius: 5rpx; /* 原型 2.5px → 5rpx */
  padding: 5rpx 15rpx; /* 原型 2.5px 8px → 5rpx 15rpx */
  background: var(--tag-bg);
}

/* ── 朱砂印章「明」— 全局签名元素 ── */
.seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--acc);
  color: #FBF6E8;
  border-radius: 6rpx;  /* 原型 3px → 6rpx */
  font-family: var(--font-brush);
  font-weight: 400;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,.12), 0 2rpx 6rpx rgba(60,30,20,.25);  /* 原型 inset 1px → 2rpx */
  flex-shrink: 0;
  transform: rotate(-3deg);
}
.seal .seal-char { transform: translateY(1rpx); }

/* ── 细线 ── */
.hairline { height: 1rpx; background: var(--line-soft); }
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--line), transparent);
  margin: var(--space-md) 0;
}

/* ── 文字层级 ── */
.text-muted { color: var(--ink-muted); font-size: var(--text-sm); }
.text-secondary { color: var(--ink-secondary); }
.text-gold { color: var(--acc); }
.text-xs { font-size: var(--text-xs); }
.text-sm { font-size: var(--text-sm); }
.text-lg { font-size: var(--text-lg); }
.text-xl { font-size: var(--text-xl); }
.text-center { text-align: center; }
.font-kai { font-family: var(--font-kai); }
.font-song { font-family: var(--font-song); }
.font-brush { font-family: var(--font-brush); }
.font-lat { font-family: var(--font-lat); font-style: italic; }

/* ── 间距 ── */
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mt-xl { margin-top: var(--space-xl); }
.mb-md { margin-bottom: var(--space-md); }
.px-lg { padding: 0 var(--space-lg); }

/* ── 动效 ── */
@keyframes fadeUp {
  from { opacity:0; transform:translateY(8rpx); }
  to { opacity:1; transform:translateY(0); }
}
.fade-in { animation: fadeUp .3s ease-out; }

@keyframes breathe {
  0%,100% { opacity:.4; }
  50% { opacity:1; }
}
.breathe { animation: breathe 2.4s ease-in-out infinite; }

/* 墨点打字（研墨） */
@keyframes dotPulse {
  0%,100% { opacity:.25; transform:translateY(0); }
  50% { opacity:1; transform:translateY(-5rpx); }  /* 原型 -2.5px → -5rpx */
}
.inkdot {
  width: 9rpx; height: 9rpx; border-radius: 50%;
  background: var(--ink-soft);
  animation: dotPulse 1.1s ease-in-out infinite;
}
.inkdot:nth-child(2) { animation-delay:.18s; }
.inkdot:nth-child(3) { animation-delay:.36s; }

/* 减动效 */
@media (prefers-reduced-motion:reduce) {
  .fade-in,.breathe,.inkdot { animation:none; }
}

/* ═══════════════════════════════════════════════════════════════
   dir_b 原型共享件 — 屏容器 / 页面内 TabBar / 灯笼呼吸 / 屏入场
   ═══════════════════════════════════════════════════════════════ */

/* 屏容器（原型 .screen：absolute inset 0 + screenIn 入场） */
.screen {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 20;
  overflow: hidden;
  background: var(--paper);
  line-height: 1.5;              /* 原型浏览器默认行高（页面级 1.75 会撑高列表行） */
  animation: screenIn .4s cubic-bezier(.2,.7,.3,1) both;
}
@keyframes screenIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: none; }
}

/* 页面内 TabBar（原型：90px 高 / 34px 安全区垫底 / 图标 22px / 朱砂点） */
.tabbar {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 173rpx;             /* 90px */
  z-index: 38;
  background: var(--tabbar-bg);
  border-top: 2rpx solid var(--line);   /* 1px */
  display: flex;
  padding-bottom: 65rpx;      /* 34px 安全区 */
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;                  /* 4px */
  font-family: var(--font-song);
  font-size: 20rpx;           /* 10.5px */
  letter-spacing: .18em;
  font-weight: 500;
  color: var(--ink-soft);
  position: relative;
}
.tab-item .tab-ic {
  width: 42rpx;               /* 22px */
  height: 42rpx;
  transition: transform .15s;
}
.tab-item.on { color: var(--acc); }
.tab-item.on .tab-ic { transform: translateY(-2rpx); }
.tab-item.on .tab-label { color: var(--ink); }
.tab-item .tab-label { transition: color .18s; }
.tab-item .dot {
  position: absolute;
  bottom: 2rpx;               /* 1px */
  left: 50%;
  transform: translateX(-50%);
  width: 25rpx;               /* 13px */
  height: 4rpx;               /* 2px */
  border-radius: 2rpx;
  background: var(--acc);
}

/* 水墨灯笼 · 暖金烛光呼吸（原型 lanternPulse 4.2s） */
@keyframes lanternPulse {
  0%, 100% { opacity: .5; }
  50% { opacity: .8; }
}
.lantern-glow { animation: lanternPulse 4.2s ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .screen, .lantern-glow { animation: none; }
}


/* ═══════════════════════════════════════════════════════════════
   夜色宣纸主题(方案·灯下漫谈)：暖纸夜色派生 —— 宣纸加深一层(非深色模式)。
   墨韵原 token 一律不动；根视图挂 .night 类时变量级联覆盖。
   夜色=暖纸 #F4EBD6 系(禁灰/禁深墨蓝)，灯笼暖光 + 朱砂点睛不变。
   ═══════════════════════════════════════════════════════════════ */
.night {
  --paper: #F4EBD6;          /* 夜色宣纸：宣纸 #F5EFE1 加深一层·更暖 */
  --paper-deep: #EBDFC4;     /* 深一层夜色纸(便签/深底) */
  --paper-card: #FBF4E1;     /* 夜色笺卡 */
  --line: rgba(58,44,30,.18);
  --line-soft: rgba(58,44,30,.10);
  --line-strong: rgba(58,44,30,.42);
  --tabbar-bg: rgba(244,235,214,.97);
  --tag-bg: rgba(251,244,225,.6);
  --shadow-sm: rgba(58,44,30,.06);
  --shadow: rgba(58,44,30,.09);
  --shadow-lg: rgba(58,44,30,.12);
  --gold: #C08A4B;                   /* 灯笼暖金 */
  --gold-soft: rgba(192,138,75,.26); /* 烛光晕 */
  --cover-grad: linear-gradient(165deg, #F5EDD7 0%, #F0E3C6 55%, #E8D9B4 100%);
}

/* 灯笼 2 秒渐亮(每日一次,可关) */
.lamp-fade { animation: lampFade 2s ease-out; }
@keyframes lampFade { from { opacity: .12; } to { opacity: 1; } }

/* ═══════════════════════════════════════════════════════════════
   k52-1 平台受限引导（iOS 端虚拟支付屏蔽）：替代付费按钮的只读提示，
   无任何可点击的支付元素。全局类，各页复用；配色沿用墨韵 token
   （随暗黑/夜色主题自动适配）。
   ═══════════════════════════════════════════════════════════════ */
.k52-ios-guide {
  margin: 28rpx 8rpx 8rpx;
  padding: 28rpx 30rpx;
  background: var(--paper-card);
  border: 1rpx dashed var(--line);
  border-radius: 16rpx;
}
.k52-ios-guide-title {
  font-family: var(--font-song);
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
}
.k52-ios-guide-line {
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--ink-mid);
}
